  {
    "RowId": 2001,
    "Text": "Das große Jäten"
  },
  {
    "RowId": 2002,
    "Text": "Punkte: <Num>IntegerParameter(1)</Num> / Höchstpunktzahl: <Num>IntegerParameter(2)</Num> "
  },
  {
    "RowId": 2003,
    "Text": "Goldene Saliah-Eier (<Num>IntegerParameter(1)</Num> Pkt.)"
  },
  {
    "RowId": 2004,
    "Text": "Silberne Saliah-Eier (<Num>IntegerParameter(1)</Num> Pkt.)"
  },
  {
    "RowId": 2005,
    "Text": "Bronzene Saliah-Eier (<Num>IntegerParameter(1)</Num> Pkt.)"
  },
  {
    "RowId": 2006,
    "Text": "Pflanzenwesen-Zweige (<Num>IntegerParameter(1)</Num> Pkt.)"
  },
  {
    "RowId": 2007,
    "Text": "Merze die mysteriösen Pflanzenwesen aus und sichere dir Belohnungen!"
  },
  {
    "RowId": 2008,
    "Text": "Da sind sie! Diese lästigen Fallen breiten sich in unserem Areal aus..."
  },
  {
    "RowId": 2009,
    "Text": "Du hast unsere Gegner bezwungen! Weiter so!"
  },
  {
    "RowId": 2010,
    "Text": "Oho? Welch strahlende Schönheit erspähe ich da im Unkraut? Bring mir ein Stück davon!"
  },
  {
    "RowId": 2011,
    "Text": "Welch ein Einsatz! Das Erlegen dieser wundervollen Kreaturen beflügelt ganz offensichtlich deine größten Talente. Vergiss das nicht..."
  },
  {
    "RowId": 2012,
    "Text": "Benutze die Gartensense von Herberin und mähe drauflos!"
  },
  {
    "RowId": 2013,
    "Text": "Jäten abgeschlossen"
  },
  {
    "RowId": 2014,
    "Text": "Dies ist der letzte Bereich, den wir noch stutzen müssen! I-Ich weiß, es ist viel verlangt, aber... ich habe vollstes Vertrauen in dich!"
  },
