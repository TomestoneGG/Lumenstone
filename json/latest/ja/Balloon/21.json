  {
    "RowId": 10050,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 10051,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 10052,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 10053,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 10054,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 10055,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 10056,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 10057,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 10058,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 10059,
    "Dialogue": "環境が一時的に\n激変するかもな",
    "Slowly": false
  },
  {
    "RowId": 10060,
    "Dialogue": "警戒を怠るなよ！",
    "Slowly": false
  },
  {
    "RowId": 10061,
    "Dialogue": "遠方の作業者に\n退避指示を！",
    "Slowly": false
  },
  {
    "RowId": 10062,
    "Dialogue": "活発化した微生物による\n回路への影響とのことだ",
    "Slowly": false
  },
  {
    "RowId": 10063,
    "Dialogue": "幻極光による緊急状況！\n各員、任務への協力を頼む！",
    "Slowly": false
  },
  {
    "RowId": 10064,
    "Dialogue": "繁殖した月面菌類の駆除に\n至急、協力してくれ！",
    "Slowly": false
  },
  {
    "RowId": 10065,
    "Dialogue": "この宙を舞う幻花風が\nレポリットにも影響があるとは…",
    "Slowly": false
  },
  {
    "RowId": 10066,
    "Dialogue": "活発化した微生物が\n彼らを酩酊させるらしい…",
    "Slowly": false
  },
  {
    "RowId": 10067,
    "Dialogue": "みんなの尽力に感謝する！",
    "Slowly": false
  },
  {
    "RowId": 10068,
    "Dialogue": "復旧の目処は立った…\nあとはこちらで片付けておこう",
    "Slowly": false
  },
  {
    "RowId": 10069,
    "Dialogue": "幻極光の予兆が\n観測されました！",
    "Slowly": false
  },
  {
    "RowId": 10070,
    "Dialogue": "幻極光の予兆が\n観測されました！",
    "Slowly": false
  },
  {
    "RowId": 10071,
    "Dialogue": "幻花風の予兆を確認！",
    "Slowly": false
  },
  {
    "RowId": 10072,
    "Dialogue": "幻花風の予兆を確認！",
    "Slowly": false
  },
  {
    "RowId": 10073,
    "Dialogue": "植物の異常成長が\n起こりそうですね",
    "Slowly": false
  },
  {
    "RowId": 10074,
    "Dialogue": "植物を成長させる光か…",
    "Slowly": false
  },
  {
    "RowId": 10075,
    "Dialogue": "異物を除去する\n環境維持機構か…",
    "Slowly": false
  },
  {
    "RowId": 10076,
    "Dialogue": "見た目は綺麗なんだがな…\n機器類が狂うから厄介だ",
    "Slowly": false
  },
  {
    "RowId": 10077,
    "Dialogue": "任務達成です！\nみんな、撤収しましょう！",
    "Slowly": false
  },
  {
    "RowId": 10078,
    "Dialogue": "緊急状況は\nこれにて解除だ！",
    "Slowly": false
  },
  {
    "RowId": 10079,
    "Dialogue": "あとの処理はお任せを！",
    "Slowly": false
  },
  {
    "RowId": 10080,
    "Dialogue": "ふう、後片付けを\nもうひと頑張りだな",
    "Slowly": false
  },
  {
    "RowId": 10081,
    "Dialogue": "物資はこちらへー！",
    "Slowly": false
  },
  {
    "RowId": 10082,
    "Dialogue": "オイジュス由来種の\n駆除をお願いします！",
    "Slowly": false
  },
  {
    "RowId": 10083,
    "Dialogue": "この辺りは\n私たちに任せて！",
    "Slowly": false
  },
  {
    "RowId": 10084,
    "Dialogue": "ここから先は\n火炎放射器は使えないな",
    "Slowly": false
  },
  {
    "RowId": 10085,
    "Dialogue": "鋭い棘に気を付けつつ\n刈り取ってくれ！",
    "Slowly": false
  },
  {
    "RowId": 10086,
    "Dialogue": "この輝く水場の調査だ\n試料の採集を頼んだぞ！",
    "Slowly": false
  },
  {
    "RowId": 10087,
    "Dialogue": "この池は\n何かが違うのか…？",
    "Slowly": false
  },
  {
    "RowId": 10088,
    "Dialogue": "光源について解明すれば\n応用研究に繋がるはず！",
    "Slowly": false
  },
  {
    "RowId": 10089,
    "Dialogue": "月面菌類駆除班はこちら！\n物資の調達を頼みます！",
    "Slowly": false
  },
  {
    "RowId": 10090,
    "Dialogue": "この一帯は\nすぐ片付きそうね",
    "Slowly": false
  },
  {
    "RowId": 10091,
    "Dialogue": "全部を焼くには\n燃焼促進材がいるかな",
    "Slowly": false
  },
  {
    "RowId": 10092,
    "Dialogue": "稀少鉱物果実の回収を頼む！\n掘削用物資も預かるぞ",
    "Slowly": false
  },
  {
    "RowId": 10093,
    "Dialogue": "この下のを掘り出すぞ！",
    "Slowly": false
  },
  {
    "RowId": 10094,
    "Dialogue": "そろそろ替刃が\n欲しいかしらね",
    "Slowly": false
  },
  {
    "RowId": 10095,
    "Dialogue": "地表に出ているのは\nそのまま回収だ！",
    "Slowly": false
  },
  {
    "RowId": 10096,
    "Dialogue": "ローダー修理班はこちら！\n物資調達に協力願います！",
    "Slowly": false
  },
  {
    "RowId": 10097,
    "Dialogue": "回路がショートしているな",
    "Slowly": false
  },
  {
    "RowId": 10098,
    "Dialogue": "補修材が足りないぞ\n誰か持ってきてくれ～",
    "Slowly": false
  },
  {
    "RowId": 10099,
    "Dialogue": "のうひん、のぉ～\nばしょはここ、でぇ～す！",
    "Slowly": false
  },
  {
    "RowId": 10100,
    "Dialogue": "見てくれ、この惨状！！\n酔い覚まし用品を頼む！",
    "Slowly": false
  },
  {
    "RowId": 10101,
    "Dialogue": "僕たちのぉ～～\n新作ダンスを、見てってぇ～！",
    "Slowly": false
  },
  {
    "RowId": 10102,
    "Dialogue": "よいしょっ\nよいしょぉ～！",
    "Slowly": false
  },
  {
    "RowId": 10103,
    "Dialogue": "もっともっと\n踊っちゃえ～～！",
    "Slowly": false
  },
  {
    "RowId": 10104,
    "Dialogue": "たっのし～いな～！\nでも、あれれ…何だっけ…",
    "Slowly": false
  },
  {
    "RowId": 10105,
    "Dialogue": "うぇぇ…\n気持ち悪いや…",
    "Slowly": false
  },
  {
    "RowId": 10106,
    "Dialogue": "ありゃりゃ\n大丈夫？",
    "Slowly": false
  },
  {
    "RowId": 10107,
    "Dialogue": "おいおい\nどうしたもんかね？",
    "Slowly": false
  },
  {
    "RowId": 10108,
    "Dialogue": "楽しそうだけど…\n止めてあげなきゃ",
    "Slowly": false
  },
  {
    "RowId": 10109,
    "Dialogue": "ドローン修理班はこちら！\nショートした機体に気を付けて！",
    "Slowly": false
  },
  {
    "RowId": 10110,
    "Dialogue": "これは精密パーツの\n交換が必要だな～",
    "Slowly": false
  },
  {
    "RowId": 10111,
    "Dialogue": "回収したドローンは\n一旦ここらに集めとくぞ",
    "Slowly": false
  },
  {
    "RowId": 10112,
    "Dialogue": "菌類の胞子と\n検体を集めてくれ！",
    "Slowly": false
  },
  {
    "RowId": 10113,
    "Dialogue": "胞子回収任務は\n俺たちに任せてくれ！",
    "Slowly": false
  },
  {
    "RowId": 10114,
    "Dialogue": "小さい株から\n試料の採集をお願い！",
    "Slowly": false
  },
  {
    "RowId": 10115,
    "Dialogue": "試料回収班は\nここの奥へ進んでね！",
    "Slowly": false
  },
  {
    "RowId": 10116,
    "Dialogue": "あれ、れれれ？\n僕たちはなにを…",
    "Slowly": false
  },
  {
    "RowId": 10117,
    "Dialogue": "すっご～く\n楽しかったなあ",
    "Slowly": false
  },
  {
    "RowId": 10118,
    "Dialogue": "ぷはーっ、すっきりしたー！\n作業だ、作業ー！",
    "Slowly": false
  },
  {
    "RowId": 10119,
    "Dialogue": "るんるんっ…♪まだまだ、これからだよーー！？",
    "Slowly": false
  },
  {
    "RowId": 10120,
    "Dialogue": "もぉ～しっかりして！\n探索に戻んなくっちゃ",
    "Slowly": false
  },
  {
    "RowId": 10121,
    "Dialogue": "まだ瞼の裏で\nキャロットが踊ってるや…",
    "Slowly": false
  },
  {
    "RowId": 10122,
    "Dialogue": "いっくぞぉ～～～♪",
    "Slowly": false
  },
  {
    "RowId": 10123,
    "Dialogue": "るん、るんるんっ☆",
    "Slowly": false
  },
  {
    "RowId": 10124,
    "Dialogue": "すこぉし、休ませて～？",
    "Slowly": false
  },
  {
    "RowId": 10125,
    "Dialogue": "ネオな時代の\n生き方ってのはな…",
    "Slowly": false
  },
  {
    "RowId": 10126,
    "Dialogue": "わぁー、さすがですー",
    "Slowly": false
  },
  {
    "RowId": 10127,
    "Dialogue": "星芒マーケットへ\nようこそー！",
    "Slowly": false
  },
  {
    "RowId": 10128,
    "Dialogue": "故郷の森を\n思い出すな",
    "Slowly": false
  },
  {
    "RowId": 10129,
    "Dialogue": "次の便の資材は\nどのくらい来るんだ？",
    "Slowly": false
  },
  {
    "RowId": 10130,
    "Dialogue": "今調べるね～",
    "Slowly": false
  },
  {
    "RowId": 10131,
    "Dialogue": "倉庫の空きも\n確認しないとな",
    "Slowly": false
  },
  {
    "RowId": 10132,
    "Dialogue": "この見晴らしが\nたまらんな",
    "Slowly": false
  },
  {
    "RowId": 10133,
    "Dialogue": "ギャラクティックウェイ号も\n2号機が必要かもな",
    "Slowly": false
  },
  {
    "RowId": 10134,
    "Dialogue": "輸送効率、倍増ね",
    "Slowly": false
  },
  {
    "RowId": 10135,
    "Dialogue": "美味いもんが\nいっぱい届いてるといいな",
    "Slowly": false
  },
  {
    "RowId": 10136,
    "Dialogue": "シャーレアン人に\nそんな期待するなって～",
    "Slowly": false
  },
  {
    "RowId": 10137,
    "Dialogue": "フフンフン～♪",
    "Slowly": false
  },
  {
    "RowId": 10138,
    "Dialogue": "要望中の新機能\nどうなりそうです？",
    "Slowly": false
  },
  {
    "RowId": 10139,
    "Dialogue": "企画は進んでいると\n聞いてますよ！",
    "Slowly": false
  },
  {
    "RowId": 10140,
    "Dialogue": "そろそろ追加依頼を\nかけておくか",
    "Slowly": false
  },
  {
    "RowId": 10141,
    "Dialogue": "メンテも終わったし\n飛ばしてみましょうか",
    "Slowly": false
  },
  {
    "RowId": 10142,
    "Dialogue": "作業完了まで\nあとちょっとかな",
    "Slowly": false
  },
  {
    "RowId": 10143,
    "Dialogue": "滞空動作は\n満点でしたよ！",
    "Slowly": false
  },
  {
    "RowId": 10144,
    "Dialogue": "ふむ…空中テストは\n一発クリアですね",
    "Slowly": false
  },
  {
    "RowId": 10145,
    "Dialogue": "スーツの改良なら\nまずスピード強化優先だろ？",
    "Slowly": false
  },
  {
    "RowId": 10146,
    "Dialogue": "いやいや…\n追求すべきは多機能性よ",
    "Slowly": false
  },
  {
    "RowId": 10147,
    "Dialogue": "結局のとこ\n着用者のテクニックじゃん？",
    "Slowly": false
  },
  {
    "RowId": 10148,
    "Dialogue": "雷力のストックも\n溜まり始めたな",
    "Slowly": false
  },
  {
    "RowId": 10149,
    "Dialogue": "このままいけば\n安定するだろう",
    "Slowly": false
  },
  {
    "RowId": 10150,
    "Dialogue": "幻花風時の\n対策が必要だな",
    "Slowly": false
  },
  {
    "RowId": 10151,
    "Dialogue": "エネルギー面では\nこの星は安定してるわね",
    "Slowly": false
  },
  {
    "RowId": 10152,
    "Dialogue": "オイジュスの重力異常は\nヒヤヒヤでしたもんね",
    "Slowly": false
  },
  {
    "RowId": 10153,
    "Dialogue": "ああ\nデータの変動も少ないな",
    "Slowly": false
  },
  {
    "RowId": 10154,
    "Dialogue": "今日の交通量はっと…",
    "Slowly": false
  },
  {
    "RowId": 10155,
    "Dialogue": "そういうの見るの\n好きだね～",
    "Slowly": false
  },
  {
    "RowId": 10156,
    "Dialogue": "オイジュスに比べると\nまったく違う場所だな",
    "Slowly": false
  },
  {
    "RowId": 10157,
    "Dialogue": "基地の外は\nどんなだろうな",
    "Slowly": false
  },
  {
    "RowId": 10158,
    "Dialogue": "ここならではの気候も\nチェックしないとね",
    "Slowly": false
  },
  {
    "RowId": 10159,
    "Dialogue": "興味深い塔が\nあるらしくって！",
    "Slowly": false
  },
  {
    "RowId": 10160,
    "Dialogue": "もう近くにいけるの？",
    "Slowly": false
  },
  {
    "RowId": 10161,
    "Dialogue": "じきに情報が\n入ってくるでしょうね",
    "Slowly": false
  },
  {
    "RowId": 10162,
    "Dialogue": "今回もしっかり\n記録をしていかねば",
    "Slowly": false
  },
  {
    "RowId": 10163,
    "Dialogue": "まずはしっかり\n腹ごしらえです！",
    "Slowly": false
  },
  {
    "RowId": 10164,
    "Dialogue": "ヤスミ取得\nオススメ！",
    "Slowly": false
  },
  {
    "RowId": 10165,
    "Dialogue": "おやすみくんのプログラム\nこの子に入ってる？",
    "Slowly": false
  },
  {
    "RowId": 10166,
    "Dialogue": "今までにない\n空気の美味しさね",
    "Slowly": false
  },
  {
    "RowId": 10167,
    "Dialogue": "子葉の塔から\nサポート要請があるって",
    "Slowly": false
  },
  {
    "RowId": 10168,
    "Dialogue": "必要なら向かうが\n連絡きてたっけ？",
    "Slowly": false
  },
  {
    "RowId": 10169,
    "Dialogue": "最新情報\n見てみるね～",
    "Slowly": false
  },
  {
    "RowId": 10170,
    "Dialogue": "あの中央機構\nいずれ到達できるかしら？",
    "Slowly": false
  },
  {
    "RowId": 10171,
    "Dialogue": "やってやろうとも！",
    "Slowly": false
  },
  {
    "RowId": 10172,
    "Dialogue": "この星の土は\n素晴らしい色だな",
    "Slowly": false
  },
  {
    "RowId": 10173,
    "Dialogue": "あんた\n違いがわかるのか？",
    "Slowly": false
  },
  {
    "RowId": 10174,
    "Dialogue": "まずは、ひとやすみ！",
    "Slowly": false
  },
  {
    "RowId": 10175,
    "Dialogue": "ヒトヤスミ、ヨシ！",
    "Slowly": false
  },
  {
    "RowId": 10176,
    "Dialogue": "…動けないわね",
    "Slowly": false
  },
  {
    "RowId": 10177,
    "Dialogue": "ちょっとばかし\nお時間あります？",
    "Slowly": false
  },
  {
    "RowId": 10178,
    "Dialogue": "え、ムムッコさん！？\n少々お待ちくださいね…",
    "Slowly": false
  },
  {
    "RowId": 10179,
    "Dialogue": "とんでもない文明度だよね",
    "Slowly": false
  },
  {
    "RowId": 10180,
    "Dialogue": "先駆者たち\nどこへ行ったんだろ？",
    "Slowly": false
  },
  {
    "RowId": 10181,
    "Dialogue": "絶望し、滅亡したなら\n痕跡が無さすぎるな…",
    "Slowly": false
  },
  {
    "RowId": 10182,
    "Dialogue": "そこそこ施設も\n揃ってきたね",
    "Slowly": false
  },
  {
    "RowId": 10183,
    "Dialogue": "堅実な\n整備計画でしたね！",
    "Slowly": false
  },
  {
    "RowId": 10184,
    "Dialogue": "お前の荷物\n居住モジュールまでか？",
    "Slowly": false
  },
  {
    "RowId": 10185,
    "Dialogue": "塔と基地を繋げたが\nこれで十分だろうか？",
    "Slowly": false
  },
  {
    "RowId": 10186,
    "Dialogue": "解析速度を\nもっと向上させたいな…",
    "Slowly": false
  },
  {
    "RowId": 10187,
    "Dialogue": "データ容量の圧縮\n問題かもね",
    "Slowly": false
  },
  {
    "RowId": 10188,
    "Dialogue": "いやぁ、ムムッコさんに\nこんなお時間あるなんて",
    "Slowly": false
  },
  {
    "RowId": 10189,
    "Dialogue": "調査レポートの提出\nお待ちしてるんですけどネ？",
    "Slowly": false
  },
  {
    "RowId": 10190,
    "Dialogue": "ヒッ！\nす…すぐ出します…",
    "Slowly": false
  },
  {
    "RowId": 10191,
    "Dialogue": "デイリー体操で\n健康度アップだ！",
    "Slowly": false
  },
  {
    "RowId": 10192,
    "Dialogue": "スッキリ快眠度、アップ！",
    "Slowly": false
  },
  {
    "RowId": 10193,
    "Dialogue": "キャロット満足度、アップ！",
    "Slowly": false
  },
  {
    "RowId": 10194,
    "Dialogue": "塔担当のチームが\n全然休まないのよ",
    "Slowly": false
  },
  {
    "RowId": 10195,
    "Dialogue": "ピピーッ！\n休ンデモライマス！",
    "Slowly": false
  },
  {
    "RowId": 10196,
    "Dialogue": "ピピピッ！\n寝テモライマス！",
    "Slowly": false
  },
  {
    "RowId": 10197,
    "Dialogue": "撮影中だぞ～",
    "Slowly": false
  },
  {
    "RowId": 10198,
    "Dialogue": "もう…賢人パンは…\nむにゃむにゃ…",
    "Slowly": false
  },
  {
    "RowId": 10199,
    "Dialogue": "すると、その時！\n幻花風が吹き荒れて…",
    "Slowly": false
  },
  {
    "RowId": 10200,
    "Dialogue": "わわ！\n綺麗だっただろなぁ…！",
    "Slowly": false
  },
  {
    "RowId": 10201,
    "Dialogue": "ネミングウェイが\n新しく閃いたらしくて…",
    "Slowly": false
  },
  {
    "RowId": 10202,
    "Dialogue": "キャロットが\nちょうどいい甘さなの！",
    "Slowly": false
  },
  {
    "RowId": 10203,
    "Dialogue": "今回は美味しいのね",
    "Slowly": false
  },
  {
    "RowId": 10204,
    "Dialogue": "新しいタブレットは\nいい感じ？",
    "Slowly": false
  },
  {
    "RowId": 10205,
    "Dialogue": "い…いま探してるんだ…",
    "Slowly": false
  },
  {
    "RowId": 10206,
    "Dialogue": "トラッキングは\nオンにしとけったら…！",
    "Slowly": false
  },
  {
    "RowId": 10207,
    "Dialogue": "この根の輝き…\n美しいね",
    "Slowly": false
  },
  {
    "RowId": 10208,
    "Dialogue": "往時の星の姿を\n取り戻せたかな？",
    "Slowly": false
  },
  {
    "RowId": 10209,
    "Dialogue": "根ッコ\n元気ヨシ！",
    "Slowly": false
  },
  {
    "RowId": 10210,
    "Dialogue": "エーテル流路\nピカピカ、ヨシ！",
    "Slowly": false
  },
  {
    "RowId": 10211,
    "Dialogue": "塔から伸びる光線は…",
    "Slowly": false
  },
  {
    "RowId": 10212,
    "Dialogue": "エネルギーの質量を\n毎日計測中よ",
    "Slowly": false
  },
  {
    "RowId": 10213,
    "Dialogue": "この森島の地中も\n調査が必要かもな",
    "Slowly": false
  },
  {
    "RowId": 10214,
    "Dialogue": "これからめちゃくちゃ\n働いてもらうぜ！",
    "Slowly": false
  },
  {
    "RowId": 10215,
    "Dialogue": "何のための\nタワーなのかね",
    "Slowly": false
  },
  {
    "RowId": 10216,
    "Dialogue": "まるでエーテルが\n干からびているようだ…",
    "Slowly": false
  },
  {
    "RowId": 10217,
    "Dialogue": "研究中の錬金剤が\n効くかしらね？",
    "Slowly": false
  },
  {
    "RowId": 10218,
    "Dialogue": "噴射力が弱くて…\nバッテリーの不調か？",
    "Slowly": false
  },
  {
    "RowId": 10219,
    "Dialogue": "ノズルの詰まりも\n考えられるな",
    "Slowly": false
  },
  {
    "RowId": 10220,
    "Dialogue": "たーんと\n浸透してくれよ！",
    "Slowly": false
  },
  {
    "RowId": 10221,
    "Dialogue": "元気になぁ～れ！",
    "Slowly": false
  },
  {
    "RowId": 10222,
    "Dialogue": "すみずみまで\n余さずお願いしますね！",
    "Slowly": false
  },
  {
    "RowId": 10223,
    "Dialogue": "鬱蒼としてるわ",
    "Slowly": false
  },
  {
    "RowId": 10224,
    "Dialogue": "スゲェ都市機構が\n眠ってるかもってか",
    "Slowly": false
  },
  {
    "RowId": 10225,
    "Dialogue": "開発中の新重機…\n投入できるか？",
    "Slowly": false
  },
  {
    "RowId": 10226,
    "Dialogue": "木が茂るのは\n濃いエーテルゆえ…",
    "Slowly": false
  },
  {
    "RowId": 10227,
    "Dialogue": "ワクワクが止まらない！！",
    "Slowly": false
  },
  {
    "RowId": 10228,
    "Dialogue": "このくらいあれば\n十分だろう",
    "Slowly": false
  },
  {
    "RowId": 10229,
    "Dialogue": "トンテンカンテン！",
    "Slowly": false
  },
  {
    "RowId": 10230,
    "Dialogue": "イッキにここを\n貫通しましょー！",
    "Slowly": false
  },
  {
    "RowId": 10231,
    "Dialogue": "ここの塔は\nまたちょっと違うわね",
    "Slowly": false
  },
  {
    "RowId": 10232,
    "Dialogue": "蔦状の植物が\nすっかり覆ってるな",
    "Slowly": false
  },
  {
    "RowId": 10233,
    "Dialogue": "エネルギーの数値が\n見違えるようだ",
    "Slowly": false
  },
  {
    "RowId": 10234,
    "Dialogue": "それぞれの塔の\n役割が気になるよな",
    "Slowly": false
  },
  {
    "RowId": 10235,
    "Dialogue": "鉱石の投入に\n反応してるみたいだな",
    "Slowly": false
  },
  {
    "RowId": 10236,
    "Dialogue": "鉱石の大きさは\nどのくらいがベストだ？",
    "Slowly": false
  },
  {
    "RowId": 10237,
    "Dialogue": "運びやすければ\n大丈夫よ",
    "Slowly": false
  },
  {
    "RowId": 10238,
    "Dialogue": "丁寧にお願いしますよー！",
    "Slowly": false
  },
  {
    "RowId": 10239,
    "Dialogue": "くぅぅ\nなかなか手強い！",
    "Slowly": false
  },
  {
    "RowId": 10240,
    "Dialogue": "砕けろ～～～！",
    "Slowly": false
  },
  {
    "RowId": 10241,
    "Dialogue": "澄んだ水は\n水草のおかげかしら",
    "Slowly": false
  },
  {
    "RowId": 10242,
    "Dialogue": "鉱石の供給バランスを…",
    "Slowly": false
  },
  {
    "RowId": 10243,
    "Dialogue": "力仕事があれば\n言ってくれよな",
    "Slowly": false
  },
  {
    "RowId": 10244,
    "Dialogue": "安定してるみたいだな",
    "Slowly": false
  },
  {
    "RowId": 10245,
    "Dialogue": "完全に閉ざされてるな\nどんな計画を？",
    "Slowly": false
  },
  {
    "RowId": 10246,
    "Dialogue": "早く先へ\n進みたいもんだね",
    "Slowly": false
  },
  {
    "RowId": 10247,
    "Dialogue": "先駆者の遺物だから\n慎重にお願いね！",
    "Slowly": false
  },
  {
    "RowId": 10248,
    "Dialogue": "あの奥はどんな空間が\n広がってるんだ…！？",
    "Slowly": false
  },
  {
    "RowId": 10249,
    "Dialogue": "木を自在に育てる技術とは…\n先駆者たちはすごいな",
    "Slowly": false
  },
  {
    "RowId": 10250,
    "Dialogue": "がんばろうぜ、相棒！",
    "Slowly": false
  },
  {
    "RowId": 10251,
    "Dialogue": "暗いから\n慎重に調査しないと",
    "Slowly": false
  },
  {
    "RowId": 10252,
    "Dialogue": "うんうん\n順調なペースよ！",
    "Slowly": false
  },
  {
    "RowId": 10253,
    "Dialogue": "でっかくもらってくよ！",
    "Slowly": false
  },
  {
    "RowId": 10254,
    "Dialogue": "あ～あ、こいつは\n完全にオーバーヒートだね",
    "Slowly": false
  },
  {
    "RowId": 10255,
    "Dialogue": "オーノー！\n大事なドリルが動かないぃぃ",
    "Slowly": false
  },
  {
    "RowId": 10256,
    "Dialogue": "集中投入して\n出力を上げるのよ！",
    "Slowly": false
  },
  {
    "RowId": 10257,
    "Dialogue": "ガガガガガガガガ！",
    "Slowly": false
  },
  {
    "RowId": 10258,
    "Dialogue": "ここの塔は上部に\n繋がってるみたいだな",
    "Slowly": false
  },
  {
    "RowId": 10259,
    "Dialogue": "…それで、ドリルが\n見事に天を突いたってわけ！",
    "Slowly": false
  },
  {
    "RowId": 10260,
    "Dialogue": "鉱石ならいいけど\n遺構に穴開けないでね～",
    "Slowly": false
  },
  {
    "RowId": 10261,
    "Dialogue": "この空間ごと\nしっかり調べないとさ",
    "Slowly": false
  },
  {
    "RowId": 10262,
    "Dialogue": "つまり\n塔と塔の関係性は…",
    "Slowly": false
  },
  {
    "RowId": 10263,
    "Dialogue": "この場所が\n復旧すれば…！",
    "Slowly": false
  },
  {
    "RowId": 10264,
    "Dialogue": "僕らのサイズには\nこんな資材が適切かとっ！",
    "Slowly": false
  },
  {
    "RowId": 10265,
    "Dialogue": "なるほど、ぴったりだな",
    "Slowly": false
  },
  {
    "RowId": 10266,
    "Dialogue": "外周部の\n裏までお願いね！",
    "Slowly": false
  },
  {
    "RowId": 10267,
    "Dialogue": "ここが正念場だな！",
    "Slowly": false
  },
  {
    "RowId": 10268,
    "Dialogue": "タンクを空にするまで\n思っきしやるぜ～！",
    "Slowly": false
  },
  {
    "RowId": 10269,
    "Dialogue": "キャロットの風味が\n沁みわたる…",
    "Slowly": false
  },
  {
    "RowId": 10270,
    "Dialogue": "すっごい情報量だ",
    "Slowly": false
  },
  {
    "RowId": 10271,
    "Dialogue": "大詰めよ！\n気力を振り絞りましょう！",
    "Slowly": false
  },
  {
    "RowId": 10272,
    "Dialogue": "うぉおおお！！！",
    "Slowly": false
  },
  {
    "RowId": 10273,
    "Dialogue": "ほかの建物にも\nルートを開かないとな",
    "Slowly": false
  },
  {
    "RowId": 10274,
    "Dialogue": "まだまだ\nやることは山積みね～",
    "Slowly": false
  },
  {
    "RowId": 10275,
    "Dialogue": "遠くまで建物が連なってるわ\nすごい大都市だったのね…",
    "Slowly": false
  },
  {
    "RowId": 10276,
    "Dialogue": "大気圏外から観測した\nこの星と同じような模様だな",
    "Slowly": false
  },
  {
    "RowId": 10277,
    "Dialogue": "彼らの宇宙観を\n現してるのかしら？",
    "Slowly": false
  },
  {
    "RowId": 10278,
    "Dialogue": "ここが、惑星アウクセシアっ！",
    "Slowly": false
  },
  {
    "RowId": 10279,
    "Dialogue": "また新たな風景が\n僕の撮影意欲をかき立てるっ！",
    "Slowly": false
  },
  {
    "RowId": 10280,
    "Dialogue": "安全と健康のため\nよぉく準備運動しますよー！",
    "Slowly": false
  },
  {
    "RowId": 10281,
    "Dialogue": "いっちにー、いっちにー！",
    "Slowly": false
  },
  {
    "RowId": 10282,
    "Dialogue": "イッチニー、イッチニー",
    "Slowly": false
  },
  {
    "RowId": 10283,
    "Dialogue": "まずはスケジュールの\n再確認からだな",
    "Slowly": false
  },
  {
    "RowId": 10284,
    "Dialogue": "記録というものは\n研究活動の一部だからな",
    "Slowly": false
  },
  {
    "RowId": 10285,
    "Dialogue": "おおっ！\nいけるぜ",
    "Slowly": false
  },
  {
    "RowId": 10286,
    "Dialogue": "新開発のキャロットジャム\nお味はいかが？",
    "Slowly": false
  },
  {
    "RowId": 10287,
    "Dialogue": "何枚でもペロッと\nいけちゃいそうね",
    "Slowly": false
  },
  {
    "RowId": 10288,
    "Dialogue": "辿ってきた惑星と\nまったく違うわね",
    "Slowly": false
  },
  {
    "RowId": 10289,
    "Dialogue": "このパンも\n今までの味わいじゃない！",
    "Slowly": false
  },
  {
    "RowId": 10290,
    "Dialogue": "ピカピカにして\n作戦待機だ",
    "Slowly": false
  },
  {
    "RowId": 10291,
    "Dialogue": "キレイキレイして\n大活躍しましょ～！",
    "Slowly": false
  },
  {
    "RowId": 10292,
    "Dialogue": "何ができるのかなー？",
    "Slowly": false
  },
  {
    "RowId": 10293,
    "Dialogue": "撮影の手が\n止まらないー！",
    "Slowly": false
  },
  {
    "RowId": 10294,
    "Dialogue": "みなさーん\nがんばっていきましょうですー！",
    "Slowly": false
  },
  {
    "RowId": 10295,
    "Dialogue": "あれれ、またですかー？\nあの子がいないですー！",
    "Slowly": false
  },
  {
    "RowId": 10296,
    "Dialogue": "ハーイ！",
    "Slowly": false
  },
  {
    "RowId": 10297,
    "Dialogue": "順調な進行だ\nこの調子でいこう！",
    "Slowly": false
  },
  {
    "RowId": 10298,
    "Dialogue": "迅速に、かつ丁寧に！",
    "Slowly": false
  },
  {
    "RowId": 10299,
    "Dialogue": "完璧主義のボクに\nふさわしい仕上がりさ",
    "Slowly": false
  },
  {
    "RowId": 10300,
    "Dialogue": "細かいとこも\nこだわって…",
    "Slowly": false
  },
  {
    "RowId": 10301,
    "Dialogue": "ここをこうしてっと",
    "Slowly": false
  },
  {
    "RowId": 10302,
    "Dialogue": "丁寧に…丁寧に…",
    "Slowly": false
  },
  {
    "RowId": 10303,
    "Dialogue": "俺たちのテクニックに\n任せてくれよ！",
    "Slowly": false
  },
  {
    "RowId": 10304,
    "Dialogue": "は～い、こっちですよ～",
    "Slowly": false
  },
  {
    "RowId": 10305,
    "Dialogue": "コッチコッチ～！",
    "Slowly": false
  },
  {
    "RowId": 10306,
    "Dialogue": "居住モジュールが！",
    "Slowly": false
  },
  {
    "RowId": 10307,
    "Dialogue": "撮っるよ～！",
    "Slowly": false
  },
  {
    "RowId": 10308,
    "Dialogue": "完成しましたー！",
    "Slowly": false
  },
  {
    "RowId": 10309,
    "Dialogue": "ワーイ！",
    "Slowly": false
  },
  {
    "RowId": 10310,
    "Dialogue": "ここまでは\nスケジュールどおりだな",
    "Slowly": false
  },
  {
    "RowId": 10311,
    "Dialogue": "段々と技術力が\n上がってきたみたいだ",
    "Slowly": false
  },
  {
    "RowId": 10312,
    "Dialogue": "いえ～い！",
    "Slowly": false
  },
  {
    "RowId": 10313,
    "Dialogue": "みんな～\n撮るよっ！",
    "Slowly": false
  },
  {
    "RowId": 10314,
    "Dialogue": "すっかり\n星渡る転勤族だ",
    "Slowly": false
  },
  {
    "RowId": 10315,
    "Dialogue": "荷物をまとめるのも\n慣れたものね",
    "Slowly": false
  },
  {
    "RowId": 10316,
    "Dialogue": "お前との一杯は\n欠かせないな",
    "Slowly": false
  },
  {
    "RowId": 10317,
    "Dialogue": "ワクワクするなぁっ！",
    "Slowly": false
  },
  {
    "RowId": 10318,
    "Dialogue": "みんなその調子だ！\nあと少し、がんばってくれ！",
    "Slowly": false
  },
  {
    "RowId": 10319,
    "Dialogue": "安全には\n十分配慮してくださいね！",
    "Slowly": false
  },
  {
    "RowId": 10320,
    "Dialogue": "細かいところも\n手を抜くもんか！",
    "Slowly": false
  },
  {
    "RowId": 10321,
    "Dialogue": "ふっふっふ\nいい調子だァ…！",
    "Slowly": false
  },
  {
    "RowId": 10322,
    "Dialogue": "磨いたテクを\n発揮するぞ！",
    "Slowly": false
  },
  {
    "RowId": 10323,
    "Dialogue": "集中…集中…",
    "Slowly": false
  },
  {
    "RowId": 10324,
    "Dialogue": "繊細なコントロールが\n必要なのさ！",
    "Slowly": false
  },
  {
    "RowId": 10325,
    "Dialogue": "大事な施設がっ！",
    "Slowly": false
  },
  {
    "RowId": 10326,
    "Dialogue": "みんな！\nそのまま、そのまま～！",
    "Slowly": false
  },
  {
    "RowId": 10327,
    "Dialogue": "完成しました～！",
    "Slowly": false
  },
  {
    "RowId": 10328,
    "Dialogue": "カッコよく撮ってくれよ！",
    "Slowly": false
  },
  {
    "RowId": 10329,
    "Dialogue": "はいっ\nポーズ！",
    "Slowly": false
  },
  {
    "RowId": 10330,
    "Dialogue": "ここまでは毎度\n順調なんだがな",
    "Slowly": false
  },
  {
    "RowId": 10331,
    "Dialogue": "惑星の特徴的な問題は\nこれからだものね",
    "Slowly": false
  },
  {
    "RowId": 10332,
    "Dialogue": "ここからの一杯も\nまた格別だな",
    "Slowly": false
  },
  {
    "RowId": 10333,
    "Dialogue": "腹ごしらえが\n楽しみになって助かるよ",
    "Slowly": false
  },
  {
    "RowId": 10334,
    "Dialogue": "餌って感じだったもんね～",
    "Slowly": false
  },
  {
    "RowId": 10335,
    "Dialogue": "ジャムひとつで\nこの感動とは…",
    "Slowly": false
  },
  {
    "RowId": 10336,
    "Dialogue": "慣れてもメンテナンスは\n欠かさずに！",
    "Slowly": false
  },
  {
    "RowId": 10337,
    "Dialogue": "バッテリーの状態は\n気にしておきたいわね…",
    "Slowly": false
  },
  {
    "RowId": 10338,
    "Dialogue": "俺たちと一緒に\n旅してきたからな",
    "Slowly": false
  },
  {
    "RowId": 10339,
    "Dialogue": "ピカピカ！\nピッカピカ！",
    "Slowly": false
  },
  {
    "RowId": 10340,
    "Dialogue": "今後の進行を\nしっかり確認だ",
    "Slowly": false
  },
  {
    "RowId": 10341,
    "Dialogue": "どぉぉりゃぁあーー！！",
    "Slowly": false
  },
  {
    "RowId": 10342,
    "Dialogue": "泥岩らしいが\n手応えあるな！",
    "Slowly": false
  },
  {
    "RowId": 10343,
    "Dialogue": "パワードスーツなら\nこんなのなんて！",
    "Slowly": false
  },
  {
    "RowId": 10344,
    "Dialogue": "どんなもんじゃい！！",
    "Slowly": false
  },
  {
    "RowId": 10345,
    "Dialogue": "スーツのお陰で\n楽々だわ♪",
    "Slowly": false
  },
  {
    "RowId": 10346,
    "Dialogue": "ティンバーロッジ基地がっ",
    "Slowly": false
  },
  {
    "RowId": 10347,
    "Dialogue": "ステキに拡張されましたー！",
    "Slowly": false
  },
  {
    "RowId": 10348,
    "Dialogue": "基地の整備も\nひと段落だな",
    "Slowly": false
  },
  {
    "RowId": 10349,
    "Dialogue": "落ち着いて過ごせるわね",
    "Slowly": false
  },
  {
    "RowId": 10350,
    "Dialogue": "今のうちに\nドローンをメンテしておくか",
    "Slowly": false
  },
  {
    "RowId": 10351,
    "Dialogue": "どれどれ…\n問題はなさそうか？",
    "Slowly": false
  },
  {
    "RowId": 10352,
    "Dialogue": "試しに\nテスト飛行といくか",
    "Slowly": false
  },
  {
    "RowId": 10353,
    "Dialogue": "よし、行ってこーい！！",
    "Slowly": false
  },
  {
    "RowId": 10354,
    "Dialogue": "うんうん、いい子だな\n…って、ペットみたいだ",
    "Slowly": false
  },
  {
    "RowId": 10355,
    "Dialogue": "他の食材も入ってきたが\n敢えてのこれだな",
    "Slowly": false
  },
  {
    "RowId": 10356,
    "Dialogue": "気に入っちゃったんだね？",
    "Slowly": false
  },
  {
    "RowId": 10357,
    "Dialogue": "食べ過ぎないでよ",
    "Slowly": false
  },
  {
    "RowId": 10358,
    "Dialogue": "錬金剤の影響は\n大丈夫そうだな",
    "Slowly": false
  },
  {
    "RowId": 10359,
    "Dialogue": "バッテリー残量…\nよし！",
    "Slowly": false
  },
  {
    "RowId": 10360,
    "Dialogue": "馴染んだ道具こそ\n油断せずにチェック！",
    "Slowly": false
  },
  {
    "RowId": 10361,
    "Dialogue": "さて、俺は相棒と\n次の現場を探すかな",
    "Slowly": false
  },
  {
    "RowId": 10362,
    "Dialogue": "どこにいるですかー？",
    "Slowly": false
  },
  {
    "RowId": 10363,
    "Dialogue": "もうー！\n一緒にやりましょうよー！",
    "Slowly": false
  },
  {
    "RowId": 10364,
    "Dialogue": "アトチョット",
    "Slowly": false
  },
  {
    "RowId": 10365,
    "Dialogue": "溶接に問題は\n無さそうだな",
    "Slowly": false
  },
  {
    "RowId": 10366,
    "Dialogue": "コスモポートがっ",
    "Slowly": false
  },
  {
    "RowId": 10367,
    "Dialogue": "アップグレードされましたー！",
    "Slowly": false
  },
  {
    "RowId": 10368,
    "Dialogue": "元の都市空間とも\n調和しているな",
    "Slowly": false
  },
  {
    "RowId": 10369,
    "Dialogue": "木材のぬくもりって\n大切ね",
    "Slowly": false
  },
  {
    "RowId": 10370,
    "Dialogue": "ラヴィリンソスのような\n居心地かもしれないな",
    "Slowly": false
  },
  {
    "RowId": 10371,
    "Dialogue": "だんだん\n慣れてくるよね",
    "Slowly": false
  },
  {
    "RowId": 10372,
    "Dialogue": "衣食住も\nあまり変わらないしね？",
    "Slowly": false
  },
  {
    "RowId": 10373,
    "Dialogue": "ローダーハンガーがっ",
    "Slowly": false
  },
  {
    "RowId": 10374,
    "Dialogue": "パワーアップしましたっ！",
    "Slowly": false
  },
  {
    "RowId": 10375,
    "Dialogue": "ローダーも随分と\n機種が増えたな",
    "Slowly": false
  },
  {
    "RowId": 10376,
    "Dialogue": "メカニック魂が\n燃えちゃったのね",
    "Slowly": false
  },
  {
    "RowId": 10377,
    "Dialogue": "宇宙って楽しいなの\nるんるんダンスです！",
    "Slowly": false
  },
  {
    "RowId": 10378,
    "Dialogue": "先駆者文明の探索も\n大詰めというところだな",
    "Slowly": false
  },
  {
    "RowId": 10379,
    "Dialogue": "無事に中枢機構が\n復旧するといいですね",
    "Slowly": false
  },
  {
    "RowId": 10380,
    "Dialogue": "やっぱり温かい飯も\n沁みわたるぜ！",
    "Slowly": false
  },
  {
    "RowId": 10381,
    "Dialogue": "がっつかないのー！",
    "Slowly": false
  },
  {
    "RowId": 10382,
    "Dialogue": "私はキャロットジャムパン\nまだまだいけるわよ？",
    "Slowly": false
  },
  {
    "RowId": 10383,
    "Dialogue": "中枢機構が復旧したら\n何がわかるだろうな？",
    "Slowly": false
  },
  {
    "RowId": 10384,
    "Dialogue": "エウヘドロンには航路図…\n今回も気になるわ",
    "Slowly": false
  },
  {
    "RowId": 10385,
    "Dialogue": "俺たちは任務完了だ\nピカピカにしてやるぞ",
    "Slowly": false
  },
  {
    "RowId": 10386,
    "Dialogue": "ピカピカにしますですー",
    "Slowly": false
  },
  {
    "RowId": 10387,
    "Dialogue": "ピカピカ\nピカピカピカ！",
    "Slowly": false
  },
  {
    "RowId": 10388,
    "Dialogue": "探索がんばったねの\nるんるんダンスだよ～っ♪",
    "Slowly": false
  },
  {
    "RowId": 10389,
    "Dialogue": "無事に中枢機構が\n復旧したようだな",
    "Slowly": false
  },
  {
    "RowId": 10390,
    "Dialogue": "ディリズたちならって\n信じてましたよ",
    "Slowly": false
  },
  {
    "RowId": 10391,
    "Dialogue": "俺たちの班も\nこれで…",
    "Slowly": false
  },
  {
    "RowId": 10392,
    "Dialogue": "色々あったけど\n楽しかったよね！",
    "Slowly": false
  },
  {
    "RowId": 10393,
    "Dialogue": "何言ってんの\nまだまだ研究調査よ",
    "Slowly": false
  },
  {
    "RowId": 10394,
    "Dialogue": "これからどうするかな",
    "Slowly": false
  },
  {
    "RowId": 10395,
    "Dialogue": "大学に戻ろうかしら\nそれともここでもっと…",
    "Slowly": false
  },
  {
    "RowId": 10396,
    "Dialogue": "やれやれ\n俺は一匹狼なんだがな…",
    "Slowly": false
  },
  {
    "RowId": 10397,
    "Dialogue": "ボクたちも\n一緒に行くですよ～！",
    "Slowly": false
  },
  {
    "RowId": 10398,
    "Dialogue": "イッショ\nイッショ！",
    "Slowly": false
  },
  {
    "RowId": 10399,
    "Dialogue": "スペースダルメルだ！\n動物もかっこいいだろ？",
    "Slowly": false
  },
  {
    "RowId": 10400,
    "Dialogue": "…本当に何回も言うけど\n危ないから絶対触るなよ！",
    "Slowly": false
  },
  {
    "RowId": 10401,
    "Dialogue": "少し外すけど本当の本当に\n見ておくだけにしてよ？",
    "Slowly": false
  },
  {
    "RowId": 10402,
    "Dialogue": "うん、スペースなダルメル\nカッコかわいいや～！",
    "Slowly": false
  },
  {
    "RowId": 10403,
    "Dialogue": "ボクを信じてってば！\nいってらっしゃ～い♪",
    "Slowly": false
  },
  {
    "RowId": 10404,
    "Dialogue": "…でもでもやっぱり！\nダルメル乗ってみたいな～！",
    "Slowly": false
  },
  {
    "RowId": 10405,
    "Dialogue": "やっぱりねぇぇぇーー！！",
    "Slowly": false
  },
  {
    "RowId": 10406,
    "Dialogue": "絶対やると思ったよ！\nしっかり言ったのにぃ～！！",
    "Slowly": false
  },
  {
    "RowId": 10407,
    "Dialogue": "いけいけっ！\nダルメル、はっしーん！",
    "Slowly": false
  },
  {
    "RowId": 10408,
    "Dialogue": "ブモーッ！",
    "Slowly": false
  },
  {
    "RowId": 10409,
    "Dialogue": "ああもう…絶対だめって\n言ったじゃないか！",
    "Slowly": false
  },
  {
    "RowId": 10410,
    "Dialogue": "…本当に操縦したいなら\nパイロット訓練受けてみるか？",
    "Slowly": false
  },
  {
    "RowId": 10411,
    "Dialogue": "その代わり訓練は\nとっても厳しいぞ！",
    "Slowly": false
  },
  {
    "RowId": 10412,
    "Dialogue": "ごご、ごめんなさぁ～い…！\n乗りたかったんだもん…",
    "Slowly": false
  },
  {
    "RowId": 10413,
    "Dialogue": "え！？\nい、いいの！？",
    "Slowly": false
  },
  {
    "RowId": 10414,
    "Dialogue": "やったぁあーー！\n絶対パイロットになるぞー！！",
    "Slowly": false
  },
  {
    "RowId": 10415,
    "Dialogue": "だが愛機のほかに\n仲間がいるのも悪くないか",
    "Slowly": false
  },
  {
    "RowId": 10416,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 10417,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 10418,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 10419,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 10420,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 10421,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 10422,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 10423,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 10424,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 10425,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 10426,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 10427,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 10428,
    "Dialogue": "まだ息は\nあるようだが…",
    "Slowly": false
  },
  {
    "RowId": 10429,
    "Dialogue": "もう戦意は\nないみたいね",
    "Slowly": false
  },
  {
    "RowId": 10430,
    "Dialogue": "大丈夫だ\nちゃんと見張ってるさ",
    "Slowly": false
  },
  {
    "RowId": 10431,
    "Dialogue": "あとは\nクラックを閉じれば…",
    "Slowly": false
  },
  {
    "RowId": 10432,
    "Dialogue": "この妖異…\n消滅しかけてるのか？",
    "Slowly": false
  },
  {
    "RowId": 10433,
    "Dialogue": "なんとかなったな",
    "Slowly": false
  },
  {
    "RowId": 10434,
    "Dialogue": "「無」を打ち破るとは…",
    "Slowly": false
  },
  {
    "RowId": 10435,
    "Dialogue": "さぁ、私の後ろへ！",
    "Slowly": false
  },
  {
    "RowId": 10436,
    "Dialogue": "次から次へと…！",
    "Slowly": false
  },
  {
    "RowId": 10437,
    "Dialogue": "ここは任せろ！",
    "Slowly": false
  },
  {
    "RowId": 10438,
    "Dialogue": "私が護ります…！",
    "Slowly": false
  },
  {
    "RowId": 10439,
    "Dialogue": "無事ならよかったわ",
    "Slowly": false
  },
  {
    "RowId": 10440,
    "Dialogue": "たすけて～！",
    "Slowly": false
  },
  {
    "RowId": 10441,
    "Dialogue": "ウリエンジェ～！",
    "Slowly": false
  },
  {
    "RowId": 10442,
    "Dialogue": "こっちに妖異は\n来てないよ～",
    "Slowly": false
  },
  {
    "RowId": 10443,
    "Dialogue": "共同施工作業への参加は\nこちらへ！",
    "Slowly": false
  },
  {
    "RowId": 10444,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 10445,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 10446,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 10447,
    "Dialogue": "ぶぇッくし！！\n…明らかに異質な花粉だ",
    "Slowly": false
  },
  {
    "RowId": 10448,
    "Dialogue": "大丈夫ですか？\n今後の対処が必要ですね",
    "Slowly": false
  },
  {
    "RowId": 10449,
    "Dialogue": "先駆者の立派な遺構が…\nすごい星まで来たなぁ",
    "Slowly": false
  },
  {
    "RowId": 10450,
    "Dialogue": "空気が濁ってきた…\n嫌な感じだな",
    "Slowly": false
  },
  {
    "RowId": 10451,
    "Dialogue": "今回も、何とかやってみよう！",
    "Slowly": false
  },
  {
    "RowId": 10452,
    "Dialogue": "魔導重機、がんばれ～ッ！\n僕もがんばる！",
    "Slowly": false
  },
  {
    "RowId": 10453,
    "Dialogue": "見た目からして\nいかにも有害そうだぁ！",
    "Slowly": false
  },
  {
    "RowId": 10454,
    "Dialogue": "花粉めぇ…！\n燃やす、燃やし尽くすッ！！",
    "Slowly": false
  },
  {
    "RowId": 10455,
    "Dialogue": "魔導重機で\n有害性植物を伐採してくれ！",
    "Slowly": false
  },
  {
    "RowId": 10456,
    "Dialogue": "いけいけ～その調子～！",
    "Slowly": false
  },
  {
    "RowId": 10457,
    "Dialogue": "フィールドサーチャーで\n隠れた有害性植物を見つけるんだ！",
    "Slowly": false
  },
  {
    "RowId": 10458,
    "Dialogue": "有害性植物の灰は\nここに集めてください！",
    "Slowly": false
  },
  {
    "RowId": 10459,
    "Dialogue": "フェっ、フェっクシ！！\nか、花粉がぁぁ…！",
    "Slowly": false
  },
  {
    "RowId": 10460,
    "Dialogue": "鼻がジンジンするよぉ～…",
    "Slowly": false
  },
  {
    "RowId": 10461,
    "Dialogue": "こ、この！\nこんな程度で負けるか～っ！",
    "Slowly": false
  },
  {
    "RowId": 10462,
    "Dialogue": "フィールドサーチャーで\n植物の動きを止めるぞ！",
    "Slowly": false
  },
  {
    "RowId": 10463,
    "Dialogue": "サポーターの方は\n灰を納品してください！",
    "Slowly": false
  },
  {
    "RowId": 10464,
    "Dialogue": "マジでヤバい連中だな～！？",
    "Slowly": false
  },
  {
    "RowId": 10465,
    "Dialogue": "いよっ、魔導重機！\nナイスな活躍だったぞ～！",
    "Slowly": false
  },
  {
    "RowId": 10466,
    "Dialogue": "いや～\n空気が澄み渡ったね～",
    "Slowly": false
  },
  {
    "RowId": 10467,
    "Dialogue": "またひとつ、任務完了だ！",
    "Slowly": false
  },
  {
    "RowId": 10468,
    "Dialogue": "ふぅ～鼻がスッキリだ！\n深呼吸もできちゃうぜ",
    "Slowly": false
  },
  {
    "RowId": 10469,
    "Dialogue": "パイロットってば\nさすがだね～",
    "Slowly": false
  },
  {
    "RowId": 10470,
    "Dialogue": "ほぼ間違いないだろうな",
    "Slowly": false
  },
  {
    "RowId": 10471,
    "Dialogue": "この一帯の植物は\n先駆者たちが環境整備を？",
    "Slowly": false
  },
  {
    "RowId": 10472,
    "Dialogue": "今回の任務は\n肥料撒きみたいなもんか？",
    "Slowly": false
  },
  {
    "RowId": 10473,
    "Dialogue": "アウクセシアでも\nエクスプローラー魂だぜ！",
    "Slowly": false
  },
  {
    "RowId": 10474,
    "Dialogue": "よーし、がんばるぞぉ！",
    "Slowly": false
  },
  {
    "RowId": 10475,
    "Dialogue": "スペアの錬金剤…\nまだ保つかな？",
    "Slowly": false
  },
  {
    "RowId": 10476,
