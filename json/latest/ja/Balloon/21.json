[
  {
    "RowId": 10000,
    "Dialogue": "ふふ…",
    "Slowly": false
  },
  {
    "RowId": 10001,
    "Dialogue": "総長はどこへ…？",
    "Slowly": false
  },
  {
    "RowId": 10002,
    "Dialogue": "このあたりのはずだ…！",
    "Slowly": false
  },
  {
    "RowId": 10003,
    "Dialogue": "ちょちょいのちょいだぜ！",
    "Slowly": false
  },
  {
    "RowId": 10004,
    "Dialogue": "ボンクラ貴族にゃ\n負けねぇ！",
    "Slowly": false
  },
  {
    "RowId": 10005,
    "Dialogue": "あんまり遠くには\n行ってないよな…？",
    "Slowly": false
  },
  {
    "RowId": 10006,
    "Dialogue": "イッセにい\n見つけてくれるかな？",
    "Slowly": false
  },
  {
    "RowId": 10007,
    "Dialogue": "喋ったら\nすぐ見つかっちゃいますよ",
    "Slowly": false
  },
  {
    "RowId": 10008,
    "Dialogue": "オブリビオンのみんなにも\n見せてみたいです",
    "Slowly": false
  },
  {
    "RowId": 10009,
    "Dialogue": "し、障壁の外は…\n刺激的ですね…",
    "Slowly": false
  },
  {
    "RowId": 10010,
    "Dialogue": "",
    "Slowly": false
  },
  {
