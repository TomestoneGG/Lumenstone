  },
  {
    "RowId": 10019,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 10020,
    "Dialogue": "さァ、楽しい饗宴だゾー！",
    "Slowly": false
  },
  {
    "RowId": 10021,
    "Dialogue": "ヒヒ…この扉の先には…",
    "Slowly": false
  },
  {
    "RowId": 10022,
    "Dialogue": "遊びまショー！",
    "Slowly": false
  },
  {
    "RowId": 10023,
    "Dialogue": "バァ～！",
    "Slowly": false
  },
  {
    "RowId": 10024,
    "Dialogue": "落ちたラもう\n戻ってこられないヨォ…",
    "Slowly": false
  },
  {
    "RowId": 10025,
    "Dialogue": "ガタガタ！ガタガタ！",
    "Slowly": false
  },
  {
    "RowId": 10026,
    "Dialogue": "ギシギシ…ヒヒヒ…",
    "Slowly": false
  },
  {
    "RowId": 10027,
    "Dialogue": "ヨってらっしゃイ！\nミてらっしゃ～イ！",
    "Slowly": false
  },
  {
    "RowId": 10028,
    "Dialogue": "クルル…ニャーン…",
    "Slowly": false
  },
  {
    "RowId": 10029,
    "Dialogue": "ニャニャン…？",
    "Slowly": false
  },
  {
    "RowId": 10030,
    "Dialogue": "パワーローダーに乗りこんで\nコア・シュラウド上層へ！",
    "Slowly": false
  },
  {
    "RowId": 10031,
    "Dialogue": "下層に戻るときは\nこちらからどうぞ！",
    "Slowly": false
  },
  {
    "RowId": 10032,
    "Dialogue": "パワーローダーへの再搭乗は\nこちらからどうぞ！",
    "Slowly": false
  },
  {
    "RowId": 10033,
    "Dialogue": "共同施工作業の準備中です！\nもう少しお待ちを～！",
    "Slowly": false
  },
  {
    "RowId": 10034,
    "Dialogue": "熱き魔神♪\nボクらの、ガダラル～♪",
    "Slowly": false
  },
  {
    "RowId": 10035,
    "Dialogue": "獣少女～♪\nその名は～ミ～リ♪",
    "Slowly": false
  },
  {
    "RowId": 10036,
    "Dialogue": "炎蛇将ガダラル様がいれば\n皇都の護りは万全！",
    "Slowly": false
  },
  {
    "RowId": 10037,
    "Dialogue": "ガダラル様が\n消息を絶たれてしまったのだ…",
    "Slowly": false
  },
  {
    "RowId": 10038,
    "Dialogue": "ボクの魔法の…\nじっ、実験台に…！",
    "Slowly": false
  },
  {
    "RowId": 10039,
    "Dialogue": "兄さんも\n無事かなぁ…",
    "Slowly": false
  },
  {
    "RowId": 10040,
    "Dialogue": "冒険者の数が\n勝敗を左右するだろう…",
    "Slowly": false
  },
  {
    "RowId": 10041,
    "Dialogue": "冒険者たちの尽力に\n感謝せねばな",
    "Slowly": false
  },
  {
    "RowId": 10042,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 10043,
    "Dialogue": "",
    "Slowly": false
  },
  {
