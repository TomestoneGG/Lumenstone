  {
    "RowId": 9885,
    "Dialogue": "異常が発生したら\nローダーで解決できるかな",
    "Slowly": false
  },
  {
    "RowId": 9886,
    "Dialogue": "ここらはいつも\n重力の数値が安定しないな…",
    "Slowly": false
  },
  {
    "RowId": 9887,
    "Dialogue": "ガレアン系の魔導重機か…\nどんな活躍をするんだ？",
    "Slowly": false
  },
  {
    "RowId": 9888,
    "Dialogue": "重力歪みなんて\nすぐ落ち着かせてやろうぜ！",
    "Slowly": false
  },
  {
    "RowId": 9889,
    "Dialogue": "しっぽの毛がモゾモゾ…\n重力歪みのせい？",
    "Slowly": false
  },
  {
    "RowId": 9890,
    "Dialogue": "このグラビデ塊\n歯ごたえがあるじゃんか！",
    "Slowly": false
  },
  {
    "RowId": 9891,
    "Dialogue": "コスモランマーも\n使いこなすぜ！",
    "Slowly": false
  },
  {
    "RowId": 9892,
    "Dialogue": "重力歪み\nどんどん直しちゃお～",
    "Slowly": false
  },
  {
    "RowId": 9893,
    "Dialogue": "こいつが\n重力歪みの親玉か！",
    "Slowly": false
  },
  {
    "RowId": 9894,
    "Dialogue": "うぅ～…\n耳の毛がじんじんする…",
    "Slowly": false
  },
  {
    "RowId": 9895,
    "Dialogue": "く～っ\nこの程度じゃ負けませんよ～",
    "Slowly": false
  },
  {
    "RowId": 9896,
    "Dialogue": "これが魔導重機…\nかっけぇぜ！",
    "Slowly": false
  },
  {
    "RowId": 9897,
    "Dialogue": "いや～\n大変だったね～",
    "Slowly": false
  },
  {
    "RowId": 9898,
    "Dialogue": "みんな、協力ありがとう！",
    "Slowly": false
  },
  {
    "RowId": 9899,
    "Dialogue": "地中のレビテトストーン\nどう回収したものか…",
    "Slowly": false
  },
  {
    "RowId": 9900,
    "Dialogue": "そのうち\n勝手に浮かんでくるかもね？",
    "Slowly": false
  },
  {
    "RowId": 9901,
    "Dialogue": "今度のパイロットの\n腕前はどうかな",
    "Slowly": false
  },
  {
    "RowId": 9902,
    "Dialogue": "パエンナイトの次は\nレビテトストーンか…",
    "Slowly": false
  },
  {
    "RowId": 9903,
    "Dialogue": "はやくローダーこないかな～",
    "Slowly": false
  },
  {
    "RowId": 9904,
    "Dialogue": "この機器も\n使いこなしてみせる！",
    "Slowly": false
  },
  {
    "RowId": 9905,
    "Dialogue": "落ち着いて…\nスゥ～っと…",
    "Slowly": false
  },
  {
    "RowId": 9906,
    "Dialogue": "吸っても吸っても\n終わんな～い！",
    "Slowly": false
  },
  {
    "RowId": 9907,
    "Dialogue": "フィールドサーチャーで\nローダーの支援を！",
    "Slowly": false
  },
  {
    "RowId": 9908,
    "Dialogue": "回収した小レビテトストーンは\nここに納品を！",
    "Slowly": false
  },
  {
    "RowId": 9909,
    "Dialogue": "レビテトストーン\nこんなに浮かび上がるとはねぇ",
    "Slowly": false
  },
  {
    "RowId": 9910,
    "Dialogue": "フィールドサーチャーの力で\n上空の岩も座標特定できる！",
    "Slowly": false
  },
  {
    "RowId": 9911,
    "Dialogue": "チャンスが来たら\nトーウィング・ハイレーザーを！",
    "Slowly": false
  },
  {
    "RowId": 9912,
    "Dialogue": "いつもながら\nローダーってパワフル～！",
    "Slowly": false
  },
  {
    "RowId": 9913,
    "Dialogue": "私でも操縦できるのかな～",
    "Slowly": false
  },
  {
    "RowId": 9914,
    "Dialogue": "素晴らしい活躍でした！\nありがとうございます～！",
    "Slowly": false
  },
  {
    "RowId": 9915,
    "Dialogue": "また岩が浮かんだら\n集合よろしくね～",
    "Slowly": false
  },
  {
    "RowId": 9916,
    "Dialogue": "飛べ飛べ～！",
    "Slowly": false
  },
  {
    "RowId": 9917,
    "Dialogue": "いい感じだよ！",
    "Slowly": false
  },
  {
    "RowId": 9918,
    "Dialogue": "目指せ\n1000回！",
    "Slowly": false
  },
