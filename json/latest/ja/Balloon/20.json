[
  {
    "RowId": 9500,
    "Dialogue": "見てくれ、すごいだろ！\n無限にできるぞ！",
    "Slowly": false
  },
  {
    "RowId": 9501,
    "Dialogue": "ボクは遠慮しておくよ",
    "Slowly": false
  },
  {
    "RowId": 9502,
    "Dialogue": "そのためのスーツじゃ\nないはずだけど～？",
    "Slowly": false
  },
  {
    "RowId": 9503,
    "Dialogue": "何なんだ、ここは？",
    "Slowly": false
  },
  {
    "RowId": 9504,
    "Dialogue": "まだ分析情報には\n上がっていませんね",
    "Slowly": false
  },
  {
    "RowId": 9505,
    "Dialogue": "ヨイショオオオ",
    "Slowly": false
  },
  {
    "RowId": 9506,
    "Dialogue": "手元に注意して\n作業してくださいね！",
    "Slowly": false
  },
  {
    "RowId": 9507,
    "Dialogue": "キャロット100個分の\nスーパーパワーをっ！",
    "Slowly": false
  },
  {
    "RowId": 9508,
    "Dialogue": "ぼ…僕にも\nパワードスーツを支給して…",
    "Slowly": false
  },
  {
    "RowId": 9509,
    "Dialogue": "追加の支援要請を\n出しておきましょう",
    "Slowly": false
  },
  {
    "RowId": 9510,
    "Dialogue": "慎重な作業を\nお願いしますね！",
    "Slowly": false
  },
  {
    "RowId": 9511,
    "Dialogue": "慎重にか…\n俺は触らないほうがいいか？",
    "Slowly": false
  },
  {
    "RowId": 9512,
    "Dialogue": "なんだろ～？",
    "Slowly": false
  },
  {
    "RowId": 9513,
    "Dialogue": "記録係が適任だな",
    "Slowly": false
  },
  {
    "RowId": 9514,
    "Dialogue": "資材はこのあたりに…",
    "Slowly": false
  },
  {
    "RowId": 9515,
    "Dialogue": "結晶体機構への接触は\n注意してくださいね！",
    "Slowly": false
  },
  {
    "RowId": 9516,
    "Dialogue": "これも扉か？",
    "Slowly": false
  },
  {
    "RowId": 9517,
    "Dialogue": "こちらですよ～！",
    "Slowly": false
  },
  {
    "RowId": 9518,
    "Dialogue": "これは…大発見だ！",
    "Slowly": false
  },
  {
    "RowId": 9519,
    "Dialogue": "ほかに必要な資材は…",
    "Slowly": false
  },
  {
    "RowId": 9520,
    "Dialogue": "なんと興味深い…",
    "Slowly": false
  },
  {
    "RowId": 9521,
    "Dialogue": "すごく透きとおった水ね\n鉱物の影響かしら…",
    "Slowly": false
  },
  {
    "RowId": 9522,
    "Dialogue": "この美しさ、喩えるなら\n僕の瞳のようではないかな？",
    "Slowly": false
  },
  {
    "RowId": 9523,
    "Dialogue": "もっと具体的にお願いします",
    "Slowly": false
  },
  {
    "RowId": 9524,
    "Dialogue": "そろそろ\n作業の時間かな？",
    "Slowly": false
  },
  {
    "RowId": 9525,
    "Dialogue": "コチラデス～",
    "Slowly": false
  },
  {
    "RowId": 9526,
    "Dialogue": "スーツの負荷を調整すれば\nトレーニングにもなるな",
    "Slowly": false
  },
  {
    "RowId": 9527,
    "Dialogue": "素晴らしい…\n完璧なフォームだな",
    "Slowly": false
  },
  {
    "RowId": 9528,
    "Dialogue": "迷子のヒトは\n手を挙げてください～！",
    "Slowly": false
  },
  {
    "RowId": 9529,
    "Dialogue": "ここにもコスモライナーを？",
    "Slowly": false
  },
  {
    "RowId": 9530,
    "Dialogue": "まずは奥への探索が優先されるらしいよ",
    "Slowly": false
  },
  {
    "RowId": 9531,
    "Dialogue": "足元の岩に\n注意してくださいね！",
    "Slowly": false
  },
  {
    "RowId": 9532,
    "Dialogue": "活性化ユニットが必要と…\n了解です",
    "Slowly": false
  },
  {
    "RowId": 9533,
    "Dialogue": "アチラデス～",
    "Slowly": false
  },
  {
    "RowId": 9534,
    "Dialogue": "地下にこんな空間が\n広がっていたとは！",
    "Slowly": false
  },
  {
    "RowId": 9535,
    "Dialogue": "いい感じですよ～！",
    "Slowly": false
  },
  {
    "RowId": 9536,
    "Dialogue": "ほいよっと！",
    "Slowly": false
  },
  {
    "RowId": 9537,
    "Dialogue": "ご褒美には\nキャロット3個進呈ですよー！",
    "Slowly": false
  },
  {
    "RowId": 9538,
    "Dialogue": "地下にこれだけの遺跡が\n眠っていたとは",
    "Slowly": false
  },
  {
    "RowId": 9539,
    "Dialogue": "ふむふむ\nご報告ありがとうございます！",
    "Slowly": false
  },
  {
    "RowId": 9540,
    "Dialogue": "遺跡の中で\n一服できるなんてね",
    "Slowly": false
  },
  {
    "RowId": 9541,
    "Dialogue": "キロクチュウ～",
    "Slowly": false
  },
  {
    "RowId": 9542,
    "Dialogue": "どういう仕組なのかしら？",
    "Slowly": false
  },
  {
    "RowId": 9543,
    "Dialogue": "キレイ～！",
    "Slowly": false
  },
  {
    "RowId": 9544,
    "Dialogue": "ここが、惑星オイジュスっ！",
    "Slowly": false
  },
  {
    "RowId": 9545,
    "Dialogue": "また新しい風景が\n僕の撮影意欲をかき立てるっ！",
    "Slowly": false
  },
  {
    "RowId": 9546,
    "Dialogue": "安全と健康、正常な動作のため\n準備運動しますよー！",
    "Slowly": false
  },
  {
    "RowId": 9547,
    "Dialogue": "いっちにー、いっちにー",
    "Slowly": false
  },
  {
    "RowId": 9548,
    "Dialogue": "イッチニー、イッチニー",
    "Slowly": false
  },
  {
    "RowId": 9549,
    "Dialogue": "まずはスケジュールの\n組み立てからだな",
    "Slowly": false
  },
  {
    "RowId": 9550,
    "Dialogue": "記録しておかないとね",
    "Slowly": false
  },
  {
    "RowId": 9551,
    "Dialogue": "これまでとは\nひと味違う惑星だな！",
    "Slowly": false
  },
  {
    "RowId": 9552,
    "Dialogue": "新開発スーツの\n性能を発揮するときね！",
    "Slowly": false
  },
  {
    "RowId": 9553,
    "Dialogue": "まずは腹ごしらえ…っと",
    "Slowly": false
  },
  {
    "RowId": 9554,
    "Dialogue": "今回は\nどんな基地になるかね",
    "Slowly": false
  },
  {
    "RowId": 9555,
    "Dialogue": "また完全食三昧か…\n改良の噂はどうなった？",
    "Slowly": false
  },
  {
    "RowId": 9556,
    "Dialogue": "砂塵の多い惑星だが\nいつでもピカピカにしてやるぞ",
    "Slowly": false
  },
  {
    "RowId": 9557,
    "Dialogue": "キレイキレイするの\n大事です～！",
    "Slowly": false
  },
  {
    "RowId": 9558,
    "Dialogue": "何ができるのかなー？",
    "Slowly": false
  },
  {
    "RowId": 9559,
    "Dialogue": "シャッターを切る手が\nやっぱり止まらない！！",
    "Slowly": false
  },
  {
    "RowId": 9560,
    "Dialogue": "みなさーん\nがんばっていきましょうですー！",
    "Slowly": false
  },
  {
    "RowId": 9561,
    "Dialogue": "ハーイ！",
    "Slowly": false
  },
  {
    "RowId": 9562,
    "Dialogue": "プランどおりだ\nいい調子だぞ！",
    "Slowly": false
  },
  {
    "RowId": 9563,
    "Dialogue": "手際よく頼むよ！",
    "Slowly": false
  },
  {
    "RowId": 9564,
    "Dialogue": "我ながら\n完璧な出来栄えだな！",
    "Slowly": false
  },
  {
    "RowId": 9565,
    "Dialogue": "繊細な作業も\n嫌いじゃないぜ",
    "Slowly": false
  },
  {
    "RowId": 9566,
    "Dialogue": "ここはこんな感じでっと",
    "Slowly": false
  },
  {
    "RowId": 9567,
    "Dialogue": "丁寧に…丁寧に…",
    "Slowly": false
  },
  {
    "RowId": 9568,
    "Dialogue": "重力異常が\nなんだってんだ！",
    "Slowly": false
  },
  {
    "RowId": 9569,
    "Dialogue": "は～い、こっちですよ～",
    "Slowly": false
  },
  {
    "RowId": 9570,
    "Dialogue": "コッチコッチ～！",
    "Slowly": false
  },
  {
    "RowId": 9571,
    "Dialogue": "居住モジュールがっ！",
    "Slowly": false
  },
  {
    "RowId": 9572,
    "Dialogue": "撮っるよ～！",
    "Slowly": false
  },
  {
    "RowId": 9573,
    "Dialogue": "完成しましたーっ！",
    "Slowly": false
  },
  {
    "RowId": 9574,
    "Dialogue": "ワーイ！",
    "Slowly": false
  },
  {
    "RowId": 9575,
    "Dialogue": "ここまでは\nスケジュールどおりだな",
    "Slowly": false
  },
  {
    "RowId": 9576,
    "Dialogue": "さすが僕たち\nスムーズな施工だったんじゃ？",
    "Slowly": false
  },
  {
    "RowId": 9577,
    "Dialogue": "いえ～い！",
    "Slowly": false
  },
  {
    "RowId": 9578,
    "Dialogue": "みんな～\n撮るよっ！",
    "Slowly": false
  },
  {
    "RowId": 9579,
    "Dialogue": "居住モジュールができると\nひと息つけるな",
    "Slowly": false
  },
  {
    "RowId": 9580,
    "Dialogue": "なんだかんだ\n住み慣れてきたわね",
    "Slowly": false
  },
  {
    "RowId": 9581,
    "Dialogue": "ひと仕事終わった後の\n愛機との時間は最高だ",
    "Slowly": false
  },
  {
    "RowId": 9582,
    "Dialogue": "安定した橋で\n安心できるわね",
    "Slowly": false
  },
  {
    "RowId": 9583,
    "Dialogue": "さすが\n見事な手際だな！",
    "Slowly": false
  },
  {
    "RowId": 9584,
    "Dialogue": "雷力供給が\n途切れないようせねば",
    "Slowly": false
  },
  {
    "RowId": 9585,
    "Dialogue": "綿毛が定着するといいけど…",
    "Slowly": false
  },
  {
    "RowId": 9586,
    "Dialogue": "さっきまでここに\nあったんだけどな～？",
    "Slowly": false
  },
  {
    "RowId": 9587,
    "Dialogue": "いいから\n俺のを使えって",
    "Slowly": false
  },
  {
    "RowId": 9588,
    "Dialogue": "えいっ、えい～！\n誰か肩車して～！",
    "Slowly": false
  },
  {
    "RowId": 9589,
    "Dialogue": "これで頑丈になるだろう",
    "Slowly": false
  },
  {
    "RowId": 9590,
    "Dialogue": "もう少しでいいはずよ",
    "Slowly": false
  },
  {
    "RowId": 9591,
    "Dialogue": "了解！",
    "Slowly": false
  },
  {
    "RowId": 9592,
    "Dialogue": "キャロットは…\nこっそり食べるのが至高！",
    "Slowly": false
  },
  {
    "RowId": 9593,
    "Dialogue": "うふふ～ナイショですよ！",
    "Slowly": false
  },
  {
    "RowId": 9594,
    "Dialogue": "現在の発雷量は…",
    "Slowly": false
  },
  {
    "RowId": 9595,
    "Dialogue": "定期メンテが\n大事だからな",
    "Slowly": false
  },
  {
    "RowId": 9596,
    "Dialogue": "ワクワクだなぁー！",
    "Slowly": false
  },
  {
    "RowId": 9597,
    "Dialogue": "いい調子だ！\n仕上げまで頑張ろう！",
    "Slowly": false
  },
  {
    "RowId": 9598,
    "Dialogue": "自身の安全にも\n十分配慮するように！",
    "Slowly": false
  },
  {
    "RowId": 9599,
    "Dialogue": "細かいところも\nこだわりを持って！",
    "Slowly": false
  },
  {
    "RowId": 9600,
    "Dialogue": "ふっふふ…\n自分の腕前にニヤけるぜ…",
    "Slowly": false
  },
  {
    "RowId": 9601,
    "Dialogue": "イイ感じなんじゃあ？",
    "Slowly": false
  },
  {
    "RowId": 9602,
    "Dialogue": "ずれないように…\nちゃんと丁寧に…",
    "Slowly": false
  },
  {
    "RowId": 9603,
    "Dialogue": "繊細なコントロールに\n集中せねば！",
    "Slowly": false
  },
  {
    "RowId": 9604,
    "Dialogue": "あれれ、またまたあの子が\nいなくなっちゃったですー！",
    "Slowly": false
  },
  {
    "RowId": 9605,
    "Dialogue": "もうー！\nどこにいるですかー？",
    "Slowly": false
  },
  {
    "RowId": 9606,
    "Dialogue": "こらこらー！\n真面目にお仕事してください！",
    "Slowly": false
  },
  {
    "RowId": 9607,
    "Dialogue": "スリープモード…",
    "Slowly": false
  },
  {
    "RowId": 9608,
    "Dialogue": "お役立ち施設が！",
    "Slowly": false
  },
  {
    "RowId": 9609,
    "Dialogue": "みんな、そのまま～！",
    "Slowly": false
  },
  {
    "RowId": 9610,
    "Dialogue": "カッコよく撮ってくれよ！",
    "Slowly": false
  },
  {
    "RowId": 9611,
    "Dialogue": "はいっ、笑顔でねー！",
    "Slowly": false
  },
  {
    "RowId": 9612,
    "Dialogue": "とりあえず\n美味い水は飲めるってわけだ",
    "Slowly": false
  },
  {
    "RowId": 9613,
    "Dialogue": "コーヒーの味も\n変わるかしらね？",
    "Slowly": false
  },
  {
    "RowId": 9614,
    "Dialogue": "ここからの眺めが\n俺には一番だぜ",
    "Slowly": false
  },
  {
    "RowId": 9615,
    "Dialogue": "何か塗ったもんかなぁ…",
    "Slowly": false
  },
  {
    "RowId": 9616,
    "Dialogue": "キャロットペーストがあるって",
    "Slowly": false
  },
  {
    "RowId": 9617,
    "Dialogue": "キャロットジャムも！",
    "Slowly": false
  },
  {
    "RowId": 9618,
    "Dialogue": "隙あらば\nメンテナンスだな",
    "Slowly": false
  },
  {
    "RowId": 9619,
    "Dialogue": "バッテリーも\n大丈夫そうね",
    "Slowly": false
  },
  {
    "RowId": 9620,
    "Dialogue": "刃こぼれは…\n特になさそうか",
    "Slowly": false
  },
  {
    "RowId": 9621,
    "Dialogue": "今後のスケジュールを\n確認しておこう",
    "Slowly": false
  },
  {
    "RowId": 9622,
    "Dialogue": "ピカピカ！\nピッカピカ！",
    "Slowly": false
  },
  {
    "RowId": 9623,
    "Dialogue": "一粒の粉塵も\n逃さないぞ！",
    "Slowly": false
  },
  {
    "RowId": 9624,
    "Dialogue": "必要な杭だけ丁寧に！",
    "Slowly": false
  },
  {
    "RowId": 9625,
    "Dialogue": "このスーツなら\n2個持ちもへっちゃらよ！",
    "Slowly": false
  },
  {
    "RowId": 9626,
    "Dialogue": "丁寧に少しずつ\n修復も兼ねてだからね！",
    "Slowly": false
  },
  {
    "RowId": 9627,
    "Dialogue": "パワードスーツのおかげで\n軽々と扱えるわー！",
    "Slowly": false
  },
  {
    "RowId": 9628,
    "Dialogue": "基地がまたちょっと\n新しくキレイに！",
    "Slowly": false
  },
  {
    "RowId": 9629,
    "Dialogue": "遺構を保護しながらの\n基地整備とはな",
    "Slowly": false
  },
  {
    "RowId": 9630,
    "Dialogue": "なかなか\n骨が折れたわね",
    "Slowly": false
  },
  {
    "RowId": 9631,
    "Dialogue": "くらえぇッ！\nエーテル活性剤だぁぁあ！！",
    "Slowly": false
  },
  {
    "RowId": 9632,
    "Dialogue": "パワードスーツがあれば\n私にだって！",
    "Slowly": false
  },
  {
    "RowId": 9633,
    "Dialogue": "錬金術の粋を集めた\nとっておきの活性剤だぜ！",
    "Slowly": false
  },
  {
    "RowId": 9634,
    "Dialogue": "エウヘドロンが\nピカピカキレイな姿に！",
    "Slowly": false
  },
  {
    "RowId": 9635,
    "Dialogue": "ボロボロだった結晶体が\nあんなに輝くとは",
    "Slowly": false
  },
  {
    "RowId": 9636,
    "Dialogue": "澄んだ樹木みたいな\n綺麗な緑色よね",
    "Slowly": false
  },
  {
    "RowId": 9637,
    "Dialogue": "コスモポートが\n装い新たに！",
    "Slowly": false
  },
  {
    "RowId": 9638,
    "Dialogue": "重力異常の惑星なんて\nどうなるかと思ったがな",
    "Slowly": false
  },
  {
    "RowId": 9639,
    "Dialogue": "意外となんとかなってるわね",
    "Slowly": false
  },
  {
    "RowId": 9640,
    "Dialogue": "基地担当班はしばらく\nここで待機かな",
    "Slowly": false
  },
  {
    "RowId": 9641,
    "Dialogue": "試料の整理も\n手伝いましょ",
    "Slowly": false
  },
  {
    "RowId": 9642,
    "Dialogue": "なんだかんだ\n忙しいかもね",
    "Slowly": false
  },
  {
    "RowId": 9643,
    "Dialogue": "だいぶ使ってきたから\n愛着も湧いてくるな",
    "Slowly": false
  },
  {
    "RowId": 9644,
    "Dialogue": "丈夫な機材だからこそ\n点検とメンテナンスね！",
    "Slowly": false
  },
  {
    "RowId": 9645,
    "Dialogue": "今後もきっと\n世話になるしな",
    "Slowly": false
  },
  {
    "RowId": 9646,
    "Dialogue": "基地のさらなる\nカッコイイ構造強化がっ！",
    "Slowly": false
  },
  {
    "RowId": 9647,
    "Dialogue": "研究チームからの\n仕様要望ときたら…",
    "Slowly": false
  },
  {
    "RowId": 9648,
    "Dialogue": "ただ建てるだけじゃなく\n今回は大変だったねぇ",
    "Slowly": false
  },
  {
    "RowId": 9649,
    "Dialogue": "さぁて研究チームの\n日報を読むのが楽しみだ",
    "Slowly": false
  },
  {
    "RowId": 9650,
    "Dialogue": "どんな分析が\n進んでるのかしらね",
    "Slowly": false
  },
  {
    "RowId": 9651,
    "Dialogue": "ふんふーん♪\n喜びの舞ってやつです！",
    "Slowly": false
  },
  {
    "RowId": 9652,
    "Dialogue": "うまい、うっ…！\nゲホッガハッ…！！",
    "Slowly": false
  },
  {
    "RowId": 9653,
    "Dialogue": "ちょっとぉ\nがっつきすぎじゃない？",
    "Slowly": false
  },
  {
    "RowId": 9654,
    "Dialogue": "お皿まで食べちゃいそうね",
    "Slowly": false
  },
  {
    "RowId": 9655,
    "Dialogue": "今回も頑張ってくれたな\nお前も、ご苦労さん",
    "Slowly": false
  },
  {
    "RowId": 9656,
    "Dialogue": "花丸あげちゃいますー！",
    "Slowly": false
  },
  {
    "RowId": 9657,
    "Dialogue": "エライ！\nトッテモ、エライ！",
    "Slowly": false
  },
  {
    "RowId": 9658,
    "Dialogue": "も～、ちゃんと注意したのに！\n言わんこっちゃない！",
    "Slowly": false
  },
  {
    "RowId": 9659,
    "Dialogue": "ごご、ごめんなさぁ～い…！\nだってカッコイイんだもん…",
    "Slowly": false
  },
  {
    "RowId": 9660,
    "Dialogue": "フンッ！\nフンフンフン！！！",
    "Slowly": false
  },
  {
    "RowId": 9661,
    "Dialogue": "さ～て\n新記録達成なるかしら？",
    "Slowly": false
  },
  {
    "RowId": 9662,
    "Dialogue": "とってもステキに\n完了しましたよ～っ！！",
    "Slowly": false
  },
  {
    "RowId": 9663,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9664,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9665,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9666,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9667,
    "Dialogue": "ウィフーテの奴…\nもう騙されないからな",
    "Slowly": false
  },
  {
    "RowId": 9668,
    "Dialogue": "永久人を\n利用しやがって！",
    "Slowly": false
  },
  {
    "RowId": 9669,
    "Dialogue": "みんなの記憶を\n決して無駄にしない…",
    "Slowly": false
  },
  {
    "RowId": 9670,
    "Dialogue": "今は進むしかないわ",
    "Slowly": false
  },
  {
    "RowId": 9671,
    "Dialogue": "永久人たちの\n恐怖の記憶が…",
    "Slowly": false
  },
  {
    "RowId": 9672,
    "Dialogue": "非道なことを…",
    "Slowly": false
  },
  {
    "RowId": 9673,
    "Dialogue": "カリュクスの奴…！",
    "Slowly": false
  },
  {
    "RowId": 9674,
    "Dialogue": "決着をつけに行こう",
    "Slowly": false
  },
  {
    "RowId": 9675,
    "Dialogue": "こっちの勝ちだ\nカリュクス",
    "Slowly": false
  },
  {
    "RowId": 9676,
    "Dialogue": "やったよ、みんな…！",
    "Slowly": false
  },
  {
    "RowId": 9677,
    "Dialogue": "本当にこれで\n終わりかしら…",
    "Slowly": false
  },
  {
    "RowId": 9678,
    "Dialogue": "嫌な予感がするわ…",
    "Slowly": false
  },
  {
    "RowId": 9679,
    "Dialogue": "今のうちに\n制御装置を壊そう",
    "Slowly": false
  },
  {
    "RowId": 9680,
    "Dialogue": "これでカリュクスに\n為す術はないわ",
    "Slowly": false
  },
  {
    "RowId": 9681,
    "Dialogue": "まさか蛮神を\n召喚するとはな",
    "Slowly": false
  },
  {
    "RowId": 9682,
    "Dialogue": "ジオードさんの分まで\n頑張らないと…",
    "Slowly": false
  },
  {
    "RowId": 9683,
    "Dialogue": "物資がある以上\n見張りは続けないとね",
    "Slowly": false
  },
  {
    "RowId": 9684,
    "Dialogue": "くそ…まだ信じられねえ…",
    "Slowly": false
  },
  {
    "RowId": 9685,
    "Dialogue": "異状なしだ",
    "Slowly": false
  },
  {
    "RowId": 9686,
    "Dialogue": "ジオードさん…",
    "Slowly": false
  },
  {
    "RowId": 9687,
    "Dialogue": "この銃はゲノルトさん行きだ",
    "Slowly": false
  },
  {
    "RowId": 9688,
    "Dialogue": "言葉が出ない…",
    "Slowly": false
  },
  {
    "RowId": 9689,
    "Dialogue": "仮眠室に行こうか…",
    "Slowly": false
  },
  {
    "RowId": 9690,
    "Dialogue": "こんなときこそ\nしっかりしないと…",
    "Slowly": false
  },
  {
    "RowId": 9691,
    "Dialogue": "製造品をガバメントに\n申請しないと",
    "Slowly": false
  },
  {
    "RowId": 9692,
    "Dialogue": "ジオードさんのためにも…",
    "Slowly": false
  },
  {
    "RowId": 9693,
    "Dialogue": "セキュリティレベルの高い\n魔法回路を開発中さ",
    "Slowly": false
  },
  {
    "RowId": 9694,
    "Dialogue": "この一帯の地下反応…\nすごいものがあるな",
    "Slowly": false
  },
  {
    "RowId": 9695,
    "Dialogue": "例の「パエンナイト」が\nこの地下にまだまだあるのか",
    "Slowly": false
  },
  {
    "RowId": 9696,
    "Dialogue": "惑星パエンナでも\nエクスプローラー魂だぜ！",
    "Slowly": false
  },
  {
    "RowId": 9697,
    "Dialogue": "メカオペレーション…\n緊張するなぁ…",
    "Slowly": false
  },
  {
    "RowId": 9698,
    "Dialogue": "コスモドリルの扱いなら\n任せとけ！",
    "Slowly": false
  },
  {
    "RowId": 9699,
    "Dialogue": "パエンナイトどこだ～！？",
    "Slowly": false
  },
  {
    "RowId": 9700,
    "Dialogue": "任務ご苦労様！",
    "Slowly": false
  },
  {
    "RowId": 9701,
    "Dialogue": "あのパイロットは\n良い仕事をしていたな",
    "Slowly": false
  },
  {
    "RowId": 9702,
    "Dialogue": "結晶みたいなガラスが\nどんどん生えてくる…",
    "Slowly": false
  },
  {
    "RowId": 9703,
    "Dialogue": "独特な惑星ですねぇ\nパエンナは…",
    "Slowly": false
  },
  {
    "RowId": 9704,
    "Dialogue": "メカオペレーションなら\n私に任せときな！",
    "Slowly": false
  },
  {
    "RowId": 9705,
    "Dialogue": "鍾乳洞での任務かぁ",
    "Slowly": false
  },
  {
    "RowId": 9706,
    "Dialogue": "出力を加減して…\nスゥ～…ッとな！",
    "Slowly": false
  },
  {
    "RowId": 9707,
    "Dialogue": "コスモゲイナーって\nこんなに強力なの！？",
    "Slowly": false
  },
  {
    "RowId": 9708,
    "Dialogue": "素晴らしい活躍だ\nありがとうー！",
    "Slowly": false
  },
  {
    "RowId": 9709,
    "Dialogue": "ホイールローダー\nカッコいいなぁ～！",
    "Slowly": false
  },
  {
    "RowId": 9710,
    "Dialogue": "砕いた偏属性クリスタルは\nこちらへ！",
    "Slowly": false
  },
  {
    "RowId": 9711,
    "Dialogue": "フィールドサーチャーに\n資材を投入して分析だ！",
    "Slowly": false
  },
  {
    "RowId": 9712,
    "Dialogue": "巨大な偏属性クリスタルを\nローダーで破砕してください！",
    "Slowly": false
  },
  {
    "RowId": 9713,
    "Dialogue": "ハイ・キャロットキャノン…\n威力は予想以上だ",
    "Slowly": false
  },
  {
    "RowId": 9714,
    "Dialogue": "焼却した菌床の灰は\nこちらへ！",
    "Slowly": false
  },
  {
    "RowId": 9715,
    "Dialogue": "フィールドサーチャーで\n隠れた異常菌床を探すぞ！",
    "Slowly": false
  },
  {
    "RowId": 9716,
    "Dialogue": "巨大な異常菌床を\nローダーで粉砕してくれ！",
    "Slowly": false
  },
  {
    "RowId": 9717,
    "Dialogue": "ブレードダッシュが\n異常菌床にこうも有効だとは！",
    "Slowly": false
  },
  {
    "RowId": 9718,
    "Dialogue": "獲得したパエンナイトは\nこちらへ～！",
    "Slowly": false
  },
  {
    "RowId": 9719,
    "Dialogue": "フィールドサーチャーは\nこの星でも正常稼働中だな",
    "Slowly": false
  },
  {
    "RowId": 9720,
    "Dialogue": "エネルギーが溜まったら\n流砂の穴にビームを撃って～！",
    "Slowly": false
  },
  {
    "RowId": 9721,
    "Dialogue": "ビームのエネルギーは\n雷気イオンを吸収して貯めよう",
    "Slowly": false
  },
  {
    "RowId": 9722,
    "Dialogue": "吸引したガラス片は\nここに納品を！",
    "Slowly": false
  },
  {
    "RowId": 9723,
    "Dialogue": "フィールドサーチャー…\nガラス塊を見つけてくれよ",
    "Slowly": false
  },
  {
    "RowId": 9724,
    "Dialogue": "でかいガラス塊は\nローダーが破砕してくれ！",
    "Slowly": false
  },
  {
    "RowId": 9725,
    "Dialogue": "プラズマ・ブレードダッシュ…\n素晴らしい力です！",
    "Slowly": false
  },
  {
    "RowId": 9726,
    "Dialogue": "先生も飾りタマゴと共に\n木の根元でじっと…フフ…",
    "Slowly": false
  },
  {
    "RowId": 9727,
    "Dialogue": "ホッホウ！\n皆、似合っておりますな！",
    "Slowly": false
  },
  {
    "RowId": 9728,
    "Dialogue": "噂の魔物も\n対処できたらしいな",
    "Slowly": false
  },
  {
    "RowId": 9729,
    "Dialogue": "祝祭なんだから\nいいだろ！",
    "Slowly": false
  },
  {
    "RowId": 9730,
    "Dialogue": "チッ\n視界が悪い…",
    "Slowly": false
  },
  {
    "RowId": 9731,
    "Dialogue": "こういうデザインも\nたまにはいいですね",
    "Slowly": false
  },
  {
    "RowId": 9732,
    "Dialogue": "ククク…\n似合ってるぜ",
    "Slowly": false
  },
  {
    "RowId": 9733,
    "Dialogue": "ミララ族はこの地に残って\nトレノを護ってきたんだね…",
    "Slowly": false
  },
  {
    "RowId": 9734,
    "Dialogue": "障壁のおかげか\n雷エーテルが穏やかね",
    "Slowly": false
  },
  {
    "RowId": 9735,
    "Dialogue": "住民に負傷者がいるなら\n手当を急がないと…",
    "Slowly": false
  },
  {
    "RowId": 9736,
    "Dialogue": "静かになったな…\n住民は無事だろうか",
    "Slowly": false
  },
  {
    "RowId": 9737,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9738,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9739,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9740,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9741,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9742,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9743,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9744,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9745,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9746,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9747,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9748,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9749,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9750,
    "Dialogue": "おい、しっかりしろ！",
    "Slowly": false
  },
  {
    "RowId": 9751,
    "Dialogue": "いたたた…",
    "Slowly": false
  },
  {
    "RowId": 9752,
    "Dialogue": "綺麗に咲いたね…",
    "Slowly": false
  },
  {
    "RowId": 9753,
    "Dialogue": "う、うおお…！\nこのくらい自力で…",
    "Slowly": false
  },
  {
    "RowId": 9754,
    "Dialogue": "ほんとに\n助けなくて平気！？",
    "Slowly": false
  },
  {
    "RowId": 9755,
    "Dialogue": "魔物…\nもう、いない…？",
    "Slowly": false
  },
  {
    "RowId": 9756,
    "Dialogue": "大丈夫だから\n復旧作業やるぞ！",
    "Slowly": false
  },
  {
    "RowId": 9757,
    "Dialogue": "街の外から\n人が来たんだって！",
    "Slowly": false
  },
  {
    "RowId": 9758,
    "Dialogue": "戦ったあとの薬湯が\n染みるわぁ",
    "Slowly": false
  },
  {
    "RowId": 9759,
    "Dialogue": "避難するにしても\nしのげるの…？",
    "Slowly": false
  },
  {
    "RowId": 9760,
    "Dialogue": "やったやった！\nお祝いしなきゃ！",
    "Slowly": false
  },
  {
    "RowId": 9761,
    "Dialogue": "お客人だなんて\n何年振りだ？",
    "Slowly": false
  },
  {
    "RowId": 9762,
    "Dialogue": "この酸味が\nクセになるよな",
    "Slowly": false
  },
  {
    "RowId": 9763,
    "Dialogue": "最悪の事態は\n覚悟しないと…",
    "Slowly": false
  },
  {
    "RowId": 9764,
    "Dialogue": "ド派手に\n祭りでもやるか！",
    "Slowly": false
  },
  {
    "RowId": 9765,
    "Dialogue": "まずはここを\n片付けるぞー！",
    "Slowly": false
  },
  {
    "RowId": 9766,
    "Dialogue": "ぼくたち仲良しだよね…？\n噛まないでね？",
    "Slowly": false
  },
  {
    "RowId": 9767,
    "Dialogue": "カードゲーム大会\nまたやりたいなぁ",
    "Slowly": false
  },
  {
    "RowId": 9768,
    "Dialogue": "残りの12枚\nどこにあったっけな…",
    "Slowly": false
  },
  {
    "RowId": 9769,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9770,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9771,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9772,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9773,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9774,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9775,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9776,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9777,
    "Dialogue": "衣装も好評ね！",
    "Slowly": false
  },
  {
    "RowId": 9778,
    "Dialogue": "すごーい！\n旅先でそんなことが…！",
    "Slowly": false
  },
  {
    "RowId": 9779,
    "Dialogue": "友達ができたみたいだな",
    "Slowly": false
  },
  {
    "RowId": 9780,
    "Dialogue": "ウキャキャッ！",
    "Slowly": false
  },
  {
    "RowId": 9781,
    "Dialogue": "ウェーイ！！\nいいパーティーじゃないか！",
    "Slowly": false
  },
  {
    "RowId": 9782,
    "Dialogue": "イメージが\n湧いてきまちた！",
    "Slowly": false
  },
  {
    "RowId": 9783,
    "Dialogue": "よしよし\n今日もフカフカだね",
    "Slowly": false
  },
  {
    "RowId": 9784,
    "Dialogue": "ボクがついていれば\n大丈夫さ！",
    "Slowly": false
  },
  {
    "RowId": 9785,
    "Dialogue": "私たち\n街を守っていけるかしら",
    "Slowly": false
  },
  {
    "RowId": 9786,
    "Dialogue": "唸れ、筋肉ゥ！",
    "Slowly": false
  },
  {
    "RowId": 9787,
    "Dialogue": "砕けろ、瓦礫ィ！",
    "Slowly": false
  },
  {
    "RowId": 9788,
    "Dialogue": "それ飲んだら\n作業はじめましょう",
    "Slowly": false
  },
  {
    "RowId": 9789,
    "Dialogue": "ルムルの薬湯は\nよく効くわね",
    "Slowly": false
  },
  {
    "RowId": 9790,
    "Dialogue": "よっしゃあ！\nまかせとけぇ！",
    "Slowly": false
  },
  {
    "RowId": 9791,
    "Dialogue": "警戒を怠らないようにしよう",
    "Slowly": false
  },
  {
    "RowId": 9792,
    "Dialogue": "惑星オイジュスの環境が\n一時的に激変するかもしれないな",
    "Slowly": false
  },
  {
    "RowId": 9793,
    "Dialogue": "万一の場合に備えておこう",
    "Slowly": false
  },
  {
    "RowId": 9794,
    "Dialogue": "有事の際は\n迅速に行動しなければな",
    "Slowly": false
  },
  {
    "RowId": 9795,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9796,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9797,
    "Dialogue": "機材が浮かんでしまったか…！？\nグラビティジェネレーターが必要か",
    "Slowly": false
  },
  {
    "RowId": 9798,
    "Dialogue": "水泡嵐が稀少資源を運んできたか\n物資確保のチャンスだ！",
    "Slowly": false
  },
  {
    "RowId": 9799,
    "Dialogue": "輸送作業中に事故とは…\n事後対応を急ごう！",
    "Slowly": false
  },
  {
    "RowId": 9800,
    "Dialogue": "やはり落石が起きてしまったか\n迅速に対処しなければ",
    "Slowly": false
  },
  {
    "RowId": 9801,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9802,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9803,
    "Dialogue": "みんなの尽力に感謝する！",
    "Slowly": false
  },
  {
    "RowId": 9804,
    "Dialogue": "復旧の目処は立った…\nあとはこちらで片付けておこう",
    "Slowly": false
  },
  {
    "RowId": 9805,
    "Dialogue": "乱重力の予兆が\n観測されました！",
    "Slowly": false
  },
  {
    "RowId": 9806,
    "Dialogue": "海水が浮き上がる現象が\n発生したそうです",
    "Slowly": false
  },
  {
    "RowId": 9807,
    "Dialogue": "マザーボム級の\n極大低気圧の接近を確認！",
    "Slowly": false
  },
  {
    "RowId": 9808,
    "Dialogue": "マザーボム級の\n極大低気圧の接近を確認！",
    "Slowly": false
  },
  {
    "RowId": 9809,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9810,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9811,
    "Dialogue": "重力異常の影響が\n深刻化すると…？",
    "Slowly": false
  },
  {
    "RowId": 9812,
    "Dialogue": "これが例の\n水泡嵐というやつか",
    "Slowly": false
  },
  {
    "RowId": 9813,
    "Dialogue": "輸送中の資材への\n影響が心配だな…",
    "Slowly": false
  },
  {
    "RowId": 9814,
    "Dialogue": "この風向きだと脆い岩盤から\n落石事故でもありそうだ",
    "Slowly": false
  },
  {
    "RowId": 9815,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9816,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9817,
    "Dialogue": "大変な事になっています！\n物資の固定を急ぎ行いましょう！",
    "Slowly": false
  },
  {
    "RowId": 9818,
    "Dialogue": "物資はこちらへー！",
    "Slowly": false
  },
  {
    "RowId": 9819,
    "Dialogue": "これで、よし！",
    "Slowly": false
  },
  {
    "RowId": 9820,
    "Dialogue": "ふぅ…\n何とか間に合った、な…！",
    "Slowly": false
  },
  {
    "RowId": 9821,
    "Dialogue": "このあたりは重力異常が強い\n十分に気をつけろ",
    "Slowly": false
  },
  {
    "RowId": 9822,
    "Dialogue": "失われた物資の\n補充をお願いしたい！",
    "Slowly": false
  },
  {
    "RowId": 9823,
    "Dialogue": "1、2、3…\n納品数に問題なし",
    "Slowly": false
  },
  {
    "RowId": 9824,
    "Dialogue": "なんとか無事、任務達成しました！\n撤収しましょう！",
    "Slowly": false
  },
  {
    "RowId": 9825,
    "Dialogue": "緊急状況が解除されたようです\nあとの処理はお任せを！",
    "Slowly": false
  },
  {
    "RowId": 9826,
    "Dialogue": "緊急状況はこれにて解除だ！\nみな、協力に感謝する！",
    "Slowly": false
  },
  {
    "RowId": 9827,
    "Dialogue": "ふう、緊急状況は解除か\n後片付けをもうひと頑張りだな",
    "Slowly": false
  },
  {
    "RowId": 9828,
    "Dialogue": "好湿植物が大発生中です！\n伐採へのご協力をお願いします！",
    "Slowly": false
  },
  {
    "RowId": 9829,
    "Dialogue": "漂う水泡を求めて\n一斉に出てきたのか…",
    "Slowly": false
  },
  {
    "RowId": 9830,
    "Dialogue": "吸水、吸湿性に優れた\n便利な素材になるみたい",
    "Slowly": false
  },
  {
    "RowId": 9831,
    "Dialogue": "よくきてくれた！\n稀少資源の回収を依頼したい！",
    "Slowly": false
  },
  {
    "RowId": 9832,
    "Dialogue": "なかなか見ない資源が\n浅瀬に流れ着いているねぇ",
    "Slowly": false
  },
  {
    "RowId": 9833,
    "Dialogue": "重力異常の影響が\n海中でも起きているのね",
    "Slowly": false
  },
  {
    "RowId": 9834,
    "Dialogue": "海水が宙を漂うとはな！",
    "Slowly": false
  },
  {
    "RowId": 9835,
    "Dialogue": "事故でコスモヌードルが…！\n補充を手伝ってください！",
    "Slowly": false
  },
  {
    "RowId": 9836,
    "Dialogue": "復旧作業を急がないと…",
    "Slowly": false
  },
  {
    "RowId": 9837,
    "Dialogue": "落水してしまった遺跡片の\n引き上げ作業を頼む！",
    "Slowly": false
  },
  {
    "RowId": 9838,
    "Dialogue": "空中輸送中に突風とは\n運が悪い…",
    "Slowly": false
  },
  {
    "RowId": 9839,
    "Dialogue": "引き上げた遺物は\nよく洗浄しないと",
    "Slowly": false
  },
  {
    "RowId": 9840,
    "Dialogue": "落石処理の作業に\nご協力をお願いします！",
    "Slowly": false
  },
  {
    "RowId": 9841,
    "Dialogue": "これは…\n替えの刃がすぐに要りそうだ",
    "Slowly": false
  },
  {
    "RowId": 9842,
    "Dialogue": "落石処理は\nまかせてください！",
    "Slowly": false
  },
  {
    "RowId": 9843,
    "Dialogue": "青い鉱石は\n回収してくださーい！",
    "Slowly": false
  },
  {
    "RowId": 9844,
    "Dialogue": "負傷者の治療のため\n協力をお願いしたい！",
    "Slowly": false
  },
  {
    "RowId": 9845,
    "Dialogue": "治療薬の材料は\nこの先で調達できそうね",
    "Slowly": false
  },
  {
    "RowId": 9846,
    "Dialogue": "この成分…ふむふむ\n応急処置に役立ちそう",
    "Slowly": false
  },
  {
    "RowId": 9847,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9848,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9849,
    "Dialogue": "共同施工作業の参加者は\nエレベーターで屋上階へ！",
    "Slowly": false
  },
  {
    "RowId": 9850,
    "Dialogue": "共同施工作業の参加者は\nエレベーターで屋上階へ！",
    "Slowly": false
  },
  {
    "RowId": 9851,
    "Dialogue": "共同施工作業の参加者は\nエレベーターで屋上階へ！",
    "Slowly": false
  },
  {
    "RowId": 9852,
    "Dialogue": "全焼しなくて\n本当によかったわ…",
    "Slowly": false
  },
  {
    "RowId": 9853,
    "Dialogue": "瓦礫を片付けて\n修繕を進めよう",
    "Slowly": false
  },
  {
    "RowId": 9854,
    "Dialogue": "うおぉぉ！\n気合だ、気合ー！",
