[
  {
    "RowId": 10500,
    "Dialogue": "周辺の作業に\nとりかかるよー！",
    "Slowly": false
  },
  {
    "RowId": 10501,
    "Dialogue": "ハイ！",
    "Slowly": false
  },
  {
    "RowId": 10502,
    "Dialogue": "ハイ！",
    "Slowly": false
  },
  {
    "RowId": 10503,
    "Dialogue": "ハイ！",
    "Slowly": false
  },
  {
    "RowId": 10504,
    "Dialogue": "あらら？",
    "Slowly": false
  },
  {
    "RowId": 10505,
    "Dialogue": "おやすみくんの監査\nここにも来てるんだ～？",
    "Slowly": false
  },
  {
    "RowId": 10506,
    "Dialogue": "えへへ\n記念撮影ー！",
    "Slowly": false
  },
  {
    "RowId": 10507,
    "Dialogue": "ここでもキャロット栽培を\n計画中だって！",
    "Slowly": false
  },
  {
    "RowId": 10508,
    "Dialogue": "アウクセシア産…\nどんなお味かな～！",
    "Slowly": false
  },
  {
    "RowId": 10509,
    "Dialogue": "微妙な違いが\nあるもんねっ",
    "Slowly": false
  },
  {
    "RowId": 10510,
    "Dialogue": "ここで飲むキャロットラテは\n特別な味わいなのです",
    "Slowly": false
  },
  {
    "RowId": 10511,
    "Dialogue": "けっこう好きかも～！",
    "Slowly": false
  },
  {
    "RowId": 10512,
    "Dialogue": "キャロットジャム\n好評みたいね",
    "Slowly": false
  },
  {
    "RowId": 10513,
    "Dialogue": "賢人パンに慣れる日が\nついに来るとはなぁ～",
    "Slowly": false
  },
  {
    "RowId": 10514,
    "Dialogue": "やっと探索活動にも\n余裕が出てきたかな",
    "Slowly": false
  },
  {
    "RowId": 10515,
    "Dialogue": "最初の頃は\nバタバタだったね～",
    "Slowly": false
  },
  {
    "RowId": 10516,
    "Dialogue": "標本がたくさんで\n嬉しい悲鳴なの！",
    "Slowly": false
  },
  {
    "RowId": 10517,
    "Dialogue": "植物学者には\nここは楽園でしょうね",
    "Slowly": false
  },
  {
    "RowId": 10518,
    "Dialogue": "そこらじゅうが\n新種祭りってわけだ",
    "Slowly": false
  },
  {
    "RowId": 10519,
    "Dialogue": "この星は湿度も十分で\n髪も肌もツヤツヤさ",
    "Slowly": false
  },
  {
    "RowId": 10520,
    "Dialogue": "たしかに\n毛並みに潤いを感じるな…",
    "Slowly": false
  },
  {
    "RowId": 10521,
    "Dialogue": "復旧したら\nどんなになるかな～？",
    "Slowly": false
  },
  {
    "RowId": 10522,
    "Dialogue": "みなさ～ん！\nがんばってくださ～い！",
    "Slowly": false
  },
  {
    "RowId": 10523,
    "Dialogue": "キラキラの作業風景\n記録しなくっちゃ～！",
    "Slowly": false
  },
  {
    "RowId": 10524,
    "Dialogue": "子葉の塔がっ！",
    "Slowly": false
  },
  {
    "RowId": 10525,
    "Dialogue": "復旧しましたー！",
    "Slowly": false
  },
  {
    "RowId": 10526,
    "Dialogue": "とってもパワフルな予感！",
    "Slowly": false
  },
  {
    "RowId": 10527,
    "Dialogue": "森島の奥まで！",
    "Slowly": false
  },
  {
    "RowId": 10528,
    "Dialogue": "開通しましたーっ！",
    "Slowly": false
  },
  {
    "RowId": 10529,
    "Dialogue": "塔のまわりのは\n何かな～？？",
    "Slowly": false
  },
  {
    "RowId": 10530,
    "Dialogue": "今だけの姿だっ！！",
    "Slowly": false
  },
  {
    "RowId": 10531,
    "Dialogue": "常葉の塔がっ！",
    "Slowly": false
  },
  {
    "RowId": 10532,
    "Dialogue": "復旧しましたー！",
    "Slowly": false
  },
  {
    "RowId": 10533,
    "Dialogue": "これがみーんな\n飛び立つのかな！？",
    "Slowly": false
  },
  {
    "RowId": 10534,
    "Dialogue": "ドローンさんたちの\n整備中ですよ～！",
    "Slowly": false
  },
  {
    "RowId": 10535,
    "Dialogue": "どどーんと橋が！",
    "Slowly": false
  },
  {
    "RowId": 10536,
    "Dialogue": "できましたーっ！",
    "Slowly": false
  },
  {
    "RowId": 10537,
    "Dialogue": "この塔は\nどんな役目なのかな？",
    "Slowly": false
  },
  {
    "RowId": 10538,
    "Dialogue": "暗闇のなかに\n努力の光がっ！",
    "Slowly": false
  },
  {
    "RowId": 10539,
    "Dialogue": "末葉の塔がっ！",
    "Slowly": false
  },
  {
    "RowId": 10540,
    "Dialogue": "復旧しましたー！",
    "Slowly": false
  },
  {
    "RowId": 10541,
    "Dialogue": "すやすやすや…\nあったかぁい…",
    "Slowly": false
  },
  {
    "RowId": 10542,
    "Dialogue": "フハハハハ\n我、翠玉の星に降臨せん！",
    "Slowly": false
  },
  {
    "RowId": 10543,
    "Dialogue": "自然な背景も\nグッドですよー！",
    "Slowly": false
  },
  {
    "RowId": 10544,
    "Dialogue": "ふぅー…\n間に合ってよかったぜ",
    "Slowly": false
  },
  {
    "RowId": 10545,
    "Dialogue": "そうか、私は…",
    "Slowly": false
  },
  {
    "RowId": 10546,
    "Dialogue": "こら～～！\n登ったらダメでしょ～～！！",
    "Slowly": false
  },
  {
    "RowId": 10547,
    "Dialogue": "う～む\n至福の一杯ですな",
    "Slowly": false
  },
  {
    "RowId": 10548,
    "Dialogue": "グリーナー仲間のあいつ\n宇宙にも興味あるかな？",
    "Slowly": false
  },
  {
    "RowId": 10549,
    "Dialogue": "ああ、トラル出身っていう？",
    "Slowly": false
  },
  {
    "RowId": 10550,
    "Dialogue": "その魔物…\nよく懐いてるな",
    "Slowly": false
  },
  {
    "RowId": 10551,
    "Dialogue": "うわ、びっくりした\n魔獣使いの魔物か…",
    "Slowly": false
  },
  {
    "RowId": 10552,
    "Dialogue": "その魔物…\nいくらなら売ってくれる？",
    "Slowly": false
  },
  {
    "RowId": 10553,
    "Dialogue": "おっと、魔獣使いか…",
    "Slowly": false
  },
  {
    "RowId": 10554,
    "Dialogue": "魔物の管理はしっかりな",
    "Slowly": false
  },
  {
    "RowId": 10555,
    "Dialogue": "ほう…\nいい使役獣だな",
    "Slowly": false
  },
  {
    "RowId": 10556,
    "Dialogue": "へえ…\n魔獣使いの使役獣ってやつか？",
    "Slowly": false
  },
  {
    "RowId": 10557,
    "Dialogue": "最近、魔物連れの奴が\n増えた気がしないか？",
    "Slowly": false
  },
  {
    "RowId": 10558,
    "Dialogue": "そんな魔物がいれば\n海賊も大人しくなりそうだ",
    "Slowly": false
  },
  {
    "RowId": 10559,
    "Dialogue": "オラ、絶対釣ってみせるだす！",
    "Slowly": false
  },
  {
    "RowId": 10560,
    "Dialogue": "ニッダーナさんに\n異国の魚を…！",
    "Slowly": false
  },
  {
    "RowId": 10561,
    "Dialogue": "この星のあちこちで\n活用できそうだな",
    "Slowly": false
  },
  {
    "RowId": 10562,
    "Dialogue": "耐熱装備の機能性\n試すっきゃねーですよ！",
    "Slowly": false
  },
  {
    "RowId": 10563,
    "Dialogue": "しよか・・・\nこの美しい旋律でしよか～",
    "Slowly": false
  }
]