  },
  {
    "RowId": 17334,
    "Text": "ホットバー"
  },
  {
    "RowId": 17335,
    "Text": "ギアセット"
  },
  {
    "RowId": 17336,
    "Text": "その他のデータ"
  },
  {
    "RowId": 17337,
    "Text": "キャラクターマクロ"
  },
  {
    "RowId": 17338,
    "Text": "共通マクロ"
  },
  {
    "RowId": 17339,
    "Text": "キャラクターコンフィグ"
  },
  {
    "RowId": 17340,
    "Text": "システムコンフィグ（一部）"
  },
  {
    "RowId": 17341,
    "Text": "共有する設定データについてのコメントを入力してください。"
  },
  {
    "RowId": 17342,
    "Text": "入力したコメントは他人が閲覧する可能性があります。\nプライベートな内容は記載しないようご注意ください。"
  },
  {
    "RowId": 17343,
    "Text": "設定データをアップロード"
  },
  {
    "RowId": 17344,
    "Text": "キャンセル"
  },
  {
