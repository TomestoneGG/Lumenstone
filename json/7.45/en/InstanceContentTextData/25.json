    "RowId": 38200,
    "Text": "Clear the hover docks"
  },
  {
    "RowId": 38201,
    "Text": "Clear the resource transport elevator"
  },
  {
    "RowId": 38202,
    "Text": "Defeat Herpekaris"
  },
  {
    "RowId": 38203,
    "Text": "Clear the soul management division"
  },
  {
    "RowId": 38204,
    "Text": "Defeat Deceiver"
  },
  {
    "RowId": 38205,
    "Text": "Clear the soul research division"
  },
  {
    "RowId": 38206,
    "Text": "Defeat Ambrose the Undeparted"
  },
  {
    "RowId": 38207,
    "Text": ""
  },
  {
