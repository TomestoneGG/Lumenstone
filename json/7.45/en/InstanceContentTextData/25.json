  {
    "RowId": 38209,
    "Text": ""
  },
  {
    "RowId": 38210,
    "Text": "I see you've arrived. Follow the path and you'll soon see the entrance. Be careful now."
  },
  {
    "RowId": 38211,
    "Text": "Whew, the diversion did the trick. Let's push straight to the middle level!"
  },
  {
    "RowId": 38212,
    "Text": "There should be another freight elevator further in. Use it to head up."
  },
  {
    "RowId": 38213,
    "Text": "Oh dear, this one looks like trouble..."
  },
  {
    "RowId": 38214,
    "Text": "It's nothing they can't handle. I'll activate the elevator to keep you moving."
  }
]