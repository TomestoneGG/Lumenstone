  },
  {
    "RowId": 40808,
    "Text": "フグゥゥ……！"
  },
  {
    "RowId": 40809,
    "Text": "グゥゥギャア！"
  },
  {
    "RowId": 40810,
    "Text": "ギギ……ギィ！"
  },
  {
    "RowId": 40811,
    "Text": "ギ、ギャガァァァ！"
  },
  {
    "RowId": 40812,
