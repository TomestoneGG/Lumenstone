    "RowId": 40800,
    "Text": "グ、ギィヤアアアア！"
  },
  {
    "RowId": 40801,
    "Text": "氷漬けになるがいい……！"
  },
  {
    "RowId": 40802,
    "Text": "プギャァアア！"
  },
  {
    "RowId": 40803,
    "Text": "グゥ、ググガアア……！"
  },
  {
    "RowId": 40804,
    "Text": "ギイィィィ！\u3000ギイィィィ！"
  },
  {
    "RowId": 40805,
    "Text": "グギャ、ギャア……！"
  },
  {
    "RowId": 40806,
    "Text": "ピギィヤアアアアアアアアア！"
  },
  {
    "RowId": 40807,
