  },
  {
    "RowId": 40700,
    "Text": "強烈な一撃！\nこれは効いたかァ～！？"
  },
  {
    "RowId": 40701,
    "Text": "得意技を喰らったァ！\nしかし、なんとか耐えている！"
  },
  {
    "RowId": 40702,
    "Text": "華麗に攻撃をかわしたァ！"
  },
  {
    "RowId": 40703,
    "Text": "見事に攻撃を見切っているぞ！？"
  },
  {
    "RowId": 40704,
    "Text": "お～っと！\n挑戦者、ここでダウ～ン！"
  },
  {
    "RowId": 40705,
    "Text": "挑戦者がダウン！\n立ち上がれるかァ～！？"
  },
  {
    "RowId": 40706,
    "Text": "挑戦者、なんとか立ち上がったァ～！"
  },
  {
    "RowId": 40707,
    "Text": "立ち上がったァ！\nだが、挑戦者はピンチ！"
  },
  {
    "RowId": 40708,
    "Text": "必殺技が炸裂！渾身の一撃だァ～！"
  },
  {
    "RowId": 40709,
    "Text": "治癒魔法が発動！\n起死回生なるかァ～！？"
  },
  {
    "RowId": 40710,
    "Text": "ここで守りを固める！\n鉄壁の防御だァ～！"
  },
  {
    "RowId": 40711,
    "Text": "なんと、挑戦者がリングアウトだァ～！"
  },
  {
    "RowId": 40712,
    "Text": "実況はメテムでお送りしました！"
  },
  {
    "RowId": 40713,
    "Text": "まともに喰らった！\nこのまま立っていられるかァ～？"
  },
  {
    "RowId": 40714,
    "Text": "おっと！\n挑戦者、大丈夫かァ～？"
  },
  {
    "RowId": 40715,
    "Text": "これは、かわせなかったァ～！"
  },
  {
    "RowId": 40716,
    "Text": "痛手を負ったがァ～\nまだまだ倒れない！"
  },
  {
    "RowId": 40717,
    "Text": "余裕で攻撃をかわしたァ！"
  },
  {
    "RowId": 40718,
    "Text": "アメージング！\n得意技を見切ったァ～！"
  },
  {
    "RowId": 40719,
    "Text": "落ち着いて攻撃を避けているぞ！"
  },
  {
    "RowId": 40720,
    "Text": "素晴らしい動き！\nすべてを見通している！？"
  },
  {
    "RowId": 40721,
    "Text": "オー・マイ・ガッシュ！\n挑戦者が倒れたァ～！"
  },
  {
    "RowId": 40722,
    "Text": "挑戦者、ダウン！\nさァ、立ち上がれるかァ～！？"
  },
  {
    "RowId": 40723,
    "Text": "挑戦者、復活！\n巻き返せるかァ～！？"
  },
  {
    "RowId": 40724,
    "Text": "立ち上がったぞォ！\nだが、油断はできない！"
  },
  {
    "RowId": 40725,
    "Text": "これは痛い！\nどうした、挑戦者ァ～？"
  },
  {
    "RowId": 40726,
    "Text": "避け切れなかったァ～！"
  },
  {
    "RowId": 40727,
    "Text": "喰らった！\n油断は禁物だァ～！"
  },
  {
    "RowId": 40728,
    "Text": "挑戦者に直撃！\nだが、倒れることはない！"
  },
  {
    "RowId": 40729,
    "Text": "挑戦者、さすがの動きだァ！"
  },
  {
    "RowId": 40730,
    "Text": "アンビリーバボー！\n巧みに回避したァ～！"
  },
  {
    "RowId": 40731,
    "Text": "冷静に対処しているぞォ～！"
  },
  {
    "RowId": 40732,
    "Text": "挑戦者、\n攻撃を当てさせません！"
  },
  {
    "RowId": 40733,
    "Text": "お～っと！\n挑戦者が倒れてしまったァ！"
  },
  {
    "RowId": 40734,
    "Text": "ここでダウン！\nさあ、復活できるかァ～？"
  },
  {
    "RowId": 40735,
    "Text": "立ち上がったぞォ！\n挑戦者は諦めない！"
  },
  {
    "RowId": 40736,
    "Text": "戦線復帰！\nここから挽回なるかァ～！？"
  },
