[
  {
    "RowId": 41609,
    "Text": "まだ生きていますか？\n安全装置を解除します！"
  },
  {
    "RowId": 41610,
    "Text": "空間を掌握しました！\n存在抹消を実行します！"
  },
  {
    "RowId": 41611,
    "Text": "限界負荷を超過……中断します。"
  },
  {
    "RowId": 41612,
    "Text": "まだ生きて……空間掌握……再実行します！"
  },
  {
    "RowId": 41613,
    "Text": "限界負荷……超過……\nエラーが発生し……"
  },
  {
    "RowId": 41614,
    "Text": "強制実行……命令……確認……"
  },
  {
    "RowId": 41615,
    "Text": "アブソリュート・オーソリティ発動まで\u30005"
  },
  {
    "RowId": 41616,
    "Text": "アブソリュート・オーソリティ発動まで\u30004"
  },
  {
    "RowId": 41617,
    "Text": "アブソリュート・オーソリティ発動まで\u30003"
  },
  {
    "RowId": 41618,
    "Text": "アブソリュート・オーソリティ発動まで\u30002"
  },
  {
    "RowId": 41619,
    "Text": "アブソリュート・オーソリティ発動まで\u30001"
  },
  {
    "RowId": 41620,
    "Text": "ココ、コんに……こんニチは！\nそそそソシて、そソシて、さようナラ……！！！"
  },
  {
    "RowId": 41621,
    "Text": "トワびトの、み、ミなさんは、ゴ安心……さい……！\nまもなく、いのチ、いのチが、がガガ……。"
  },
  {
    "RowId": 41622,
    "Text": "もしモの、トき……ハ……\nきミ、が……わタシを……。"
  },
  {
    "RowId": 41623,
    "Text": "せ、せつゾく……世界を……\nオオお、見せ、しましょう……！"
  },
  {
    "RowId": 41624,
    "Text": "シシ、し……しあわ、セ、ですか……？"
  },
  {
    "RowId": 41625,
    "Text": "こ、ココ、こわがら……ナい……で……。"
  },
  {
    "RowId": 41626,
    "Text": "し、シを……死を、死を！\nのりこえましょう！"
  },
