  {
    "RowId": 3031,
    "Text": "Die <sheet(Relic6Magicite,IntegerParameter(1),1)> ist kaum spürbar. Die ätherische Konkordanz läuft gegen null."
  },
  {
    "RowId": 3032,
    "Text": "Die <sheet(Relic6Magicite,IntegerParameter(1),1)> ist leicht ausgeprägt. Die ätherische Konkordanz ist gering."
