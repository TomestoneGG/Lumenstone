  },
  {
    "RowOffset": 633578,
    "RowId": 9750,
    "Dialogue": "Tiens bon, je t'en prie!",
    "Slowly": false
  },
  {
    "RowOffset": 633622,
    "RowId": 9751,
    "Dialogue": "Aïe aïe aïe...",
    "Slowly": false
  },
  {
    "RowOffset": 633654,
    "RowId": 9752,
    "Dialogue": "Comme elles ont bien fleuri...",
    "Slowly": false
  },
  {
    "RowOffset": 633702,
    "RowId": 9753,
    "Dialogue": "P-pas de panique! Je gère!",
    "Slowly": false
  },
  {
    "RowOffset": 633754,
    "RowId": 9754,
    "Dialogue": "Euh... t'en es bien sûr!?",
    "Slowly": false
  },
  {
    "RowOffset": 633802,
    "RowId": 9755,
    "Dialogue": "Les monstres... Ils sont partis?",
    "Slowly": false
  },
  {
    "RowOffset": 633854,
    "RowId": 9756,
    "Dialogue": "C'est bon, on peut se remettre au boulot!",
    "Slowly": false
  },
  {
    "RowOffset": 633914,
    "RowId": 9757,
    "Dialogue": "Des étrangers nous ont rendu visite!",
    "Slowly": false
  },
  {
    "RowOffset": 633970,
    "RowId": 9758,
    "Dialogue": "Ce bon goût de potion après la bataille, miam!",
    "Slowly": false
  },
  {
    "RowOffset": 634038,
    "RowId": 9759,
    "Dialogue": "On reste cachés jusqu'à ce que ça passe, en gros?",
    "Slowly": false
  },
  {
    "RowOffset": 634110,
    "RowId": 9760,
    "Dialogue": "Ouaiiis, on a gagné! Place à la fête!",
    "Slowly": false
  },
  {
    "RowOffset": 634174,
    "RowId": 9761,
    "Dialogue": "Ça faisait combien d'années qu'on avait pas eu d'invités?",
    "Slowly": false
  },
  {
    "RowOffset": 634254,
    "RowId": 9762,
    "Dialogue": "Plus c'est acide, plus ça fait du bien par où ça passe!",
    "Slowly": false
  },
  {
    "RowOffset": 634334,
    "RowId": 9763,
    "Dialogue": "Tout en se préparant au pire, je suppose...",
    "Slowly": false
  },
  {
    "RowOffset": 634394,
    "RowId": 9764,
    "Dialogue": "Pourquoi pas une grande parade, hein?",
    "Slowly": false
  },
  {
    "RowOffset": 634450,
    "RowId": 9765,
    "Dialogue": "Ici commence le grand nettoyage!",
    "Slowly": false
  },
  {
    "RowOffset": 634502,
    "RowId": 9766,
    "Dialogue": "Eh, on est copains! Ne me mords pas, d'accord?",
    "Slowly": false
  },
  {
    "RowOffset": 634574,
    "RowId": 9767,
    "Dialogue": "J'ai tellement envie de participer à un tournoi de jeu de cartes!",
    "Slowly": false
  },
  {
    "RowOffset": 634662,
    "RowId": 9768,
    "Dialogue": "Zut, où sont les douze restantes...",
    "Slowly": false
