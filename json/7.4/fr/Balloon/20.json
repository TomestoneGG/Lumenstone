  {
    "RowOffset": 628330,
    "RowId": 9667,
    "Dialogue": "T'avise pas de nous la faire à l'enverrrs, Wihuwte. Je t'ai à l'œil.",
    "Slowly": false
  },
  {
    "RowOffset": 628418,
    "RowId": 9668,
    "Dialogue": "Ce bâtard a osé se servir des Éternels contre nous!",
    "Slowly": false
  },
  {
    "RowOffset": 628494,
    "RowId": 9669,
    "Dialogue": "Mes compatriotes... Je vengerai votre mémoire...",
    "Slowly": false
  },
  {
    "RowOffset": 628558,
    "RowId": 9670,
    "Dialogue": "Quoi qu'il arrive, il faut continuer d'avancer.",
    "Slowly": false
  },
  {
    "RowOffset": 628622,
    "RowId": 9671,
    "Dialogue": "Il est allé puiser dans les pires souvenirs des Alexandrins...",
    "Slowly": false
  },
  {
    "RowOffset": 628702,
    "RowId": 9672,
    "Dialogue": "Encore une démonstration de cruauté...",
    "Slowly": false
  },
  {
    "RowOffset": 628770,
    "RowId": 9673,
    "Dialogue": "Ce maudit Calyx va nous le payer!",
    "Slowly": false
  },
  {
    "RowOffset": 628822,
    "RowId": 9674,
    "Dialogue": "Allez, il faut en finirrr à présent.",
    "Slowly": false
  },
  {
    "RowOffset": 628878,
    "RowId": 9675,
    "Dialogue": "Tu as perdu, Calyx!",
    "Slowly": false
  },
  {
    "RowOffset": 628918,
    "RowId": 9676,
    "Dialogue": "Bien joué, tout le monde!",
    "Slowly": false
  },
  {
    "RowOffset": 628966,
    "RowId": 9677,
    "Dialogue": "C'est vraiment terminé? J'ai comme un doute...",
    "Slowly": false
  },
  {
    "RowOffset": 629034,
    "RowId": 9678,
    "Dialogue": "J'ai un mauvais pressentiment...",
    "Slowly": false
  },
  {
    "RowOffset": 629094,
    "RowId": 9679,
    "Dialogue": "C'est le moment ou jamais de détruire l'ordinateur!",
    "Slowly": false
  },
  {
    "RowOffset": 629166,
    "RowId": 9680,
    "Dialogue": "Maintenant, Calyx n'a plus aucun atout dans sa manche.",
    "Slowly": false
  },
  {
    "RowOffset": 629238,
    "RowId": 9681,
    "Dialogue": "Un Primordial... Qui l'aurait crrru...",
    "Slowly": false
  },
  {
    "RowOffset": 629294,
    "RowId": 9682,
    "Dialogue": "Même moins nombreux, on continuera de s'accrocher.",
    "Slowly": false
  },
  {
    "RowOffset": 629362,
    "RowId": 9683,
    "Dialogue": "Dès lors qu'on a des marchandises, il faut les surveiller.",
    "Slowly": false
  },
  {
    "RowOffset": 629450,
    "RowId": 9684,
    "Dialogue": "Bon sang... Je ne réalise toujours pas ce qu'il s'est passé...",
    "Slowly": false
  },
  {
    "RowOffset": 629530,
    "RowId": 9685,
    "Dialogue": "Rien à signaler pour l'instant.",
    "Slowly": false
  },
  {
    "RowOffset": 629578,
    "RowId": 9686,
    "Dialogue": "Geode...",
    "Slowly": false
  },
  {
    "RowOffset": 629602,
    "RowId": 9687,
    "Dialogue": "Je dois livrer ce fusil à Genolt.",
    "Slowly": false
  },
  {
    "RowOffset": 629654,
    "RowId": 9688,
    "Dialogue": "J'ai pas les mots...",
    "Slowly": false
  },
  {
    "RowOffset": 629690,
    "RowId": 9689,
    "Dialogue": "J'aurais bien besoin d'un petit tour en salle de repos, moi...",
    "Slowly": false
  },
  {
    "RowOffset": 629770,
    "RowId": 9690,
    "Dialogue": "C'est dans ces moments-là qu'il faut se montrer fort...",
    "Slowly": false
  },
  {
    "RowOffset": 629842,
    "RowId": 9691,
    "Dialogue": "Je dois commander du matériel auprès du gouvernement.",
    "Slowly": false
  },
  {
    "RowOffset": 629914,
    "RowId": 9692,
    "Dialogue": "Le combat continuera... pour Geode...",
    "Slowly": false
  },
  {
    "RowOffset": 629966,
    "RowId": 9693,
    "Dialogue": "Je travaille sur un nouveau modèle de circuit magique hautement sécurisé.",
    "Slowly": false
  },
  {
    "RowOffset": 630058,
    "RowId": 9694,
    "Dialogue": "Le détecteur souterrain réagit... Il y a quelque chose d'enfoui ici!",
    "Slowly": false
  },
  {
    "RowOffset": 630150,
    "RowId": 9695,
    "Dialogue": "Je me demande s'il reste encore des morceaux de phaennite à récupérer...",
    "Slowly": false
  },
  {
    "RowOffset": 630242,
    "RowId": 9696,
    "Dialogue": "Même sur Phaenna, l'esprit des explorateurs cosmiques ne flanchera pas!",
    "Slowly": false
  },
  {
    "RowOffset": 630334,
    "RowId": 9697,
    "Dialogue": "Une intervention mécanique... J'ai le trac...",
    "Slowly": false
  },
  {
    "RowOffset": 630410,
    "RowId": 9698,
    "Dialogue": "Je gère la cosmoforeuse, vous en faites pas pour moi!",
    "Slowly": false
  },
  {
    "RowOffset": 630486,
    "RowId": 9699,
    "Dialogue": "Où se trouve cette fameuse phaennite?",
    "Slowly": false
  },
  {
    "RowOffset": 630546,
    "RowId": 9700,
    "Dialogue": "Bon boulot!",
    "Slowly": false
  },
  {
    "RowOffset": 630578,
    "RowId": 9701,
    "Dialogue": "Ce pilote fait du super travail, c'est indéniable!",
    "Slowly": false
  },
  {
    "RowOffset": 630650,
    "RowId": 9702,
    "Dialogue": "Des sortes de cristaux de verre poussent un peu partout...",
    "Slowly": false
  },
  {
    "RowOffset": 630726,
    "RowId": 9703,
    "Dialogue": "Cette planète est vraiment très étrange...",
    "Slowly": false
  },
  {
    "RowOffset": 630786,
    "RowId": 9704,
    "Dialogue": "Laissez-moi faire! Les interventions mécaniques, je m'y connais!",
    "Slowly": false
  },
  {
    "RowOffset": 630886,
    "RowId": 9705,
    "Dialogue": "Une mission dans les grottes, hein...",
    "Slowly": false
  },
  {
    "RowOffset": 630938,
    "RowId": 9706,
    "Dialogue": "Il faut ajuster la puissance et hop! Ça aspire d'un coup!",
    "Slowly": false
  },
  {
    "RowOffset": 631022,
    "RowId": 9707,
    "Dialogue": "Je ne savais pas que le cosmoaspirateur était si puissant!",
    "Slowly": false
  },
  {
    "RowOffset": 631102,
    "RowId": 9708,
    "Dialogue": "Excellent boulot! Merci!",
    "Slowly": false
  },
  {
    "RowOffset": 631150,
    "RowId": 9709,
    "Dialogue": "La déblayeuse cosmique est vraiment trop classe!",
    "Slowly": false
  },
  {
    "RowOffset": 631218,
    "RowId": 9710,
    "Dialogue": "Les fragments de cristaux corrompus, c'est par là!",
    "Slowly": false
  },
  {
    "RowOffset": 631290,
    "RowId": 9711,
    "Dialogue": "On doit passer ces matériaux à l'analyseur de terrain.",
    "Slowly": false
  },
  {
    "RowOffset": 631362,
    "RowId": 9712,
    "Dialogue": "Fracassez ces énormes cristaux corrompus avec votre robot!",
    "Slowly": false
  },
  {
    "RowOffset": 631442,
    "RowId": 9713,
    "Dialogue": "Le Super carotto-canon est plus puissant que je l'imaginais!",
    "Slowly": false
  },
  {
    "RowOffset": 631522,
    "RowId": 9714,
    "Dialogue": "Les cendres d'excroissances fongiques, c'est par ici!",
    "Slowly": false
  },
  {
    "RowOffset": 631594,
    "RowId": 9715,
    "Dialogue": "L'analyseur de terrain va nous aider à débusquer ces mycoses.",
    "Slowly": false
  },
  {
    "RowOffset": 631674,
    "RowId": 9716,
    "Dialogue": "Pulvérisez ces gigantesques excroissances fongiques avec votre engin!",
    "Slowly": false
  },
  {
    "RowOffset": 631774,
    "RowId": 9717,
    "Dialogue": "La ruée tranchante est très efficace!",
    "Slowly": false
  },
  {
    "RowOffset": 631834,
    "RowId": 9718,
    "Dialogue": "Par ici! Venez déposer les morceaux de phaennite!",
    "Slowly": false
  },
  {
    "RowOffset": 631910,
    "RowId": 9719,
    "Dialogue": "L'analyseur de terrain fonctionne normalement sur cette planète.",
    "Slowly": false
  },
  {
    "RowOffset": 631990,
    "RowId": 9720,
    "Dialogue": "Une fois que vous avez accumulé suffisamment d'énergie, utilisez votre rayon extracteur dans les sables mouvants.",
    "Slowly": false
  },
  {
    "RowOffset": 632134,
    "RowId": 9721,
    "Dialogue": "Aspirez les charges ioniques pour alimenter le rayon extracteur!",
    "Slowly": false
  },
  {
    "RowOffset": 632218,
    "RowId": 9722,
    "Dialogue": "Déposez ici les éclats de verre que vous avez aspirrrés!",
    "Slowly": false
  },
  {
    "RowOffset": 632298,
    "RowId": 9723,
    "Dialogue": "Allez mon petit analyseur, trouve-moi des amas de verre!",
    "Slowly": false
  },
  {
    "RowOffset": 632374,
    "RowId": 9724,
    "Dialogue": "Détruisez les amas de verre à l'aide de la déblayeuse!",
    "Slowly": false
  },
  {
    "RowOffset": 632450,
    "RowId": 9725,
    "Dialogue": "Voilà la fameuse Ruée plasma... Quelle puissance incroyable!",
    "Slowly": false
  },
  {
    "RowOffset": 632534,
    "RowId": 9726,
    "Dialogue": "Ces racines vigoureuses me font oublier les Prœufs...",
    "Slowly": false
  },
  {
    "RowOffset": 632606,
    "RowId": 9727,
    "Dialogue": "Ho... Hoo... Les lunettes ont un succès fou!",
    "Slowly": false
  },
  {
    "RowOffset": 632670,
    "RowId": 9728,
    "Dialogue": "Les monstres ne faisaient pas le poids!",
    "Slowly": false
  },
  {
    "RowOffset": 632730,
    "RowId": 9729,
    "Dialogue": "Détends-toi, on est juste là pourrr s'amuser!",
    "Slowly": false
  },
  {
    "RowOffset": 632798,
    "RowId": 9730,
    "Dialogue": "Pfff... Ça obscurcit ma vision!",
    "Slowly": false
  },
  {
    "RowOffset": 632850,
    "RowId": 9731,
    "Dialogue": "Il faut parfois savoir changer de style!",
    "Slowly": false
  },
  {
    "RowOffset": 632910,
    "RowId": 9732,
    "Dialogue": "Ha ha ha! Elles te vont bien!",
    "Slowly": false
  },
  {
    "RowOffset": 632962,
    "RowId": 9733,
    "Dialogue": "Les Milalla défendent Tréno depuis très longtemps...",
    "Slowly": false
  },
  {
    "RowOffset": 633034,
    "RowId": 9734,
    "Dialogue": "Le dôme nous protège convenablement de l'éther de foudre... pour l'instant...",
    "Slowly": false
  },
  {
    "RowOffset": 633146,
    "RowId": 9735,
    "Dialogue": "S'il y a des blessés parmi la population, il faut les soigner immédiatement!",
    "Slowly": false
  },
  {
    "RowOffset": 633262,
    "RowId": 9736,
    "Dialogue": "C'est bien calme, tout à coup... J'espèrrre que les habitants sont tous sains et saufs...",
    "Slowly": false
  },
