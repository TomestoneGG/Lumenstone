    "Dialogue": "Ouhouhou!",
    "Slowly": false
  },
  {
    "RowOffset": 635010,
    "RowId": 9781,
    "Dialogue": "Yeeeaaah! C'est la fête!",
    "Slowly": false
  },
  {
    "RowOffset": 635058,
    "RowId": 9782,
    "Dialogue": "Cette ville est une source d'inspiration!",
    "Slowly": false
  },
  {
    "RowOffset": 635118,
    "RowId": 9783,
    "Dialogue": "Te voilà encore tout douillet aujourd'hui!",
    "Slowly": false
  },
  {
    "RowOffset": 635182,
    "RowId": 9784,
    "Dialogue": "Avec moi, rien n'est impossible!",
    "Slowly": false
  },
  {
    "RowOffset": 635234,
    "RowId": 9785,
    "Dialogue": "Pourra-t-on éternellement protéger cette cité...?",
    "Slowly": false
  },
  {
    "RowOffset": 635318,
    "RowId": 9786,
    "Dialogue": "Voilà qui va faire travailler nos muscles!",
    "Slowly": false
  },
  {
    "RowOffset": 635382,
    "RowId": 9787,
    "Dialogue": "Et réduire en miettes tous ces débris!",
    "Slowly": false
  },
  {
    "RowOffset": 635442,
    "RowId": 9788,
    "Dialogue": "Surtout pour nous pousser à travailler!",
    "Slowly": false
  },
  {
    "RowOffset": 635502,
    "RowId": 9789,
    "Dialogue": "Les potions de Lumull sont sacrément efficaces!",
    "Slowly": false
  },
  {
    "RowOffset": 635570,
