[
  {
    "RowOffset": 956610,
    "RowId": 41609,
    "Text": "Êtes-vous toujours en vie? Déverrouillage de la sécurité..."
  },
  {
    "RowOffset": 956690,
    "RowId": 41610,
    "Text": "Zone cible délimitée. Suppression de toute existence..."
  },
  {
    "RowOffset": 956758,
    "RowId": 41611,
    "Text": "Surcharge du système... Interruption de la procédure."
  },
  {
    "RowOffset": 956826,
    "RowId": 41612,
    "Text": "... Toujours en vie?...ne délimitée......eprise de la suppression..."
  },
  {
    "RowOffset": 956922,
    "RowId": 41613,
    "Text": "Surcharg... extrême... Erreur dé..."
  },
  {
    "RowOffset": 956970,
    "RowId": 41614,
    "Text": "Instruction...écution...rcée... con...ée."
  },
  {
    "RowOffset": 957034,
    "RowId": 41615,
    "Text": "5 secondes avant Autorité absolue..."
  },
  {
    "RowOffset": 957082,
    "RowId": 41616,
    "Text": "4 secondes avant Autorité absolue..."
  },
  {
    "RowOffset": 957130,
    "RowId": 41617,
    "Text": "3 secondes avant Autorité absolue..."
  },
  {
    "RowOffset": 957178,
    "RowId": 41618,
    "Text": "2 secondes avant Autorité absolue..."
  },
  {
    "RowOffset": 957226,
    "RowId": 41619,
    "Text": "1 seconde avant Autorité absolue..."
  },
  {
    "RowOffset": 957274,
    "RowId": 41620,
    "Text": "◎×■venue e-e-e-et ad#▼△ieu!"
  },
  {
    "RowOffset": 957326,
    "RowId": 41621,
    "Text": "É◎×■♭nels, veu▼△ patienter. La dis■♭!×tion d'énergie ×■tale-ale-ale-ale..."
  },
  {
    "RowOffset": 957434,
    "RowId": 41622,
    "Text": "Dans ce cas, si ja◎×■♭!×#▼sion △♭◎ne au vinaigre... Je p... ourrai ×#?■ sur toi...?"
  },
  {
    "RowOffset": 957554,
    "RowId": 41623,
    "Text": "Ad-ad-dmir▼△ez le lien en■♭tre les mon-◎▼ondes!"
  },
  {
    "RowOffset": 957630,
    "RowId": 41624,
    "Text": "Êtes-v■♭... Êtes-vous heu▼◎eux?"
  },
  {
    "RowOffset": 957686,
    "RowId": 41625,
    "Text": "N'a-n'a-n'ayez ◎×■ peur, la mort n'est pas #▼△ fin en soi!"
  },
  {
    "RowOffset": 957770,
    "RowId": 41626,
    "Text": "Ensem... Ens-ens-ens■♭!ble, surmontons la mort!"
  },
