  },
  {
    "RowOffset": 970138,
    "RowId": 42100,
    "Text": "Je vais utiliser la plus puissante unité défensive de ce château pour mieux étalonner ta force."
  },
  {
    "RowOffset": 970250,
    "RowId": 42101,
    "Text": "Activons un autre système d'armement."
  },
  {
    "RowOffset": 970302,
    "RowId": 42102,
    "Text": "Décidément... Passons au protocole suivant."
  },
  {
    "RowOffset": 970358,
    "RowId": 42103,
    "Text": "Testons maintenant tes capacités d'adaptation."
  },
  {
    "RowOffset": 970418,
    "RowId": 42104,
    "Text": "Pourrais-tu mourir, s'il te plaît? Cela m'épargnerait bien des désagréments."
  },
  {
    "RowOffset": 970514,
    "RowId": 42105,
    "Text": "Encore en vie? Quelle corvée..."
  },
  {
    "RowOffset": 970562,
    "RowId": 42106,
    "Text": "Je vois... C'est donc ce pouvoir incommensurable qui a eu raison de la Reine Éternité."
  },
  {
    "RowOffset": 970662,
    "RowId": 42107,
    "Text": "Essayons avec ceci."
  },
  {
    "RowOffset": 970694,
    "RowId": 42108,
    "Text": "Comment vas-tu réagir à ça?"
  }
]