[
  {
    "RowOffset": 696458,
    "RowId": 34269,
    "Text": "Vaincre Silkie"
  },
  {
    "RowOffset": 696486,
    "RowId": 34270,
    "Text": "Franchir le Refuge des Puissants"
  },
  {
    "RowOffset": 696530,
    "RowId": 34271,
    "Text": "Vaincre le gladiateur sildien"
  },
  {
    "RowOffset": 696570,
    "RowId": 34272,
    "Text": "Vaincre Zeless Gah"
  },
  {
    "RowOffset": 696602,
    "RowId": 34273,
    "Text": ""
  },
  {
    "RowOffset": 696614,
    "RowId": 34300,
    "Text": "Franchir les canaux de la connaissance"
  },
  {
    "RowOffset": 696678,
    "RowId": 34301,
    "Text": "Franchir la rivière du savoir"
  },
  {
    "RowOffset": 696722,
    "RowId": 34302,
    "Text": "Franchir l'œil de l'océan"
  },
  {
    "RowOffset": 696762,
    "RowId": 34303,
    "Text": "Franchir la voie des vents"
  },
  {
    "RowOffset": 696802,
    "RowId": 34304,
    "Text": "Franchir les marches du firmament"
  },
  {
    "RowOffset": 696846,
    "RowId": 34305,
    "Text": "Franchir la voûte astrale"
  },
  {
    "RowOffset": 696886,
    "RowId": 34306,
    "Text": "Vous allez découvrir les secrets de la navigation!"
  },
  {
    "RowOffset": 696954,
    "RowId": 34307,
    "Text": "Ô, vents et océans, donnez-moi votre force!"
  },
  {
    "RowOffset": 697014,
    "RowId": 34308,
    "Text": "Que la fureur divine des mers vous emporte!"
  },
  {
    "RowOffset": 697074,
    "RowId": 34309,
    "Text": "Ne comptez pas sur moi pour ménager mon équipage!"
  },
  {
    "RowOffset": 697142,
    "RowId": 34310,
    "Text": "Arriverez-vous à me suivre dans mon élément?"
  },
  {
    "RowOffset": 697206,
    "RowId": 34311,
    "Text": "Il faut toujours garder le vent en poupe!"
  },
  {
    "RowOffset": 697262,
    "RowId": 34312,
    "Text": "Bravo, vous êtes comme des poissons dans l'eau!"
  },
  {
    "RowOffset": 697326,
    "RowId": 34313,
    "Text": "Essayez donc de franchir l'écume!"
  },
  {
    "RowOffset": 697378,
    "RowId": 34314,
    "Text": "La marée monte, ne perdez pas pied!"
  },
  {
    "RowOffset": 697430,
    "RowId": 34315,
    "Text": "Tempête en vue, accrochez-vous!"
  },
  {
    "RowOffset": 697478,
    "RowId": 34316,
    "Text": "Que mon trident fende les mers!"
  },
  {
    "RowOffset": 697526,
    "RowId": 34317,
    "Text": "Ha ha ha! Bravo, moussaillons!"
  },
  {
    "RowOffset": 697578,
    "RowId": 34318,
    "Text": "Ça alors, de vrais loups de mer!"
  },
  {
    "RowOffset": 697626,
    "RowId": 34319,
    "Text": "Ne me dites pas que vous avez bu la tasse?"
  },
  {
    "RowOffset": 697686,
    "RowId": 34320,
    "Text": "Le secret, c'est de toujours rester soudés..."
  },
  {
    "RowOffset": 697746,
    "RowId": 34321,
    "Text": "Courage, et vous arriverez à bon port!"
  },
  {
    "RowOffset": 697802,
    "RowId": 34322,
    "Text": "À moi, Pérykos et Thalaos!"
  },
  {
    "RowOffset": 697846,
    "RowId": 34323,
    "Text": "Venez, mes chers familiers!"
  },
  {
    "RowOffset": 697890,
    "RowId": 34324,
    "Text": "Pérykos! Thalaos! À vous de jouer!"
  },
  {
    "RowOffset": 697950,
    "RowId": 34325,
    "Text": "Amusez-vous donc avec ces humains!"
  },
  {
    "RowOffset": 698002,
    "RowId": 34326,
    "Text": "Les bons petits serpents à leur maman!"
  },
  {
    "RowOffset": 698058,
    "RowId": 34327,
    "Text": "Pérykos, en avant!"
  },
  {
    "RowOffset": 698094,
    "RowId": 34328,
    "Text": "C'est bien, Pérykos!"
  },
  {
    "RowOffset": 698130,
    "RowId": 34329,
    "Text": "Va, et fends les vagues!"
  },
  {
    "RowOffset": 698170,
    "RowId": 34330,
    "Text": "Thalaos, à ton tour!"
  },
  {
    "RowOffset": 698206,
    "RowId": 34331,
    "Text": "Continue comme ça, Thalaos!"
  },
  {
    "RowOffset": 698250,
    "RowId": 34332,
    "Text": "L'océan est ton terrain de jeu!"
  },
  {
    "RowOffset": 698298,
    "RowId": 34333,
    "Text": "Allez!"
  },
  {
    "RowOffset": 698322,
    "RowId": 34334,
    "Text": "Soyez les bienvenus dans la voûte de l'eau..."
  },
  {
    "RowOffset": 698382,
    "RowId": 34335,
    "Text": "Commencez par affronter mes serviteurs..."
  },
  {
    "RowOffset": 698434,
    "RowId": 34336,
    "Text": "Votre réputation n'était donc pas usurpée..."
  },
  {
    "RowOffset": 698494,
    "RowId": 34337,
    "Text": "Venez à moi, maintenant."
  },
  {
    "RowOffset": 698530,
    "RowId": 34338,
    "Text": "Je vois que vous gardez le cap... Embarquez donc avec moi!"
  },
  {
    "RowOffset": 698606,
    "RowId": 34339,
    "Text": "Tout le monde à son poste!"
  },
  {
    "RowOffset": 698650,
    "RowId": 34340,
    "Text": "On lève l'ancre!"
  },
  {
    "RowOffset": 698682,
    "RowId": 34341,
    "Text": "Prêts à naviguer en ma compagnie?"
  },
  {
    "RowOffset": 698734,
    "RowId": 34342,
    "Text": "Allez, on se dépêche!"
  },
  {
    "RowOffset": 698774,
    "RowId": 34343,
    "Text": "Il nous faut un décor digne de notre traversée!"
  },
  {
    "RowOffset": 698838,
    "RowId": 34344,
    "Text": "Quelle étrange sensation de m'adresser à vous ainsi..."
  },
  {
    "RowOffset": 698906,
    "RowId": 34345,
    "Text": "Je vous suis reconnaissant d'être arrivés jusqu'ici."
  },
  {
    "RowOffset": 698986,
    "RowId": 34346,
    "Text": "Votre voyage touchera bientôt à sa fin..."
  },
  {
    "RowOffset": 699042,
    "RowId": 34347,
    "Text": "Le moment est venu pour moi de vous ouvrir la voie."
  },
  {
    "RowOffset": 699106,
    "RowId": 34348,
    "Text": "Vous combattre nous a rapprochés de notre nature originelle..."
  },
  {
    "RowOffset": 699182,
    "RowId": 34349,
    "Text": "Désormais, le reste est entre vos mains."
  },
  {
    "RowOffset": 699234,
    "RowId": 34350,
    "Text": "On est revenus! Oh, regarrrde, Omphalos...!"
  },
  {
    "RowOffset": 699298,
    "RowId": 34351,
    "Text": "Les épreuves sont donc terrrminées?"
  },
  {
    "RowOffset": 699350,
    "RowId": 34352,
    "Text": "Encorrre des familiers... Mais de qui!?"
  },
  {
    "RowOffset": 699406,
    "RowId": 34353,
    "Text": "On dirrrait que nous sommes attendus..."
  },
  {
    "RowOffset": 699458,
    "RowId": 34354,
    "Text": "Parrrs devant! Je m'occupe de protéger Snoegeim et les autres!"
  },
  {
    "RowOffset": 699542,
    "RowId": 34355,
    "Text": "Encore un effort, vous y êtes presque..."
  },
  {
    "RowOffset": 699594,
    "RowId": 34356,
    "Text": "Je suis le dernier. Vous êtes prêts?"
  },
  {
    "RowOffset": 699650,
    "RowId": 34357,
    "Text": "Descendez, ô vents des sommets!"
  },
  {
    "RowOffset": 699698,
    "RowId": 34358,
    "Text": "Que la colère des vents s'abatte sur vous!"
  },
  {
    "RowOffset": 699758,
    "RowId": 34359,
    "Text": "Tournoyez jusqu'aux cieux!"
  },
  {
    "RowOffset": 699802,
    "RowId": 34360,
    "Text": "Vole, ô flèche du Vagabond!"
  },
  {
    "RowOffset": 699846,
    "RowId": 34361,
    "Text": "Entendez résonner la corde de mon arc!"
  },
  {
    "RowOffset": 699902,
    "RowId": 34362,
    "Text": "Soyez transpercés!"
  },
  {
    "RowOffset": 699938,
    "RowId": 34363,
    "Text": "Allez de l'avant, encore et toujours!"
  },
  {
    "RowOffset": 699990,
    "RowId": 34364,
    "Text": "Allons, ne retenez pas vos coups!"
  },
  {
    "RowOffset": 700038,
    "RowId": 34365,
    "Text": "Notre voyage est sur le point de s'achever..."
  },
  {
    "RowOffset": 700094,
    "RowId": 34366,
    "Text": "Je vous tiens!"
  },
  {
    "RowOffset": 700126,
    "RowId": 34367,
    "Text": "Montrez-moi comment vous encaissez ça!"
  },
  {
    "RowOffset": 700182,
    "RowId": 34368,
    "Text": "La terre jaillit et s'élève!"
  },
  {
    "RowOffset": 700230,
    "RowId": 34369,
    "Text": "Que tout soit remis à plat!"
  },
  {
    "RowOffset": 700274,
    "RowId": 34370,
    "Text": "Vos prières nous ont rendus si puissants..."
  },
  {
    "RowOffset": 700330,
    "RowId": 34371,
    "Text": "En vous affrontant, notre éther retournera à la planète."
  },
  {
    "RowOffset": 700402,
    "RowId": 34372,
    "Text": "À vous de réaliser le vœu des Dieux!"
  },
  {
    "RowOffset": 700458,
    "RowId": 34373,
    "Text": "Vous ne cesserez jamais de me surprendre..."
  },
  {
    "RowOffset": 700514,
    "RowId": 34374,
    "Text": "Humains, prouvez-moi votre valeur ici et maintenant!"
  },
  {
    "RowOffset": 700582,
    "RowId": 34375,
    "Text": "Cette fois ça y est, j'ai l'esprit tranquille."
  },
  {
    "RowOffset": 700642,
    "RowId": 34376,
    "Text": "Allez, faites-moi croire en vous..."
  },
  {
    "RowOffset": 700690,
    "RowId": 34377,
    "Text": "Une fois notre combat achevé, je devrai..."
  },
  {
    "RowOffset": 700746,
    "RowId": 34378,
    "Text": "Quelle joie de vous avoir rencontrés..."
  },
  {
    "RowOffset": 700798,
    "RowId": 34379,
    "Text": "C'est donc ça, la douleur d'une séparation..."
  },
  {
    "RowOffset": 700858,
    "RowId": 34380,
    "Text": "Puissiez-vous arriver au bout de votre route!"
  },
  {
    "RowOffset": 700918,
    "RowId": 34381,
    "Text": "Béni soit le voyage de l'humanité."
  },
  {
    "RowOffset": 700966,
    "RowId": 34382,
    "Text": "Que les vents vous portent au firmament..."
  },
  {
    "RowOffset": 701022,
    "RowId": 34383,
    "Text": "Voyager rend plus fort... Vous le savez si bien!"
  },
  {
    "RowOffset": 701086,
    "RowId": 34384,
    "Text": "Ô, humains, puissiez-vous réaliser notre ultime souhait..."
  },
  {
    "RowOffset": 701158,
    "RowId": 34385,
    "Text": "Que notre essence retourne à la planète à tout jamais!"
  },
  {
    "RowOffset": 701230,
    "RowId": 34386,
    "Text": "Au nom des Douze!"
  },
  {
    "RowOffset": 701262,
    "RowId": 34387,
    "Text": "Oui, encore! Encore!"
  },
  {
    "RowOffset": 701302,
    "RowId": 34388,
    "Text": "Brillez de toutes vos forces!"
  },
  {
    "RowOffset": 701346,
    "RowId": 34389,
    "Text": "Miséricorde pour nos enfants bien-aimés!"
  },
  {
    "RowOffset": 701406,
    "RowId": 34390,
    "Text": "Donnez-vous la main pour être plus forts!"
  },
  {
    "RowOffset": 701466,
    "RowId": 34391,
    "Text": "N'ayez jamais peur d'aller de l'avant!"
  },
  {
    "RowOffset": 701522,
    "RowId": 34392,
    "Text": "Vous êtes capables de surmonter cette ultime épreuve!"
  },
  {
    "RowOffset": 701594,
    "RowId": 34393,
    "Text": "Libérez votre force et vos pensées!"
  },
  {
    "RowOffset": 701646,
    "RowId": 34394,
    "Text": "Donnez-vous corps et âme!"
  },
  {
    "RowOffset": 701690,
    "RowId": 34395,
    "Text": "Vous êtes petits par la taille, mais grands par la force!"
  },
  {
    "RowOffset": 701766,
    "RowId": 34396,
    "Text": "Recevez notre amour, et soyez portés!"
  },
  {
    "RowOffset": 701822,
    "RowId": 34397,
    "Text": "Depuis toujours, vous avez fidèlement prié pour nous..."
  },
  {
    "RowOffset": 701890,
    "RowId": 34398,
    "Text": "Vos souhaits passionnés nous ont donné forme..."
  },
  {
    "RowOffset": 701950,
    "RowId": 34399,
    "Text": "Aujourd'hui, le destin de cette planète vous revient!"
  },
  {
    "RowOffset": 702022,
    "RowId": 34400,
    "Text": "Aaah... Loué soit le miracle de l'humanité..."
  },
  {
    "RowOffset": 702082,
    "RowId": 34401,
    "Text": "Bénie soit Ætherys!"
  },
  {
    "RowOffset": 702118,
    "RowId": 34402,
    "Text": "Transcendez-vous, maintenant ou jamais!"
  },
  {
    "RowOffset": 702174,
    "RowId": 34403,
    "Text": "De votre foi naît notre pouvoir!"
  },
  {
    "RowOffset": 702222,
    "RowId": 34404,
    "Text": "Des lunes sont créées par le pouvoir de Menphina!"
  },
  {
    "RowOffset": 702290,
    "RowId": 34405,
    "Text": "La brillance de l'amour commence à s'intensifier..."
  },
  {
    "RowOffset": 702354,
    "RowId": 34406,
    "Text": "Le temps est accéléré par le pouvoir d'Althyk!"
  },
  {
    "RowOffset": 702418,
    "RowId": 34407,
    "Text": "Vous voilà, mes brillants enfants..."
  },
  {
    "RowOffset": 702466,
    "RowId": 34408,
    "Text": "Le moment est venu d'évaluer votre érudition."
  },
  {
    "RowOffset": 702526,
    "RowId": 34409,
    "Text": "Les courants tumultueux révéleront votre essence!"
  },
  {
    "RowOffset": 702594,
    "RowId": 34410,
    "Text": "Déchaîne-toi, flux torrentiel!"
  },
  {
    "RowOffset": 702642,
    "RowId": 34411,
    "Text": "Triturons-nous un peu les méninges..."
  },
  {
    "RowOffset": 702694,
    "RowId": 34412,
    "Text": "Répondez-donc à l'Érudit!"
  },
  {
    "RowOffset": 702738,
    "RowId": 34413,
    "Text": "Un problème, plusieurs aspects..."
  },
  {
    "RowOffset": 702786,
    "RowId": 34414,
    "Text": "Donnez-vous le temps de la réflexion."
  },
  {
    "RowOffset": 702838,
    "RowId": 34415,
    "Text": "Prouvez-moi le savoir de l'humanité!"
  },
  {
    "RowOffset": 702890,
    "RowId": 34416,
    "Text": "Soyez purifiés!"
  },
  {
    "RowOffset": 702922,
    "RowId": 34417,
    "Text": "Échangeons donc nos points de vue."
  },
  {
    "RowOffset": 702970,
    "RowId": 34418,
    "Text": "Tout ce qui coule n'est pas eau!"
  },
  {
    "RowOffset": 703018,
    "RowId": 34419,
    "Text": "Exposez-moi le fond de votre pensée."
  },
  {
    "RowOffset": 703066,
    "RowId": 34420,
    "Text": "Le choix de la force n'est pas toujours le plus sage."
  },
  {
    "RowOffset": 703130,
    "RowId": 34421,
    "Text": "Je comprends mieux l'enthousiasme de mes pairs!"
  },
  {
    "RowOffset": 703194,
    "RowId": 34422,
    "Text": "Rejoignez-moi dans les abysses de la connaissance!"
  },
  {
    "RowOffset": 703274,
    "RowId": 34423,
    "Text": "Épreuve passée avec mention très bien..."
  },
  {
    "RowOffset": 703330,
    "RowId": 34424,
    "Text": ""
  },
  {
    "RowOffset": 703342,
    "RowId": 34425,
    "Text": ""
  },
  {
    "RowOffset": 703354,
    "RowId": 34426,
    "Text": ""
  },
  {
    "RowOffset": 703366,
    "RowId": 34427,
    "Text": ""
  },
  {
    "RowOffset": 703378,
    "RowId": 34428,
    "Text": ""
  },
  {
    "RowOffset": 703390,
    "RowId": 34429,
    "Text": ""
  },
  {
    "RowOffset": 703402,
    "RowId": 34500,
    "Text": "Votre éther a l'air si bon..."
  },
  {
    "RowOffset": 703446,
    "RowId": 34501,
    "Text": "Mes cheveux en fulminent d'avance!"
  },
  {
    "RowOffset": 703498,
    "RowId": 34502,
    "Text": "Saurez-vous éviter ça?"
  },
  {
    "RowOffset": 703538,
    "RowId": 34503,
    "Text": "Subissez ma colère!"
  },
  {
    "RowOffset": 703574,
    "RowId": 34504,
    "Text": "Ça va trancher!"
  },
  {
    "RowOffset": 703606,
    "RowId": 34505,
    "Text": "Vous allez souffrir!"
  },
  {
    "RowOffset": 703642,
    "RowId": 34506,
    "Text": "Mes cheveux sont libres comme l'air qui les porte..."
  },
  {
    "RowOffset": 703706,
    "RowId": 34507,
    "Text": "Une chevelure soyeuse... mais toujours vigoureuse!"
  },
  {
    "RowOffset": 703774,
    "RowId": 34508,
    "Text": "Mmm... Quel vent agréable!"
  },
  {
    "RowOffset": 703818,
    "RowId": 34509,
    "Text": "Vous sentez le vent venir, vous aussi?"
  },
  {
    "RowOffset": 703874,
    "RowId": 34510,
    "Text": "Peuh! Vous n'avez encore rien vu..."
  },
  {
    "RowOffset": 703926,
    "RowId": 34511,
    "Text": "Préparez-vous à être réduits en poussière!"
  },
  {
    "RowOffset": 703990,
    "RowId": 34512,
    "Text": "Aaahahahahaha!!"
  },
  {
    "RowOffset": 704022,
    "RowId": 34513,
    "Text": "J'vais vous défoncer la gueule, bande de minables!"
  },
  {
    "RowOffset": 704090,
    "RowId": 34514,
    "Text": "Prenez ça, et ça, et encore ça!"
  },
  {
    "RowOffset": 704142,
    "RowId": 34515,
    "Text": "Vous allez crever, oui!??"
  },
  {
    "RowOffset": 704182,
    "RowId": 34516,
    "Text": "Yaaah raaah haah haah!"
  },
  {
    "RowOffset": 704222,
    "RowId": 34517,
    "Text": "Vous m'échapperez pas, pauvres larves!"
  },
  {
    "RowOffset": 704278,
    "RowId": 34518,
    "Text": "Haah haah haah haaaah!"
  },
  {
    "RowOffset": 704318,
    "RowId": 34519,
    "Text": "Je vais vous mettre en charpie, un par un!"
  },
  {
    "RowOffset": 704378,
    "RowId": 34520,
    "Text": "Faites pas l'erreur de vous foutre de moi!"
  },
  {
    "RowOffset": 704438,
    "RowId": 34521,
    "Text": "Vous me donnez envie de gerber!"
  },
  {
    "RowOffset": 704486,
    "RowId": 34522,
    "Text": "Vous n'êtes rien, rien du tout!"
  },
  {
    "RowOffset": 704534,
    "RowId": 34523,
    "Text": "Allez, c'est reparti pour un tour..."
  },
  {
    "RowOffset": 704582,
    "RowId": 34524,
    "Text": "Fondez-vous dans le néant!"
  },
  {
    "RowOffset": 704626,
    "RowId": 34525,
    "Text": "Fini de jouer, mes petits..."
  },
  {
    "RowOffset": 704666,
    "RowId": 34526,
    "Text": "Vous allez finir en bouillie!"
  },
  {
    "RowOffset": 704710,
    "RowId": 34527,
    "Text": ""
  },
  {
    "RowOffset": 704722,
