    "RowOffset": 551562,
    "RowId": 26399,
    "Text": ""
  },
  {
    "RowOffset": 551574,
    "RowId": 26400,
    "Text": "Vaincre le roi de l'Ombre"
  },
  {
    "RowOffset": 551610,
    "RowId": 26401,
    "Text": "Les sentiments que vous avez abandonnés ont fait de moi le roi de l'Ombre... Renoncez à cette <i>amitié</i>, que j'accomplisse ma destinée!"
  },
  {
    "RowOffset": 551774,
    "RowId": 26402,
    "Text": "Inutile de vous cacher, vous n'échapperez pas à mes griffes!"
  },
  {
    "RowOffset": 551854,
    "RowId": 26403,
    "Text": "Tapi dans l'ombre, je suis à l'affût!"
  },
  {
    "RowOffset": 551910,
    "RowId": 26404,
    "Text": "Les ombres se meuvent, et jaillissent des Ténèbres!"
  },
  {
    "RowOffset": 551978,
    "RowId": 26405,
    "Text": "Votre ombre est mienne!"
  },
  {
    "RowOffset": 552018,
    "RowId": 26406,
    "Text": "Surveillez vos arrières... Vos ombres vous trahissent!"
  },
  {
    "RowOffset": 552090,
    "RowId": 26407,
    "Text": "Mon monde, englouti par les Ténèbres...\nLa source de mon pouvoir!"
  },
  {
    "RowOffset": 552178,
    "RowId": 26408,
    "Text": "Toutes les ombres m'appartiennent...\nEt les vôtres ne font pas exception!"
  },
  {
    "RowOffset": 552270,
    "RowId": 26409,
    "Text": "Je contrôle toute ombre qui soit!"
  },
  {
    "RowOffset": 552322,
    "RowId": 26410,
    "Text": "C'est la fin de notre aventure. Adieu, mes chers compagnons..."
  },
