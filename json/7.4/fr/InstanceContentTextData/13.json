[
  {
    "RowOffset": 544794,
    "RowId": 25941,
    "Text": "Eh ben... Elle se défend bien... Faites attention à ne pas vous faire aspirer!"
  },
  {
    "RowOffset": 544890,
    "RowId": 25942,
    "Text": "Elle s'est cachée! Trouvez-la rapidement avant qu'elle n'ait fini de préparer son attaque!"
  },
  {
    "RowOffset": 545002,
    "RowId": 25943,
    "Text": "Bien, moi je vais vous observer d'ici..."
  },
  {
    "RowOffset": 545054,
    "RowId": 25944,
    "Text": ""
  },
  {
    "RowOffset": 545066,
    "RowId": 25945,
    "Text": ""
  },
  {
    "RowOffset": 545078,
    "RowId": 26000,
    "Text": "Je suis le seul à même de la protéger..."
  },
  {
    "RowOffset": 545134,
    "RowId": 26001,
    "Text": "Que la Lumière vous purge de vos péchés!"
  },
  {
    "RowOffset": 545194,
    "RowId": 26002,
    "Text": "Voyons un peu ce que vous valez... En garde!"
  },
  {
    "RowOffset": 545254,
    "RowId": 26003,
    "Text": "Voyons voir ce que vous dites de ça."
  },
  {
    "RowOffset": 545302,
    "RowId": 26004,
    "Text": "Ce petit jeu a assez duré..."
  },
  {
    "RowOffset": 545342,
    "RowId": 26005,
    "Text": "J'ai juré de la protéger..."
  },
  {
    "RowOffset": 545382,
    "RowId": 26006,
    "Text": "C'est ça, mon image de l'être ultime...!?"
  },
  {
    "RowOffset": 545442,
    "RowId": 26007,
    "Text": "Cette créature contrôle l'élément des cartouches...?"
  },
  {
    "RowOffset": 545514,
    "RowId": 26008,
    "Text": "La Lumière est trop forte... Où est-il?"
  },
  {
    "RowOffset": 545570,
    "RowId": 26009,
    "Text": "Je sens l'éther s'intensifier dans ces cercles!"
  },
  {
    "RowOffset": 545634,
    "RowId": 26010,
    "Text": "La cartouche est chargée de Lumière!"
  },
  {
    "RowOffset": 545690,
    "RowId": 26011,
    "Text": "C'est... la multi-taillade de Gaïa...!?"
  },
  {
    "RowOffset": 545746,
    "RowId": 26012,
    "Text": "Pas question d'abandonner maintenant!"
  },
  {
    "RowOffset": 545798,
    "RowId": 26013,
    "Text": "Vaincre le Sabreur de destins"
  },
  {
    "RowOffset": 545838,
    "RowId": 26014,
    "Text": "Goûtez à ma véritable puissance!"
  },
  {
    "RowOffset": 545890,
    "RowId": 26015,
    "Text": "Non... Elle a encore besoin de moi..."
  },
  {
    "RowOffset": 545938,
    "RowId": 26016,
    "Text": ""
  },
  {
    "RowOffset": 545950,
    "RowId": 26017,
    "Text": ""
  },
  {
    "RowOffset": 545962,
    "RowId": 26018,
    "Text": ""
  },
  {
    "RowOffset": 545974,
    "RowId": 26019,
    "Text": ""
  },
  {
    "RowOffset": 545986,
    "RowId": 26020,
    "Text": ""
  },
  {
    "RowOffset": 545998,
    "RowId": 26100,
    "Text": "Vaincre le Nuage de Ténèbres"
  },
  {
    "RowOffset": 546042,
    "RowId": 26101,
    "Text": "La Lumière ne peut nous atteindre!"
  },
  {
    "RowOffset": 546094,
    "RowId": 26102,
    "Text": "Le monde entier sera englouti dans notre ombre!"
  },
  {
    "RowOffset": 546158,
    "RowId": 26103,
    "Text": "Que le pouvoir des Ténèbres jaillisse en une forêt obscure!"
  },
  {
    "RowOffset": 546238,
    "RowId": 26104,
    "Text": "Disparaissez dans les entrailles du néant!"
  },
  {
    "RowOffset": 546298,
    "RowId": 26105,
    "Text": "Vous raccrocher les uns aux autres ne fera qu'entraîner votre perte!"
  },
  {
    "RowOffset": 546382,
    "RowId": 26106,
    "Text": "Avec les Ténèbres vient l'équilibre, avec l'équilibre vient la vie!"
  },
  {
    "RowOffset": 546470,
    "RowId": 26107,
    "Text": "Ce qui vient du néant retourne au néant!"
  },
  {
    "RowOffset": 546530,
    "RowId": 26108,
    "Text": "Espoir, désespoir... Nous nous en nourrissons!"
  },
  {
    "RowOffset": 546594,
    "RowId": 26109,
    "Text": "Que les Ténèbres se déchaînent!"
  },
  {
    "RowOffset": 546646,
    "RowId": 26200,
    "Text": "Tu seras mon modèle. Je te rendrai coup pour coup, sort pour sort."
  },
  {
    "RowOffset": 546726,
    "RowId": 26201,
    "Text": "Tu refuses d'agir? Qu'à cela ne tienne, j'ai d'autres imitations en réserve."
  },
  {
    "RowOffset": 546822,
    "RowId": 26202,
    "Text": ""
  },
  {
    "RowOffset": 546834,
    "RowId": 26203,
    "Text": "Imbécile, ne te contente pas de <If(PlayerParameter(4))>la<Else/>le</If> copier! Tous les coups sont permis!"
  },
  {
    "RowOffset": 546938,
    "RowId": 26204,
    "Text": "D'accord... Je vais me battre comme vous le feriez, sans honneur ni humanité."
  },
  {
    "RowOffset": 547030,
    "RowId": 26205,
    "Text": "Règle d'or du mime: toujours suivre son modèle. Je combattrai la magie par la magie!"
  },
  {
    "RowOffset": 547138,
    "RowId": 26206,
    "Text": "Je t'ai prévenu, Bleuet masqué... Si tu me frappes, je te frappe!"
  },
  {
    "RowOffset": 547222,
    "RowId": 26207,
    "Text": ""
  },
