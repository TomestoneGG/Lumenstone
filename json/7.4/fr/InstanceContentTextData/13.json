  },
  {
    "RowOffset": 559074,
    "RowId": 26771,
    "Text": "6E6F7■73206E■■2066616973696F■E732071■527756E"
  },
  {
    "RowOffset": 559142,
    "RowId": 26772,
    "Text": "Pour l'ouvrir, vous devez infiltrer le réseau ennemi et éliminer l'entité qui la bloque."
  },
  {
    "RowOffset": 559246,
    "RowId": 26773,
    "Text": ""
  },
  {
    "RowOffset": 559258,
