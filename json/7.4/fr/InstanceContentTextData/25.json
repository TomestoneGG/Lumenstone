    "Text": ""
  },
  {
    "RowOffset": 827790,
    "RowId": 37900,
    "Text": "Vaincre Ifrit enflammé"
  },
  {
    "RowOffset": 827826,
    "RowId": 37901,
    "Text": "À l'attaque, <split(<String>ObjectParameter(1)</String>, ,1)>!"
  },
  {
    "RowOffset": 827874,
    "RowId": 37902,
    "Text": "Prenez garde, ses flammes sont de plus en plus ardentes!"
  },
  {
    "RowOffset": 827946,
    "RowId": 37903,
    "Text": "Argh! Je ne peux plus... bouger...!"
  },
  {
    "RowOffset": 828002,
    "RowId": 37904,
    "Text": "J'ai besoin de vous, <split(<String>ObjectParameter(1)</String>, ,1)>! Essayez de gagner du temps!"
  },
  {
    "RowOffset": 828090,
    "RowId": 37905,
    "Text": "On y est presque! OUUUAAARRRGH!"
  },
  {
    "RowOffset": 828142,
    "RowId": 37906,
    "Text": "Merci, c'était moins une!"
  },
  {
    "RowOffset": 828186,
    "RowId": 37907,
    "Text": "Attention, il prépare un coup fourré!"
  },
  {
    "RowOffset": 828242,
    "RowId": 37908,
    "Text": "すべてを潰すつもりか！？\nあのまま、振り下ろさせるわけには……！"
  },
  {
    "RowOffset": 828350,
    "RowId": 37909,
    "Text": "Tu ne l'emporteras pas au paradis, Ifrit!"
  },
  {
    "RowOffset": 828406,
    "RowId": 37910,
    "Text": "<split(<String>ObjectParameter(1)</String>, ,1)>! Est-ce que ça va?"
  },
  {
    "RowOffset": 828462,
    "RowId": 37911,
    "Text": "Détruisons ces épées avant qu'il n'absorbe toute leur puissance!"
  },
  {
    "RowOffset": 828546,
    "RowId": 37912,
    "Text": "C'est le moment ou jamais! Rouez-le de coups!"
  },
  {
    "RowOffset": 828610,
    "RowId": 37913,
    "Text": "Observez bien ses mouvements avant de tenter une esquive!"
  },
  {
    "RowOffset": 828682,
    "RowId": 37914,
    "Text": "Bien joué! Et maintenant, la contre-attaque!"
  },
  {
    "RowOffset": 828746,
    "RowId": 37915,
    "Text": "<split(<String>ObjectParameter(1)</String>, ,1)>... NOOOON!!"
  },
  {
    "RowOffset": 828790,
    "RowId": 37916,
    "Text": "C'est la fin... de mon voyage..."
  },
  {
    "RowOffset": 828834,
    "RowId": 37917,
    "Text": "Seul le pouvoir de Phénix nous permettra de résister à un tel assaut!"
  },
  {
    "RowOffset": 828922,
    "RowId": 37918,
    "Text": "Encore un effort, <split(<String>ObjectParameter(1)</String>, ,1)>, et il n'en restera bientôt plus que de la poussière!"
  },
