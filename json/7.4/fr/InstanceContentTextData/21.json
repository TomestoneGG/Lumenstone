  {
    "RowOffset": 741530,
    "RowId": 35900,
    "Text": "Démarrage du système de sonde mémorielle...\nMon nom est Tiamat, protectrice de Méracydia!"
  },
  {
    "RowOffset": 741642,
    "RowId": 35901,
    "Text": "Dansez, mes chers enfants!\nFestoyez des entrailles de ceux qui menacent notre terre!"
  },
  {
    "RowOffset": 741750,
    "RowId": 35902,
    "Text": "Vils envahisseurs! Préparez-vous à goûter à la colère de Tiamat!"
  },
  {
    "RowOffset": 741838,
    "RowId": 35903,
    "Text": "Périssez dans le tumulte de mes flammes obscures!"
  },
  {
    "RowOffset": 741906,
    "RowId": 35904,
    "Text": "Subissez la fureur de la mère des dragons de Méracydia!"
  },
