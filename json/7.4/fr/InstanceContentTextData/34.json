  {
    "RowOffset": 1000846,
    "RowId": 43000,
    "Text": "Sacs brillants ramassés"
  },
  {
    "RowOffset": 1000882,
    "RowId": 43100,
    "Text": "Franchir la grotte de Kwane"
  },
  {
    "RowOffset": 1000922,
    "RowId": 43101,
    "Text": "Vaincre le catoblépas de Tréno"
  },
  {
    "RowOffset": 1000966,
    "RowId": 43102,
    "Text": "Franchir la plaine de Tréno"
  },
  {
    "RowOffset": 1001006,
    "RowId": 43103,
    "Text": "Vaincre Amdusias"
  },
  {
    "RowOffset": 1001034,
    "RowId": 43104,
    "Text": "Franchir le centre-ville de Tréno"
  },
  {
    "RowOffset": 1001082,
    "RowId": 43105,
    "Text": "Vaincre le griffon de foudre"
  },
  {
    "RowOffset": 1001122,
    "RowId": 43106,
    "Text": "Nom d'une buse, ils arrivent de tous les côtés... mais nous protégerons notre cité bien-aimée jusqu'au bout!"
  },
  {
    "RowOffset": 1001250,
    "RowId": 43107,
    "Text": "Q-qui êtes-vous!? Des voyageurs? Peu importe, on a pas le temps de discuter! Essayez de secourir la population réfugiée à l'hôtel de ville!"
  },
  {
    "RowOffset": 1001422,
    "RowId": 43300,
    "Text": "Un enterrement en prévision? Très bien, je me ferai l'ange du sommeil!"
  },
  {
    "RowOffset": 1001514,
    "RowId": 43400,
    "Text": "À vous de jouer, chers invités!"
  },
  {
    "RowOffset": 1001562,
    "RowId": 43401,
    "Text": "Aaah! Il a fait sauter un wagon!"
  },
  {
    "RowOffset": 1001614,
    "RowId": 43402,
    "Text": "Oh non, des tourelles!? Je compte sur vous!"
  },
  {
    "RowOffset": 1001678,
    "RowId": 43403,
    "Text": "Un autre wagon en moins... Rien de cassé?"
  },
  {
    "RowOffset": 1001738,
    "RowId": 43404,
    "Text": "Utilisez les plateformes pour vous déplacer!"
  },
  {
    "RowOffset": 1001798,
    "RowId": 43405,
    "Text": "Mais il va en détruire combien comme ça!?"
  },
  {
    "RowOffset": 1001858,
    "RowId": 43406,
    "Text": "Ça va? Vous tenez le coup?"
  },
  {
    "RowOffset": 1001906,
    "RowId": 43407,
    "Text": "Qu'est-ce que... Des bras d'éther!?"
  },
  {
    "RowOffset": 1001958,
    "RowId": 43408,
    "Text": "Il faut abandonner ce wagon! Sautez vite sur le suivant!"
  },
  {
    "RowOffset": 1002034,
    "RowId": 43409,
    "Text": "Meeerde, il est vraiment pas content!"
  },
  {
    "RowOffset": 1002086,
    "RowId": 43410,
    "Text": "Aaah! Il nous en veut, ça c'est sûr!"
  },
  {
    "RowOffset": 1002146,
    "RowId": 43411,
    "Text": "Attention, ça risque de faire mal!"
  },
  {
    "RowOffset": 1002198,
    "RowId": 43412,
    "Text": "Plus nulle part où fuir... C'est chaud là!"
  },
  {
    "RowOffset": 1002258,
    "RowId": 43413,
    "Text": "Tout ça va mal finir!!"
  },
  {
    "RowOffset": 1002298,
    "RowId": 43414,
    "Text": "Il lâche jamais l'affaire ou quoi!?"
  },
  {
    "RowOffset": 1002350,
    "RowId": 43500,
    "Text": "Vaincre Vamp Fatale"
  },
  {
    "RowOffset": 1002382,
    "RowId": 43501,
    "Text": "Hahaha... J'ai hâte de goûter à tes larmes!"
  },
  {
    "RowOffset": 1002446,
    "RowId": 43502,
    "Text": "La première combattante de la catégorie poids lourds est Vamp Fatale!"
  },
  {
    "RowOffset": 1002534,
    "RowId": 43503,
    "Text": "Le challenger saura-t-il résister à son charme ravageur?"
  },
  {
    "RowOffset": 1002610,
    "RowId": 43504,
    "Text": "À moi, mes fidèles serviteurs!"
  },
  {
    "RowOffset": 1002658,
    "RowId": 43505,
    "Text": "Le spectacle va commencer! Tu vas hurler de plaisir, je te le promets."
  },
  {
    "RowOffset": 1002746,
    "RowId": 43506,
    "Text": "C'est parti! Vamp Fatale entame sa danse macabre!"
  },
  {
    "RowOffset": 1002814,
    "RowId": 43507,
    "Text": "Bientôt tu ne seras plus qu'une tâche de plus sur mon ring!"
  },
  {
    "RowOffset": 1002890,
    "RowId": 43508,
    "Text": "Notre challenger n'a plus aucune échappatoire!"
  },
  {
    "RowOffset": 1002954,
    "RowId": 43509,
    "Text": "Je commence à peine à m'amuser... Allez, mes chéris, donnez-moi votre éther!"
  },
  {
    "RowOffset": 1003050,
    "RowId": 43510,
    "Text": "Vamp Fatale aspire l'éther de son public en délire!"
  },
  {
    "RowOffset": 1003118,
    "RowId": 43511,
    "Text": "Vous allez tous me nourrir!"
  },
  {
    "RowOffset": 1003162,
    "RowId": 43512,
    "Text": "Admirez ce déferlement éthéré! Notre vampire asseoit sa domination!"
  },
  {
    "RowOffset": 1003254,
    "RowId": 43513,
    "Text": "Tu as la peau dure... Mais je veux bien te pardonner si tu te mets à genoux!"
  },
  {
    "RowOffset": 1003346,
    "RowId": 43514,
    "Text": "La danse macabre reprend de plus belle! Le challenger saura-t-il y échapper?"
  },
  {
    "RowOffset": 1003442,
    "RowId": 43515,
    "Text": "Vamp Fatale lance une véritable pluie mortelle!"
  },
  {
    "RowOffset": 1003506,
    "RowId": 43516,
    "Text": "Quelle insolence! Il me faut plus d'éther!"
  },
  {
    "RowOffset": 1003570,
    "RowId": 43517,
    "Text": "Vamp Fatale suce à nouveau l'éther des spectateurs! J'espère que vous tenez le coup dans les gradins!"
  },
  {
    "RowOffset": 1003694,
    "RowId": 43518,
    "Text": "Je vais te faire découvrir le paroxysme de la souffrance!"
  },
  {
    "RowOffset": 1003770,
    "RowId": 43519,
    "Text": "C'est un nouveau déluge d'éther? Comment y échapper cette fois?"
  },
  {
    "RowOffset": 1003858,
    "RowId": 43520,
    "Text": "Tu ne m'échapperas pas!"
  },
  {
    "RowOffset": 1003898,
    "RowId": 43521,
    "Text": "Encore... Il m'en faut toujours plus! Donnez-moi tout votre éther!"
  },
  {
    "RowOffset": 1003986,
    "RowId": 43522,
    "Text": "Vamp Fatale s'abreuve encore une fois d'éther... et votre serviteur... commence à avoir le vertige..."
  },
  {
    "RowOffset": 1004102,
    "RowId": 43523,
    "Text": "Tu auras beau me supplier... Je n'aurai aucune pitié!"
  },
  {
    "RowOffset": 1004174,
    "RowId": 43524,
    "Text": "Attention! Le challenger se fait siphonner son éther!"
  },
  {
    "RowOffset": 1004250,
    "RowId": 43525,
    "Text": "Assez! Tu vas obéir, oui? Prosterne-toi!"
  },
