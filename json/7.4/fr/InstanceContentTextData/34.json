  },
  {
    "RowOffset": 991038,
    "RowId": 42700,
    "Text": "Faim... Faim...!"
  },
  {
    "RowOffset": 991070,
    "RowId": 42701,
    "Text": "Germes... Pousses...!"
  },
  {
    "RowOffset": 991106,
    "RowId": 42702,
    "Text": "Fleurs... Floraison...!"
  },
  {
    "RowOffset": 991146,
    "RowId": 42703,
    "Text": "Faim... Pas flétrir... Pas flétrir...!"
  },
  {
    "RowOffset": 991202,
    "RowId": 42704,
    "Text": "Germes... Pousses... Encore... Encore...!"
  },
