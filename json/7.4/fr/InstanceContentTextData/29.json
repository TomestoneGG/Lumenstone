  },
  {
    "RowOffset": 906190,
    "RowId": 40200,
    "Text": "Vaincre Brute Bomber"
  },
  {
    "RowOffset": 906222,
    "RowId": 40201,
    "Text": "Je vais vous balayer avec le pouvoir de mon roi bombo!"
  },
  {
    "RowOffset": 906294,
    "RowId": 40202,
    "Text": "Oh là là! Brute Bomber est d'une humeur explosive!"
  },
  {
    "RowOffset": 906366,
    "RowId": 40203,
    "Text": "Gah! Ce “petit remontant” va me faire du bien!"
  },
  {
    "RowOffset": 906438,
    "RowId": 40204,
    "Text": "Acte de dopage détecté! Disqualification du combattant en cours..."
  },
  {
    "RowOffset": 906522,
    "RowId": 40205,
    "Text": "Ta gueule, toi! Tu vas voir si tu peux me disqualifier!"
  },
  {
    "RowOffset": 906598,
    "RowId": 40206,
    "Text": "Brute Bomber s'en prend à l'arbitre! Il n'a donc de respect pour rien ni personne!?"
  },
  {
    "RowOffset": 906702,
    "RowId": 40207,
    "Text": "Bouahaha! Comme ça, y a plus personne pour m'emmerder!"
  },
  {
    "RowOffset": 906778,
    "RowId": 40208,
    "Text": "Le petit remontant suffit pas! Y me faut quelque chose de plus efficace!"
  },
  {
    "RowOffset": 906870,
    "RowId": 40209,
    "Text": "Ouaaah! Brute Bomber devient de plus en plus imposant!"
  },
  {
    "RowOffset": 906946,
    "RowId": 40210,
    "Text": "Raaah! Y me faut encore autre chose! Essayons un peu ça!"
  },
  {
    "RowOffset": 907026,
    "RowId": 40211,
    "Text": "Incroyable! Brute Bomber se moque clairement des règles de la compétition!"
  },
  {
    "RowOffset": 907122,
    "RowId": 40212,
    "Text": "Tiens, tu m'en diras des nouvelles!"
  },
  {
    "RowOffset": 907174,
    "RowId": 40213,
    "Text": "Regardez bien! Brute Bomber nous prépare une technique spéciale!"
  },
  {
    "RowOffset": 907262,
    "RowId": 40214,
    "Text": "Je vais vous donner en pâture à mes bombos!"
  },
  {
    "RowOffset": 907322,
    "RowId": 40215,
    "Text": "Voilà de quoi provoquer une grosse explosion!"
  },
  {
    "RowOffset": 907386,
    "RowId": 40216,
    "Text": "Toutes ces mèches constituent un véritable enfer explosif! Ça risque bien de péter!"
  },
  {
    "RowOffset": 907494,
    "RowId": 40217,
    "Text": "Les règles, c'est moi qui les décide!"
  },
  {
    "RowOffset": 907550,
    "RowId": 40218,
    "Text": "La chaîne de la mort! Impossible d'échapper à Brute Bomber quand il vous attrape!"
  },
  {
    "RowOffset": 907654,
    "RowId": 40219,
    "Text": "Hors de question que je perde ce match!"
  },
  {
    "RowOffset": 907710,
    "RowId": 40220,
    "Text": "Brute Bomber est désespéré! Il est prêt à tout pour gagner!"
  },
  {
    "RowOffset": 907794,
    "RowId": 40221,
    "Text": "Je vais vous pulvériser une bonne fois pour toutes!"
