    "Text": ""
  },
  {
    "RowOffset": 911866,
    "RowId": 40400,
    "Text": "L'issue de cette bataille prouvera que je suis le seul à mériter le titre d'Aurarque!"
  },
  {
    "RowOffset": 911970,
    "RowId": 40401,
    "Text": "J'absorberai tout l'éther qu'il faudra... pour vous détruire!"
  },
  {
    "RowOffset": 912050,
    "RowId": 40402,
    "Text": "Aaargh... Uuurgh... Graaah...!"
  },
  {
    "RowOffset": 912098,
    "RowId": 40403,
    "Text": "C'est pas assez... Il m'en faut toujours plus!"
  },
  {
    "RowOffset": 912162,
    "RowId": 40404,
    "Text": "Pourquoi ces visions!? Pourquoi maintenant!?"
  },
  {
    "RowOffset": 912226,
    "RowId": 40405,
    "Text": "Hors de ma vue, misérables!"
  },
  {
    "RowOffset": 912270,
    "RowId": 40406,
    "Text": "Je ne vous laisserai pas m'affaiblir!"
  },
  {
    "RowOffset": 912322,
    "RowId": 40407,
    "Text": "Fini de jouer!"
  },
  {
    "RowOffset": 912354,
    "RowId": 40408,
    "Text": "Je surpasserai toutes les limites humaines!"
  },
  {
    "RowOffset": 912414,
    "RowId": 40409,
    "Text": "Dégagez!! Je ne suis plus cet être faible que vous avez connu!"
  },
  {
    "RowOffset": 912498,
    "RowId": 40410,
    "Text": "GRRRRRAAAAAAAAH!!!"
  },
  {
    "RowOffset": 912534,
    "RowId": 40411,
    "Text": "Allez-vous-en... et ne revenez jamais...!"
  },
  {
    "RowOffset": 912590,
    "RowId": 40412,
    "Text": "Moi seul suis digne du trône!"
  },
  {
    "RowOffset": 912638,
    "RowId": 40413,
    "Text": "L'enfant prodige n'existe pas!"
  },
  {
    "RowOffset": 912686,
    "RowId": 40414,
    "Text": "Personne n'est à ma hauteur! Personne!!"
  },
  {
    "RowOffset": 912746,
    "RowId": 40415,
    "Text": ""
  },
  {
    "RowOffset": 912758,
    "RowId": 40416,
    "Text": "Tel est mon chemin... Celui que j'ai choisi!"
  },
  {
    "RowOffset": 912818,
    "RowId": 40417,
    "Text": ""
  },
  {
    "RowOffset": 912830,
    "RowId": 40418,
    "Text": "Ha ha ha ha!! La voilà enfin, cette puissance ultime!"
  },
  {
    "RowOffset": 912906,
    "RowId": 40419,
    "Text": "Je vais vous montrer que je suis l'aurarque absolu!"
  },
  {
    "RowOffset": 912974,
    "RowId": 40420,
    "Text": "Le monde entier devra se plier à ma volonté!"
  },
  {
    "RowOffset": 913038,
    "RowId": 40421,
    "Text": "Résonne en moi, ô monde!"
  },
  {
    "RowOffset": 913082,
    "RowId": 40422,
    "Text": "Je suis le créateur et le destructeur du monde! Je suis... le grand tout!!"
  },
  {
    "RowOffset": 913178,
    "RowId": 40423,
    "Text": "Le pouvoir de dominer toute chose et tout être... Ça me va comme un gant!"
  },
