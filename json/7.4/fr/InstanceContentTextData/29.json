  },
  {
    "RowOffset": 908798,
    "RowId": 40300,
    "Text": "N'y vois rien de perrrsonnel, mais je veux ton âme!"
  },
  {
    "RowOffset": 908866,
    "RowId": 40301,
    "Text": "Je vais te montrrrer ce qu'on peut faire avec l'électrope!"
  },
  {
    "RowOffset": 908942,
    "RowId": 40302,
    "Text": "Pour voler, il suffit de se fairrre pousser des ailes!"
  },
  {
    "RowOffset": 909014,
    "RowId": 40303,
    "Text": "Encaisse ça!"
  },
  {
    "RowOffset": 909042,
    "RowId": 40304,
    "Text": "Je vais te dégommer!"
  },
  {
    "RowOffset": 909078,
    "RowId": 40305,
    "Text": "Voilà une autre prrropriété de l'électrope!"
  },
  {
    "RowOffset": 909142,
    "RowId": 40306,
    "Text": "On ne peut pas échapper à la foudrrre!"
  },
  {
    "RowOffset": 909198,
    "RowId": 40307,
    "Text": "Prrrends ça!"
  },
  {
    "RowOffset": 909226,
    "RowId": 40308,
    "Text": "Tu m'en dirrras des nouvelles!"
  },
  {
    "RowOffset": 909274,
    "RowId": 40309,
    "Text": "Wicked Thunder fait son grand retour sur le ring!"
  },
  {
    "RowOffset": 909338,
    "RowId": 40310,
    "Text": "L'électrope est devenu un immense canon! Preuve que Wicked Thunder est toujours aussi dangereuse!"
  },
  {
    "RowOffset": 909458,
    "RowId": 40311,
    "Text": "Et voilà qu'il lui pousse des ailes! Quelle vision angélique!"
  },
  {
    "RowOffset": 909542,
    "RowId": 40312,
    "Text": "N'espère pas pouvoir me vaincrrre!"
  },
  {
    "RowOffset": 909594,
    "RowId": 40313,
    "Text": "Disparrraaais!"
  },
  {
    "RowOffset": 909626,
    "RowId": 40314,
    "Text": "Il me faut absolument cette âme..."
  },
  {
    "RowOffset": 909674,
    "RowId": 40315,
    "Text": "Non... Je ne dois pas mourirrr..."
  },
  {
    "RowOffset": 909718,
    "RowId": 40316,
    "Text": "À moi... le pouvoirrr de l'électrope..."
  },
  {
    "RowOffset": 909770,
    "RowId": 40317,
    "Text": "Ouaaarrrgh!"
  },
  {
    "RowOffset": 909798,
    "RowId": 40318,
    "Text": "Je dois gagner... coûte que coûte!"
  },
  {
    "RowOffset": 909850,
    "RowId": 40319,
    "Text": "Et pour ça... mon corrrps doit tenir le coup!"
  },
  {
    "RowOffset": 909914,
    "RowId": 40320,
    "Text": "Eurrrgh!"
  },
  {
    "RowOffset": 909938,
    "RowId": 40321,
    "Text": "Bien, il est temps de passer aux choses sérrrieuses!"
  },
  {
    "RowOffset": 910006,
    "RowId": 40322,
    "Text": "Mais que se passe-t-il!? Wicked Thunder rejette une grande quantité d'éther!"
  },
  {
    "RowOffset": 910106,
    "RowId": 40323,
    "Text": "Quelque chose vient de surgir du corps de Wicked Thunder! De quoi s'agit-il!?"
  },
  {
    "RowOffset": 910202,
    "RowId": 40324,
    "Text": "L'électrope a pénétré dans son corps! Elle se serait injecté l'âme d'une nouvelle créature!?"
  },
  {
    "RowOffset": 910322,
    "RowId": 40325,
    "Text": "Que ma lame danse et tranche les chairrrs!"
  },
  {
    "RowOffset": 910382,
    "RowId": 40326,
    "Text": "Ce trrranchant enflammé va tout réduire en cendres!"
  },
  {
    "RowOffset": 910450,
    "RowId": 40327,
    "Text": "L'électrope peut même modifier la nature de l'étherrr!"
  },
  {
    "RowOffset": 910522,
    "RowId": 40328,
    "Text": "Que s'abatte une pluie d'épées!"
  },
  {
    "RowOffset": 910570,
    "RowId": 40329,
    "Text": "C'en est fini de toi! Ton âme m'apparrrtient!"
  },
  {
    "RowOffset": 910646,
    "RowId": 40330,
    "Text": "Yaaah!"
  },
  {
    "RowOffset": 910670,
    "RowId": 40331,
    "Text": "Tu vas mourirrr!"
  },
  {
    "RowOffset": 910702,
    "RowId": 40332,
    "Text": "Rien ne me rrrésiste!"
  },
  {
    "RowOffset": 910742,
    "RowId": 40333,
    "Text": "Mais pourrrquoi!? Personne ne m'a jamais autant résisté..."
  },
  {
    "RowOffset": 910818,
    "RowId": 40334,
    "Text": "Wicked Thunder accumule de l'éther! Qu'est-ce qu'elle manigance!?"
  },
  {
    "RowOffset": 910906,
    "RowId": 40335,
    "Text": "Serait-elle en train de changer l'affinité élémentaire de son corps avec l'électrope!?"
  },
  {
    "RowOffset": 911014,
    "RowId": 40336,
    "Text": "Impossible de détourner les yeux de ce combat palpitant!"
  },
  {
    "RowOffset": 911086,
    "RowId": 40337,
    "Text": "Vaincre Wicked Thunder"
  },
