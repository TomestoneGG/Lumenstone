  },
  {
    "RowOffset": 889466,
    "RowId": 39800,
    "Text": "Bienvenue et adieu!"
  },
  {
    "RowOffset": 889502,
    "RowId": 39801,
    "Text": "Êtes-vous vivants?"
  },
  {
    "RowOffset": 889538,
    "RowId": 39802,
    "Text": "Êtes-vous heureux?"
  },
  {
    "RowOffset": 889574,
    "RowId": 39803,
    "Text": "Ensemble, surmontons la mort!"
  },
  {
    "RowOffset": 889618,
    "RowId": 39804,
    "Text": "Mon peuple a besoin de votre éther!"
  },
  {
    "RowOffset": 889670,
    "RowId": 39805,
    "Text": "N'ayez pas peur, la mort n'est pas une fin en soi!"
  },
  {
    "RowOffset": 889738,
    "RowId": 39806,
    "Text": "Admirez le lien entre les mondes!"
  },
  {
    "RowOffset": 889786,
    "RowId": 39807,
    "Text": "Déploiement des sous-unités!"
  },
  {
    "RowOffset": 889834,
    "RowId": 39808,
    "Text": "Êtes-vous toujours en vie? Activation de la puissance de réserve..."
  },
  {
    "RowOffset": 889918,
    "RowId": 39809,
    "Text": "Êtes-vous toujours en vie? Déverrouillage de la sécurité..."
  },
  {
    "RowOffset": 889998,
    "RowId": 39810,
    "Text": "Zone cible délimitée. Suppression de toute existence..."
  },
  {
    "RowOffset": 890066,
    "RowId": 39811,
    "Text": "Surcharge du système... Interruption de la procédure."
  },
  {
    "RowOffset": 890134,
    "RowId": 39812,
    "Text": "... Toujours en vie?...ne délimitée......eprise de la suppression..."
  },
  {
    "RowOffset": 890230,
    "RowId": 39813,
    "Text": "Surcharg... extrême... Erreur dé..."
  },
  {
    "RowOffset": 890278,
    "RowId": 39814,
    "Text": "Instruction...écution...rcée... con...ée."
  },
  {
    "RowOffset": 890342,
    "RowId": 39815,
    "Text": "Est-ce que c'est... une fissure dans l'espace? Le pouvoir est hors de contrôle?"
  },
  {
    "RowOffset": 890442,
    "RowId": 39816,
    "Text": "Sphene!!! Écoute-moi!!!"
  },
  {
    "RowOffset": 890486,
    "RowId": 39817,
    "Text": "Je comprends ta résolution...! Et je sais aussi que rien ne te fera fléchir."
  },
  {
    "RowOffset": 890582,
    "RowId": 39818,
    "Text": "S'il n'y a vraiment plus aucun moyen d'éviter la confrontation, alors..."
  },
  {
    "RowOffset": 890666,
    "RowId": 39819,
    "Text": "Ne m'affronte pas comme une machine. Fais-moi face avec tout ton cœur!!!"
  },
  {
    "RowOffset": 890754,
    "RowId": 39820,
    "Text": "L-Lamaty'i..."
  },
  {
    "RowOffset": 890778,
    "RowId": 39821,
    "Text": "Sphene!!!"
  },
  {
    "RowOffset": 890802,
    "RowId": 39822,
    "Text": "Anomalie détectée dans un bloc mémoire..."
  },
  {
    "RowOffset": 890858,
    "RowId": 39823,
    "Text": "Les données de l'Éternelle “Sphene” ont été partiellement restaurées."
  },
  {
    "RowOffset": 890950,
    "RowId": 39824,
    "Text": "C'est là mon vœu le plus cher... et je n'échouerai pas!"
  },
  {
    "RowOffset": 891026,
    "RowId": 39825,
    "Text": "Je ne perdrai plus jamais qui que ce soit!"
  },
  {
    "RowOffset": 891086,
    "RowId": 39826,
    "Text": "Je comprends ta douleur... Je la ressens comme si c'était la mienne!"
  },
  {
    "RowOffset": 891170,
    "RowId": 39827,
    "Text": "Pour la première fois, j'ai l'impression de te connaître <i>vraiment!</i>"
  },
  {
    "RowOffset": 891266,
    "RowId": 39828,
    "Text": "Tu n'as pas le droit de me dire ça maintenant...!"
  },
  {
    "RowOffset": 891334,
    "RowId": 39829,
    "Text": "Cette fois, c'est fini, Sphene. Tous ensemble, on va t'arrêter!"
  },
  {
    "RowOffset": 891414,
    "RowId": 39830,
    "Text": "Non... Je n'abandonnerai jamais!"
  },
  {
    "RowOffset": 891474,
    "RowId": 39831,
    "Text": "Je protégerai le sourire des miens, comme j'en ai fait le serment!"
  },
  {
    "RowOffset": 891558,
    "RowId": 39832,
    "Text": "Ce fardeau t'accable depuis trop longtemps déjà..."
  },
  {
    "RowOffset": 891622,
    "RowId": 39833,
    "Text": "Laisse-nous t'en libérer une bonne fois pour toutes!"
  },
  {
    "RowOffset": 891690,
    "RowId": 39834,
    "Text": "5 secondes avant Autorité absolue..."
  },
  {
    "RowOffset": 891738,
    "RowId": 39835,
    "Text": "4 secondes avant Autorité absolue..."
  },
  {
    "RowOffset": 891786,
    "RowId": 39836,
    "Text": "3 secondes avant Autorité absolue..."
  },
  {
    "RowOffset": 891834,
    "RowId": 39837,
    "Text": "2 secondes avant Autorité absolue..."
  },
  {
    "RowOffset": 891882,
    "RowId": 39838,
    "Text": "1 seconde avant Autorité absolue..."
