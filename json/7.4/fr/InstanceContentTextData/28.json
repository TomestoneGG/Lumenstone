  },
  {
    "RowOffset": 885142,
    "RowId": 39699,
    "Text": ""
  },
  {
    "RowOffset": 885154,
    "RowId": 39700,
    "Text": "Défendez Solution Neuf!"
  },
  {
    "RowOffset": 885194,
    "RowId": 39701,
    "Text": "Éliminez les sentinelles!"
  },
  {
    "RowOffset": 885238,
    "RowId": 39702,
    "Text": "Retrouvez les survivants!"
  },
  {
    "RowOffset": 885278,
    "RowId": 39703,
    "Text": "Éliminez les monstres!"
  },
  {
    "RowOffset": 885318,
    "RowId": 39704,
    "Text": "Dirigez-vous vers la place de l'Éthérite!"
  },
  {
    "RowOffset": 885378,
    "RowId": 39705,
    "Text": "Réconfortez les habitants!"
  },
  {
    "RowOffset": 885422,
    "RowId": 39706,
    "Text": "Éliminez les sentinelles!"
  },
  {
    "RowOffset": 885466,
    "RowId": 39707,
    "Text": "Repoussez les troupes ennemies!"
  },
  {
    "RowOffset": 885514,
    "RowId": 39708,
    "Text": "Épuisez Otis!"
  },
  {
    "RowOffset": 885546,
    "RowId": 39709,
    "Text": "Éliminez le monstre!"
  },
  {
    "RowOffset": 885582,
    "RowId": 39710,
    "Text": "Stoppez l'absorption d'éther!"
  },
  {
    "RowOffset": 885630,
    "RowId": 39711,
    "Text": "Éliminez le monstre tant qu'Otis tient debout!"
  },
  {
    "RowOffset": 885694,
    "RowId": 39712,
    "Text": "S'il vous plaît... prêtez-moi votre force!"
  },
  {
    "RowOffset": 885754,
    "RowId": 39713,
    "Text": "Je me charge de nous ouvrir le chemin! Ma qualité de souveraine de la Raison me le permet!"
  },
  {
    "RowOffset": 885866,
    "RowId": 39714,
    "Text": "Ça y est, nous pouvons passer! S'il vous plaît... secourez les survivants de votre mieux!"
  },
  {
    "RowOffset": 885978,
    "RowId": 39715,
    "Text": "On s'occupe de ceux-là d'abord!"
  },
  {
    "RowOffset": 886026,
    "RowId": 39716,
    "Text": ""
  },
  {
    "RowOffset": 886038,
    "RowId": 39717,
    "Text": "Plein de gens doivent encore être en vie! Dépêchons-nous de les mettre en sécurité!"
  },
  {
    "RowOffset": 886146,
    "RowId": 39718,
    "Text": "Laissez-moi faire! La tour répondra à mon appel!"
  },
  {
    "RowOffset": 886218,
    "RowId": 39719,
    "Text": "J'entends encore tellement de cris et de pleurs... Ça me fend le cœur..."
  },
  {
    "RowOffset": 886306,
    "RowId": 39720,
    "Text": "Voilà que Zoraal Ja nous envoie des monstres, maintenant!"
  },
  {
    "RowOffset": 886382,
    "RowId": 39721,
    "Text": "Reste plus que nous pour arrêter ce massacre!"
  },
  {
    "RowOffset": 886446,
    "RowId": 39722,
    "Text": "Des survivants... Quel soulagement!"
  },
  {
    "RowOffset": 886498,
    "RowId": 39723,
    "Text": "Je suis tellement navrée que vous souffriez ainsi par ma faute... Vous serez bientôt tous en sécurité, c'est promis!"
  },
  {
    "RowOffset": 886634,
    "RowId": 39724,
    "Text": ""
  },
  {
    "RowOffset": 886646,
    "RowId": 39725,
    "Text": "Fiers chevaliers du royaume d'Alexandrie... CHAAARGEEEZ!!"
  },
  {
    "RowOffset": 886718,
    "RowId": 39726,
    "Text": "Otis, réveille-toi! C'est nous, tes amis!"
  },
  {
    "RowOffset": 886782,
    "RowId": 39727,
    "Text": "En formation primaire! Montrez-leur toute notre puissance!"
  },
  {
    "RowOffset": 886862,
    "RowId": 39728,
    "Text": "Ces machines obéissent aveuglément à ses ordres!"
  },
  {
    "RowOffset": 886930,
    "RowId": 39729,
    "Text": "En formation secondaire! Couvrez-vous des lauriers de la victoire!"
  },
  {
    "RowOffset": 887018,
    "RowId": 39730,
    "Text": "Cette technique de combat... Je n'ose croire que ça puisse être..."
  },
  {
    "RowOffset": 887098,
    "RowId": 39731,
    "Text": "En formation tertiaire! À l'attaque, pour l'honneur d'Alexandrie!"
  },
  {
    "RowOffset": 887186,
    "RowId": 39732,
    "Text": "Ça sent le roussi! Préparez-vous à encaisser le choc!"
  },
  {
    "RowOffset": 887262,
    "RowId": 39733,
    "Text": "Ça alors... C'est vraiment lui? Le capitaine de ma garde royale!?"
  },
  {
    "RowOffset": 887350,
    "RowId": 39734,
    "Text": "Merde... Comment faire pour qu'Otis reprenne ses esprits?"
  },
  {
    "RowOffset": 887422,
    "RowId": 39735,
    "Text": "S'il a conservé en lui ne serait-ce que quelques souvenirs de moi..."
  },
  {
    "RowOffset": 887502,
    "RowId": 39736,
    "Text": ""
  },
  {
    "RowOffset": 887514,
    "RowId": 39737,
    "Text": "Votre Majesté... Je vous... protégerai..."
  },
  {
    "RowOffset": 887570,
    "RowId": 39738,
    "Text": "J'espère que vous saurez me pardonner ce petit contretemps!<Key>8205251</Key>Tant que cette vieille carcasse me le permettra, je me battrai à vos côtés!"
  },
  {
    "RowOffset": 887738,
    "RowId": 39739,
    "Text": "Quelle énergie incroyable... Faites très attention!"
  },
  {
    "RowOffset": 887806,
    "RowId": 39740,
    "Text": ""
  },
  {
    "RowOffset": 887818,
    "RowId": 39741,
    "Text": "Prenez garde, l'ennemi aspire l'énergie de foudre environnante!"
  },
  {
    "RowOffset": 887898,
    "RowId": 39742,
    "Text": "On se sépare pour être plus efficaces!"
  },
  {
    "RowOffset": 887954,
    "RowId": 39743,
    "Text": "Faites gaffe, ça risque de faire très mal!"
  },
  {
    "RowOffset": 888014,
    "RowId": 39744,
    "Text": "Ils sont tellement nombreux! Va falloir s'accrocher!"
  },
  {
    "RowOffset": 888086,
    "RowId": 39745,
    "Text": "Laissez-moi faire!<Key>8205255</Key>Admirez la botte secrète de la garde royale d'Alexandrie!"
  },
  {
    "RowOffset": 888190,
    "RowId": 39746,
    "Text": "Argh! Rassurez-vous, tous mes boulons sont en place!"
  },
  {
    "RowOffset": 888262,
    "RowId": 39747,
    "Text": "Cette énergie de foudre a l'air... foudroyante!"
  },
  {
    "RowOffset": 888326,
    "RowId": 39748,
    "Text": "Oh non... Si ça continue, on est cuits!"
  },
  {
    "RowOffset": 888382,
    "RowId": 39749,
    "Text": "Je vous défendrai coûte que coûte! Tel est le devoir d'un chevalier d'Alexandrie!"
  },
  {
    "RowOffset": 888486,
    "RowId": 39750,
    "Text": "À vous! Profitez de cette occasion pour faire virevolter votre arme!"
  },
  {
    "RowOffset": 888574,
    "RowId": 39751,
    "Text": "Arrête, Otis!! C'est trop risqué!!"
  },
  {
    "RowOffset": 888630,
    "RowId": 39752,
    "Text": "Non! Je n'ai pas le droit d'abandonner maintenant! Je me battrai jusqu'à mon dernier souffle!"
  },
  {
    "RowOffset": 888750,
    "RowId": 39753,
    "Text": "Otis, non...!!"
  },
  {
    "RowOffset": 888782,
    "RowId": 39754,
    "Text": "Votre Majesté... Dites-moi... que vous n'êtes pas... blessée..."
  },
  {
    "RowOffset": 888862,
    "RowId": 39755,
    "Text": "Admirez la botte secrète de la garde royale d'Alexandrie!"
  },
  {
