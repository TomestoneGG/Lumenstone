  {
    "RowOffset": 987826,
    "RowId": 42600,
    "Text": "Je n'ai pas le choix... Si je veux sauver mes patients, je dois mobiliser tous les moyens médicaux à ma disposition."
  },
  {
    "RowOffset": 987958,
    "RowId": 42601,
    "Text": "Activation des diffuseurs pharmaceutiques!"
  },
  {
    "RowOffset": 988018,
    "RowId": 42602,
    "Text": "Navré, mais je vais devoir utiliser un plus puissant produit. Aux grands maux les grands remèdes..."
  },
  {
    "RowOffset": 988130,
    "RowId": 42603,
    "Text": "Franchir l'étage inférieur"
  },
  {
    "RowOffset": 988170,
    "RowId": 42604,
    "Text": "Vaincre la mémoire d'un chef de clinique"
  },
  {
    "RowOffset": 988222,
    "RowId": 42605,
    "Text": "Franchir l'étage intermédiaire"
  },
  {
    "RowOffset": 988266,
    "RowId": 42606,
    "Text": "Vaincre les mémoires de bourreaux"
  },
  {
    "RowOffset": 988314,
    "RowId": 42607,
    "Text": "Franchir l'étage supérieur"
  },
  {
    "RowOffset": 988354,
    "RowId": 42608,
    "Text": "Vaincre Memoria populi"
  }
]