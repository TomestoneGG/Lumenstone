  },
  {
    "RowOffset": 979374,
    "RowId": 42400,
    "Text": "Vaincre Dancing Green"
  },
  {
    "RowOffset": 979406,
    "RowId": 42401,
    "Text": "Yeaaah! Que la fête commence!"
  },
  {
    "RowOffset": 979458,
    "RowId": 42402,
    "Text": "Et voici... Dancing Green!"
  },
  {
    "RowOffset": 979502,
    "RowId": 42403,
    "Text": "Peux-tu seulement me suivre?"
  },
  {
    "RowOffset": 979546,
    "RowId": 42404,
    "Text": "Dancing Green subjugue le public avec ses pas de danse endiablés!"
  },
  {
    "RowOffset": 979630,
    "RowId": 42405,
    "Text": "J'ai pas encore fini! Allez, on danse!"
  },
  {
    "RowOffset": 979690,
    "RowId": 42406,
    "Text": "Sur la piste, c'est moi le roi! Alors, t'as intérêt à te donner à fond!"
  },
  {
    "RowOffset": 979786,
    "RowId": 42407,
    "Text": "Tous les spots sont braqués sur moi!"
  },
  {
    "RowOffset": 979838,
    "RowId": 42408,
    "Text": "Dancing Green provoque son adversaire! Que va faire notre challenger?"
  },
  {
    "RowOffset": 979926,
    "RowId": 42409,
    "Text": "Laisse le groove guider tes pas!"
  },
  {
    "RowOffset": 979974,
    "RowId": 42410,
    "Text": "En piste, mes petits danseurs!"
  },
  {
    "RowOffset": 980022,
    "RowId": 42411,
    "Text": "C'est la fièvre de l'Arcadion! Essaye de suivre notre chorégraphie!"
  },
  {
    "RowOffset": 980110,
    "RowId": 42412,
    "Text": "Dancing Green est absolument frénétique! Attention à ne pas manquer ses mouvements!"
  },
  {
    "RowOffset": 980218,
    "RowId": 42413,
    "Text": "Balance-toi sur le rythme de nos pas!"
  },
  {
    "RowOffset": 980270,
    "RowId": 42414,
    "Text": "Et on termine en beauté!"
  },
  {
    "RowOffset": 980310,
    "RowId": 42415,
    "Text": "Parfait! T'as vraiment assuré!"
  },
  {
    "RowOffset": 980362,
    "RowId": 42416,
    "Text": "Wouh! Tu te débrouilles! Le public est en délire."
  },
  {
    "RowOffset": 980434,
    "RowId": 42417,
    "Text": "Hmpf! C'est tout? Va falloir t'améliorer."
  },
  {
    "RowOffset": 980498,
    "RowId": 42418,
    "Text": "Oh, hé, c'est une blague? T'as tué l'ambiance..."
  },
  {
    "RowOffset": 980566,
    "RowId": 42419,
    "Text": "Allez! Laisse le rythme t'entraîner jusqu'au bout de la nuit!"
  },
  {
    "RowOffset": 980650,
    "RowId": 42420,
    "Text": "On remet ça! Répète donc nos mouvements, si t'en es capable!"
  },
  {
    "RowOffset": 980734,
    "RowId": 42421,
    "Text": "Dancing Green fait encore monter la température! Il faut garder les yeux bien ouverts!"
  },
  {
    "RowOffset": 980842,
    "RowId": 42422,
    "Text": "Laisse-moi t'éblouir!"
  },
  {
    "RowOffset": 980882,
    "RowId": 42423,
    "Text": "À vous de jouer, mes mignons!"
  },
  {
    "RowOffset": 980930,
    "RowId": 42424,
    "Text": "Il est temps d'en finir! Allez!"
  },
  {
    "RowOffset": 980982,
    "RowId": 42425,
    "Text": "C'était génial! On se retrouve quand tu veux sur la piste de danse!"
  },
