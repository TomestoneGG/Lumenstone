  },
  {
    "RowOffset": 976202,
    "RowId": 42300,
    "Text": "Par cette épée, je jure de protéger Sa Majesté Sphene!"
  },
  {
    "RowOffset": 976278,
    "RowId": 42301,
    "Text": "Je t'en prie, cesse de bafouer mes précieux souvenirs de Zelenia!"
  },
  {
    "RowOffset": 976362,
    "RowId": 42302,
    "Text": "Prenez ça!"
  },
  {
    "RowOffset": 976390,
    "RowId": 42303,
    "Text": "Pas de pitié!"
  },
  {
    "RowOffset": 976422,
    "RowId": 42304,
    "Text": "Vils cancrelats!"
  },
  {
    "RowOffset": 976454,
    "RowId": 42305,
    "Text": "Votre sang souillera mon épée!"
  },
  {
    "RowOffset": 976502,
    "RowId": 42306,
    "Text": "Goûtez au fil de ma lame!"
  },
  {
    "RowOffset": 976546,
    "RowId": 42307,
    "Text": "Je vais vous dépecer!"
  },
  {
    "RowOffset": 976586,
    "RowId": 42308,
    "Text": "À moi, arcanes magiques!"
  },
  {
    "RowOffset": 976626,
    "RowId": 42309,
    "Text": "Soyez oblitérés!"
  },
  {
    "RowOffset": 976662,
    "RowId": 42310,
    "Text": "Je vous transpercerai!"
  },
  {
    "RowOffset": 976702,
    "RowId": 42311,
    "Text": "Tremblez face à ma technique sacrée!"
  },
  {
    "RowOffset": 976758,
    "RowId": 42312,
    "Text": "Soyez anéantis!"
  },
  {
    "RowOffset": 976790,
    "RowId": 42313,
    "Text": "Cette technique...! Tu dois l'esquiver!"
  },
  {
    "RowOffset": 976850,
    "RowId": 42314,
    "Text": "Que le tonnerre gronde!"
  },
  {
    "RowOffset": 976890,
    "RowId": 42315,
    "Text": "Je n'en crois pas mes yeux! Son style de combat a été reproduit à la perfection!"
  },
  {
    "RowOffset": 976994,
    "RowId": 42316,
    "Text": "Reste sur tes gardes, elle n'a pas encore montré son plein potentiel!"
  },
  {
    "RowOffset": 977082,
    "RowId": 42317,
    "Text": "Que ma lame soit infaillible!"
  },
  {
    "RowOffset": 977126,
    "RowId": 42318,
    "Text": "Soyez témoins de la vaillance qui anime la garde royale d'Alexandrie!"
  },
  {
    "RowOffset": 977214,
    "RowId": 42319,
    "Text": "Pliez sous le poids de mon serment!"
  },
  {
    "RowOffset": 977266,
    "RowId": 42320,
    "Text": "C'est une attaque puissante... Prépare-toi à l'endurer!"
  },
  {
    "RowOffset": 977338,
    "RowId": 42321,
    "Text": "Contemplez la véritable puissance de mon épée!"
  },
  {
    "RowOffset": 977402,
    "RowId": 42322,
    "Text": "Je ne vous laisserai pas une seconde de répit!"
  },
  {
    "RowOffset": 977466,
    "RowId": 42323,
    "Text": "Vos manigances s'arrêtent ici!"
  },
  {
    "RowOffset": 977514,
    "RowId": 42324,
    "Text": "Évitez donc ça!"
  },
  {
    "RowOffset": 977546,
    "RowId": 42325,
    "Text": "Éloigne-toi à tout prix de ses cercles arcaniques!"
  },
  {
    "RowOffset": 977614,
    "RowId": 42326,
    "Text": "Elle utilise ces symboles pour transmettre et amplifier ses sorts."
  },
  {
    "RowOffset": 977694,
    "RowId": 42327,
    "Text": "Elle va allier escrime et magie, prends garde!"
  },
  {
    "RowOffset": 977758,
    "RowId": 42328,
    "Text": "Incroyable! C'est la première fois que je vois quelqu'un rendre coup pour coup à Zelenia!"
  },
  {
    "RowOffset": 977870,
    "RowId": 42329,
    "Text": "Il faut trouver où se déplacer pour éviter ses cercles arcaniques!"
  },
  {
    "RowOffset": 977954,
    "RowId": 42330,
    "Text": "J'accomplirai mon devoir, même si je dois y laisser la vie!"
  },
  {
    "RowOffset": 978030,
    "RowId": 42331,
    "Text": "Quoi qu'il advienne, je ne faillirai pas!"
  },
  {
    "RowOffset": 978086,
    "RowId": 42332,
    "Text": "Vous êtes trop jeunes pour m'affronter!"
  },
  {
    "RowOffset": 978142,
    "RowId": 42333,
    "Text": "Vous allez regretter votre insolence..."
  },
  {
    "RowOffset": 978194,
    "RowId": 42334,
    "Text": "Assez joué, je n'ai plus le temps!"
  },
  {
    "RowOffset": 978246,
    "RowId": 42335,
    "Text": "Je détruirai tous les ennemis d'Alexandrie!"
  },
  {
    "RowOffset": 978306,
    "RowId": 42336,
    "Text": "J'ai juré de défendre Sa Majesté Sphene, quoi qu'il m'en coûte!"
  },
  {
    "RowOffset": 978390,
    "RowId": 42337,
    "Text": "C'est vrai... Aussi loin que je m'en souvienne, Zelenia a toujours été là pour moi..."
  },
  {
    "RowOffset": 978490,
    "RowId": 42338,
    "Text": "Je... Je sais que ce n'est que le fruit de mes souvenirs, mais j'ai comme un pincement au cœur..."
  },
  {
    "RowOffset": 978602,
    "RowId": 42339,
    "Text": "Pliez sous le poids de mon serment!"
  },
