  },
  {
    "RowOffset": 918066,
    "RowId": 40600,
    "Text": "Prrrépare-toi à goûter à mes griffes acérées!"
  },
  {
    "RowOffset": 918134,
    "RowId": 40601,
    "Text": "Black Cat annonce la couleur d'entrée de match!"
  },
  {
    "RowOffset": 918198,
    "RowId": 40602,
    "Text": "Est-ce que notre challenger saura résister aux assauts de cette féroce combattante féline!?"
  },
  {
    "RowOffset": 918310,
    "RowId": 40603,
    "Text": "Perrrsonne ne résiste à mes attaques tranchantes!"
  },
  {
    "RowOffset": 918378,
    "RowId": 40604,
    "Text": "Black Cat prépare une technique spéciale!"
  },
  {
    "RowOffset": 918438,
    "RowId": 40605,
    "Text": "Incroyable! Le ring entier a été déchiqueté!"
  },
  {
    "RowOffset": 918506,
    "RowId": 40606,
    "Text": "Nous allons nous charger de réparer ça au plus vite!"
  },
  {
    "RowOffset": 918578,
    "RowId": 40607,
    "Text": "Je vais me faire les grrriffes sur toi!"
  },
  {
    "RowOffset": 918634,
    "RowId": 40608,
    "Text": "Voyons si tu arrives à suivrrre mes mouvements!"
  },
  {
    "RowOffset": 918698,
    "RowId": 40609,
    "Text": "Je vais t'embrrrocher!"
  },
  {
    "RowOffset": 918738,
    "RowId": 40610,
    "Text": "Il est temps de t'envoler bien haut!"
  },
  {
    "RowOffset": 918790,
    "RowId": 40611,
    "Text": "Et maintenant au sol!"
  },
  {
    "RowOffset": 918826,
    "RowId": 40612,
    "Text": "Les chats ont neuf vies! Je peux dédoubler mon âme!"
  },
  {
    "RowOffset": 918898,
    "RowId": 40613,
    "Text": "Black Cat a décidé d'utiliser Neuf-Vies!"
  },
  {
    "RowOffset": 918958,
    "RowId": 40614,
    "Text": "Il est temps que je fasse appel à un double!"
  },
  {
    "RowOffset": 919018,
    "RowId": 40615,
    "Text": "À moi, incarrrnations de ma volonté!"
  },
  {
    "RowOffset": 919074,
    "RowId": 40616,
    "Text": "Attention! Black Cat va effectuer une série d'attaques frénétiques!"
  },
  {
    "RowOffset": 919166,
    "RowId": 40617,
    "Text": "Yaaah!"
  },
  {
    "RowOffset": 919190,
    "RowId": 40618,
    "Text": "Je vais te réduire en charrrpie!"
  },
  {
    "RowOffset": 919238,
    "RowId": 40619,
    "Text": "Prrrends ça!"
  },
  {
    "RowOffset": 919266,
    "RowId": 40620,
    "Text": "Fini de s'amuser! Vous allez morrrdre la poussière!"
  },
  {
    "RowOffset": 919338,
    "RowId": 40621,
    "Text": "Personne ne peut me vaincrrre sans régulateur!"
  },
  {
    "RowOffset": 919402,
    "RowId": 40622,
    "Text": "Vaincre Black Cat"
  },
