  {
    "RowOffset": 925562,
    "RowId": 40899,
    "Text": ""
  },
  {
    "RowOffset": 925574,
    "RowId": 40900,
    "Text": "Atteindre la carrière de cristal"
  },
  {
    "RowOffset": 925618,
    "RowId": 40901,
    "Text": "Vaincre le zaghnal"
  },
  {
    "RowOffset": 925650,
    "RowId": 40902,
    "Text": "Atteindre le centre de gestion des âmes"
  },
  {
    "RowOffset": 925702,
    "RowId": 40903,
    "Text": "Vaincre Kanilokka"
  },
  {
    "RowOffset": 925730,
    "RowId": 40904,
    "Text": "Atteindre le Clapier tempétueux"
  },
  {
    "RowOffset": 925774,
    "RowId": 40905,
    "Text": "Vaincre Lunipyati"
  },
  {
    "RowOffset": 925802,
    "RowId": 40906,
    "Text": "Mon père n'est pas venu ici sans raison, ja..."
  },
  {
    "RowOffset": 925862,
    "RowId": 40907,
    "Text": "Il a l'air coriace, celui-là. Faites attention!"
  },
  {
    "RowOffset": 925926,
    "RowId": 40908,
    "Text": "Alors c'est ça, Yuweyawata?"
  },
  {
    "RowOffset": 925970,
    "RowId": 40909,
    "Text": "Qu'est-ce qu'ils pouvaient bien étudier ici, ja?"
  },
  {
    "RowOffset": 926034,
    "RowId": 40910,
    "Text": "J'aime pas trop cet endroit, ja..."
  },
  {
    "RowOffset": 926082,
    "RowId": 40911,
    "Text": "Ce tourbillon... C'est une tempête!?"
  },
  {
    "RowOffset": 926134,
    "RowId": 40912,
    "Text": "Attention, quelque chose ne tourne pas rond..."
  },
  {
    "RowOffset": 926194,
    "RowId": 40913,
    "Text": "Cette bête est restée scellée pendant tout ce temps, ja?"
  },
  {
    "RowOffset": 926270,
    "RowId": 40914,
    "Text": "Aaagh... Offrez vos âmes... à Sa Majesté Zoraal Ja!"
  },
  {
    "RowOffset": 926342,
    "RowId": 40915,
    "Text": "Venez à moi... mes petites âmes!"
  },
  {
    "RowOffset": 926394,
    "RowId": 40916,
    "Text": "Vous ne m'échapperez pas. Mes précieux cobayes..."
  },
  {
    "RowOffset": 926458,
    "RowId": 40917,
    "Text": "Abandonnez votre chair... Léguez-moi vos âmes!"
  },
  {
    "RowOffset": 926522,
    "RowId": 40918,
    "Text": "P-pourquoi refusez-vous de servir Sa Majesté? Pourquoi n'acceptez-vous pas le sacrifice...?"
  },
  {
    "RowOffset": 926634,
    "RowId": 40919,
    "Text": "Je m'emparerai de vos âmes! Sa Majesté l'exige..."
  },
  {
    "RowOffset": 926702,
    "RowId": 40920,
    "Text": "Aaagh... Il m'en faut plus... Toujours plus!"
  },
  {
    "RowOffset": 926762,
    "RowId": 40921,
    "Text": "Si seulement j'avais pu me servir de la créature... Vous n'auriez eu... aucune chance... Mais, le sceau est déjà..."
  },
  {
    "RowOffset": 926894,
    "RowId": 40922,
    "Text": "Wouah! C'était quoi ce cri, ja? Vous croyez qu'il y a un monstre à l'intérieur?"
  },
