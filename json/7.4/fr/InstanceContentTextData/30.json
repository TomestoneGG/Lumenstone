    "RowId": 40800,
    "Text": "グ、ギィヤアアアア！"
  },
  {
    "RowId": 40801,
    "Text": "Transformez-vous en glaaace!!"
  },
  {
    "RowId": 40802,
    "Text": "プギャァアア！"
  },
  {
    "RowId": 40803,
    "Text": "グゥ、ググガアア……！"
  },
  {
    "RowId": 40804,
    "Text": "ギイィィィ！\u3000ギイィィィ！"
  },
  {
    "RowId": 40805,
    "Text": "グギャ、ギャア……！"
  },
  {
    "RowId": 40806,
    "Text": "ピギィヤアアアアアアアアア！"
  },
  {
    "RowId": 40807,
    "Text": "ピィギィィ！"
  },
  {
    "RowId": 40808,
    "Text": "フグゥゥ……！"
  },
  {
    "RowId": 40809,
    "Text": "グゥゥギャア！"
  },
  {
    "RowId": 40810,
    "Text": "ギギ……ギィ！"
  },
  {
    "RowId": 40811,
    "Text": "ギ、ギャガァァァ！"
  },
  {
    "RowId": 40812,
    "Text": "フグゥゥ……フゥ、ギャア……！"
