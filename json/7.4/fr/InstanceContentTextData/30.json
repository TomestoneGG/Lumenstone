  {
    "RowOffset": 923990,
    "RowId": 40800,
    "Text": "グ、ギィヤアアアア！"
  },
  {
    "RowOffset": 924034,
    "RowId": 40801,
    "Text": "Transformez-vous en glaaace!!"
  },
  {
    "RowOffset": 924078,
    "RowId": 40802,
    "Text": "プギャァアア！"
  },
  {
    "RowOffset": 924110,
    "RowId": 40803,
    "Text": "グゥ、ググガアア……！"
  },
  {
    "RowOffset": 924154,
    "RowId": 40804,
    "Text": "ギイィィィ！\u3000ギイィィィ！"
  },
  {
    "RowOffset": 924206,
    "RowId": 40805,
    "Text": "グギャ、ギャア……！"
  },
  {
    "RowOffset": 924250,
    "RowId": 40806,
    "Text": "ピギィヤアアアアアアアアア！"
  },
  {
    "RowOffset": 924306,
    "RowId": 40807,
    "Text": "ピィギィィ！"
  },
  {
    "RowOffset": 924338,
    "RowId": 40808,
    "Text": "フグゥゥ……！"
  },
  {
    "RowOffset": 924370,
    "RowId": 40809,
    "Text": "グゥゥギャア！"
  },
  {
    "RowOffset": 924402,
    "RowId": 40810,
    "Text": "ギギ……ギィ！"
  },
  {
    "RowOffset": 924434,
    "RowId": 40811,
    "Text": "ギ、ギャガァァァ！"
  },
  {
    "RowOffset": 924474,
    "RowId": 40812,
