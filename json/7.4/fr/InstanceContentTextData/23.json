  },
  {
    "RowOffset": 778406,
    "RowId": 36700,
    "Text": "Comment osez-vous entraver ma guerre sacrée?"
  },
  {
    "RowOffset": 778466,
    "RowId": 36701,
    "Text": "Votre disparition marquera le début d'une ère nouvelle!"
  },
  {
    "RowOffset": 778538,
    "RowId": 36702,
    "Text": "Je suis l'unique salut de ce monde!"
  },
  {
    "RowOffset": 778590,
    "RowId": 36703,
    "Text": "Personne ne me barrera la route!"
  },
  {
    "RowOffset": 778638,
    "RowId": 36704,
    "Text": "Misérables!"
  },
  {
    "RowOffset": 778666,
    "RowId": 36705,
    "Text": "C'est tout ce dont vous êtes capables?"
  },
  {
    "RowOffset": 778722,
    "RowId": 36706,
    "Text": "Voici la preuve que votre puissance n'est rien!"
  },
  {
    "RowOffset": 778786,
    "RowId": 36707,
    "Text": "Qu'une pluie d'astres vous pulvérise!"
  },
  {
    "RowOffset": 778842,
    "RowId": 36708,
    "Text": "Sentez la glace sur ma lame!"
  },
  {
    "RowOffset": 778886,
    "RowId": 36709,
    "Text": "Emporte-les, vent ténébreux!"
  },
  {
    "RowOffset": 778934,
    "RowId": 36710,
    "Text": "Je vais vous réduire en poussière!"
  },
  {
    "RowOffset": 778986,
    "RowId": 36711,
    "Text": "Explosez en mille morceaux!"
  },
  {
    "RowOffset": 779030,
    "RowId": 36712,
    "Text": "À moi, dragonne obscure!"
  },
  {
    "RowOffset": 779070,
    "RowId": 36713,
    "Text": "Dragonne obscure, soumets-toi à ma volonté!"
  },
  {
    "RowOffset": 779130,
    "RowId": 36714,
    "Text": "Seule la quintessence de nos pouvoirs départagera les Ténèbres et la Lumière!"
  },
  {
    "RowOffset": 779226,
    "RowId": 36715,
    "Text": "Contemplez le paroxysme de la terreur!"
  },
  {
    "RowOffset": 779282,
    "RowId": 36716,
    "Text": "Écrabouille-les, ma dragonne!"
  },
  {
    "RowOffset": 779330,
    "RowId": 36717,
    "Text": "Va et dévore leurs entrailles!"
  },
  {
    "RowOffset": 779378,
    "RowId": 36718,
    "Text": "Réduis-les en cendres, dragonne!"
  },
  {
    "RowOffset": 779426,
    "RowId": 36719,
    "Text": "Dragonne obscure! N'aie aucune pitié!"
  },
  {
    "RowOffset": 779486,
    "RowId": 36720,
    "Text": "Renforce-toi, Météore!"
  },
  {
    "RowOffset": 779526,
    "RowId": 36721,
    "Text": "Votre monde sera à nous!"
  },
