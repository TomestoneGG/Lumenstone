  },
  {
    "RowOffset": 785554,
    "RowId": 37000,
    "Text": "Vaincre Thémis"
  },
  {
    "RowOffset": 785582,
    "RowId": 37001,
    "Text": "Va savoir pourquoi, mon cœur s'emballe...!"
  },
  {
    "RowOffset": 785642,
    "RowId": 37002,
    "Text": "Je sais comment te mettre à l'épreuve!"
  },
  {
    "RowOffset": 785698,
    "RowId": 37003,
    "Text": "Lumière ou Ténèbres... Quel sera ton juge?"
  },
  {
    "RowOffset": 785758,
    "RowId": 37004,
    "Text": "杖はこう使う、友人からの提案だ！"
  },
  {
    "RowOffset": 785818,
    "RowId": 37005,
    "Text": "Parviendras-tu à balancer Lumière et Ténèbres?"
  },
  {
    "RowOffset": 785886,
    "RowId": 37006,
    "Text": "Moi, Elidibus, serai ton arbitre!"
  },
  {
    "RowOffset": 785934,
    "RowId": 37007,
    "Text": "Que jaillisse l'énergie contenue en moi!"
  },
  {
    "RowOffset": 785990,
    "RowId": 37008,
    "Text": "Goûte à ce sort signé Emet-Selch!"
  },
  {
    "RowOffset": 786042,
    "RowId": 37009,
    "Text": "Je peux créer des copies de moi-même!"
  },
  {
    "RowOffset": 786098,
    "RowId": 37010,
    "Text": "Il me faut des doubles plus solides!"
  },
  {
    "RowOffset": 786150,
    "RowId": 37011,
    "Text": "Quelle excitation! C'en est presque indécent!"
  },
  {
    "RowOffset": 786218,
    "RowId": 37012,
    "Text": "Je suis le médiateur... Je vis pour ma mission!"
  },
  {
    "RowOffset": 786282,
    "RowId": 37013,
    "Text": "À moi de juger ton existence!"
  },
  {
    "RowOffset": 786330,
    "RowId": 37014,
    "Text": "J'aimerais que ce combat dure éternellement..."
  },
  {
    "RowOffset": 786402,
    "RowId": 37015,
    "Text": "Hélas... toutes les bonnes choses ont une fin!"
  },
