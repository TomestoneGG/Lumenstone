  {
    "RowOffset": 782366,
    "RowId": 36899,
    "Text": ""
  },
  {
    "RowOffset": 782378,
    "RowId": 36900,
    "Text": "Vaincre Athéna"
  },
  {
    "RowOffset": 782406,
    "RowId": 36901,
    "Text": "Dévoilez-moi votre nature, que je puisse enfin toucher au divin!"
  },
  {
    "RowOffset": 782486,
    "RowId": 36902,
    "Text": "Et du néant émergea la vie!"
  },
  {
    "RowOffset": 782530,
    "RowId": 36903,
    "Text": "Le pouvoir infini de la création réside en ces chaînes..."
  },
  {
    "RowOffset": 782602,
    "RowId": 36904,
    "Text": "Offrons une âme à ces réceptacles muets!"
  },
  {
    "RowOffset": 782662,
    "RowId": 36905,
    "Text": "Voici un aperçu de la puissance divine!"
  },
  {
    "RowOffset": 782718,
    "RowId": 36906,
    "Text": "Éprouvez la puissance à l'état pur!"
  },
  {
    "RowOffset": 782774,
    "RowId": 36907,
    "Text": "Des portes des sept enfers à celles des cieux, le monde tremblera! Qu'Ultima se déchaîne!"
  },
  {
    "RowOffset": 782886,
    "RowId": 36908,
    "Text": "Quelle merveille. Une âme si frêle et pourtant si tenace..."
  },
  {
    "RowOffset": 782958,
    "RowId": 36909,
    "Text": "Jusqu'à quand résisterez-vous à la déesse que je suis?"
  },
  {
    "RowOffset": 783034,
    "RowId": 36910,
    "Text": "Montrez-moi encore l'éclat de vos âmes!"
  },
  {
    "RowOffset": 783090,
    "RowId": 36911,
    "Text": "Je vais de ce pas prouver ma théorie!"
  },
  {
    "RowOffset": 783146,
    "RowId": 36912,
    "Text": "J'ai commis une erreur de calcul. Je dois être trop naïve..."
  },
  {
    "RowOffset": 783222,
    "RowId": 36913,
    "Text": "Tout de même... Des sous-êtres humains qui tiennent tête à une déesse...?"
  },
  {
    "RowOffset": 783318,
    "RowId": 36914,
    "Text": "Je n'y crois pas... Ma théorie serait erronée...?"
  },
  {
    "RowOffset": 783386,
    "RowId": 36915,
    "Text": "Mon désir n'est visiblement pas assez puissant..."
  },
  {
    "RowOffset": 783450,
    "RowId": 36916,
    "Text": "Dans ce cas, je n'ai qu'à l'amplifier! À moi, Cœur de Sabik!"
  },
  {
    "RowOffset": 783534,
    "RowId": 36917,
    "Text": "Si quelqu'un se trompe ici, ce n'est certainement pas moi, non...!"
  },
  {
    "RowOffset": 783630,
    "RowId": 36918,
    "Text": "C'est plutôt le monde entier qui est dans l'erreur..."
  },
  {
    "RowOffset": 783698,
    "RowId": 36919,
    "Text": "Je vais donc le remodeler selon mes goûts!"
  },
  {
    "RowOffset": 783758,
    "RowId": 36920,
    "Text": "Me voilà devenue une véritable divinité créatrice!"
  },
  {
    "RowOffset": 783830,
    "RowId": 36921,
    "Text": "Voici à quoi doit ressembler le monde!"
  },
  {
    "RowOffset": 783886,
    "RowId": 36922,
    "Text": "Regardez le ciel vriller!"
  },
  {
    "RowOffset": 783926,
    "RowId": 36923,
    "Text": "Que le démon des noirs abysses prenne forme... À moi, invocations des Ténèbres!"
  },
  {
    "RowOffset": 784026,
    "RowId": 36924,
    "Text": "Maudissez-moi, l'astre funeste s'écrasera sur vous malgré tout!"
  },
  {
    "RowOffset": 784106,
    "RowId": 36925,
    "Text": "Les éléments chimiques s'entremêlent!"
  },
  {
    "RowOffset": 784162,
    "RowId": 36926,
    "Text": "Tout se meut, rien ne demeure!"
  },
  {
    "RowOffset": 784210,
    "RowId": 36927,
    "Text": "Saurez-vous percevoir la chaleur à l'état brut?"
  },
  {
    "RowOffset": 784274,
    "RowId": 36928,
    "Text": "Les voies de l'évolution sont impénétrables... sauf pour moi!"
  },
  {
    "RowOffset": 784370,
    "RowId": 36929,
    "Text": "Soumettez-vous à la volonté divine!"
  },
  {
    "RowOffset": 784422,
    "RowId": 36930,
    "Text": "Le monde doit être refaçonné!"
  },
  {
    "RowOffset": 784470,
    "RowId": 36931,
    "Text": "Tous mes détracteurs seront punis!"
  },
  {
    "RowOffset": 784522,
    "RowId": 36932,
    "Text": "En vertu de quoi refusez-vous de disparaître!?"
  },
  {
    "RowOffset": 784586,
    "RowId": 36933,
    "Text": "Je suis une déesse! Rien ne devrait échapper à ma compréhension!"
  },
  {
    "RowOffset": 784674,
    "RowId": 36934,
    "Text": "Mais alors... pourquoi diable ce monde existe-t-il...?"
  },
  {
    "RowOffset": 784746,
    "RowId": 36935,
    "Text": "Pourquoi suis-je moi...?"
  },
