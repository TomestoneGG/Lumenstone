  {
    "RowOffset": 780490,
    "RowId": 36799,
    "Text": ""
  },
  {
    "RowOffset": 780502,
    "RowId": 36800,
    "Text": "Je suis Asura, la Manusya qui vit pour combattre..."
  },
  {
    "RowOffset": 780566,
    "RowId": 36801,
    "Text": "Voyons un peu ce que vous valez, piètres humains..."
  },
  {
    "RowOffset": 780630,
    "RowId": 36802,
    "Text": "Saurez-vous discerner la lueur de mes lames?"
  },
  {
    "RowOffset": 780690,
    "RowId": 36803,
    "Text": "Plus rapide que mon ombre!"
  },
  {
    "RowOffset": 780734,
    "RowId": 36804,
    "Text": "Voici comment une Manusya inflige le trépas!"
  },
  {
    "RowOffset": 780794,
    "RowId": 36805,
    "Text": "À moi, incarnation guerrière!"
  },
  {
    "RowOffset": 780842,
    "RowId": 36806,
    "Text": "Cette résidence sera votre tombeau!"
  },
  {
    "RowOffset": 780894,
    "RowId": 36807,
    "Text": "Incarnation guerrière! L'heure de l'éveil a sonné!"
  },
  {
    "RowOffset": 780966,
    "RowId": 36808,
    "Text": "Mon sextuor de lames va vous mettre en charpie!"
  },
  {
    "RowOffset": 781030,
    "RowId": 36809,
    "Text": "Plongez votre regard dans un autre de mes visages..."
  },
  {
    "RowOffset": 781094,
    "RowId": 36810,
    "Text": "Arrière, mécréants!"
  },
  {
    "RowOffset": 781134,
    "RowId": 36811,
    "Text": "Le destin des faibles est de périr!"
  },
  {
    "RowOffset": 781186,
    "RowId": 36812,
    "Text": "Amusez-moi donc un peu!"
  },
  {
    "RowOffset": 781226,
    "RowId": 36813,
    "Text": "Personne n'est de taille face à trois têtes et six bras!"
  },
  {
    "RowOffset": 781302,
    "RowId": 36814,
    "Text": "Vous allez bientôt redevenir poussière!"
  },
