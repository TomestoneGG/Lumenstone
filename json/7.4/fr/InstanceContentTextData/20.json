  {
    "RowOffset": 728394,
    "RowId": 35400,
    "Text": "Contrôle mental du sujet “Artorius”: total...\nMode combat activé... Élimination imminente."
  },
  {
    "RowOffset": 728510,
    "RowId": 35401,
    "Text": "Invocation de la lame dimensionnelle...\nSon maniement... Je me souviens... Tu m'as appris..."
  },
  {
    "RowOffset": 728618,
    "RowId": 35402,
    "Text": "Maniement de la lame dimensionnelle...\nNiveau de maîtrise conforme aux données de l'original..."
  },
  {
    "RowOffset": 728730,
    "RowId": 35403,
    "Text": "Phlégéton... Mon ami...\nC'est moi, Ar... Ex... calibur!"
  },
  {
    "RowOffset": 728806,
    "RowId": 35404,
    "Text": "Charge en éther élémentaire optimale...\nUtilisation du séparateur thermique."
  },
  {
    "RowOffset": 728902,
    "RowId": 35405,
    "Text": "Purge totale de l'éther élémentaire...\nRayon exterminateur... Nom de code: “Paradoxe”..."
  },
  {
    "RowOffset": 729018,
    "RowId": 35406,
    "Text": "Les avaries du sujet dépassent le seuil de tolérance...\nArrêt des fonctions vitales imminent... T-t-t-tuez... Tuez-moi!"
  },
  {
    "RowOffset": 729158,
    "RowId": 35407,
    "Text": "Echec de l'élimination...\nCeux qui menacent l'empire d'Allag doivent être assujettis."
  },
  {
    "RowOffset": 729262,
    "RowId": 35408,
    "Text": "Chargement du module stratégique... Démarrage de l'assaut... "
  },
