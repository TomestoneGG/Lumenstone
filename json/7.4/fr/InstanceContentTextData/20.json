  {
    "RowOffset": 716250,
    "RowId": 35100,
    "Text": "Hihihi! Je suis venue aussi!"
  },
  {
    "RowOffset": 716298,
    "RowId": 35101,
    "Text": "Tiens donc, je ne m'attendais pas à te voir ici."
  },
  {
    "RowOffset": 716358,
    "RowId": 35102,
    "Text": "Mortels, nous serons vos adversaires!"
  },
  {
    "RowOffset": 716410,
    "RowId": 35103,
    "Text": "Le temps se plie à ma volonté!"
  },
  {
    "RowOffset": 716458,
    "RowId": 35104,
    "Text": "Ressentez l'essence du Contemplateur!"
  },
  {
    "RowOffset": 716510,
    "RowId": 35105,
    "Text": "Je vous ai à l'œil!"
  },
  {
    "RowOffset": 716546,
    "RowId": 35106,
    "Text": "Gardez le fil du temps!"
  },
  {
    "RowOffset": 716586,
    "RowId": 35107,
    "Text": "Brillez dans votre fugacité!"
  },
  {
    "RowOffset": 716630,
    "RowId": 35108,
    "Text": "Ployez sous la puissance de la pesanteur!"
  },
  {
    "RowOffset": 716686,
    "RowId": 35109,
    "Text": "À vous d'affronter votre destinée!"
  },
  {
    "RowOffset": 716738,
    "RowId": 35110,
    "Text": "Montrez-moi ce que vous savez faire!"
  },
  {
    "RowOffset": 716790,
    "RowId": 35111,
    "Text": "Priez pour que les étoiles vous soient favorables!"
  },
  {
    "RowOffset": 716858,
    "RowId": 35112,
    "Text": "Ah, que les étoiles scintillantes sont belles!"
  },
  {
    "RowOffset": 716922,
    "RowId": 35113,
    "Text": "Soyez engloutis par le déchaînement de l'eau divine!"
  },
  {
    "RowOffset": 716994,
    "RowId": 35114,
    "Text": "Laissez-moi tisser les fils de votre destin."
  },
  {
    "RowOffset": 717050,
    "RowId": 35115,
    "Text": "Tu es prête? C'est le moment..."
  },
  {
    "RowOffset": 717098,
    "RowId": 35116,
    "Text": "Quand tu veux, grand frère!"
  },
  {
    "RowOffset": 717142,
    "RowId": 35117,
    "Text": "Soumettez-vous aux lois du temps et du destin!"
  },
  {
    "RowOffset": 717206,
    "RowId": 35118,
    "Text": "J'ai tant attendu ce moment..."
  },
  {
    "RowOffset": 717250,
    "RowId": 35119,
    "Text": "Telle est donc votre destinée..."
  },
  {
    "RowOffset": 717294,
    "RowId": 35120,
    "Text": "Franchir la terre d'abondance"
  },
  {
    "RowOffset": 717334,
    "RowId": 35121,
    "Text": "Franchir les racines de l'Arbre-Monde"
  },
  {
    "RowOffset": 717382,
    "RowId": 35122,
    "Text": "Franchir l'Arbre-Monde"
  },
  {
    "RowOffset": 717418,
    "RowId": 35123,
    "Text": "Franchir le glacier ciselé"
  },
  {
    "RowOffset": 717458,
    "RowId": 35124,
    "Text": "Franchir les quartiers de la Conquérante"
  },
  {
    "RowOffset": 717510,
    "RowId": 35125,
    "Text": "Franchir la chambre des lunes jumelles"
  },
  {
    "RowOffset": 717562,
    "RowId": 35126,
    "Text": "Nophica elle-même est venue nous accueillirrr!"
  },
  {
    "RowOffset": 717626,
    "RowId": 35127,
    "Text": "L'éthérographe fonctionne comme prrrévu. Continuons!"
  },
  {
    "RowOffset": 717698,
    "RowId": 35128,
    "Text": "Il est temps de révéler une autre facette de la planète..."
  },
  {
    "RowOffset": 717770,
    "RowId": 35129,
    "Text": "Un Dieu capable de manipuler le temps et la grrravité... C'est Althyk, le Contemplateur!"
  },
  {
    "RowOffset": 717874,
    "RowId": 35130,
    "Text": "Hihihi! Je suis venue aussi!"
  },
  {
    "RowOffset": 717922,
    "RowId": 35131,
    "Text": "Tiens donc, je ne m'attendais pas à te voir ici."
  },
  {
    "RowOffset": 717982,
    "RowId": 35132,
    "Text": "Je vous invite à me rejoindre sur le champ de bataille suprême!"
  },
  {
    "RowOffset": 718062,
    "RowId": 35133,
    "Text": "Ce domaine est entièrrrement gelé..."
  },
  {
    "RowOffset": 718114,
    "RowId": 35134,
    "Text": "En avant, marche!"
  },
  {
    "RowOffset": 718146,
    "RowId": 35135,
    "Text": "Aucun doute, notre prrrochain adversaire sera bien Halone, la Conquérante."
  },
  {
    "RowOffset": 718234,
    "RowId": 35136,
    "Text": "Cette lumièrrre... Elle nous invite à l'intérieur!?"
  },
  {
    "RowOffset": 718306,
    "RowId": 35137,
    "Text": "Montrez-moi la pétulance de l'humanité!"
  },
  {
    "RowOffset": 718362,
    "RowId": 35138,
    "Text": "Sentez le souffle de la Mère..."
  },
  {
    "RowOffset": 718406,
    "RowId": 35139,
    "Text": "Vous allez vous prosterner!"
  },
  {
    "RowOffset": 718450,
    "RowId": 35140,
    "Text": "Contemplez la fertilité dans toute sa splendeur!"
  },
  {
    "RowOffset": 718514,
    "RowId": 35141,
    "Text": "Quelle extase d'admirer ce dont vous êtes capables!"
  },
  {
    "RowOffset": 718582,
    "RowId": 35142,
    "Text": "Que ce qui a été semé soit récolté!"
  },
  {
    "RowOffset": 718638,
    "RowId": 35143,
    "Text": "Nourrissez les terres fertiles!"
  },
  {
    "RowOffset": 718686,
    "RowId": 35144,
    "Text": "Révélez-moi vos capacités insondées!"
  },
  {
    "RowOffset": 718742,
    "RowId": 35145,
    "Text": "Sentez-vous battre le cœur de la planète?"
  },
  {
    "RowOffset": 718802,
    "RowId": 35146,
    "Text": "Que fleurissent les arbres, que verdissent les terres!"
  },
  {
    "RowOffset": 718874,
    "RowId": 35147,
    "Text": "Mes chers enfants... N'abandonnez jamais..."
  },
  {
    "RowOffset": 718930,
    "RowId": 35148,
    "Text": "Faites-moi sentir votre amour!"
  },
  {
    "RowOffset": 718978,
    "RowId": 35149,
    "Text": "Voilà toute l'étendue de ma puissance!"
  },
  {
    "RowOffset": 719034,
    "RowId": 35150,
    "Text": "Quel bonheur de me mesurer à vous!"
  },
  {
    "RowOffset": 719086,
    "RowId": 35151,
    "Text": "À moi de jouer... Préparez-vous!"
  },
  {
    "RowOffset": 719138,
    "RowId": 35152,
    "Text": "Qui aime bien, châtie bien!"
  },
  {
    "RowOffset": 719182,
    "RowId": 35153,
    "Text": "Jouez donc avec mon fidèle compagnon!"
  },
  {
    "RowOffset": 719238,
    "RowId": 35154,
    "Text": "On s'amuse bien, hein?"
  },
  {
    "RowOffset": 719278,
    "RowId": 35155,
    "Text": "Je vous aimerai pour toujours... de tout mon cœur!"
  },
  {
    "RowOffset": 719346,
    "RowId": 35156,
    "Text": "Prouvez votre courage à la Conquérante!"
  },
  {
    "RowOffset": 719402,
    "RowId": 35157,
    "Text": "Que ma lance s'imprègne d'un froid étincelant!"
  },
  {
    "RowOffset": 719466,
    "RowId": 35158,
    "Text": "Soyez sacrifiés dans la gloire!"
  },
  {
    "RowOffset": 719514,
    "RowId": 35159,
    "Text": "Trop faible! Ne retenez pas vos coups!"
  },
  {
    "RowOffset": 719574,
    "RowId": 35160,
    "Text": "La capitulation n'est pas une option!"
  },
  {
    "RowOffset": 719626,
    "RowId": 35161,
    "Text": "L'apothéose de la victoire sera mienne!"
  },
  {
    "RowOffset": 719682,
    "RowId": 35162,
    "Text": "Soyez écrasés par la grandeur des glaciers..."
  },
  {
    "RowOffset": 719742,
    "RowId": 35163,
    "Text": "À moi, égide majestueuse!"
  },
  {
    "RowOffset": 719786,
    "RowId": 35164,
    "Text": "Ah, si cette joute pouvait être éternelle!"
  },
  {
    "RowOffset": 719846,
    "RowId": 35165,
    "Text": "Enivrons-nous ensemble de ce festin de sang!"
  },
  {
    "RowOffset": 719906,
    "RowId": 35166,
    "Text": "Admirable! Continuez votre marche en avant!"
  },
  {
    "RowOffset": 719970,
    "RowId": 35167,
    "Text": "Accélération du temps dans 3 secondes..."
  },
  {
    "RowOffset": 720026,
    "RowId": 35168,
    "Text": "Accélération du temps dans 2 secondes..."
  },
  {
    "RowOffset": 720082,
    "RowId": 35169,
    "Text": "Accélération du temps dans 1 seconde..."
  },
  {
    "RowOffset": 720134,
    "RowId": 35170,
    "Text": "Le temps est accéléré par le pouvoir d'Althyk!"
  },
  {
    "RowOffset": 720198,
    "RowId": 35171,
    "Text": "Des lunes sont créées par le pouvoir de Menphina!"
  },
  {
    "RowOffset": 720266,
    "RowId": 35172,
    "Text": "La brillance de l'amour commence à s'intensifier..."
  },
  {
    "RowOffset": 720330,
    "RowId": 35173,
    "Text": "Puissiez-vous accepter tout notre amour!"
  },
  {
    "RowOffset": 720386,
    "RowId": 35174,
    "Text": ""
  },
  {
