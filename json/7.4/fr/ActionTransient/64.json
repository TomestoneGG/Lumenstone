  {
    "RowOffset": 1634054,
    "RowId": 31785,
    "Description": "Saute sur la cible et lui porte une attaque physique.\n<span style=\"color: #ffff66;\">Puissance:</span> 150"
  },
  {
    "RowOffset": 1634166,
    "RowId": 31786,
    "Description": ""
  },
  {
    "RowOffset": 1634178,
    "RowId": 31787,
    "Description": ""
  },
