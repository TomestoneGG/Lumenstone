  {
    "RowOffset": 466926,
    "RowId": 633,
    "Description": "Effectue une attaque magique de terre sur la cible.\n<span style=\"color: #ffff66;\">Puissance:</span> 40\n\n<span style=\"color: #00cc22;\">* Cette action ne peut pas être ajoutée aux barres de raccourcis.</span>"
  },
  {
    "RowOffset": 467134,
    "RowId": 634,
    "Description": "Effectue une attaque magique de terre sur les ennemis alentour.\n<span style=\"color: #ffff66;\">Puissance:</span> 200\n\n<span style=\"color: #00cc22;\">* Cette action ne peut pas être ajoutée aux barres de raccourcis.</span>"
  },
  {
    "RowOffset": 467354,
    "RowId": 635,
    "Description": "Réduit de 20% les dégâts subis par le familier.\n<span style=\"color: #ffff66;\">Durée:</span> 20s\nEn mode <span style=\"color: #ff7b1a;\">Obéir</span>, requiert l'ordre du maître."
  },
  {
    "RowOffset": 467530,
    "RowId": 636,
    "Description": "Effectue une attaque magique de terre sur la cible.\n<span style=\"color: #ffff66;\">Puissance:</span> 60\n<span style=\"color: #ffff66;\">Effet additionnel:</span> inflige Étourdissement.\n<span style=\"color: #ffff66;\">Durée:</span> 2s\nEn mode <span style=\"color: #ff7b1a;\">Obéir</span>, requiert l'ordre du maître."
  },
  {
    "RowOffset": 467826,
    "RowId": 637,
    "Description": "Effectue une attaque magique de vent sur la cible et les ennemis autour.\n<span style=\"color: #ffff66;\">Puissance:</span> 20\n\n<span style=\"color: #00cc22;\">* Cette action ne peut pas être ajoutée aux barres de raccourcis.</span>"
  },
  {
    "RowOffset": 468054,
    "RowId": 638,
    "Description": "Effectue une attaque magique de vent sur la cible.\n<span style=\"color: #ffff66;\">Puissance:</span> 80\n<span style=\"color: #ffff66;\">Effet additionnel:</span> projette la cible 15 yalms en arrière\nEn mode <span style=\"color: #ff7b1a;\">Obéir</span>, requiert l'ordre du maître."
  },
  {
    "RowOffset": 468322,
    "RowId": 639,
    "Description": "Effectue une attaque magique de vent sur la cible et les ennemis autour.\n<span style=\"color: #ffff66;\">Puissance:</span> 100\n\n<span style=\"color: #00cc22;\">* Cette action ne peut pas être ajoutée aux barres de raccourcis.</span>"
  },
  {
    "RowOffset": 468550,
    "RowId": 640,
    "Description": "Augmente de 10% les dégâts magiques subis par la cible.\n<span style=\"color: #ffff66;\">Durée:</span> 15s\nEn mode <span style=\"color: #ff7b1a;\">Obéir</span>, requiert l'ordre du maître."
