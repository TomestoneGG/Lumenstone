[
  {
    "RowOffset": 893734,
    "RowId": 17500,
    "Text": "Contesté"
  },
  {
    "RowOffset": 893754,
    "RowId": 17501,
    "Text": "<switch(IntegerParameter(1),<Icon>51</Icon><span style=\"color: #ffc8c8;\">Le Maelstrom</span> capture,<Icon>52</Icon><span style=\"color: #ffffc0;\">Les Deux Vipères</span> capturent,<Icon>53</Icon><span style=\"color: #ffc0ff;\">Les Immortels</span> capturent)> un cercle\u00A0!"
  },
  {
    "RowOffset": 893950,
    "RowId": 17502,
    "Text": "Capture terminée"
  },
  {
    "RowOffset": 893978,
    "RowId": 17503,
    "Text": "<switch(IntegerParameter(1),<Icon>51</Icon><span style=\"color: #ffc8c8;\">Le Maelstrom</span> a capturé,<Icon>52</Icon><span style=\"color: #ffffc0;\">L'ordre des Deux Vipères</span> a capturé,<Icon>53</Icon><span style=\"color: #ffc0ff;\">Les Immortels</span> ont capturé)> un point névralgique de <switch(IntegerParameter(2),rang B,rang A,rang S)>!"
  },
  {
    "RowOffset": 894234,
    "RowId": 17504,
    "Text": "<Num>IntegerParameter(1)</Num> s avant la neige!"
  },
  {
    "RowOffset": 894274,
    "RowId": 17505,
    "Text": "Il commence à neiger!"
  },
  {
    "RowOffset": 894314,
    "RowId": 17506,
    "Text": "<Num>IntegerParameter(1)</Num> s avant l'apparition d'aurores boréales!"
  },
  {
    "RowOffset": 894378,
    "RowId": 17507,
    "Text": "Des aurores boréales sont apparues!"
  },
  {
    "RowOffset": 894430,
    "RowId": 17508,
    "Text": "Importer"
  },
  {
    "RowOffset": 894450,
    "RowId": 17509,
    "Text": ""
  },
  {
    "RowOffset": 894462,
    "RowId": 17510,
    "Text": "Saisissez un code de partage puis cliquez sur “Décoder”."
  },
  {
    "RowOffset": 894534,
    "RowId": 17511,
    "Text": "●廃止"
  },
  {
    "RowOffset": 894554,
    "RowId": 17512,
    "Text": "Coller depuis le presse-papiers"
  },
  {
    "RowOffset": 894598,
    "RowId": 17513,
    "Text": "●廃止"
  },
  {
    "RowOffset": 894618,
    "RowId": 17514,
    "Text": "●廃止"
  },
  {
    "RowOffset": 894638,
    "RowId": 17515,
    "Text": "Décoder"
  },
  {
    "RowOffset": 894658,
    "RowId": 17516,
    "Text": "Exporter"
  },
  {
    "RowOffset": 894678,
    "RowId": 17517,
    "Text": ""
  },
  {
    "RowOffset": 894690,
    "RowId": 17518,
    "Text": "Le code de partage a été généré."
  },
  {
    "RowOffset": 894738,
    "RowId": 17519,
    "Text": "Intitulé"
  },
  {
    "RowOffset": 894758,
    "RowId": 17520,
    "Text": "Fermer"
  },
  {
    "RowOffset": 894778,
    "RowId": 17521,
    "Text": ""
  },
  {
    "RowOffset": 894790,
    "RowId": 17522,
    "Text": "Copier dans le presse-papiers"
  },
  {
    "RowOffset": 894830,
    "RowId": 17523,
    "Text": "Fermer"
  },
  {
    "RowOffset": 894850,
    "RowId": 17524,
    "Text": "Enregistrer"
  },
  {
    "RowOffset": 894874,
    "RowId": 17525,
    "Text": "Décodage réussi. Voulez-vous enregistrer:\n“<String>StringParameter(1)</String>”?"
  },
  {
    "RowOffset": 894954,
    "RowId": 17526,
    "Text": ": "
  },
  {
    "RowOffset": 894974,
    "RowId": 17527,
    "Text": "Choisissez l'emplacement de destination du tableau stratégique: “<String>StringParameter(1)</String>”."
