  },
  {
    "RowOffset": 888130,
    "RowId": 17200,
    "Text": "Jobs identiques impossibles"
  },
  {
    "RowOffset": 888170,
    "RowId": 17201,
    "Text": ""
  },
  {
    "RowOffset": 888182,
    "RowId": 17202,
    "Text": "Un nouveau niveau a été ajouté au JACTA “As de l'air”!\nProfitez-en pour vous dégourdir les jambes\ndans le décor exotique des îles de Cieldalaes!\n\nLes horaires des JACTA ont été adaptés en conséquence.\nPour plus d'informations à ce sujet, renseignez-vous auprès\ndu réceptionniste dans le hall d'accueil."
  },
  {
    "RowOffset": 888550,
    "RowId": 17203,
    "Text": ""
  },
  {
    "RowOffset": 888562,
    "RowId": 17204,
    "Text": ""
  },
  {
    "RowOffset": 888574,
    "RowId": 17205,
    "Text": ""
  },
  {
    "RowOffset": 888586,
    "RowId": 17206,
    "Text": ""
  },
  {
    "RowOffset": 888598,
    "RowId": 17207,
    "Text": ""
  },
  {
    "RowOffset": 888610,
    "RowId": 17208,
    "Text": ""
  },
  {
    "RowOffset": 888622,
    "RowId": 17209,
    "Text": ""
  },
  {
    "RowOffset": 888634,
    "RowId": 17210,
    "Text": "Permet de fermer automatiquement la fenêtre d'accès rapide après le lancement d'une des actions enregistrées."
  },
  {
    "RowOffset": 888778,
    "RowId": 17211,
    "Text": "Permet d'ouvrir la fenêtre d'accès rapide à la position où se trouve le curseur."
  },
  {
    "RowOffset": 888874,
    "RowId": 17212,
    "Text": "Permet d'empêcher le déplacement par glisser des actions enregistrées."
  },
  {
    "RowOffset": 888958,
    "RowId": 17213,
    "Text": "Permet de modifier l'opacité de la fenêtre d'accès rapide."
  },
  {
    "RowOffset": 889030,
    "RowId": 17214,
    "Text": "Enregistrer ces actions dans les barres de raccourcis permet d'ouvrir la fenêtre d'accès rapide directement dans l'onglet souhaité."
  },
  {
    "RowOffset": 889178,
    "RowId": 17215,
    "Text": "Accès rapide (<Num>IntegerParameter(1)</Num>)"
  },
  {
    "RowOffset": 889214,
    "RowId": 17216,
    "Text": "Permet d'ouvrir la fenêtre d'accès rapide dans le dernier onglet utilisé."
  },
  {
    "RowOffset": 889302,
    "RowId": 17217,
    "Text": "Quitter sans sauvegarder les changements?"
  },
  {
    "RowOffset": 889358,
    "RowId": 17218,
    "Text": "Paramètres d'accès rapide"
  },
  {
    "RowOffset": 889398,
    "RowId": 17219,
    "Text": ""
  },
  {
    "RowOffset": 889410,
    "RowId": 17220,
    "Text": "Réparer tous les objets possédés"
  },
  {
    "RowOffset": 889458,
    "RowId": 17221,
    "Text": "Réparer tous les objets équipés, dans l'arsenal et dans l'inventaire?\n<String>StringParameter(1)</String> <If(IntegerParameter(2))>\n<span style=\"color: #ff7b1a;\">Vous n'avez pas le catalyseur correspondant. Un catalyseur de plus haut niveau va être utilisé.</span><Else/> </If>"
  },
  {
    "RowOffset": 889694,
    "RowId": 17222,
    "Text": "Réparation automatique"
  },
  {
    "RowOffset": 889730,
    "RowId": 17223,
    "Text": ""
  },
  {
    "RowOffset": 889742,
    "RowId": 17224,
    "Text": "Progression"
  },
  {
    "RowOffset": 889766,
    "RowId": 17225,
    "Text": "Réparations en cours dans:\n“<String>StringParameter(1)</String>”"
  },
  {
    "RowOffset": 889826,
    "RowId": 17226,
    "Text": "Tous les objets ont été réparés."
  },
  {
    "RowOffset": 889874,
    "RowId": 17227,
    "Text": "Interrompre"
  },
  {
    "RowOffset": 889898,
    "RowId": 17228,
    "Text": "Terminer"
  },
  {
    "RowOffset": 889918,
    "RowId": 17229,
    "Text": "Réparer tous les objets équipés, dans l'arsenal et dans l'inventaire?\nCoût: <kilo(IntegerParameter(1),,)>\uE049"
  },
