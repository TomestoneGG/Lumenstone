  {
    "RowOffset": 460510,
    "RowId": 633,
    "Description": "Führt eine erdbasierte magische Attacke auf das Ziel aus.\nAttacke-Wert: 40\nKann nicht im Kommandomenü angelegt werden."
  },
  {
    "RowOffset": 460650,
    "RowId": 634,
    "Description": "Führt eine erdbasierte magische Attacke auf alle umstehenden Gegner aus.\nAttacke-Wert: 200\nKann nicht im Kommandomenü angelegt werden."
  },
  {
    "RowOffset": 460806,
    "RowId": 635,
    "Description": "Verringert den Schaden, den dein Familiar erleidet, um 20 %.\nDauer: 20 Sekunden\nBei der Haltung „Gib Acht“ wird dieses Kommando nur auf ausdrücklichen Befehl ausgeführt."
  },
  {
    "RowOffset": 460998,
    "RowId": 636,
    "Description": "Führt eine erdbasierte magische Attacke aus.\nAttacke-Wert: 60\nZusatzeffekt: Betäubung\nDauer: 2 Sekunden\nBei der Haltung <span style=\"color: #ffff66;\">Gib Acht</span> wird dieses Kommando nur auf ausdrücklichen Befehl ausgeführt."
  },
  {
    "RowOffset": 461242,
    "RowId": 637,
    "Description": "Führt eine windbasierte magische Attacke auf das Ziel und die Gegner in seiner Nähe aus.\nAttacke-Wert: 20\nKann nicht im Kommandomenü angelegt werden."
  },
  {
    "RowOffset": 461414,
    "RowId": 638,
    "Description": "Schleudert den Gegner mit einer windbasierten Attacke um 15y zurück.\nAttacke-Wert: 80\nBei der Haltung <span style=\"color: #ffff66;\">Gib Acht</span> wird dieses Kommando nur auf ausdrücklichen Befehl ausgeführt."
  },
  {
    "RowOffset": 461634,
    "RowId": 639,
    "Description": "Führt eine windbasierte magische Attacke auf das Ziel und die Gegner in seiner Nähe aus.\nAttacke-Wert: 100\nKann nicht im Kommandomenü angelegt werden."
  },
  {
    "RowOffset": 461806,
    "RowId": 640,
    "Description": "Erhöht den erlittenen Magieschaden des Ziels um 10%. \nDauer: 15 Sekunden\nBei der Haltung <span style=\"color: #ffff66;\">Gib Acht</span> wird dieses Kommando nur auf ausdrücklichen Befehl ausgeführt."
  },
