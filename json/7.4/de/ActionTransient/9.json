  {
    "RowOffset": 578730,
    "RowId": 4062,
    "Description": "Schwerkraftverstärkendes Gravitationsgeschoss. Kein Effekt auf großes Kriegsgerät."
  },
  {
    "RowOffset": 578826,
    "RowId": 4063,
    "Description": "Elektrisierendes Geschoss. Kein Effekt auf Maschinen."
  },
  {
    "RowOffset": 578890,
    "RowId": 4064,
    "Description": "Rüstungszersetzendes Geschoss."
  },
  {
    "RowOffset": 578934,
    "RowId": 4065,
    "Description": "Das Ziel wird biomagnetisiert und zu sich herangeholt."
  },
  {
    "RowOffset": 579002,
    "RowId": 4066,
    "Description": ""
  },
  {
    "RowOffset": 579014,
    "RowId": 4067,
    "Description": "Saugt aus feindlichen Maschinen Energie für den eigenen Bedarf ab."
  },
