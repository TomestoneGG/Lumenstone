  {
    "RowId": 11524,
    "Text": "Das Teilen in Echtzeit wurde beendet, da sich die Gruppengröße geändert hat.",
    "LogKind": {
      "RowId": 60,
      "SheetName": "LogKind"
    },
    "Unknown0": 8,
    "Unknown1": 0,
    "Unknown_70": 0,
    "Unknown2": false
  },
  {
    "RowId": 11525,
    "Text": "Das Teilen in Echtzeit wurde beendet, da sich die Gruppe nun im Kampf befindet.",
    "LogKind": {
      "RowId": 60,
      "SheetName": "LogKind"
    },
    "Unknown0": 8,
    "Unknown1": 0,
    "Unknown_70": 0,
    "Unknown2": false
  },
  {
    "RowId": 11526,
    "Text": "Das Teilen in Echtzeit wurde beendet, da das Areal gewechselt wurde.",
