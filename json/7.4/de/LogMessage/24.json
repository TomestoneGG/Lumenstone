  {
    "RowId": 11506,
    "Text": "Im aktuellen Erkundungsareal gibt es Intraplanetar-Ätheryten, mit denen du dich noch nicht harmonisiert hast.",
    "LogKind": {
      "RowId": 57,
      "SheetName": "LogKind"
    },
    "Unknown0": 1,
    "Unknown1": 0,
    "Unknown_70": 0,
    "Unknown2": false
  },
  {
    "RowId": 11507,
    "Text": "Das Intraplanetar-Ätherytennetz wurden erweitert.\nStandorte können auf der Karte eingesehen werden!",
    "LogKind": {
      "RowId": 57,
      "SheetName": "LogKind"
    },
    "Unknown0": 1,
    "Unknown1": 0,
    "Unknown_70": 0,
    "Unknown2": false
  },
  {
    "RowId": 11508,
    "Text": "制限時間に達したため、コンテンツを終了しました。",
    "LogKind": {
      "RowId": 57,
      "SheetName": "LogKind"
    },
