  {
    "RowOffset": 988670,
    "RowId": 11506,
    "Text": "Im aktuellen Erkundungsareal gibt es Intraplanetar-Ätheryten, mit denen du dich noch nicht harmonisiert hast.",
    "LogKind": {
      "RowId": 57,
      "SheetName": "LogKind"
    },
