    "Unknown2": false
  },
  {
    "RowOffset": 988802,
    "RowId": 11507,
    "Text": "Das Intraplanetar-Ätherytennetz wurden erweitert.\nStandorte können auf der Karte eingesehen werden!",
    "LogKind": {
      "RowId": 57,
      "SheetName": "LogKind"
    },
    "Unknown0": 1,
    "Unknown1": 0,
    "Unknown_70": 0,
    "Unknown2": false
  },
  {
    "RowOffset": 988930,
    "RowId": 11508,
    "Text": "制限時間に達したため、コンテンツを終了しました。",
