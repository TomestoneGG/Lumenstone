    "RowId": 2001,
    "Text": "Das große Jäten"
  },
  {
    "RowOffset": 39950,
    "RowId": 2002,
    "Text": "Punkte: <Num>IntegerParameter(1)</Num> / Höchstpunktzahl: <Num>IntegerParameter(2)</Num> "
  },
  {
    "RowOffset": 40006,
    "RowId": 2003,
    "Text": "Goldene Saliah-Eier (<Num>IntegerParameter(1)</Num> Pt.)"
  },
  {
    "RowOffset": 40050,
    "RowId": 2004,
    "Text": "Silberne Saliah-Eier (<Num>IntegerParameter(1)</Num> Pt.)"
  },
  {
    "RowOffset": 40094,
    "RowId": 2005,
    "Text": "Bronzene Saliah-Eier (<Num>IntegerParameter(1)</Num> Pt.)"
  },
  {
    "RowOffset": 40138,
    "RowId": 2006,
    "Text": "Pflanzenwesen-Zweige (<Num>IntegerParameter(1)</Num> Pt.)"
  },
  {
    "RowOffset": 40182,
    "RowId": 2007,
    "Text": "Merze die mysteriösen Pflanzenwesen aus und sichere dir Belohnungen!"
  },
  {
    "RowOffset": 40262,
    "RowId": 2008,
    "Text": "あっ、あれがツヨツヨ・トラップですぅ～！\nそこかしこの会場でお邪魔になっていて……！"
  },
  {
    "RowOffset": 40402,
    "RowId": 2009,
    "Text": "行く手を阻んでいた草むらが消えたぞッ！\n魔物を全て刈ったことで周囲への影響が薄れたか……先へ進もう！"
  },
  {
    "RowOffset": 40566,
    "RowId": 2010,
    "Text": "ひときわ目立つエレガントな変異種ちゃんがいるねェ！\nあの子も刈ってみてもらえるだろうか……！？"
  },
  {
    "RowOffset": 40722,
    "RowId": 2011,
    "Text": "ン～フフ、キミがそんな特別な力を得られるとは……！\nもしまた現れたら、ぜひとも逃さずに刈ってくれたまえッ！"
  },
  {
    "RowOffset": 40894,
    "RowId": 2012,
    "Text": "エッグハント・ガーデンサイズを使って、\nひとつ残らず、刈りつくしてください！"
  },
  {
    "RowOffset": 41022,
    "RowId": 2013,
    "Text": "草刈り達成"
  },
  {
    "RowOffset": 41050,
    "RowId": 2014,
    "Text": "ここが綺麗になれば、ひとまずの催し会場は確保できそう……！\nもうひと踏ん張り、よろしくお願いしますぅ～！"
  },
