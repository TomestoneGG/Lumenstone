  },
  {
    "RowOffset": 805246,
    "RowId": 40200,
    "Text": "Brutalo Bomber bezwingen"
  },
  {
    "RowOffset": 805282,
    "RowId": 40201,
    "Text": "Meine Explosionen werden euch wegfegen!"
  },
  {
    "RowOffset": 805334,
    "RowId": 40202,
    "Text": "Brutalo Bomber bringt wieder den Ring zum Beben!"
  },
  {
    "RowOffset": 805394,
    "RowId": 40203,
    "Text": "Gehehehe... Zeit für meine „Medizin“!"
  },
  {
    "RowOffset": 805454,
    "RowId": 40204,
    "Text": "Regelverstoß! Disqualifikation, Disqualifikation...!"
  },
  {
    "RowOffset": 805522,
    "RowId": 40205,
    "Text": "Schnauze! Aus dem Weg!"
  },
  {
    "RowOffset": 805558,
    "RowId": 40206,
    "Text": "Das gibt's doch nicht! Er hat den Ringrichter angegriffen!"
  },
  {
    "RowOffset": 805630,
    "RowId": 40207,
    "Text": "Sooo, jetzt können wir uns ungestört amüsieren!"
  },
  {
    "RowOffset": 805694,
    "RowId": 40208,
    "Text": "Es reicht nicht...! Dann helfen wir halt <i>damit</i> nach!"
  },
  {
    "RowOffset": 805774,
    "RowId": 40209,
    "Text": "Brutalo Bomber wächst und wächst!"
  },
  {
    "RowOffset": 805822,
    "RowId": 40210,
    "Text": "Verdammt, immer noch nicht genug! Ich brauch mehr!"
  },
  {
    "RowOffset": 805886,
    "RowId": 40211,
    "Text": "Brutalo Bomber pfeift auf alle Regeln!"
  },
  {
    "RowOffset": 805938,
    "RowId": 40212,
    "Text": "Wie schmeckt euch <i>das</i> hier?!"
  },
  {
    "RowOffset": 805990,
    "RowId": 40213,
    "Text": "Da ist er! Der „Brutalo-Spezial“!"
  },
  {
    "RowOffset": 806038,
    "RowId": 40214,
    "Text": "Meine Bombe hat Hunger!"
  },
  {
    "RowOffset": 806074,
    "RowId": 40215,
    "Text": "Diesem Höllenfeuer entkommt keiner!"
  },
  {
    "RowOffset": 806122,
    "RowId": 40216,
    "Text": "Eine Schlangengrube aus Zündschnüren! Was nun?!"
  },
  {
    "RowOffset": 806182,
    "RowId": 40217,
    "Text": "Ab jetzt gelten <i>meine</i> Regeln!"
  },
  {
    "RowOffset": 806234,
    "RowId": 40218,
    "Text": "Diesen Ketten entkommt keiner! Ein Kampf auf Leben und Tod!"
  },
  {
    "RowOffset": 806306,
    "RowId": 40219,
    "Text": "Unmöglich! Ich kann nicht verlieren!"
  },
  {
    "RowOffset": 806354,
    "RowId": 40220,
    "Text": "Achtung, Brutalo Bomber geht gleich in die Luft!"
  },
  {
    "RowOffset": 806414,
    "RowId": 40221,
    "Text": "Ihr kommt hier... nicht lebend raus...!"
  },
