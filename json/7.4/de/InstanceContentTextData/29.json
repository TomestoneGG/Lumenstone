    "Text": ""
  },
  {
    "RowOffset": 810134,
    "RowId": 40400,
    "Text": "Nur der wahre König wird diesen Kampf lebend verlassen...!"
  },
  {
    "RowOffset": 810210,
    "RowId": 40401,
    "Text": "Mehr Macht!"
  },
  {
    "RowOffset": 810234,
    "RowId": 40402,
    "Text": "Ghua ... Haa ... Khu ...!"
  },
  {
    "RowOffset": 810270,
    "RowId": 40403,
    "Text": "Mehr ... Ich brauche mehr ...!"
  },
  {
    "RowOffset": 810314,
    "RowId": 40404,
    "Text": "Was ... Was sind das für Phantome ...?!"
  },
  {
    "RowOffset": 810366,
    "RowId": 40405,
    "Text": "Weg mit euch!"
  },
  {
    "RowOffset": 810390,
    "RowId": 40406,
    "Text": "Abbilder ... meiner Schwäche ...?"
  },
  {
    "RowOffset": 810438,
    "RowId": 40407,
    "Text": "Nehmt das!"
  },
  {
    "RowOffset": 810462,
    "RowId": 40408,
    "Text": "Für mich existieren keine Grenzen ...!"
  },
  {
    "RowOffset": 810514,
    "RowId": 40409,
    "Text": "Verschwindet! Ihr Geister der Vergangenheit!"
  },
  {
    "RowOffset": 810578,
    "RowId": 40410,
    "Text": "Uaaaaargh!"
  },
  {
    "RowOffset": 810602,
    "RowId": 40411,
    "Text": "Alles und jeder ... kommt mir in die Quere ...!"
  },
  {
    "RowOffset": 810662,
    "RowId": 40412,
    "Text": "Der einzig würdige König ... bin ich!"
  },
  {
    "RowOffset": 810714,
    "RowId": 40413,
    "Text": "Das „Wunderkind“ gab es nie ...!"
  },
  {
    "RowOffset": 810762,
    "RowId": 40414,
    "Text": "Ich brauche nur mich selbst!!!"
  },
  {
    "RowOffset": 810806,
    "RowId": 40415,
    "Text": ""
  },
  {
    "RowOffset": 810818,
    "RowId": 40416,
    "Text": "Ich habe ... meinen Pfad gewählt ...!"
  },
  {
    "RowOffset": 810870,
    "RowId": 40417,
    "Text": ""
  },
  {
    "RowOffset": 810882,
    "RowId": 40418,
    "Text": "Hahaha! Endlich, die ultimative Stärke gehört mir!"
  },
  {
    "RowOffset": 810946,
    "RowId": 40419,
    "Text": "Der Thron ist mein! Diese Stärke ist der Beweis!"
  },
  {
    "RowOffset": 811006,
    "RowId": 40420,
    "Text": "Die Welt beugt sich meinem Willen!"
  },
  {
    "RowOffset": 811054,
    "RowId": 40421,
    "Text": "Mit der Welt im Einklang ...!"
  },
  {
    "RowOffset": 811094,
    "RowId": 40422,
    "Text": "Ich allein bestimme das Schicksal der Welt!"
  },
  {
    "RowOffset": 811150,
    "RowId": 40423,
    "Text": "Die Macht eines wahren Herrschers! Wie sie mir gebührt!"
  },
