    "Text": ""
  },
  {
    "RowOffset": 770422,
    "RowId": 39100,
    "Text": "Vorhang auf für Suzie Summ Honigsüß!"
  },
  {
    "RowOffset": 770474,
    "RowId": 39101,
    "Text": "Ein Angriff mit Bienengift! Das muss brennen!"
  },
  {
    "RowOffset": 770530,
    "RowId": 39102,
    "Text": "Der Moment, auf den wir alle gewartet haben!"
  },
  {
    "RowOffset": 770586,
    "RowId": 39103,
    "Text": "Die Zuschauer hält es kaum mehr auf ihren Sitzen!"
  },
  {
    "RowOffset": 770650,
    "RowId": 39104,
    "Text": "Können die Herausforderer dieser Versuchung widerstehen?!"
  },
  {
    "RowOffset": 770722,
    "RowId": 39105,
    "Text": "Ist da etwa jemand Hals über Kopf verliebt?!"
  },
  {
    "RowOffset": 770778,
    "RowId": 39106,
    "Text": "Oho?! Suzie scheint ihre Strategie zu ändern!"
  },
  {
    "RowOffset": 770838,
    "RowId": 39107,
    "Text": "Keine Seite gibt nach! Ein Kampf für die Ewigkeit!"
  },
  {
    "RowOffset": 770902,
    "RowId": 39108,
    "Text": "Mein Herz summ-summ-summt vor Freude!"
  },
  {
    "RowOffset": 770950,
    "RowId": 39109,
    "Text": "Das übersteht ihr doch, oooder?"
  },
  {
    "RowOffset": 770994,
    "RowId": 39110,
    "Text": "Mein Stachel wird euch bestrafen!"
  },
  {
    "RowOffset": 771038,
    "RowId": 39111,
    "Text": "Mein Gift kribbelt von Kopf bis Fuß!"
  },
  {
    "RowOffset": 771086,
    "RowId": 39112,
    "Text": "Vor mir fällt jeder auf die Knie!"
  },
  {
    "RowOffset": 771134,
    "RowId": 39113,
    "Text": "Summ! Summ! Super!"
  },
  {
    "RowOffset": 771166,
    "RowId": 39114,
    "Text": "Oh, so langsam kommt ihr in Fahrt, was?"
  },
  {
    "RowOffset": 771218,
    "RowId": 39115,
    "Text": "Seid mir nicht böse, wenn euch das umbringt, ja?"
  },
  {
    "RowOffset": 771278,
    "RowId": 39116,
    "Text": "Dieser Kampf ist der beste seit Langem!"
  },
  {
    "RowOffset": 771330,
    "RowId": 39117,
    "Text": "Meine Bienchen! Sind eure Herzen bereit für mich?!"
  },
  {
    "RowOffset": 771394,
    "RowId": 39118,
    "Text": "Empfangt meine Liebe!"
  },
  {
    "RowOffset": 771426,
    "RowId": 39119,
    "Text": "Echte Bienchen arbeiten fleißig für ihre Königin!"
  },
  {
    "RowOffset": 771490,
    "RowId": 39120,
    "Text": "Ich muss wieder auf die Bühne! Feuert mich weiter an, ja?"
  },
  {
    "RowOffset": 771562,
    "RowId": 39121,
    "Text": "Was, ihr seid mir nicht hilflos verfallen? Das glaub ich jetzt nicht!"
  },
  {
    "RowOffset": 771642,
    "RowId": 39122,
    "Text": "Eure Liebe gibt mir Kraft! Ihr seid summ-summ-super!"
  },
  {
    "RowOffset": 771706,
    "RowId": 39123,
    "Text": "Ach, kommt schon! Wieso seid ihr immer noch bei Sinnen?!"
  },
  {
    "RowOffset": 771774,
    "RowId": 39124,
    "Text": "Summ... Summ... Sterbt...!"
  },
  {
    "RowOffset": 771826,
    "RowId": 39125,
    "Text": "Weiter, immer weiter!"
  },
  {
    "RowOffset": 771858,
    "RowId": 39126,
    "Text": "Schluss damit... <i>Ich</i> stehe im Mittelpunkt...!"
  },
  {
    "RowOffset": 771934,
    "RowId": 39127,
    "Text": "Letzte Warnung... Ihr solltet lieber aufgeben...!"
  },
  {
    "RowOffset": 772002,
    "RowId": 39128,
    "Text": "Ihr seid... erledigt!"
  },
  {
    "RowOffset": 772038,
    "RowId": 39129,
    "Text": "Suzie Summ Honigsüß bezwingen"
