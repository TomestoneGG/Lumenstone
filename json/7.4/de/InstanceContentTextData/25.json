  },
  {
    "RowOffset": 737078,
    "RowId": 37999,
    "Text": ""
  },
  {
    "RowOffset": 737090,
    "RowId": 38000,
    "Text": "Diese Dunkelheit... Wie lange umgibt sie mich schon..."
  },
  {
    "RowOffset": 737166,
    "RowId": 38001,
    "Text": "So fließen die Schatten des Mondes zusammen..."
  },
  {
    "RowOffset": 737230,
    "RowId": 38002,
    "Text": "... und formen sich zu tiefster Schwärze!"
  },
  {
    "RowOffset": 737286,
    "RowId": 38003,
    "Text": "Kein Licht kann vollkommener Dunkelheit entkommen..."
  },
  {
    "RowOffset": 737354,
    "RowId": 38004,
    "Text": "Sinke in die Verzweiflung dieser Welt..."
  },
  {
    "RowOffset": 737418,
    "RowId": 38005,
    "Text": "Meine Klauen werden den Wall zwischen den Welten einreißen!"
  },
  {
    "RowOffset": 737490,
    "RowId": 38006,
    "Text": "Weiter... Noch viel weiter!"
  },
  {
    "RowOffset": 737534,
    "RowId": 38007,
    "Text": "Hinter diesem Wall liegt mein Zuhause... meine Heimat!"
  },
  {
    "RowOffset": 737606,
    "RowId": 38008,
    "Text": "Wo bin ich... Weshalb bin ich hier?"
  },
  {
    "RowOffset": 737658,
    "RowId": 38009,
    "Text": "Warum versperrt ihr meinen Weg...?"
  },
  {
    "RowOffset": 737710,
    "RowId": 38010,
    "Text": "Mich sehnt es doch nur nach meiner Heimat!"
  },
  {
    "RowOffset": 737766,
    "RowId": 38011,
    "Text": "Ein Stern schmiegt sich an den Mond, so wie einst..."
  },
  {
    "RowOffset": 737834,
    "RowId": 38012,
    "Text": "Lass uns den Nachthimmel gemeinsam erhellen!"
  },
  {
    "RowOffset": 737890,
    "RowId": 38013,
    "Text": "Dieser Wunsch zweier Seelen... Ich werde ihn erfüllen..."
  },
  {
    "RowOffset": 737966,
    "RowId": 38014,
    "Text": "Zurück in den Kreislauf des Lebens..."
  },
  {
    "RowOffset": 738022,
    "RowId": 38015,
    "Text": "Möge diese Kraft allen Erlösung bringen!"
  },
  {
    "RowOffset": 738078,
    "RowId": 38016,
    "Text": "Aber wieso? Wieso grämt euch mein innigster Wunsch?"
  },
  {
    "RowOffset": 738142,
    "RowId": 38017,
    "Text": "Jegliche Hindernisse werden dahinschmelzen!"
  },
  {
    "RowOffset": 738198,
    "RowId": 38018,
    "Text": "Hinfort mit dem gräulichen Licht!"
  },
  {
    "RowOffset": 738246,
    "RowId": 38019,
    "Text": "In dieser Welt findet sich keinerlei Rettung..."
  },
  {
    "RowOffset": 738310,
    "RowId": 38020,
    "Text": "Auf, an einen warmen, leuchtenden Ort!"
  },
  {
    "RowOffset": 738362,
    "RowId": 38021,
    "Text": "Ich verschlinge eure Seelen mit einem Biss!"
  },
  {
    "RowOffset": 738418,
    "RowId": 38022,
    "Text": "Aah, die Dunkelheit in mir drängt hinaus!"
  },
  {
    "RowOffset": 738474,
    "RowId": 38023,
    "Text": "In der Finsternis wird alles eins!"
  },
  {
    "RowOffset": 738522,
    "RowId": 38024,
    "Text": "Hinab in das sanfte Vergessen!"
  },
  {
    "RowOffset": 738566,
    "RowId": 38025,
    "Text": "Lasst auch euch von Dunkelheit umhüllen!"
  },
  {
    "RowOffset": 738618,
    "RowId": 38026,
    "Text": "Geboren in der Dunkelheit des Nichts..."
  },
  {
    "RowOffset": 738674,
    "RowId": 38027,
    "Text": "So leuchtet neues Leben wie ein Stern in der Nacht..."
  },
  {
    "RowOffset": 738742,
    "RowId": 38028,
    "Text": "Es gedeiht und wächst, voller Gesundheit!"
  },
  {
    "RowOffset": 738798,
    "RowId": 38029,
    "Text": "Oh, wenn ich nur noch einmal an seiner Seite weilen dürfte..."
  },
  {
    "RowOffset": 738878,
    "RowId": 38030,
    "Text": "Gebt mir meine geliebte Heimat zurück!"
  },
  {
    "RowOffset": 738930,
    "RowId": 38031,
    "Text": "Verschwindet... Alles in meinem Weg soll verschwinden!"
  },
  {
    "RowOffset": 739002,
    "RowId": 38032,
    "Text": "Dunkelheit... Nichts... Vollkommene Leere..."
  },
  {
