  },
  {
    "RowOffset": 581034,
    "RowId": 33399,
    "Text": ""
  },
  {
    "RowOffset": 581046,
    "RowId": 33400,
    "Text": "Widersacher des Legatus werden gnadenlos beseitigt!"
  },
  {
    "RowOffset": 581110,
    "RowId": 33401,
    "Text": "Spür das Schild des Kaisers ..."
  },
  {
    "RowOffset": 581154,
    "RowId": 33402,
    "Text": "Meine Schilde sind undurchbrechlich!"
  },
  {
    "RowOffset": 581202,
    "RowId": 33403,
    "Text": "Du wirst nicht entkommen!"
  },
  {
    "RowOffset": 581238,
    "RowId": 33404,
    "Text": "Mit dieser Kraft also fälltest du den großen Titan ..."
  },
  {
    "RowOffset": 581306,
    "RowId": 33405,
    "Text": "Mein Praefectus! Wir stehen an Eurer Seite!"
  },
  {
    "RowOffset": 581362,
    "RowId": 33406,
    "Text": "Ihr seid zurückgekommen? Ich hatte euch befohlen, zu verschwinden!"
  },
  {
    "RowOffset": 581442,
    "RowId": 33407,
    "Text": "Vergebt uns, Praefectus. Wir konnten Euch nicht im Stich lassen ..."
  },
  {
    "RowOffset": 581522,
    "RowId": 33408,
    "Text": ""
  },
  {
    "RowOffset": 581534,
    "RowId": 33409,
    "Text": "Ich werde den Mut und die Treue meiner Männer nicht umsonst sein lassen! Verlasst euch darauf!"
  },
  {
    "RowOffset": 581642,
    "RowId": 33410,
    "Text": "Dein Kopf soll rollen! Für Gaius! Für unseren Sieg!"
  },
  {
    "RowOffset": 581706,
    "RowId": 33411,
    "Text": ""
  },
  {
    "RowOffset": 581718,
    "RowId": 33412,
    "Text": ""
  },
  {
    "RowOffset": 581730,
    "RowId": 33413,
    "Text": ""
  },
  {
    "RowOffset": 581742,
    "RowId": 33414,
    "Text": "Für dich gibt es kein Entkommen!"
  },
  {
    "RowOffset": 581786,
    "RowId": 33415,
    "Text": "Dieses Inferno wird uns gemeinsam in den Tod reißen!"
  },
  {
    "RowOffset": 581850,
    "RowId": 33416,
    "Text": "Und wenn du mir die Finger zerschmetterst, ich werde nicht loslassen!"
  },
  {
    "RowOffset": 581930,
    "RowId": 33417,
    "Text": "Ich bringe dich um ... und wenn es das Letzte ist, was ich tue!"
  },
  {
    "RowOffset": 582006,
    "RowId": 33418,
    "Text": "Ruhet in Frieden. Auf dass ich euch schon sehr bald folgen möge ..."
  },
  {
    "RowOffset": 582086,
    "RowId": 33419,
    "Text": "\\\\<keuch> \\\\<keuch> Du bist stark, aber nicht stark genug. Dies ist dein Ende!"
  },
  {
    "RowOffset": 582174,
    "RowId": 33420,
    "Text": "Bezwinge Rhitahtyn sas Arvina"
  },
  {
    "RowOffset": 582214,
    "RowId": 33421,
    "Text": "Bezwinge Rhitahtyns Gefolge"
  },
  {
    "RowOffset": 582254,
    "RowId": 33422,
    "Text": "Bezwinge Rhitahtyn erneut"
  },
  {
    "RowOffset": 582290,
    "RowId": 33423,
    "Text": "Genug! Zieh dich zurück!"
  },
  {
    "RowOffset": 582326,
    "RowId": 33424,
    "Text": "Dies ist eine Technik aus meinem Heimatland! Lass sie mich dir demonstrieren!"
  },
  {
    "RowOffset": 582414,
    "RowId": 33425,
    "Text": "Na schön! Wenn du dich nicht zurückhältst, sollst auch du meine ganze Kraft kennenlernen!"
  },
  {
    "RowOffset": 582518,
    "RowId": 33426,
    "Text": "Ignoriere den Schmerz ... Entfache deinen Zorn! Kämpfe mit dem Feuer wilder Entschlossenheit!"
  },
  {
    "RowOffset": 582638,
    "RowId": 33427,
    "Text": "Erwarte keinen Funken Gnade von mir!"
  },
  {
    "RowOffset": 582686,
    "RowId": 33428,
    "Text": ""
  },
  {
    "RowOffset": 582698,
    "RowId": 33429,
    "Text": "Wir haben getan, was Ihr befohlen habt. Nun hält uns nichts mehr davon ab, bis zum Schluss an Eurer Seite zu kämpfen!"
  },
  {
    "RowOffset": 582830,
    "RowId": 33430,
    "Text": ""
  },
