  },
  {
    "RowOffset": 635394,
    "RowId": 34999,
    "Text": ""
  },
  {
    "RowOffset": 635406,
    "RowId": 35000,
    "Text": "Dieser Kerker wird euer Grab sein!"
  },
  {
    "RowOffset": 635454,
    "RowId": 35001,
    "Text": "An meine Seite, Bestie des Feuers!"
  },
  {
    "RowOffset": 635502,
    "RowId": 35002,
    "Text": "Wetze deine reißenden Klauen an ihnen!"
  },
  {
    "RowOffset": 635554,
    "RowId": 35003,
    "Text": "Zerfleische sie, bis nichts mehr übrig ist!"
  },
  {
    "RowOffset": 635610,
    "RowId": 35004,
    "Text": "Haltet mich nicht für irgendeinen beliebigen Halbgott ..."
  },
  {
    "RowOffset": 635682,
    "RowId": 35005,
    "Text": "Seht, was aus mir geworden ist!"
  },
  {
    "RowOffset": 635726,
    "RowId": 35006,
    "Text": "Züngelnde Flammen!"
  },
  {
    "RowOffset": 635758,
    "RowId": 35007,
    "Text": "In der Glut sollt ihr schmoren!"
  },
  {
    "RowOffset": 635802,
    "RowId": 35008,
    "Text": "Wie fühlt es sich an, malträtiert zu werden?"
  },
  {
    "RowOffset": 635862,
    "RowId": 35009,
    "Text": "Sterbt!"
  },
  {
    "RowOffset": 635882,
    "RowId": 35010,
    "Text": "Nur zu, lasst euch zermalmen! "
  },
  {
    "RowOffset": 635926,
    "RowId": 35011,
    "Text": "Aus meinen Augen!"
  },
  {
    "RowOffset": 635954,
    "RowId": 35012,
    "Text": "Bis hierhin und nicht weiter!"
  },
  {
    "RowOffset": 635994,
    "RowId": 35013,
    "Text": "Nichts als Abschaum!"
  },
  {
    "RowOffset": 636026,
    "RowId": 35014,
    "Text": "Mein Wunsch wird schon bald in Erfüllung gehen."
  },
  {
    "RowOffset": 636086,
    "RowId": 35015,
    "Text": "Erstickt an eurer Verzweiflung!"
  },
  {
    "RowOffset": 636138,
    "RowId": 35016,
    "Text": "Nur ein Narr stellt sich einem Gott!"
  },
  {
    "RowOffset": 636186,
    "RowId": 35017,
    "Text": "Es ist an der Zeit, meine Grenzen hinter mir zu lassen! "
  },
  {
    "RowOffset": 636254,
    "RowId": 35018,
    "Text": "Und wenn ich dafür diesen Körper opfern muss."
  },
  {
    "RowOffset": 636314,
    "RowId": 35019,
    "Text": "Meine neue Gestalt wird alles in den Schatten stellen!"
  },
  {
    "RowOffset": 636382,
    "RowId": 35020,
    "Text": "E-Endlich ... Vollkommenheit!"
  },
  {
    "RowOffset": 636422,
    "RowId": 35021,
    "Text": "Niedere ... Kreaturen!"
  },
  {
    "RowOffset": 636458,
    "RowId": 35022,
    "Text": "Eure niedere Existenz hat nun ein Ende."
  },
  {
    "RowOffset": 636510,
    "RowId": 35023,
    "Text": "Werdet ... zu einem Teil von mir!"
  },
  {
    "RowOffset": 636554,
    "RowId": 35024,
    "Text": "Eure Seelen braucht ihr jetzt nicht mehr!"
  },
  {
    "RowOffset": 636606,
    "RowId": 35025,
    "Text": "Wie kleine, tanzende Marionetten ..."
  },
  {
    "RowOffset": 636654,
    "RowId": 35026,
    "Text": "Verreckt! Verreckt, sage ich! "
  },
  {
    "RowOffset": 636698,
    "RowId": 35027,
    "Text": "Zerfallt im Chaos!"
  },
  {
    "RowOffset": 636730,
    "RowId": 35028,
    "Text": "Und nun ... in den Staub!"
  },
  {
    "RowOffset": 636766,
    "RowId": 35029,
    "Text": "Athena ... wo ist Athena?"
  },
  {
    "RowOffset": 636802,
    "RowId": 35030,
    "Text": "Verfaulen sollt ihr, allesamt!"
  },
  {
    "RowOffset": 636846,
    "RowId": 35031,
    "Text": "Lahabreas Kraft ... ist mein!"
  },
  {
    "RowOffset": 636886,
    "RowId": 35032,
    "Text": "Elende Maden! Eure Erlösung ist nah!"
  },
  {
    "RowOffset": 636934,
    "RowId": 35033,
    "Text": "Hephaistos besiegen"
  },
  {
