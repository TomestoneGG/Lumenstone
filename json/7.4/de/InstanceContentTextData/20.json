  {
    "RowId": 35100,
    "Text": "Ha! Sie sind doch tatsächlich gekommen!"
  },
  {
    "RowId": 35101,
    "Text": "Sieh an, du lässt dich auf einen Besuch bei mir herab?"
  },
  {
    "RowId": 35102,
    "Text": "So lasset die göttliche Prüfung beginnen!"
  },
  {
    "RowId": 35103,
    "Text": "Lauf der Zeit, beuge dich meinem Willen!"
  },
  {
    "RowId": 35104,
    "Text": "Dies ist die göttliche Essenz allen Seins!"
  },
  {
    "RowId": 35105,
    "Text": "Macht euch bereit!"
  },
  {
    "RowId": 35106,
    "Text": "Eure Stunde hat geschlagen!"
  },
  {
    "RowId": 35107,
    "Text": "Ihr könnt der Vergänglichkeit nicht entfliehen!"
  },
  {
    "RowId": 35108,
    "Text": "Es gibt kein Entrinnen!"
  },
  {
    "RowId": 35109,
    "Text": "Nun liegt es an euch, dem Schicksal zu trotzen!"
  },
  {
    "RowId": 35110,
    "Text": "Ich will sehen, was ihr könnt!"
  },
  {
    "RowId": 35111,
    "Text": "Sprecht euer Gebet zu den Sternen!"
  },
  {
    "RowId": 35112,
    "Text": "Oh, dieser herrliche Glanz!"
  },
  {
    "RowId": 35113,
    "Text": "Ertrinkt in den göttlichen Fluten!"
  },
  {
    "RowId": 35114,
    "Text": "Eines ist gewiss, ihr teilt alle dasselbe Schicksal!"
  },
  {
    "RowId": 35115,
    "Text": "Du bist an der Reihe, Nymeia. "
  },
  {
    "RowId": 35116,
    "Text": "Nichts lieber als das, Bruderherz."
  },
  {
    "RowId": 35117,
    "Text": "So folget dem Schicksal auf den Pfaden der Zeit!"
  },
  {
    "RowId": 35118,
    "Text": "Auf diesen Moment... habe ich lange gewartet..."
  },
  {
    "RowId": 35119,
    "Text": "Und so fand auch ich... meine Bestimmung..."
  },
  {
    "RowId": 35120,
    "Text": "Das Land der Fruchtbarkeit erobern"
  },
  {
    "RowId": 35121,
    "Text": "Den Fuß des Weltenbaums erobern"
  },
  {
    "RowId": 35122,
    "Text": "Den Weltenbaum erobern"
  },
  {
    "RowId": 35123,
    "Text": "Den Geschabten Gletscher erobern"
  },
  {
    "RowId": 35124,
    "Text": "Die Domäne der Furie erobern"
  },
  {
    "RowId": 35125,
    "Text": "Die Kammer der Zwillingsmonde erobern"
  },
  {
    "RowId": 35126,
    "Text": "Kaum zu glauben, dass Nophica uns selbst willkommen heißt!"
  },
  {
    "RowId": 35127,
    "Text": "Keine Probleme mit dem Ätheranalysator. Lass uns weitergehen."
  },
  {
    "RowId": 35128,
    "Text": "Auf mein Geheiß soll sich das Antlitz der Erde wandeln."
  },
  {
    "RowId": 35129,
    "Text": "Derart Raum und Zeit zu manipulieren... Wir stehen Althyk, dem Hüter, gegenüber!"
  },
  {
    "RowId": 35130,
    "Text": "Ha! Sie sind doch tatsächlich gekommen!"
  },
  {
    "RowId": 35131,
    "Text": "Sieh an, du lässt dich auf einen Besuch bei mir herab?"
  },
  {
    "RowId": 35132,
    "Text": "Fühlt euch geehrt, auf diesem Schlachtfeld fallen zu dürfen."
  },
  {
    "RowId": 35133,
    "Text": "Wir sind in ein gefrorenes Reich gekommen. Das bedeutet..."
  },
  {
    "RowId": 35134,
    "Text": "Nur weiter, die Front ist ganz nah!"
  },
  {
    "RowId": 35135,
    "Text": "Es scheint so gut wie sicher, dass Halone, die Furie, uns erwartet."
  },
  {
    "RowId": 35136,
    "Text": "Dieses Licht... Es scheint uns zu jenem Palast zu locken."
  },
  {
    "RowId": 35137,
    "Text": "Zeigt mir, wie viel Leben in euch steckt!"
  },
  {
    "RowId": 35138,
    "Text": "Ich rufe die Kräfte, die in der fruchtbaren Erde wohnen..."
  },
  {
    "RowId": 35139,
    "Text": "Das dürfte euch geschwächt haben."
  },
  {
    "RowId": 35140,
    "Text": "Lasst mich euch die Bedeutung von Fülle lehren!"
  },
  {
    "RowId": 35141,
    "Text": "Nichts fasziniert mich mehr als das Leben!"
  },
  {
    "RowId": 35142,
    "Text": "Reife Früchte erwartet die Ernte!"
  },
  {
    "RowId": 35143,
    "Text": "Auch ihr werdet bald den Boden nähren!"
  },
  {
    "RowId": 35144,
    "Text": "Möge das Kraut den Winden trotzen!"
  },
  {
    "RowId": 35145,
    "Text": "Fühlt ihr den Puls der Natur?"
  },
  {
    "RowId": 35146,
    "Text": "Erde den Blumen, Wasser dem Baume!"
  },
  {
    "RowId": 35147,
    "Text": "Gut gemacht, meine Kinder. Nun setzt euren Weg fort..."
  },
  {
    "RowId": 35148,
    "Text": "Keine Sorge, hier wird es euch an Liebe nicht fehlen."
  },
  {
    "RowId": 35149,
    "Text": "Ich demonstriere euch gerne mein Können!"
  },
  {
    "RowId": 35150,
    "Text": "Hm, ich habe mir das schwieriger vorgestellt."
  },
  {
    "RowId": 35151,
    "Text": "Hoffentlich seid ihr alle gut vorbereitet."
  },
  {
    "RowId": 35152,
    "Text": "Ich tue das nur, weil ich euch liebe!"
  },
  {
    "RowId": 35153,
    "Text": "Kommt, spielt mit meinem Kleinen!"
  },
  {
    "RowId": 35154,
    "Text": "Mein treuer Gefährte möchte mitmachen!"
  },
  {
    "RowId": 35155,
    "Text": "Meine Liebe für euch ist ungebrochen..."
  },
  {
    "RowId": 35156,
    "Text": "Krieger, beweist mir euren Kampfeswillen!"
  },
  {
    "RowId": 35157,
    "Text": "Eisige Lanze, durchbohre ihr Herz!"
  },
  {
    "RowId": 35158,
    "Text": "Blickt eurem Tod mit Stolz entgegen!"
  },
  {
    "RowId": 35159,
    "Text": "Ihr vergesst, wer euch gegenübersteht!"
  },
  {
    "RowId": 35160,
    "Text": "Ein Rückzug steht außer Frage!"
  },
  {
    "RowId": 35161,
    "Text": "Die Glorie des Sieges ist mein!"
  },
  {
    "RowId": 35162,
    "Text": "Erzittert vor dem Glanze des Gletschers!"
  },
  {
    "RowId": 35163,
    "Text": "Mein Schild ist meine Stärke!"
  },
  {
    "RowId": 35164,
    "Text": "Oh, könnte das Fechten doch ewig währen!"
  },
  {
    "RowId": 35165,
    "Text": "Das Blut soll auf unseren Klingen tanzen!"
  },
  {
    "RowId": 35166,
    "Text": "Geht! Euer Kampf ist noch nicht vorüber! "
  },
  {
    "RowId": 35167,
    "Text": "3 Sekunden, bis die Zeit sich beschleunigt."
  },
  {
    "RowId": 35168,
    "Text": "2 Sekunden, bis die Zeit sich beschleunigt."
  },
  {
    "RowId": 35169,
    "Text": "1 Sekunde, bis die Zeit sich beschleunigt."
  },
  {
    "RowId": 35170,
    "Text": "Die Zeit beschleunigt sich auf Althyks Geheiß!"
  },
  {
    "RowId": 35171,
    "Text": "Der Mond formt sich auf Menphinas Geheiß!"
  },
  {
    "RowId": 35172,
    "Text": "Der Mond beginnt zuzunehmen..."
  },
  {
    "RowId": 35173,
    "Text": "Wir schenken euch all unsere Liebe. Bitte nehmt sie an, meine Lieben!"
  },
  {
