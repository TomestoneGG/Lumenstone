  {
    "RowOffset": 648986,
    "RowId": 35400,
    "Text": "Optimale Verbindung zu Organismus „Artorius“. Intention: Vernichtung jeglicher Eindringlinge. Kampf wird initiiert."
  },
  {
    "RowOffset": 649118,
    "RowId": 35401,
    "Text": "Lade „Dimensionsklinge“. Anwendungsmodu...\nIch... erinnere mi..."
  },
  {
    "RowOffset": 649206,
    "RowId": 35402,
    "Text": "Starte Sequenz „Dimensionsklinge“. Leistungsfähigkeit des Originals wird äquivalent simuliert."
  },
  {
    "RowOffset": 649318,
    "RowId": 35403,
    "Text": "Phlegethon... a-a-alter Freund. Ich... In mir... E-Excalibur!"
  },
  {
    "RowOffset": 649402,
    "RowId": 35404,
    "Text": "Stimuliere elementaren Ätherausstoß zur Initiierung von Sequenz „Thermal-Spalter“."
  },
  {
    "RowOffset": 649502,
    "RowId": 35405,
    "Text": "Elementarer Ätherausstoß abgeschlossen. Überleitung zu Strahlungssequenz „Paradoxum“."
  },
  {
    "RowOffset": 649606,
    "RowId": 35406,
    "Text": "Schaden am Organismus überschreitet empfohlene Werte. Reanimation bei weitere...\nT-Töte... mich...!"
  },
  {
    "RowOffset": 649730,
    "RowId": 35407,
    "Text": "Störende Präsenz nach wie vor bestätigt. Wer sich dem Reich widersetzt, darf mit keiner Gnade rechnen."
  },
  {
    "RowOffset": 649846,
    "RowId": 35408,
    "Text": "Modulgenerierung gestartet. Initiiere Synchronschlag."
  },
