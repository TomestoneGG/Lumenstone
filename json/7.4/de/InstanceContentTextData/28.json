  },
  {
    "RowOffset": 785442,
    "RowId": 39698,
    "Text": ""
  },
  {
    "RowOffset": 785454,
    "RowId": 39699,
    "Text": ""
  },
  {
    "RowOffset": 785466,
    "RowId": 39700,
    "Text": "Verteidige Lösung Neun!"
  },
  {
    "RowOffset": 785502,
    "RowId": 39701,
    "Text": "Bezwinge die Maschinensoldaten!"
  },
  {
    "RowOffset": 785546,
    "RowId": 39702,
    "Text": "Suche die zurückgebliebenen Bewohner!"
  },
  {
    "RowOffset": 785598,
    "RowId": 39703,
    "Text": "Erledige die Bestien!"
  },
  {
    "RowOffset": 785630,
    "RowId": 39704,
    "Text": "Eile zum Ätherytenplatz!"
  },
  {
    "RowOffset": 785666,
    "RowId": 39705,
    "Text": "Kümmere dich um die Überlebenden!"
  },
  {
    "RowOffset": 785714,
    "RowId": 39706,
    "Text": "Bezwinge die Maschinensoldaten!"
  },
  {
    "RowOffset": 785758,
    "RowId": 39707,
    "Text": "Dränge die Maschinensoldaten zurück!"
  },
  {
    "RowOffset": 785810,
    "RowId": 39708,
    "Text": "Bekämpfe Otis, bis ihm die Kraft ausgeht!"
  },
  {
    "RowOffset": 785866,
    "RowId": 39709,
    "Text": "Bekämpfe die Bestie!"
  },
  {
    "RowOffset": 785898,
    "RowId": 39710,
    "Text": "Verhindere die Energieaufnahme!"
  },
  {
    "RowOffset": 785942,
    "RowId": 39711,
    "Text": "Bezwinge die Bestie, bevor Otis die Kraft ausgeht!"
  },
  {
    "RowOffset": 786006,
    "RowId": 39712,
    "Text": "Bitte, leiht mir eure Kraft ...!"
  },
  {
    "RowOffset": 786050,
    "RowId": 39713,
    "Text": "Mit meiner Befugnis kann ich auf Elektrob-Konstrukte zugreifen... Einen Moment ...!"
  },
  {
    "RowOffset": 786150,
    "RowId": 39714,
    "Text": "Geschafft... \\\\<keuch> Bitte... rettet mein Volk ...!"
  },
  {
    "RowOffset": 786222,
    "RowId": 39715,
    "Text": "Lasst uns zuerst hier aufräumen!"
  },
  {
    "RowOffset": 786266,
    "RowId": 39716,
    "Text": ""
  },
  {
    "RowOffset": 786278,
    "RowId": 39717,
    "Text": "Wir können noch viel mehr Leute retten! Lasst uns weitersuchen!"
  },
  {
    "RowOffset": 786354,
    "RowId": 39718,
    "Text": "Lasst mich einen Weg bereiten... Ich bitte dich, antworte mir, o Immerfried ...!"
  },
  {
    "RowOffset": 786450,
    "RowId": 39719,
    "Text": "Ich kann sie hören... All die Verzweiflung... Bitte seid unversehrt!"
  },
  {
    "RowOffset": 786546,
    "RowId": 39720,
    "Text": "Dass Zoraal Ja sich nicht einmal scheut, Bestien loszulassen ...!"
  },
  {
    "RowOffset": 786622,
    "RowId": 39721,
    "Text": "Wir haben keine Wahl! Los!"
  },
  {
    "RowOffset": 786662,
    "RowId": 39722,
    "Text": "Ihr seid wohlauf ... Ein Glück..."
  },
  {
    "RowOffset": 786714,
    "RowId": 39723,
    "Text": "All die Furcht, all der Schmerz, die ihr erfahren musstet... Bitte gebt nicht auf! Ich ... Nein, <i>wir</i> werden euch beschützen!"
  },
  {
    "RowOffset": 786866,
    "RowId": 39724,
    "Text": "Ich ... Nein, <i>wir</i> werden euch beschützen!"
  },
  {
    "RowOffset": 786930,
    "RowId": 39725,
    "Text": "Im Namen des Ritterordens! Schlagt unsere Feinde nieder!"
  },
  {
    "RowOffset": 786998,
    "RowId": 39726,
    "Text": "Hör auf! Erkennst du uns nicht?!"
  },
  {
    "RowOffset": 787042,
    "RowId": 39727,
    "Text": "Erste Formation! Zeigt ihnen die Führungsstärke der Ritter!"
  },
  {
    "RowOffset": 787114,
    "RowId": 39728,
    "Text": "Diese Maschinen folgen seinen Befehlen!"
  },
  {
    "RowOffset": 787166,
    "RowId": 39729,
    "Text": "Zweite Formation! Der Sieg ist zum Greifen nah!"
  },
  {
    "RowOffset": 787226,
    "RowId": 39730,
    "Text": "Diese Formationen ... Das ist nicht möglich ...!"
  },
  {
    "RowOffset": 787286,
    "RowId": 39731,
    "Text": "Dritte Formation! Vormarsch! Für Alexandria!"
  },
  {
    "RowOffset": 787342,
    "RowId": 39732,
    "Text": "Da kommt was Größeres! Passt auf!"
  },
  {
    "RowOffset": 787390,
    "RowId": 39733,
    "Text": "Kein Zweifel ... Er ist es wirklich ...!"
  },
  {
    "RowOffset": 787442,
    "RowId": 39734,
    "Text": "Können wir ihn nicht irgendwie zurückholen?!"
  },
  {
    "RowOffset": 787502,
    "RowId": 39735,
    "Text": "Wenn sich auch nur noch ein Fünkchen Erinnerung an mich in ihm befindet, dann ...!"
  },
  {
    "RowOffset": 787598,
    "RowId": 39736,
    "Text": ""
  },
  {
    "RowOffset": 787610,
    "RowId": 39737,
    "Text": "D-D-Die ... Kö... gin ... schütze...!"
  },
  {
    "RowOffset": 787662,
    "RowId": 39738,
    "Text": "Verzeiht, ich war nicht bei Sinnen!<Key>8205251</Key>Erlaubt mir, an Eurer Seite zu kämpfen!"
  },
  {
    "RowOffset": 787758,
    "RowId": 39739,
    "Text": "So viel Energie ... Seid vorsichtig!"
  },
  {
    "RowOffset": 787806,
    "RowId": 39740,
    "Text": ""
  },
  {
    "RowOffset": 787818,
    "RowId": 39741,
    "Text": "Seht Euch vor, er sammelt Blitze aus der Umgebung an!"
  },
  {
    "RowOffset": 787882,
    "RowId": 39742,
    "Text": "Wir müssen uns aufteilen und sie stoppen!"
  },
  {
    "RowOffset": 787938,
    "RowId": 39743,
    "Text": "Was?! Der ist nicht normal!"
  },
  {
    "RowOffset": 787978,
    "RowId": 39744,
    "Text": "So viele ... Das könnte eng werden ...!"
  },
  {
    "RowOffset": 788030,
    "RowId": 39745,
    "Text": "Meine Zeit ist gekommen!<Key>8205255</Key>Werdet geblendet von der edelsten Technik des Ritterordens!"
  },
  {
    "RowOffset": 788134,
    "RowId": 39746,
    "Text": "Urgh, welche Wucht!"
  },
  {
    "RowOffset": 788166,
    "RowId": 39747,
    "Text": "Welch überwältigendes Ausmaß an Blitzenergie ...!"
  },
  {
    "RowOffset": 788230,
    "RowId": 39748,
    "Text": "Verdammt, wenn das so weiter geht ...!"
  },
  {
    "RowOffset": 788282,
    "RowId": 39749,
    "Text": "Ich werde Euch beschützen! Im Namen der königlichen Ritter!"
  },
  {
    "RowOffset": 788354,
    "RowId": 39750,
    "Text": "Schnell! Entledigt Euch der Bestie!"
  },
  {
    "RowOffset": 788402,
    "RowId": 39751,
    "Text": "Otis! Dein Körper wird das nicht aushalten ...!!!"
  },
  {
    "RowOffset": 788466,
    "RowId": 39752,
    "Text": "Dann sei es so! Sollte dieser Körper auch vergehen, ich werde nicht weichen!"
  },
  {
    "RowOffset": 788554,
    "RowId": 39753,
    "Text": "Otis ...!!!"
  },
  {
    "RowOffset": 788578,
    "RowId": 39754,
    "Text": "Eure ... Hoheit ... Seid Ihr ... unverletzt?"
  },
  {
    "RowOffset": 788634,
    "RowId": 39755,
    "Text": "Werdet geblendet von der edelsten Technik des Ritterordens!"
  },
  {
