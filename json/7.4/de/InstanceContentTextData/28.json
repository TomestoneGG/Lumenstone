  },
  {
    "RowOffset": 789234,
    "RowId": 39800,
    "Text": "Hallo! Und auf Wiedersehen!"
  },
  {
    "RowOffset": 789278,
    "RowId": 39801,
    "Text": "Lebt ihr wirklich?"
  },
  {
    "RowOffset": 789310,
    "RowId": 39802,
    "Text": "\tSeid ihr glücklich?"
  },
  {
    "RowOffset": 789342,
    "RowId": 39803,
    "Text": "Lasst uns den Tod überwinden!"
  },
  {
    "RowOffset": 789386,
    "RowId": 39804,
    "Text": "Benötige Äther!"
  },
  {
    "RowOffset": 789414,
    "RowId": 39805,
    "Text": "Der Tod ist nicht das Ende! Fürchtet euch nicht!"
  },
  {
    "RowOffset": 789474,
    "RowId": 39806,
    "Text": "Seht die neu verbundene Welt!"
  },
  {
    "RowOffset": 789514,
    "RowId": 39807,
    "Text": "Sende Kampfeinheiten aus!"
  },
  {
    "RowOffset": 789550,
    "RowId": 39808,
    "Text": "Lebt ihr immer noch? Aktiviere Energiereserven!"
  },
  {
    "RowOffset": 789610,
    "RowId": 39809,
    "Text": "Lebt ihr immer noch? Entferne Sicherungsvorrichtungen!"
  },
  {
    "RowOffset": 789678,
    "RowId": 39810,
    "Text": "Raumkontrolle aktiviert! Vernichte existente Lebensformen!"
  },
  {
    "RowOffset": 789750,
    "RowId": 39811,
    "Text": "Maximale Belastung überschritten ... Unterbrechung notwendig."
  },
  {
    "RowOffset": 789826,
    "RowId": 39812,
    "Text": "Lebt ihr imm...? ... Aktivi... Raumkontrolle ...!"
  },
  {
    "RowOffset": 789886,
    "RowId": 39813,
    "Text": "Maximale Belastung ... Fehler entdeckt ..."
  },
  {
    "RowOffset": 789942,
    "RowId": 39814,
    "Text": "Unterbrechung unterbunden ... Ver..."
  },
  {
    "RowOffset": 789990,
    "RowId": 39815,
    "Text": "Ein Riss im Himmel!? Hat sie die Macht etwa nicht unter Kontrolle...?!"
  },
  {
    "RowOffset": 790078,
    "RowId": 39816,
    "Text": "Sphene! Hör mir zu!"
  },
  {
    "RowOffset": 790110,
    "RowId": 39817,
    "Text": "Ich verstehe deinen Entschluss ...! Und warum du nicht anders kannst."
  },
  {
    "RowOffset": 790190,
    "RowId": 39818,
    "Text": "Trotzdem ... Wenn wir wirklich miteinander kämpfen müssen..."
  },
  {
    "RowOffset": 790270,
    "RowId": 39819,
    "Text": "Dann kämpf mit Herz und Seele, Sphene! Nicht als kalte Maschine!"
  },
  {
    "RowOffset": 790346,
    "RowId": 39820,
    "Text": "Lama...ty'i..."
  },
  {
    "RowOffset": 790378,
    "RowId": 39821,
    "Text": "Sphene!"
  },
  {
    "RowOffset": 790398,
    "RowId": 39822,
    "Text": "Anomalie im Erinnerungsspeicher entdeckt."
  },
  {
    "RowOffset": 790450,
    "RowId": 39823,
    "Text": "Ein Teil von „Sphene“ wurde wiederhergestellt. "
  },
  {
    "RowOffset": 790522,
    "RowId": 39824,
    "Text": "Meinen Wunsch ... Ich werde ihn nicht aufgeben...!"
  },
  {
    "RowOffset": 790590,
    "RowId": 39825,
    "Text": "Ich will niemanden mehr verlieren...!"
  },
  {
    "RowOffset": 790642,
    "RowId": 39826,
    "Text": "Mir geht es genauso ... Dieser Schmerz ist unerträglich."
  },
  {
    "RowOffset": 790710,
    "RowId": 39827,
    "Text": "Endlich verstehen wir einander."
  },
  {
    "RowOffset": 790754,
    "RowId": 39828,
    "Text": "Das ist gemein ... So etwas jetzt zu sagen...!"
  },
  {
    "RowOffset": 790818,
    "RowId": 39829,
    "Text": "Es endet hier, Sphene ...! Gemeinsam mit meinen Freunden werde ich dich aufhalten!"
  },
  {
    "RowOffset": 790914,
    "RowId": 39830,
    "Text": "Ich gebe nicht nach ... Bis zum Ende...!"
  },
  {
    "RowOffset": 790970,
    "RowId": 39831,
    "Text": "Ich werde das Lachen meiner Bürger beschützen!"
  },
  {
    "RowOffset": 791030,
    "RowId": 39832,
    "Text": "Deine Hoffnung wird in mir weiterleben ..."
  },
  {
    "RowOffset": 791086,
    "RowId": 39833,
    "Text": "Wir werden dich besiegen!"
  },
  {
    "RowOffset": 791122,
    "RowId": 39834,
    "Text": "Absolute Autorität in 5..."
  },
  {
    "RowOffset": 791166,
    "RowId": 39835,
    "Text": "Absolute Autorität in 4..."
  },
  {
    "RowOffset": 791210,
