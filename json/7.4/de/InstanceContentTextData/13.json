    "Text": ""
  },
  {
    "RowOffset": 485846,
    "RowId": 26300,
    "Text": "Schütze Alisaie!"
  },
  {
    "RowOffset": 485874,
    "RowId": 26301,
    "Text": "Kanalisiere deinen Äther gen Alisaie!"
  },
  {
    "RowOffset": 485926,
    "RowId": 26302,
    "Text": "Bezwinge den Felsspalter des 2. Ordens!"
  },
  {
    "RowOffset": 485978,
    "RowId": 26303,
    "Text": "Kanalisiere mehr Äther gen Alisaie!"
  },
  {
    "RowOffset": 486026,
    "RowId": 26304,
    "Text": "Das garstige Mädchen zaubert garstige Zauber auf Za Da! Tötet sie! Tötet sie!"
  },
  {
    "RowOffset": 486118,
    "RowId": 26305,
    "Text": "Ganz sicher nicht!"
  },
  {
    "RowOffset": 486150,
    "RowId": 26306,
    "Text": "<split(<String>ObjectParameter(1)</String>, ,1)>, locke die Golems zu mir! Mit ihnen mache ich kurzen Prozess!"
  },
  {
    "RowOffset": 486242,
    "RowId": 26307,
    "Text": "Gut, wir sind soweit. Los, Angel!"
  },
  {
    "RowOffset": 486286,
    "RowId": 26308,
    "Text": "Verflucht...! Die Besessenheit ist zu stark! Viel stärker als bei Ga Bu!"
  },
  {
    "RowOffset": 486374,
    "RowId": 26309,
    "Text": "Ganz wie befürchtet. Alisaies Kraft alleine reicht nicht."
  },
  {
    "RowOffset": 486446,
    "RowId": 26310,
    "Text": "Sie wenden sich gen Alisaie! Rückt zusammen!"
  },
  {
    "RowOffset": 486502,
    "RowId": 26311,
    "Text": "Alphinaud, lass uns Alisaie zur Hand gehen."
  },
  {
    "RowOffset": 486558,
    "RowId": 26312,
    "Text": "Danke! Damit startet Versuch Nummer Zwei!"
  },
  {
    "RowOffset": 486610,
    "RowId": 26313,
    "Text": "A-Alisaie... Ich kann bald nicht mehr!"
  },
  {
    "RowOffset": 486666,
    "RowId": 26314,
    "Text": "Bei Lymlaen, sie nehmen kein Ende..."
  },
  {
    "RowOffset": 486718,
    "RowId": 26315,
    "Text": "Überlasst das mir! Zurück, alle!"
  },
  {
    "RowOffset": 486766,
    "RowId": 26316,
    "Text": "Eynzahr, du Wahnsinniger... Alisaie, jetzt oder nie!"
  },
  {
    "RowOffset": 486834,
    "RowId": 26317,
    "Text": "Gut! Bitte, bitte lass es diesmal funktionieren..."
  },
  {
    "RowOffset": 486902,
    "RowId": 26318,
    "Text": "\\\\<schnauf> Fast geschafft... <split(<String>ObjectParameter(1)</String>, ,1)>, auf deinen Äther kommt es jetzt an!"
  },
  {
    "RowOffset": 487002,
    "RowId": 26319,
    "Text": "Kekekeke! Tod für das Mädchen, ja!"
  },
  {
    "RowOffset": 487050,
    "RowId": 26320,
    "Text": "Admiral, es ist zu gefährlich!"
  },
  {
    "RowOffset": 487094,
    "RowId": 26321,
    "Text": "Ich kam mit gestähltem Herzen hierher. Limsa Lominsa wird ihren Frieden haben, ganz gleich, was es mich kostet!"
  },
  {
    "RowOffset": 487218,
    "RowId": 26322,
    "Text": "私とて、かつては海賊の頭領だったのだ……\nこの身はそんなにやわではない！"
  },
  {
    "RowOffset": 487338,
    "RowId": 26323,
    "Text": "Tötet sie! Tötet sie alleee! Kekekeke!"
  },
  {
    "RowOffset": 487390,
    "RowId": 26324,
    "Text": "Diesmal wird es klappen, ich spüre es!"
  },
  {
    "RowOffset": 487442,
    "RowId": 26325,
    "Text": "Argh! Noch mehr Feinde im Anmarsch."
  },
  {
    "RowOffset": 487490,
    "RowId": 26326,
    "Text": "Das sind Bomber! Haltet sie von Alisaie fern!"
  },
  {
    "RowOffset": 487546,
    "RowId": 26327,
    "Text": "Verstärkung... Lasst sie nicht an Alisaie heran!"
  },
  {
    "RowOffset": 487610,
    "RowId": 26328,
    "Text": "Nur noch ein bisschen mehr, <split(<String>ObjectParameter(1)</String>, ,1)>! Ich bin fast soweit...!"
  },
