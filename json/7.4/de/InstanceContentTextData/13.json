  },
  {
    "RowOffset": 488546,
    "RowId": 26400,
    "Text": "Den Schattenkönig besiegen"
  },
  {
    "RowOffset": 488586,
    "RowId": 26401,
    "Text": "Durch dein Opfer wurde ein Krieger geboren ...\nIch werde dir keine Gnade zeigen und erwarte selber keine!"
  },
  {
    "RowOffset": 488706,
    "RowId": 26402,
    "Text": "Ich bin der Schattenkönig!\nVor mir gibt es kein Entkommen!"
  },
  {
    "RowOffset": 488782,
    "RowId": 26403,
    "Text": "In Schatten gehüllt liege ich im Hinterhalt!"
  },
  {
    "RowOffset": 488838,
    "RowId": 26404,
    "Text": "Der Tod lauert auf Schritt und Tritt!"
  },
  {
    "RowOffset": 488886,
    "RowId": 26405,
    "Text": "Dein Schatten ist mein!"
  },
  {
    "RowOffset": 488922,
    "RowId": 26406,
    "Text": "Hinterhältig betrogen, auf vielfache Weise!"
  },
  {
    "RowOffset": 488978,
    "RowId": 26407,
    "Text": "Meine Welt, verzehrt von Dunkelheit. Die Quelle meiner Macht..."
  },
  {
    "RowOffset": 489058,
    "RowId": 26408,
    "Text": "Alle Schatten unterstehen mir, und deiner bildet keine Ausnahme!"
  },
  {
    "RowOffset": 489134,
    "RowId": 26409,
    "Text": "Trotz all deiner Stärke kannst du dich nicht widersetzen!"
  },
  {
    "RowOffset": 489206,
    "RowId": 26410,
    "Text": "Dies ist das Ende unseres Abenteuers.\nDu warst mein Ein und Alles..."
  },
