    "Text": ""
  },
  {
    "RowOffset": 495690,
    "RowId": 26776,
    "Text": ""
  },
  {
    "RowOffset": 495702,
    "RowId": 26777,
    "Text": ""
  },
  {
    "RowOffset": 495714,
    "RowId": 26778,
    "Text": ""
  },
  {
    "RowOffset": 495726,
    "RowId": 26779,
    "Text": "Sie bereiten eine Offensive vor! Lasst sie nicht aus den Augen!"
  },
  {
    "RowOffset": 495802,
    "RowId": 26780,
    "Text": "Eine massive Energiesignatur! Achtet auf die Richtung ihres Dralls!"
  },
  {
    "RowOffset": 495882,
    "RowId": 26781,
    "Text": ""
  },
  {
    "RowOffset": 495894,
