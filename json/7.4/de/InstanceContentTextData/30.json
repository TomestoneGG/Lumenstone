    "Text": ""
  },
  {
    "RowOffset": 815730,
    "RowId": 40600,
    "Text": "Meine Klauen zucken vor Aufregung!"
  },
  {
    "RowOffset": 815778,
    "RowId": 40601,
    "Text": "Hier die erste Gegnerin: Schwarze Katze!"
  },
  {
    "RowOffset": 815830,
    "RowId": 40602,
    "Text": "Können sie ihren Krallen wirklich ohne Regulator standhalten?!"
  },
  {
    "RowOffset": 815906,
    "RowId": 40603,
    "Text": "Nichts hält meinen Krallen stand!"
  },
  {
    "RowOffset": 815954,
    "RowId": 40604,
    "Text": "Schwarze Katze bereitet ihren Spezialangriff vor!"
  },
  {
    "RowOffset": 816014,
    "RowId": 40605,
    "Text": "Das gibt's ja nicht! Sie hat den Ring zerbrochen!"
  },
  {
    "RowOffset": 816074,
    "RowId": 40606,
    "Text": "Ah, aber der Ring wird repariert! Und das mitten im Kampf!"
  },
  {
    "RowOffset": 816146,
    "RowId": 40607,
    "Text": "Schärfer als jede Klinge!"
  },
  {
    "RowOffset": 816186,
    "RowId": 40608,
    "Text": "Mal sehen, wie schnell ihr wirklich seid!"
  },
  {
    "RowOffset": 816238,
    "RowId": 40609,
    "Text": "Durchbohrt gefallt ihr mir besser!"
  },
  {
    "RowOffset": 816286,
    "RowId": 40610,
    "Text": "Zeit für einen Höhenflug!"
  },
  {
    "RowOffset": 816326,
    "RowId": 40611,
    "Text": "In den Staub mit euch!"
  },
  {
    "RowOffset": 816362,
    "RowId": 40612,
    "Text": "Jede Katze hat sieben Leben! Auch gespalten bleibt ihr Geist vereint!"
  },
  {
    "RowOffset": 816442,
    "RowId": 40613,
    "Text": "Oh, werden wir etwa Zeuge von „Sieben Leben“?!"
  },
  {
    "RowOffset": 816506,
    "RowId": 40614,
    "Text": "Zu mir, mein Schatten!"
  },
  {
    "RowOffset": 816542,
    "RowId": 40615,
    "Text": "Geist, nimm Form an!"
  },
  {
    "RowOffset": 816574,
    "RowId": 40616,
    "Text": "Was für ein unnachgiebiger Kombinationsangriff!"
  },
  {
    "RowOffset": 816634,
    "RowId": 40617,
    "Text": "Hayaa!"
  },
  {
    "RowOffset": 816654,
    "RowId": 40618,
    "Text": "Ich schlitze euch auf!"
  },
  {
    "RowOffset": 816690,
    "RowId": 40619,
    "Text": "Wie wär es hiermit?!"
  },
  {
    "RowOffset": 816722,
    "RowId": 40620,
    "Text": "Zeit, dieses Katz-und-Maus-Spiel zu beenden...!"
  },
  {
    "RowOffset": 816786,
    "RowId": 40621,
    "Text": "Selbst schuld, ohne Regulator anzutreten...!!!"
  },
  {
    "RowOffset": 816850,
    "RowId": 40622,
    "Text": "Schwarze Katze bezwingen"
  },
