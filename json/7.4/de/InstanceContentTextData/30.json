  {
    "RowId": 40700,
    "Text": "Uuh, das hat gesessen! Aber noch ist nichts entschieden!"
  },
  {
    "RowId": 40701,
    "Text": "Uff, den hab sogar <i>ich</i> gespürt! Was für ein Angriff!"
  },
  {
    "RowId": 40702,
    "Text": "Ausgewichen, als wär es nichts!"
  },
  {
    "RowId": 40703,
    "Text": "Fantastisch! Perfekt ausgewichen!"
  },
  {
    "RowId": 40704,
    "Text": "Oh, das sieht gar nicht gut aus für unsere Herausforderer!"
  },
  {
    "RowId": 40705,
    "Text": "Aah, ein herber Schlag für die Herausforderer!"
  },
  {
    "RowId": 40706,
    "Text": "Und es geht weiter! Dieser Kampf ist noch nicht zu Ende!"
  },
  {
    "RowId": 40707,
    "Text": "Unsere Herausforderer sahen schon mal besser aus!"
  },
  {
    "RowId": 40708,
    "Text": "Oh, sie gehen aufs Ganze! Wird das den Kampf entscheiden?!"
  },
  {
    "RowId": 40709,
    "Text": "Die Herausforderer setzen alles auf ihre Heilung! Können sie den Spieß umdrehen?!"
  },
  {
    "RowId": 40710,
    "Text": "Was für ein Defensivmanöver! Wie eine Wand aus Stahl!"
  },
  {
    "RowId": 40711,
    "Text": "Und raus aus dem Ring! Können sie sich davon erholen?!"
  },
  {
    "RowId": 40712,
    "Text": "Der Kampf ist vorbei!"
  },
  {
    "RowId": 40713,
    "Text": "Und voll erwischt! Das gibt Narben!"
  },
  {
    "RowId": 40714,
    "Text": "Uh, davon würde ich mich lieber nicht treffen lassen!"
  },
  {
    "RowId": 40715,
    "Text": "Ooh, da war wohl jemand zu langsam!"
  },
  {
    "RowId": 40716,
    "Text": "Aah, das muss wehtun! Aber noch stehen die Herausforderer!"
  },
  {
    "RowId": 40717,
    "Text": "Das war den Herausforderern wohl zu einfach!"
  },
  {
    "RowId": 40718,
    "Text": "Die Herausforderer sind einfach nicht zu stoppen!"
  },
  {
    "RowId": 40719,
    "Text": "Flink ausgewichen! Sensationell!"
  },
  {
    "RowId": 40720,
    "Text": "Sie haben nicht einen Kratzer abbekommen!"
  },
  {
    "RowId": 40721,
    "Text": "Ooh, ist der Kampf etwa schon vorbei?!"
  },
  {
    "RowId": 40722,
    "Text": "Sie fallen wie die Fliegen! Haben sie den Gegner unterschätzt?!"
  },
  {
    "RowId": 40723,
    "Text": "Zäh wie eh und je! Aber wird das für den Sieg reichen?!"
  },
  {
    "RowId": 40724,
    "Text": "Sie geben nicht auf! Haben die Herausforderer noch eine Chance?"
  },
  {
    "RowId": 40725,
    "Text": "Oh, das tut ja nur vom Zusehen weh!"
  },
  {
    "RowId": 40726,
    "Text": "Uh, dem Angriff konnten nicht alle ausweichen!"
  },
  {
    "RowId": 40727,
    "Text": "Aah, da hat wohl jemand nicht aufgepasst!"
  },
  {
    "RowId": 40728,
    "Text": "Ein direkter Treffer! Aber sie gehen nicht zu Boden!"
  },
  {
    "RowId": 40729,
    "Text": "Geschmeidig wie eh und je!"
  },
  {
    "RowId": 40730,
    "Text": "Beeindruckend! Sie sind geschickt ausgewichen!"
  },
  {
    "RowId": 40731,
    "Text": "Wahnsinn, sie werden wirklich mit allem fertig!"
  },
  {
    "RowId": 40732,
    "Text": "Die Herausforderer lassen nichts an sich heran!"
  },
  {
    "RowId": 40733,
    "Text": "Oooh, und sie gehen zu Boooden!"
  },
  {
    "RowId": 40734,
    "Text": "Oje oje, haben die Herausforderer noch ein Ass im Ärmel?"
  },
  {
    "RowId": 40735,
    "Text": "Und sie stehen wieder! Aufgeben kommt nicht in Frage!"
  },
  {
    "RowId": 40736,
    "Text": "Sie sind zurück im Kampf! Lässt sich das Blatt noch wenden?!"
  },
