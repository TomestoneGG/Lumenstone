  {
    "RowId": 40900,
    "Text": "Die Elektrobgrube erreichen"
  },
  {
    "RowId": 40901,
    "Text": "Den Lindblum-Zaghnal besiegen"
  },
  {
    "RowId": 40902,
    "Text": "Die Seelenaufbewahrung erreichen"
  },
  {
    "RowId": 40903,
    "Text": "Forschungsleiter Kanilokka besiegen"
  },
  {
    "RowId": 40904,
    "Text": "Das Gefängnis des Leporiden erreichen"
  },
  {
    "RowId": 40905,
    "Text": "Lunipyati besiegen"
  },
  {
    "RowId": 40906,
    "Text": "Mein Vater war hier. Und bestimmt nicht ohne Grund ..."
  },
  {
    "RowId": 40907,
    "Text": "Das sieht so stark aus. Passt besser auf!"
  },
  {
    "RowId": 40908,
    "Text": "Das ist also Yuweyawata ..."
  },
  {
    "RowId": 40909,
    "Text": "Was haben sie hier wohl erforscht ...?"
  },
  {
    "RowId": 40910,
    "Text": "Ich hab ein ganz schlechtes Gefühl bei der Sache ..."
  },
  {
    "RowId": 40911,
    "Text": "Was ist denn mit diesem, äh... Sturm da los?"
  },
  {
    "RowId": 40912,
    "Text": "Etwas stimmt da nicht... Bitte lasst mich nicht allein!"
  },
  {
    "RowId": 40913,
    "Text": "War das etwa die ganze Zeit über hier eingesperrt?!"
  },
  {
    "RowId": 40914,
    "Text": "Hnng... Eure Seelen... für König Zoraal Ja!!!"
  },
  {
    "RowId": 40915,
    "Text": "Ooohhh, meine lieben Seelchen... Zeigt euch!"
  },
  {
    "RowId": 40916,
    "Text": "Kein Entkommen... Ihr kostbaren Pröbchen!"
  },
  {
    "RowId": 40917,
    "Text": "Weg mit dem Fleisch, her mit der Seele ...!"
  },
  {
    "RowId": 40918,
    "Text": "Warum haltet ihr so sehr an ihnen fest? <i>Er</i> verlangt sie ..."
  },
  {
    "RowId": 40919,
    "Text": "Gebt sie her ...! Im Namen ewiger Glorie!"
  },
  {
    "RowId": 40920,
    "Text": "Seelen... Unsere Forschung braucht... mehr Seelen ..."
  },
  {
    "RowId": 40921,
    "Text": "Die Bestie... Wenn ich doch nur... Ihr Siegel ist... gebrochen ..."
  },
  {
    "RowId": 40922,
    "Text": "Uwaah! Was war das für ein Gebrüll?! Kam das etwa von da drinnen ...?!"
  },
