  {
    "RowOffset": 691282,
    "RowId": 36799,
    "Text": ""
  },
  {
    "RowOffset": 691294,
    "RowId": 36800,
    "Text": "Ich bin Asura. Der Kampf ist mein Leben."
  },
  {
    "RowOffset": 691346,
    "RowId": 36801,
    "Text": "Stärke und Mut! Beides will ich in euch sehen!"
  },
  {
    "RowOffset": 691406,
    "RowId": 36802,
    "Text": "Können eure Augen meinen Klingen folgen?"
  },
  {
    "RowOffset": 691458,
    "RowId": 36803,
    "Text": "Weicht nur aus... wenn ihr könnt!"
  },
  {
    "RowOffset": 691510,
    "RowId": 36804,
    "Text": "Sehet die Macht der Manusya!"
  },
  {
    "RowOffset": 691550,
    "RowId": 36805,
    "Text": "Erhalte Form, Geist der Schlacht!"
  },
  {
    "RowOffset": 691594,
    "RowId": 36806,
    "Text": "Ein Schlachtfeld, gebührend eines wahren Kampfes!"
  },
  {
    "RowOffset": 691658,
    "RowId": 36807,
    "Text": "Geist der Schlacht, öffne deine Augen!"
  },
  {
    "RowOffset": 691710,
    "RowId": 36808,
    "Text": "Ich habe die Kunst der sechs Schwerter gemeistert!"
  },
  {
    "RowOffset": 691774,
    "RowId": 36809,
    "Text": "Vielfältig sind meine Gesichter..."
  },
  {
    "RowOffset": 691826,
    "RowId": 36810,
    "Text": "Wie Blätter im Wind!"
  },
  {
    "RowOffset": 691858,
    "RowId": 36811,
    "Text": "Nur der Tod wartet auf jene ohne Macht!"
  },
  {
    "RowOffset": 691910,
    "RowId": 36812,
    "Text": "Nun wollen wir uns vergnügen!"
  },
  {
    "RowOffset": 691954,
    "RowId": 36813,
    "Text": "Niemand ist mir gewachsen!"
  },
  {
    "RowOffset": 691994,
    "RowId": 36814,
    "Text": "Ich zerschmettere euch zu Staub!"
  },
  {
