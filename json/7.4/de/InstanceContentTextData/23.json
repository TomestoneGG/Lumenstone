  },
  {
    "RowOffset": 693046,
    "RowId": 36899,
    "Text": ""
  },
  {
    "RowOffset": 693058,
    "RowId": 36900,
    "Text": "Athena bezwingen"
  },
  {
    "RowOffset": 693086,
    "RowId": 36901,
    "Text": "Helft mir, euch zu verstehen! So werde ich meine Vollendung erlangen!"
  },
  {
    "RowOffset": 693166,
    "RowId": 36902,
    "Text": "Es entstehe Leben, wo keines war!"
  },
  {
    "RowOffset": 693210,
    "RowId": 36903,
    "Text": "Alle Existenz in diese Ketten..."
  },
  {
    "RowOffset": 693258,
    "RowId": 36904,
    "Text": "Eine Seele für den schweigenden Körper!"
  },
  {
    "RowOffset": 693310,
    "RowId": 36905,
    "Text": "Dies ist nur ein Bruchteil göttlicher Macht!"
  },
  {
    "RowOffset": 693366,
    "RowId": 36906,
    "Text": "Stärke in vollkommener Form!"
  },
  {
    "RowOffset": 693406,
    "RowId": 36907,
    "Text": "Es bebe selbst der Sieben Höllen tiefster Schlund! Erhebe dich! Dunkler Wirbel, entfalte dich!"
  },
  {
    "RowOffset": 693514,
    "RowId": 36908,
    "Text": "Ihr haltet stand... Wahrlich wundersame Wesen."
  },
  {
    "RowOffset": 693578,
    "RowId": 36909,
    "Text": "Denkt ihr wirklich, ihr seid einer Göttin gewachsen?"
  },
  {
    "RowOffset": 693642,
    "RowId": 36910,
    "Text": "Zeigt mir das Leuchten eurer Seelen!"
  },
  {
    "RowOffset": 693690,
    "RowId": 36911,
    "Text": "Ein weiterer Beweis meiner Theorie!"
  },
  {
    "RowOffset": 693738,
    "RowId": 36912,
    "Text": "Das kann nicht sein... Der Spaß hat nun ein Ende."
  },
  {
    "RowOffset": 693806,
    "RowId": 36913,
    "Text": "Diese schwächlichen Seelen wollen eine Göttin überragen?!"
  },
  {
    "RowOffset": 693878,
    "RowId": 36914,
    "Text": "Unmöglich... War meine Theorie falsch?"
  },
  {
    "RowOffset": 693934,
    "RowId": 36915,
    "Text": "Ist mein Wunsch noch nicht groß genug?"
  },
  {
    "RowOffset": 693986,
    "RowId": 36916,
    "Text": "O Sabik... So erhöre mein Verlangen!"
  },
  {
    "RowOffset": 694038,
    "RowId": 36917,
    "Text": "Genau... Es war nicht <i>ich</i>, die falsch lag..."
  },
  {
    "RowOffset": 694114,
    "RowId": 36918,
    "Text": "Diese Welt... Diese Welt ist verkehrt..."
  },
  {
    "RowOffset": 694174,
    "RowId": 36919,
    "Text": "Ich werde sie von Grund auf neu erbauen!"
  },
  {
    "RowOffset": 694226,
    "RowId": 36920,
    "Text": "Als wahre Göttin, Erschafferin von Welten!"
  },
  {
    "RowOffset": 694282,
    "RowId": 36921,
    "Text": "Die Welt, in ihrer idealen Form!"
  },
  {
    "RowOffset": 694326,
    "RowId": 36922,
    "Text": "O Himmel, tanzt einen Reigen!"
  },
  {
    "RowOffset": 694366,
    "RowId": 36923,
    "Text": "Erhebt euch, rastlose Seelen! Eure Aufgabe liegt in dieser Welt!"
  },
  {
    "RowOffset": 694442,
    "RowId": 36924,
    "Text": "Nun werdet ihr eure Wahl beklagen, mich zu erzürnen... Fallt herab, ihr Sterne!"
  },
  {
    "RowOffset": 694538,
    "RowId": 36925,
    "Text": "Die Elemente ziehen sich an!"
  },
  {
    "RowOffset": 694578,
    "RowId": 36926,
    "Text": "Alles in stetigem Wandel!"
  },
  {
    "RowOffset": 694614,
    "RowId": 36927,
    "Text": "Kennt ihr die wahre Natur der Hitze?"
  },
  {
    "RowOffset": 694662,
    "RowId": 36928,
    "Text": "Ich weise euch den Weg zu vollkommener Evolution!"
  },
  {
    "RowOffset": 694722,
    "RowId": 36929,
    "Text": "Fügt euch eurem Schicksal!"
  },
  {
    "RowOffset": 694762,
    "RowId": 36930,
    "Text": "Die Welt muss neu erschaffen werden!"
  },
  {
    "RowOffset": 694810,
    "RowId": 36931,
    "Text": "Ihr habt kein Recht, mich zu verleugnen!"
  },
  {
    "RowOffset": 694862,
    "RowId": 36932,
    "Text": "Wieso steht ihr immer noch?!"
  },
  {
    "RowOffset": 694902,
    "RowId": 36933,
    "Text": "Ich bin eine Göttin... Alles Wissen sollte mein sein!"
  },
  {
    "RowOffset": 694974,
    "RowId": 36934,
    "Text": "Warum... existiert diese Welt...?"
  },
  {
    "RowOffset": 695026,
    "RowId": 36935,
    "Text": "Warum... existiere ich...?"
  },
