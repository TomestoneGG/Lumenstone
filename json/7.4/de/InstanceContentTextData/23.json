    "Text": ""
  },
  {
    "RowOffset": 689350,
    "RowId": 36699,
    "Text": ""
  },
  {
    "RowOffset": 689362,
    "RowId": 36700,
    "Text": "Auf in die heilige Schlacht!"
  },
  {
    "RowOffset": 689402,
    "RowId": 36701,
    "Text": "Euer Untergang soll unsere Erlösung sein!"
  },
  {
    "RowOffset": 689458,
    "RowId": 36702,
    "Text": "Ich werde diese Welt retten!"
  },
  {
    "RowOffset": 689498,
    "RowId": 36703,
    "Text": "Störenfriede!"
  },
  {
    "RowOffset": 689526,
    "RowId": 36704,
    "Text": "Ihr mickrigen ...!"
  },
  {
    "RowOffset": 689558,
    "RowId": 36705,
    "Text": "Mehr habt ihr nicht zu bieten?"
  },
  {
    "RowOffset": 689602,
    "RowId": 36706,
    "Text": "Niemand ist unverwundbar!"
  },
  {
    "RowOffset": 689638,
    "RowId": 36707,
    "Text": "O Sterne, stürzet hernieder!"
  },
  {
    "RowOffset": 689678,
    "RowId": 36708,
    "Text": "Eine Klinge, kalt wie Eis!"
  },
  {
    "RowOffset": 689718,
    "RowId": 36709,
    "Text": "Eine Brise wird zum tosenden Sturm!"
  },
  {
    "RowOffset": 689766,
    "RowId": 36710,
    "Text": "Die Kraft der Erde wird euch zermalmen!"
  },
  {
    "RowOffset": 689818,
    "RowId": 36711,
    "Text": "Meine Blitze sind schneller als ihr!"
  },
  {
    "RowOffset": 689866,
    "RowId": 36712,
    "Text": "Erhebe dich, Kreatur aus den Schatten!"
  },
  {
    "RowOffset": 689918,
    "RowId": 36713,
    "Text": "Drache der Schatten, folge meinem Befehl!"
  },
  {
    "RowOffset": 689970,
    "RowId": 36714,
    "Text": "So wollen wir uns messen! Eure Kraft gegen meine Schwertkunst!"
  },
  {
    "RowOffset": 690046,
    "RowId": 36715,
    "Text": "Blickt ins Antlitz des Grauens!"
  },
  {
    "RowOffset": 690090,
    "RowId": 36716,
    "Text": "Reiß sie in Stücke!"
  },
  {
    "RowOffset": 690122,
    "RowId": 36717,
    "Text": "Verschlinge sie mit einem Biss!"
  },
  {
    "RowOffset": 690166,
    "RowId": 36718,
    "Text": "Kreatur der Schatten, brenne alles nieder!"
  },
  {
    "RowOffset": 690222,
    "RowId": 36719,
    "Text": "Offenbare das gesamte Ausmaß deiner Macht!"
  },
  {
    "RowOffset": 690278,
    "RowId": 36720,
    "Text": "All meine Kraft dem Meteo!"
  },
  {
    "RowOffset": 690318,
    "RowId": 36721,
    "Text": "Eure Welt wird uns gehören!"
