  },
  {
    "RowOffset": 695842,
    "RowId": 37000,
    "Text": "Themis besiegen"
  },
  {
    "RowOffset": 695870,
    "RowId": 37001,
    "Text": "Was ist das für ein Brodeln in meiner Brust?!"
  },
  {
    "RowOffset": 695930,
    "RowId": 37002,
    "Text": "Lasst mich euer Urteil sprechen!"
  },
  {
    "RowOffset": 695974,
    "RowId": 37003,
    "Text": "Licht oder Dunkelheit... Was wird über euch richten?"
  },
  {
    "RowOffset": 696042,
    "RowId": 37004,
    "Text": "Die Kunst eines alten Freundes!"
  },
  {
    "RowOffset": 696086,
    "RowId": 37005,
    "Text": "Halten Licht und Dunkelheit sich die Waage?"
  },
  {
    "RowOffset": 696142,
    "RowId": 37006,
    "Text": "Als Elidibus werde ich zu eurem Richter!"
  },
  {
    "RowOffset": 696194,
    "RowId": 37007,
    "Text": "Gesammelte Magie... Entlade dich!"
  },
  {
    "RowOffset": 696242,
    "RowId": 37008,
    "Text": "Hier, mit Gruß von Emet-Selch!"
  },
  {
    "RowOffset": 696286,
    "RowId": 37009,
    "Text": "Phantome in meinem Ebenbild, erhebt euch!"
  },
  {
    "RowOffset": 696338,
    "RowId": 37010,
    "Text": "Stärker... Ich brauche noch stärkere Phantome!"
  },
  {
    "RowOffset": 696402,
    "RowId": 37011,
    "Text": "Dass dieser Kampf mich so mitreißen würde!"
  },
  {
    "RowOffset": 696458,
    "RowId": 37012,
    "Text": "Ich bin der Fürsprecher... Mein Wort ist absolut!"
  },
  {
    "RowOffset": 696526,
    "RowId": 37013,
    "Text": "Beugt euch meinem Urteil!"
  },
  {
    "RowOffset": 696562,
    "RowId": 37014,
    "Text": "Wie lange habe ich mich nach diesem Kampf gesehnt?!"
  },
  {
    "RowOffset": 696626,
    "RowId": 37015,
    "Text": "Doch auch die schönste Zeit... muss ein Ende finden!"
  },
