    "Text": ""
  },
  {
    "RowOffset": 568618,
    "RowId": 33000,
    "Text": "Den Schrein des Handwerks erobern"
  },
  {
    "RowOffset": 568662,
    "RowId": 33001,
    "Text": "Den Pfad der Führung erobern"
  },
  {
    "RowOffset": 568702,
    "RowId": 33002,
    "Text": "Den Schrein des Kometen erobern"
  },
  {
    "RowOffset": 568746,
    "RowId": 33003,
    "Text": "Die Stadt der Herrlichkeit erobern"
  },
  {
    "RowOffset": 568794,
    "RowId": 33004,
    "Text": "Den Schrein des Urteils erobern"
  },
  {
    "RowOffset": 568838,
    "RowId": 33005,
    "Text": "Den Schrein der Zwei erobern"
  },
  {
    "RowOffset": 568878,
    "RowId": 33006,
    "Text": "Ihr habt Byregot überwunden?"
  },
  {
    "RowOffset": 568918,
    "RowId": 33007,
    "Text": "Mal sehen, was ihr mit meinen Helfern anstellt."
  },
  {
    "RowOffset": 568978,
    "RowId": 33008,
    "Text": "Kämpft mit ihnen, auf dass ich eure Kraft erkenne!"
  },
  {
    "RowOffset": 569042,
    "RowId": 33009,
    "Text": "Ich werde euch besiegen, im Namen des Zerstörers!"
  },
  {
    "RowOffset": 569106,
    "RowId": 33010,
    "Text": "Meine göttliche Axt wird euch zerschmettern!"
  },
  {
    "RowOffset": 569162,
    "RowId": 33011,
    "Text": "Beweist euch gegenüber dem Zerstörer!"
  },
  {
    "RowOffset": 569214,
    "RowId": 33012,
    "Text": "Kriecht im Angesicht meiner göttlichen Gewalt!"
  },
  {
    "RowOffset": 569274,
    "RowId": 33013,
    "Text": "Ich bin der Zerstörer!"
  },
  {
    "RowOffset": 569310,
    "RowId": 33014,
    "Text": "Dies ist meine schärfste Waffe!"
  },
  {
    "RowOffset": 569354,
    "RowId": 33015,
    "Text": "Meteor, stürze herab und zerstöre alles Leben!"
  },
  {
    "RowOffset": 569414,
    "RowId": 33016,
    "Text": "Etwas mehr Respekt vor göttlicher Größe!"
  },
  {
    "RowOffset": 569470,
    "RowId": 33017,
    "Text": "Donnerstab, entfessele deine Macht!"
  },
  {
    "RowOffset": 569518,
    "RowId": 33018,
    "Text": "Erkennt ihr die Gefahr, wenn ihr sie seht?"
  },
  {
    "RowOffset": 569574,
    "RowId": 33019,
    "Text": "Ihr seid stark, wirklich stark..."
  },
  {
    "RowOffset": 569622,
    "RowId": 33020,
    "Text": "Blitze und Donner. Dann ist Byregot nicht weit."
  },
  {
    "RowOffset": 569682,
    "RowId": 33021,
    "Text": "Dieser Turm scheint direkt den Legenden entsprungen zu sein."
  },
  {
    "RowOffset": 569754,
    "RowId": 33022,
    "Text": "Ein Kampf gegen die Götter... Gut, dass ich das nicht alleine durchstehen muss."
  },
  {
    "RowOffset": 569850,
    "RowId": 33023,
    "Text": ""
  },
  {
    "RowOffset": 569862,
    "RowId": 33024,
    "Text": "Die Götter schicken ihre Diener."
  },
  {
    "RowOffset": 569906,
    "RowId": 33025,
    "Text": "Rhalgr ist der Gott der Zerstörung. Macht euch bereit!"
  },
  {
    "RowOffset": 569974,
    "RowId": 33026,
    "Text": "Mein steinernes Abbild soll Zeuge dieses Kampfes sein."
  },
  {
    "RowOffset": 570042,
    "RowId": 33027,
    "Text": "Seid willkommen in meiner Domäne."
  },
  {
    "RowOffset": 570090,
    "RowId": 33028,
    "Text": "Eine neue Domäne. Sie ist dem Feuer gewidmet."
  },
  {
    "RowOffset": 570150,
    "RowId": 33029,
    "Text": "Dann gehört diese Stimme..."
  },
  {
    "RowOffset": 570194,
    "RowId": 33030,
    "Text": "Diese Diener sind kaum eine Gefahr für dich und deine Gefährten."
  },
  {
    "RowOffset": 570274,
    "RowId": 33031,
    "Text": "Eine wahre Gottheit erwartet uns. Seien wir vorsichtig."
  },
  {
    "RowOffset": 570342,
    "RowId": 33032,
    "Text": "Azeyma ist bezwungen. Die untergehende Sonne ist das Zeichen."
  },
  {
    "RowOffset": 570414,
    "RowId": 33033,
    "Text": "Eine Stadt! Aber Bewohner sehe ich keine."
  },
  {
    "RowOffset": 570466,
    "RowId": 33034,
    "Text": "Dies ist eine Probe eures Könnens."
  },
  {
    "RowOffset": 570514,
    "RowId": 33035,
    "Text": "Alles Leben endet in Asche!"
  },
  {
    "RowOffset": 570554,
    "RowId": 33036,
    "Text": "<i>Das</i> ist göttliche Kraft!"
  },
  {
    "RowOffset": 570602,
    "RowId": 33037,
    "Text": "Dies ist erst der Anfang."
  },
  {
    "RowOffset": 570638,
    "RowId": 33038,
    "Text": "Hoch lodern die Flammen der Dunkelheit!"
  },
  {
    "RowOffset": 570690,
    "RowId": 33039,
    "Text": "Diese Glut verheißt ewige Pein!"
  },
  {
    "RowOffset": 570734,
    "RowId": 33040,
    "Text": "Zurück zur Asche, der ihr einst entstiegt!"
  },
  {
    "RowOffset": 570790,
    "RowId": 33041,
    "Text": "Jetzt kennt ihr unsere göttliche Macht."
  },
  {
    "RowOffset": 570842,
    "RowId": 33042,
    "Text": "Doch der Gott des Handels ist noch nicht mit euch fertig."
  },
  {
    "RowOffset": 570910,
    "RowId": 33043,
    "Text": "Stellen wir nun eure Seelen auf die Probe!"
  },
  {
    "RowOffset": 570966,
    "RowId": 33044,
    "Text": "Die Waage muss ins Gleichgewicht."
  },
  {
    "RowOffset": 571010,
    "RowId": 33045,
    "Text": "5 Sekunden bis zum Urteil..."
  },
  {
    "RowOffset": 571054,
    "RowId": 33046,
    "Text": "4 Sekunden bis zum Urteil..."
  },
  {
    "RowOffset": 571098,
    "RowId": 33047,
    "Text": "3 Sekunden..."
  },
  {
    "RowOffset": 571126,
    "RowId": 33048,
    "Text": "2 Sekunden..."
  },
  {
    "RowOffset": 571154,
    "RowId": 33049,
    "Text": "1 Sekunde..."
  },
  {
    "RowOffset": 571182,
    "RowId": 33050,
    "Text": "Noch einmal ...\nWir werden die Seelen nur ein weiteres Mal begutachten!"
  },
  {
    "RowOffset": 571270,
    "RowId": 33051,
    "Text": "Die Waage muss ins Gleichgewicht!"
  },
  {
    "RowOffset": 571314,
    "RowId": 33052,
    "Text": "Die Zeit ist abgelaufen. Höret unser Urteil."
  },
  {
    "RowOffset": 571370,
    "RowId": 33053,
    "Text": "Ihr seid noch nicht reif."
  },
  {
    "RowOffset": 571406,
    "RowId": 33054,
    "Text": "Irrt weiter durch die Leere zwischen Leben und Tod!"
  },
  {
    "RowOffset": 571470,
    "RowId": 33055,
    "Text": "Eure Seelen haben sich als würdig erwiesen."
  },
  {
    "RowOffset": 571526,
    "RowId": 33056,
    "Text": "Ihr habt eine Heldentat vollbracht! Geht mit unserem Segen!"
  },
  {
    "RowOffset": 571598,
    "RowId": 33057,
    "Text": "So gut wird man selten unterhalten."
  },
  {
    "RowOffset": 571646,
    "RowId": 33058,
    "Text": "Zeigen wir etwas Respekt, indem wir mit aller Macht kämpfen."
  },
  {
    "RowOffset": 571718,
    "RowId": 33059,
    "Text": "Hahahaaa! <i>Das</i> ist das Leben!"
  },
  {
    "RowOffset": 571770,
    "RowId": 33060,
    "Text": "Es steckt viel Leben in euch."
  },
  {
    "RowOffset": 571810,
    "RowId": 33061,
    "Text": "Erfahrt zuerst unsere göttliche Stärke!"
  },
  {
    "RowOffset": 571862,
    "RowId": 33062,
    "Text": "Seid ihr imstande, ihr zu trotzen?"
  },
  {
    "RowOffset": 571910,
    "RowId": 33063,
    "Text": "Ihr habt unsere Domäne betreten. Aber werdet ihr sie auch wieder verlassen?"
  },
  {
    "RowOffset": 571998,
    "RowId": 33064,
    "Text": "Seid ihr bereit, euch dem Erbauer zu stellen?"
  },
  {
    "RowOffset": 572054,
    "RowId": 33065,
    "Text": "Ich gebiete über die Schöpfung und die Elemente!"
  },
  {
    "RowOffset": 572118,
    "RowId": 33066,
    "Text": "Zeigt mir, wozu ihr fähig seid."
  },
  {
    "RowOffset": 572162,
    "RowId": 33067,
    "Text": "Auseinander!"
  },
  {
    "RowOffset": 572186,
    "RowId": 33068,
    "Text": "Verbeugt euch vor dem Willen der Götter!"
  },
  {
    "RowOffset": 572238,
    "RowId": 33069,
    "Text": "Versteht ihr nun, warum sie mich als den Erbauer preisen?"
  },
  {
    "RowOffset": 572306,
    "RowId": 33070,
    "Text": "Mein Wille formt diese Welt!"
  },
  {
    "RowOffset": 572346,
    "RowId": 33071,
    "Text": "Zu mir, Weltenhammer!"
  },
  {
    "RowOffset": 572378,
    "RowId": 33072,
    "Text": "Soll der Donner zerreißen, was ich schuf!"
  },
  {
    "RowOffset": 572434,
    "RowId": 33073,
    "Text": "Gewaltiges Gewitter, beuge dich meinem Befehl!"
  },
  {
    "RowOffset": 572494,
    "RowId": 33074,
    "Text": "Geht. Die anderen erwarten euch bereits."
  },
  {
    "RowOffset": 572546,
    "RowId": 33075,
    "Text": "Lernt die Macht der Götter kennen!"
  },
  {
    "RowOffset": 572594,
    "RowId": 33076,
    "Text": "In den Staub mit euch!"
  },
  {
    "RowOffset": 572630,
    "RowId": 33077,
    "Text": "Für Reue ist es jetzt zu spät!"
  },
  {
    "RowOffset": 572674,
    "RowId": 33078,
    "Text": "Die Sonnengöttin erwartet euch mit sengender Sehnsucht!"
  },
  {
    "RowOffset": 572742,
    "RowId": 33079,
    "Text": "Rotes Feuer nährt meinen flammenden Fächer..."
  },
  {
    "RowOffset": 572806,
    "RowId": 33080,
    "Text": "Und verbrannte Erde glimmt, wo ich ihn schwinge!"
  },
  {
    "RowOffset": 572866,
    "RowId": 33081,
    "Text": "Kommt, meine Kinder, und umtanzt die Gäste!"
  },
  {
    "RowOffset": 572922,
    "RowId": 33082,
    "Text": "Ahaha! Hier, das ist für den nächsten Tanz!"
  },
  {
    "RowOffset": 572978,
    "RowId": 33083,
    "Text": "Flammenfächer, mach dich bereit für das Finale!"
  },
  {
    "RowOffset": 573038,
    "RowId": 33084,
    "Text": "Götterfeuer, stille deinen Hunger!"
  },
  {
    "RowOffset": 573086,
    "RowId": 33085,
    "Text": "Wind, wehe, und entfache einen lichterlohen Tanz!"
  },
  {
    "RowOffset": 573146,
    "RowId": 33086,
    "Text": "Nimm freien Lauf, und lodere! Brenne lichterloh!"
  },
  {
    "RowOffset": 573206,
    "RowId": 33087,
    "Text": "Meine flammende Aura soll euch verzehren!"
  },
  {
    "RowOffset": 573258,
    "RowId": 33088,
    "Text": "Spürt meine sengende Liebe!"
  },
  {
    "RowOffset": 573298,
    "RowId": 33089,
    "Text": "Ach, was habe ich euch begehrt ..."
  },
  {
    "RowOffset": 573346,
    "RowId": 33100,
    "Text": "Nun gehorchen sie mir alle aufsss Wort ...<<key>>Zeit für die erssste Mahlzeit!"
  },
  {
    "RowOffset": 573434,
    "RowId": 33101,
    "Text": "さぁ、餌の時間だ…！"
  }
]