  },
  {
    "RowOffset": 563986,
    "RowId": 32800,
    "Text": "Zur versunkenen Pforte vordringen"
  },
  {
    "RowOffset": 564030,
    "RowId": 32801,
    "Text": "Die versunkene Pforte freikämpfen"
  },
  {
    "RowOffset": 564078,
    "RowId": 32802,
    "Text": "Zur Schwelle zum Reichtum vorkämpfen"
  },
  {
    "RowOffset": 564126,
    "RowId": 32803,
    "Text": "Die Schwelle zum Reichtum erobern"
  },
  {
    "RowOffset": 564170,
    "RowId": 32804,
    "Text": "Zu Webers Wehr vordringen"
  },
  {
    "RowOffset": 564206,
    "RowId": 32805,
    "Text": "Kapikulu besiegen"
  },
  {
    "RowOffset": 564234,
    "RowId": 32806,
    "Text": "Unbekannte Äthersignatur. Kein gemeiner Dieb wird in diese Kammer dringen!"
  },
  {
    "RowOffset": 564322,
    "RowId": 32807,
    "Text": "Kehret um oder lasset diesen Ort zu eurer Grabstätte werden!"
  },
  {
    "RowOffset": 564394,
    "RowId": 32808,
    "Text": "Eure Gier wird euer Schicksal besiegeln..."
  },
  {
    "RowOffset": 564454,
    "RowId": 32809,
    "Text": "Warnung: diese Kammer untersteht meinem Schutz. Jegliches Eindringen wird schwer geahndet."
  },
  {
    "RowOffset": 564558,
    "RowId": 32810,
    "Text": "Tanzt und taumelt! Stolpert und stürzt!"
  },
  {
    "RowOffset": 564610,
    "RowId": 32811,
    "Text": "Dies soll eure letzte Warnung sein. Geht und kehret nicht wieder."
  },
  {
    "RowOffset": 564686,
    "RowId": 32812,
    "Text": "Vorsätzliches Eindringen bestätigt. Das Urteil lautet Tod."
  },
  {
    "RowOffset": 564758,
    "RowId": 32813,
    "Text": "Jeder Eindringling wird getilgt!"
  },
  {
    "RowOffset": 564802,
    "RowId": 32814,
    "Text": "Schlüsselglyphe erkannt. Identität wird geprüft."
  },
