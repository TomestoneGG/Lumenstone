  {
    "RowOffset": 654790,
    "RowId": 35699,
    "Text": ""
  },
  {
    "RowOffset": 654802,
    "RowId": 35700,
    "Text": "Gestatten, Rubicante, der Fürst des Feuers."
  },
  {
    "RowOffset": 654858,
    "RowId": 35701,
    "Text": "Ihr seid talentierte Kämpfer."
  },
  {
    "RowOffset": 654902,
    "RowId": 35702,
    "Text": "Vielleicht verdient ihr es sogar, meine wahre Kraft zu sehen."
  },
  {
    "RowOffset": 654974,
    "RowId": 35703,
    "Text": "Nun denn ..."
  },
  {
    "RowOffset": 654998,
    "RowId": 35704,
    "Text": "Uuoooooh!"
  },
  {
    "RowOffset": 655018,
    "RowId": 35705,
    "Text": "Ihr seid die ersten, die diese Gestalt zu Gesicht bekommen."
  },
  {
    "RowOffset": 655090,
    "RowId": 35706,
    "Text": ""
  },
  {
    "RowOffset": 655102,
    "RowId": 35707,
    "Text": ""
  },
  {
    "RowOffset": 655114,
    "RowId": 35708,
    "Text": "Zu mir, lodernde Flammen! "
  },
  {
    "RowOffset": 655154,
    "RowId": 35709,
    "Text": "Das Feuer gehorcht allein mir!"
  },
  {
    "RowOffset": 655198,
    "RowId": 35710,
    "Text": "Dieses Gefühl ... mein Körper birst vor Kraft!"
  },
  {
    "RowOffset": 655258,
    "RowId": 35711,
    "Text": "Versucht gar nicht erst zu fliehen!"
  },
  {
    "RowOffset": 655306,
    "RowId": 35712,
    "Text": "Diese Gestalt kann weit mehr, als das Feuer zu bändigen!"
  },
  {
    "RowOffset": 655374,
    "RowId": 35713,
    "Text": "Werdet Zeugen der ultimativen Zerstörung!"
  },
  {
    "RowOffset": 655430,
    "RowId": 35714,
    "Text": "Alles soll brennen!"
  },
  {
    "RowOffset": 655462,
    "RowId": 35715,
    "Text": "Mein Feuer dürstet nach euch!"
  },
  {
    "RowOffset": 655506,
    "RowId": 35716,
    "Text": "Werdet zu Asche!"
  },
  {
    "RowOffset": 655534,
    "RowId": 35717,
    "Text": "Fühlt die ätzende Glut!"
  },
  {
    "RowOffset": 655570,
    "RowId": 35718,
    "Text": "Erwartet von mir keine Gnade ..."
  },
  {
    "RowOffset": 655614,
    "RowId": 35719,
    "Text": "Die schwarze Lohe wird euch holen!"
  },
  {
    "RowOffset": 655662,
    "RowId": 35720,
    "Text": "Ihr seid verloren!"
  },
  {
    "RowOffset": 655694,
    "RowId": 35721,
    "Text": "Dunkelheit, gehorche mir!"
  },
  {
    "RowOffset": 655730,
    "RowId": 35722,
    "Text": "Gaaaah!"
  },
  {
    "RowOffset": 655750,
    "RowId": 35723,
    "Text": "Bereiten wir diesem Kampf ein gebührendes Ende ..."
  },
  {
    "RowOffset": 655814,
    "RowId": 35724,
    "Text": "Auf euch wartet nichts als das glühende Verderben!"
  },
  {
    "RowOffset": 655878,
    "RowId": 35725,
    "Text": "Kommt! Ich will eure Wunden heilen!"
  },
  {
    "RowOffset": 655926,
    "RowId": 35726,
    "Text": "Ihr sollt gegen mich im Vollbesitz eurer Kräfte antreten!"
  },
  {
    "RowOffset": 655998,
    "RowId": 35727,
    "Text": "Ich zeige euch, wie man mit Feuer umgeht."
  },
  {
    "RowOffset": 656050,
    "RowId": 35728,
    "Text": "Zeigt euch, Kinder der Flamme!"
  },
  {
    "RowOffset": 656094,
    "RowId": 35729,
    "Text": "Lasst sie euer Feuer spüren!"
  },
  {
