  },
  {
    "RowOffset": 651002,
    "RowId": 35500,
    "Text": "Was auch passiert, ich halte mein Wort.<<key>>Nicht mehr und nicht weniger."
  },
  {
    "RowOffset": 651086,
    "RowId": 35501,
    "Text": ""
  },
  {
    "RowOffset": 651098,
    "RowId": 35502,
    "Text": "So viel frischer Äther!"
  },
  {
    "RowOffset": 651134,
    "RowId": 35503,
    "Text": "Das wird kein Spaziergang ..."
  },
  {
    "RowOffset": 651174,
    "RowId": 35504,
    "Text": "Ts, wie gefällt dir das?"
  },
  {
    "RowOffset": 651210,
    "RowId": 35505,
    "Text": "Dich werde ich fressen!"
  },
  {
    "RowOffset": 651246,
    "RowId": 35506,
    "Text": "Ich fürchte, es ist aus ..."
  },
  {
    "RowOffset": 651286,
    "RowId": 35507,
    "Text": "Das war haarscharf. Hältst du noch eine Weile durch?"
  },
  {
    "RowOffset": 651350,
    "RowId": 35508,
    "Text": "Verzeiht die Nachlässigkeit ..."
  },
  {
    "RowOffset": 651394,
    "RowId": 35509,
    "Text": "Ah, frische Nahrung! Das wird ein Festmahl!"
  },
  {
    "RowOffset": 651450,
    "RowId": 35510,
    "Text": "Der Feind ist zu stark ... Ich kann nichts mehr gegen ihn ausrichten.<<key>>Und noch mehr will ich euch in all das nicht hineinziehen..."
  },
  {
    "RowOffset": 651598,
    "RowId": 35511,
    "Text": ""
  },
  {
    "RowOffset": 651610,
    "RowId": 35512,
    "Text": "Schluss mit dem Gejammer! Zusammen schaffen wir es!"
  },
  {
    "RowOffset": 651674,
    "RowId": 35513,
    "Text": "Gemeinsam überstehen wir es!"
  },
  {
    "RowOffset": 651714,
    "RowId": 35514,
    "Text": "Ich halte hier die Stellung!"
  },
  {
    "RowOffset": 651754,
    "RowId": 35515,
    "Text": "Wir müssen da zusammen durch!"
  },
  {
    "RowOffset": 651798,
    "RowId": 35516,
    "Text": "Zusammen, hm ...?"
  },
  {
    "RowOffset": 651826,
    "RowId": 35517,
    "Text": "Ich habe Hunger. Gib mir deinen Äther!"
  },
  {
    "RowOffset": 651878,
    "RowId": 35518,
    "Text": "Kommt alle zusammen, er bereitet einen Angriff vor!"
  },
  {
    "RowOffset": 651942,
    "RowId": 35519,
    "Text": "Widerstand ist zwecklos!"
  },
  {
    "RowOffset": 651978,
    "RowId": 35520,
    "Text": "Muaaa! Wehrt euch nicht! Ihr seid Nahrung!"
  },
  {
    "RowOffset": 652034,
    "RowId": 35521,
    "Text": "Haltet sie auf!"
  },
  {
    "RowOffset": 652062,
    "RowId": 35522,
    "Text": "Weg mit euch!"
  },
  {
    "RowOffset": 652086,
    "RowId": 35523,
    "Text": "Wie konnten so viele von ihnen auf diese Seite gelangen?"
  },
  {
    "RowOffset": 652154,
    "RowId": 35524,
    "Text": "Du bist mir nicht gewachsen!"
  },
  {
    "RowOffset": 652194,
    "RowId": 35525,
    "Text": "Zero, wir helfen dir!"
  },
  {
    "RowOffset": 652226,
    "RowId": 35526,
    "Text": "Zeit, ihn für seine Taten büßen zu lassen!"
  },
  {
    "RowOffset": 652282,
    "RowId": 35527,
    "Text": "Gyaaa! Kommt nicht näher!"
  },
  {
    "RowOffset": 652322,
    "RowId": 35528,
    "Text": "Alle Nichtsgesandten besiegen"
  },
  {
    "RowOffset": 652370,
    "RowId": 35529,
    "Text": "Gemeinsam alle Nichtsgesandten besiegen"
  },
  {
    "RowOffset": 652430,
    "RowId": 35530,
    "Text": "Zero beschützen, bis sie zurückschlagen kann"
  },
  {
    "RowOffset": 652490,
    "RowId": 35531,
    "Text": "Andromalius besiegen"
  },
  {
    "RowOffset": 652522,
    "RowId": 35532,
    "Text": ""
  },
  {
    "RowOffset": 652534,
    "RowId": 35533,
    "Text": "Zeros Konzentration wird durch Angriffe gestört!"
  },
  {
