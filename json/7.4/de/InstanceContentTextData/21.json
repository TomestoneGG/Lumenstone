  {
    "RowOffset": 660526,
    "RowId": 35900,
    "Text": "Manipulationsmodul aktiviert ...\nIch bin Tiamat, die hohe Wächterin des Südens!"
  },
  {
    "RowOffset": 660622,
    "RowId": 35901,
    "Text": "Werdet eins mit den Winden, meine Kinder, und stürzt auf jene hinab, die dem Süden schaden wollen!"
  },
  {
    "RowOffset": 660734,
    "RowId": 35902,
    "Text": "Mein Zorn soll euer Fleisch versengen!"
  },
  {
    "RowOffset": 660786,
    "RowId": 35903,
    "Text": "Brennt im Feuer der Vergeltung!"
  },
  {
    "RowOffset": 660830,
    "RowId": 35904,
    "Text": "Dies ist die wahre Macht eines Hohen Drachen!"
  },
