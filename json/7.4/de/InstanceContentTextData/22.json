  },
  {
    "RowOffset": 663486,
    "RowId": 36100,
    "Text": "Muahaha! Seid herzlichst willkommen in meiner mechanischen Menagerie!"
  },
  {
    "RowOffset": 663566,
    "RowId": 36101,
    "Text": "Das Herz von Kugane schlägt im Rhythmus von Feuer und Fehde! Geht euch gegenseitig an die Gurgel und bietet mir ein blutrünstiges Schauspiel!"
  },
  {
    "RowOffset": 663722,
    "RowId": 36102,
    "Text": "Marschiert zu dem Kling-Klong der pneumatischen Parade!"
  },
  {
    "RowOffset": 663790,
    "RowId": 36103,
    "Text": "Bwahaha, seht euch meine Aufziehmännchen an! Passt gut auf, sonst machen sie euch zu ihren Spielgefährten!"
  },
  {
    "RowOffset": 663910,
    "RowId": 36104,
    "Text": "Das war's mit unserer prachtvollen Parade! Nun müsst ihr mich unterhalten! Los los, es geht um Sieg oder Niederlage!"
  },
  {
    "RowOffset": 664038,
    "RowId": 36105,
    "Text": "Hier, eine milde Gabe für euch bettelarme Seelen! Nur zu, prügelt euch darum!"
  },
