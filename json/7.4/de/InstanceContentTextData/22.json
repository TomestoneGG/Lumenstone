  {
    "RowOffset": 662026,
    "RowId": 36000,
    "Text": "Feindliche Präsenz registriert. Verteidigungsmodus initialisiert."
  },
  {
    "RowOffset": 662106,
    "RowId": 36001,
    "Text": "Keine Anomalien bei der Geistbemächtigung festgestellt. Angriffsprotokoll wird ausgeführt."
  },
  {
    "RowOffset": 662210,
    "RowId": 36002,
    "Text": "Feindliche Präsenz abermals bestätigt. Gefahrenstufe wird erhöht und Dauerangriff initialisiert."
