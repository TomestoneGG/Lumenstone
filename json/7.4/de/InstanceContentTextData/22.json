  },
  {
    "RowOffset": 665246,
    "RowId": 36199,
    "Text": ""
  },
  {
    "RowOffset": 665258,
    "RowId": 36200,
    "Text": "Kämpfen... Seele... einverleiben... und kämpfen!"
  },
  {
    "RowOffset": 665334,
    "RowId": 36201,
    "Text": "In Frieden zu ruhen ist mir wohl nicht vergönnt..."
  },
  {
    "RowOffset": 665402,
    "RowId": 36202,
    "Text": "Erlebt das Wunder meines zweifachen Zaubers!"
  },
  {
    "RowOffset": 665458,
    "RowId": 36203,
    "Text": "Los, tanzt für mich!"
  },
  {
    "RowOffset": 665490,
    "RowId": 36204,
    "Text": "Meine Worte sind gefüllt mit Magie!"
  },
  {
    "RowOffset": 665538,
    "RowId": 36205,
    "Text": "Scheint, als wäre meine Pflicht... erfüllt..."
  },
  {
    "RowOffset": 665606,
    "RowId": 36206,
    "Text": "Ein letzter Kampf für mich? Na, dann wollen wir mal loslegen!"
  },
  {
    "RowOffset": 665682,
    "RowId": 36207,
    "Text": "Zeigt mir, was ihr draufhabt!"
  },
  {
    "RowOffset": 665722,
    "RowId": 36208,
    "Text": "Das war doch nicht schon alles, oder?!"
  },
  {
    "RowOffset": 665774,
    "RowId": 36209,
    "Text": "Verdammt... Schon vorbei?!"
  },
  {
    "RowOffset": 665818,
    "RowId": 36210,
    "Text": "Graaaaah!"
  },
  {
    "RowOffset": 665838,
    "RowId": 36211,
    "Text": "Garrh! Graaaarrrh!"
  },
  {
    "RowOffset": 665870,
    "RowId": 36212,
    "Text": "Wurde ich etwa erneut gerufen?"
  },
  {
    "RowOffset": 665914,
    "RowId": 36213,
    "Text": "Ihr seid erledigt!"
  },
  {
    "RowOffset": 665946,
    "RowId": 36214,
    "Text": "Könnt ihr meiner Magie standhalten?"
  },
  {
    "RowOffset": 665994,
    "RowId": 36215,
    "Text": "Wie wäre es dann hiermit?!"
  },
  {
    "RowOffset": 666034,
    "RowId": 36216,
    "Text": "Mehr... Lasst uns noch mehr kämpfen!"
  },
  {
    "RowOffset": 666086,
    "RowId": 36217,
    "Text": "In den Staub mit euch!"
  },
  {
    "RowOffset": 666122,
    "RowId": 36218,
    "Text": "Nimm... das!"
  },
  {
    "RowOffset": 666150,
    "RowId": 36219,
    "Text": "Leid und Qual in reinster Form!"
  },
  {
    "RowOffset": 666194,
    "RowId": 36220,
    "Text": "In Athenas Namen!"
  },
  {
    "RowOffset": 666222,
    "RowId": 36221,
    "Text": "Hiermit... endet alles!"
  },
  {
    "RowOffset": 666262,
    "RowId": 36222,
    "Text": "Wir sind noch lange nicht am Ende!"
  },
  {
    "RowOffset": 666310,
    "RowId": 36223,
    "Text": "Kokytos bezwingen"
  },
  {
    "RowOffset": 666338,
    "RowId": 36224,
    "Text": "Zerberstet!"
  },
  {
    "RowOffset": 666362,
    "RowId": 36225,
    "Text": "Erstarrt zu Eis!"
  },
  {
    "RowOffset": 666390,
