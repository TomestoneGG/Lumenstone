[
  {
    "RowOffset": 618834,
    "RowId": 34269,
    "Text": "Das Silkie bezwingen"
  },
  {
    "RowOffset": 618866,
    "RowId": 34270,
    "Text": "Die Zuflucht der Mächtigen erobern"
  },
  {
    "RowOffset": 618914,
    "RowId": 34271,
    "Text": "Den Gladiator von Sil'dih bezwingen"
  },
  {
    "RowOffset": 618962,
    "RowId": 34272,
    "Text": "Schattenwirker Zeless Gah bezwingen"
  },
  {
    "RowOffset": 619010,
    "RowId": 34273,
    "Text": ""
  },
  {
    "RowOffset": 619022,
    "RowId": 34300,
    "Text": "Den Kanal des Wissens durchqueren"
  },
  {
    "RowOffset": 619066,
    "RowId": 34301,
    "Text": "Den Fluss der Weisheit überwinden"
  },
  {
    "RowOffset": 619114,
    "RowId": 34302,
    "Text": "Das Auge des Meeres durchqueren"
  },
  {
    "RowOffset": 619158,
    "RowId": 34303,
    "Text": "Den Pfad des Windes durchschreiten"
  },
  {
    "RowOffset": 619206,
    "RowId": 34304,
    "Text": "Den Aufgang zum Firmament erklimmen"
  },
  {
    "RowOffset": 619254,
    "RowId": 34305,
    "Text": "Den Sternenhimmel erobern"
  },
  {
    "RowOffset": 619290,
    "RowId": 34306,
    "Text": "Über die Seefahrt weiß keiner mehr als ich!"
  },
  {
    "RowOffset": 619346,
    "RowId": 34307,
    "Text": "Wind und Wasser, gebt mir Kraft!"
  },
  {
    "RowOffset": 619390,
    "RowId": 34308,
    "Text": "Spürt den Willen der Meeresgöttin!"
  },
  {
    "RowOffset": 619438,
    "RowId": 34309,
    "Text": "Rau wie die See, so sollt ihr mich erleben!"
  },
  {
    "RowOffset": 619494,
    "RowId": 34310,
    "Text": "Könnt ihr der Herrscherin der Wellen trotzen?!"
  },
  {
    "RowOffset": 619554,
    "RowId": 34311,
    "Text": "Der Wind ist stets auf meiner Seite!"
  },
  {
    "RowOffset": 619602,
    "RowId": 34312,
    "Text": "Welch rauschender Kampf!"
  },
  {
    "RowOffset": 619638,
    "RowId": 34313,
    "Text": "Überwindet selbst die höchsten Wellen!"
  },
  {
    "RowOffset": 619690,
    "RowId": 34314,
    "Text": "Tropfen für Tropfen wird der See zum Meer!"
  },
  {
    "RowOffset": 619746,
    "RowId": 34315,
    "Text": "Ein guter Sturm hat noch keinem geschadet!"
  },
  {
    "RowOffset": 619802,
    "RowId": 34316,
    "Text": "O Dreizack, teile die See entzwei!"
  },
  {
    "RowOffset": 619850,
    "RowId": 34317,
    "Text": "Hahaha! Fantastisch!"
  },
  {
    "RowOffset": 619882,
    "RowId": 34318,
    "Text": "Auf euch ist wirklich Verlass! Weiter so!"
  },
  {
    "RowOffset": 619934,
    "RowId": 34319,
    "Text": "War das etwa schon zu viel für euch?"
  },
  {
    "RowOffset": 619982,
    "RowId": 34320,
    "Text": "Auf See kommt man nur gemeinsam voran!"
  },
  {
    "RowOffset": 620034,
    "RowId": 34321,
    "Text": "Vergesst das nicht ... auf euren kommenden Fahrten!"
  },
  {
    "RowOffset": 620098,
    "RowId": 34322,
    "Text": "Perykos, Thalaos, zu mir!"
  },
  {
    "RowOffset": 620134,
    "RowId": 34323,
    "Text": "Nun sind <i>wir</i> der Orkan!"
  },
  {
    "RowOffset": 620178,
    "RowId": 34324,
    "Text": "Los, ihr beiden! Haltet euch nicht zurück!"
  },
  {
    "RowOffset": 620234,
    "RowId": 34325,
    "Text": "Lasst nur keine Langeweile aufkommen!"
  },
  {
    "RowOffset": 620282,
    "RowId": 34326,
    "Text": "Fein gemacht, ihr beiden! Brave Seeschlangen!"
  },
  {
    "RowOffset": 620338,
    "RowId": 34327,
    "Text": "Perykos, vorwärts!"
  },
  {
    "RowOffset": 620370,
    "RowId": 34328,
    "Text": "<i>Das</i> ist mein Perykos!"
  },
  {
    "RowOffset": 620414,
    "RowId": 34329,
    "Text": "Segle über die Weiten des Meeres!"
  },
  {
    "RowOffset": 620462,
    "RowId": 34330,
    "Text": "Thalaos, du bist dran!"
  },
  {
    "RowOffset": 620498,
    "RowId": 34331,
    "Text": "Ja, <i>das</i> gefällt dem Guten!"
  },
  {
    "RowOffset": 620546,
    "RowId": 34332,
    "Text": "Tanze zwischen den Wellen!"
  },
  {
    "RowOffset": 620586,
    "RowId": 34333,
    "Text": "Heda! Konzentriert euch gefälligst!"
  },
  {
    "RowOffset": 620634,
    "RowId": 34334,
    "Text": "Seid mir willkommen im Himmel des Wassers..."
  },
  {
    "RowOffset": 620694,
    "RowId": 34335,
    "Text": "Darf ich euch mit meinen Dienern bekannt machen?"
  },
  {
    "RowOffset": 620754,
    "RowId": 34336,
    "Text": "Wie es scheint, habt ihr den guten Byregot nicht nur durch Glück besiegt..."
  },
  {
    "RowOffset": 620846,
    "RowId": 34337,
    "Text": "Lasst mich euch den wärmsten Empfang bereiten."
  },
  {
    "RowOffset": 620906,
    "RowId": 34338,
    "Text": "Welch prächtiges Schauspiel! Als Nächstes erwarten euch meine Planken!"
  },
  {
    "RowOffset": 620990,
    "RowId": 34339,
    "Text": "Kommt an Bord und prüft die Segel!"
  },
  {
    "RowOffset": 621038,
    "RowId": 34340,
    "Text": "Also dann, Leinen los!"
  },
  {
    "RowOffset": 621074,
    "RowId": 34341,
    "Text": "Habt ihr auch genügend Auftrieb?"
  },
  {
    "RowOffset": 621118,
    "RowId": 34342,
    "Text": "Auf jetzt, ich halte das Warten kaum mehr aus!"
  },
  {
    "RowOffset": 621178,
    "RowId": 34343,
    "Text": "Es bedarf eines angemessenen Schauplatzes!"
  },
  {
    "RowOffset": 621234,
    "RowId": 34344,
    "Text": "Meine Stimme derart zu erheben, ist mir fremd..."
  },
  {
    "RowOffset": 621298,
    "RowId": 34345,
    "Text": "Doch lasst mich euch danken... dass ihr so weit gewandert seid."
  },
  {
    "RowOffset": 621378,
    "RowId": 34346,
    "Text": "Unsere gemeinsame Reise wird bald ihr Ende finden."
  },
  {
    "RowOffset": 621442,
    "RowId": 34347,
    "Text": "Lasst mich das Tor zu eurem Ziel öffnen."
  },
  {
    "RowOffset": 621494,
    "RowId": 34348,
    "Text": "Durch den Kampf mit euch sind wir unserer wahren Natur so viel nähergekommen..."
  },
  {
    "RowOffset": 621590,
    "RowId": 34349,
    "Text": "Der Rest liegt in euren Händen."
  },
  {
    "RowOffset": 621634,
    "RowId": 34350,
    "Text": "Da bist du ja wieder! Sieh nur, was plötzlich passiert ist!"
  },
  {
    "RowOffset": 621706,
    "RowId": 34351,
    "Text": "Gottesdiener!? Aber von wem?"
  },
  {
    "RowOffset": 621746,
    "RowId": 34352,
    "Text": "Kümmer du dich um die da drüben!"
  },
  {
    "RowOffset": 621794,
    "RowId": 34353,
    "Text": "Hm ... Eine Einladung?"
  },
  {
    "RowOffset": 621830,
    "RowId": 34354,
    "Text": "Geh du vor! Ich passe auf die anderen auf!"
  },
  {
    "RowOffset": 621886,
    "RowId": 34355,
    "Text": "Endlich ist es so weit ..."
  },
  {
    "RowOffset": 621926,
    "RowId": 34356,
    "Text": "So bin ich wohl der Letzte."
  },
  {
    "RowOffset": 621966,
    "RowId": 34357,
    "Text": "Wind der Berge, wehe herab!"
  },
  {
    "RowOffset": 622006,
    "RowId": 34358,
    "Text": "Tobe und wüte! Lass sie umherfliegen wie Blätter!"
  },
  {
    "RowOffset": 622070,
    "RowId": 34359,
    "Text": "Tanze bis hoch in den Himmel, mein Wirbelsturm!"
  },
  {
    "RowOffset": 622130,
    "RowId": 34360,
    "Text": "Und nun, des Wanderers Pfeil..."
  },
  {
    "RowOffset": 622178,
    "RowId": 34361,
    "Text": "Hört das Schallen meiner Bogensehne!"
  },
  {
    "RowOffset": 622226,
    "RowId": 34362,
    "Text": "Durchlöchert mag der Wind euch lieber!"
  },
  {
    "RowOffset": 622278,
    "RowId": 34363,
    "Text": "Kämpft mit Überzeugung!"
  },
  {
    "RowOffset": 622314,
    "RowId": 34364,
    "Text": "Gebt alles, haltet nichts zurück!"
  },
  {
    "RowOffset": 622362,
    "RowId": 34365,
    "Text": "Eine jede Reise muss ein Ende haben..."
  },
  {
    "RowOffset": 622418,
    "RowId": 34366,
    "Text": "Ich habe euch im Visier!"
  },
  {
    "RowOffset": 622454,
    "RowId": 34367,
    "Text": "Zeigt mir eure Standfestigkeit!"
  },
  {
    "RowOffset": 622498,
    "RowId": 34368,
    "Text": "Erde, erhebe dich!"
  },
  {
    "RowOffset": 622530,
    "RowId": 34369,
    "Text": "Alles werde gleich und eben!"
  },
  {
    "RowOffset": 622570,
    "RowId": 34370,
    "Text": "Euer Glaube hat uns diese Stärke verliehen..."
  },
  {
    "RowOffset": 622634,
    "RowId": 34371,
    "Text": "Durch den Kampf fließt unser Äther zurück."
  },
  {
    "RowOffset": 622690,
    "RowId": 34372,
    "Text": "Zeigt, dass ihr fähig seid, unseren Wunsch zu erfüllen!"
  },
  {
    "RowOffset": 622758,
    "RowId": 34373,
    "Text": "Ah... Ihr seid wahrlich mächtig geworden."
  },
  {
    "RowOffset": 622818,
    "RowId": 34374,
    "Text": "Für euch sollte auch dies eine Leichtigkeit sein!"
  },
  {
    "RowOffset": 622882,
    "RowId": 34375,
    "Text": "Fantastisch, meine Sorgen waren sichtlich unangebracht."
  },
  {
    "RowOffset": 622950,
    "RowId": 34376,
    "Text": "Lasst mich nicht an eurer Tauglichkeit zweifeln."
  },
  {
    "RowOffset": 623010,
    "RowId": 34377,
    "Text": "Mit dem Ende dieses Kampfes wird es so weit sein..."
  },
  {
    "RowOffset": 623078,
    "RowId": 34378,
    "Text": "Ich bin überglücklich, euch eingeladen zu haben."
  },
  {
    "RowOffset": 623142,
    "RowId": 34379,
    "Text": "Danke, dass ihr mich die Trauer des Abschieds gelehrt habt."
  },
  {
    "RowOffset": 623214,
    "RowId": 34380,
    "Text": "Nur zu, beendet auch ihr eure Reise!"
  },
  {
    "RowOffset": 623262,
    "RowId": 34381,
    "Text": "Möge der Weg bis zu eurem Ziel gesegnet sein."
  },
  {
    "RowOffset": 623322,
    "RowId": 34382,
    "Text": "Mögen eure Reisen stets von Rückenwind begleitet sein."
  },
  {
    "RowOffset": 623390,
    "RowId": 34383,
    "Text": "Reisende besitzen Stärke. So wie ihr..."
  },
  {
    "RowOffset": 623446,
    "RowId": 34384,
    "Text": "Hört und erfüllt unsere letzte Bitte."
  },
  {
    "RowOffset": 623498,
    "RowId": 34385,
    "Text": "Führt uns zurück in den Ursprung...!"
  },
  {
    "RowOffset": 623554,
    "RowId": 34386,
    "Text": "Im Namen der Zwölf!"
  },
  {
    "RowOffset": 623586,
    "RowId": 34387,
    "Text": "Weiter ... Weiter!"
  },
  {
    "RowOffset": 623618,
    "RowId": 34388,
    "Text": "Lasst eure Lebenskraft funkeln wie tausende Sterne!"
  },
  {
    "RowOffset": 623682,
    "RowId": 34389,
    "Text": "Erbarmen für unsere geliebten Kinder!"
  },
  {
    "RowOffset": 623734,
    "RowId": 34390,
    "Text": "Nehmt euch an die Hand, gemeinsam seid ihr stark!"
  },
  {
    "RowOffset": 623794,
    "RowId": 34391,
    "Text": "Es gibt keinen Weg zurück, schreitet beherzt voran!"
  },
  {
    "RowOffset": 623858,
    "RowId": 34392,
    "Text": "Stellt euch dem letzten Urteil!"
  },
  {
    "RowOffset": 623902,
    "RowId": 34393,
    "Text": "Lasst euren Gedanken und eurer Kraft freien Lauf!"
  },
  {
    "RowOffset": 623962,
    "RowId": 34394,
    "Text": "Setzt alles aufs Spiel! Körper, Geist und Seele!"
  },
  {
    "RowOffset": 624022,
    "RowId": 34395,
    "Text": "Klein mögt ihr sein, doch gewaltig ist eure Macht."
  },
  {
    "RowOffset": 624086,
    "RowId": 34396,
    "Text": "Erhaltet unsere Liebe- und übertrefft sie!"
  },
  {
    "RowOffset": 624146,
    "RowId": 34397,
    "Text": "Ihr habt gebetet, gewünscht, gelebt ..."
  },
  {
    "RowOffset": 624198,
    "RowId": 34398,
    "Text": "Durch eure Gedanken habt ihr uns erschaffen ..."
  },
  {
    "RowOffset": 624258,
    "RowId": 34399,
    "Text": "Nun nehmt diese Macht wieder an euch!"
  },
  {
    "RowOffset": 624306,
    "RowId": 34400,
    "Text": "Aah, selbst das konntet ihr überstehen ..."
  },
  {
    "RowOffset": 624362,
    "RowId": 34401,
    "Text": "Gesegnet sei Ætheris!"
  },
  {
    "RowOffset": 624398,
    "RowId": 34402,
    "Text": "All unsere Macht legen wir offen!"
  },
  {
    "RowOffset": 624442,
    "RowId": 34403,
    "Text": "Seht die Kraft, die euer Glaube uns verliehen hat!"
  },
  {
    "RowOffset": 624506,
    "RowId": 34404,
    "Text": "Der Mond formt sich auf Menphinas Geheiß!"
  },
  {
    "RowOffset": 624562,
    "RowId": 34405,
    "Text": "Der Mond beginnt zuzunehmen..."
  },
  {
    "RowOffset": 624610,
    "RowId": 34406,
    "Text": "Die Zeit beschleunigt sich auf Althyks Geheiß!"
  },
  {
    "RowOffset": 624670,
    "RowId": 34407,
    "Text": "Endlich stehen wir uns gegenüber, meine geliebten Kinder..."
  },
  {
    "RowOffset": 624746,
    "RowId": 34408,
    "Text": "Erlaubt mir, euer Wissen in meinem Namen zu testen!"
  },
  {
    "RowOffset": 624810,
    "RowId": 34409,
    "Text": "Der reißende Strom offenbart eure wahre Natur!"
  },
  {
    "RowOffset": 624870,
    "RowId": 34410,
    "Text": "Wüte und tose, fließendes Gewässer!"
  },
  {
    "RowOffset": 624922,
    "RowId": 34411,
    "Text": "Meine Kinder, öffnet euren Geist dem Wissen."
  },
  {
    "RowOffset": 624978,
    "RowId": 34412,
    "Text": "Werdet ihr eine Antwort finden?"
  },
  {
    "RowOffset": 625022,
    "RowId": 34413,
    "Text": "Aus dem richtigen Blickwinkel lässt sich jedes Problem lösen..."
  },
  {
    "RowOffset": 625102,
    "RowId": 34414,
    "Text": "Eure Gedanken sind frei..."
  },
  {
    "RowOffset": 625146,
    "RowId": 34415,
    "Text": "Zeigt mir die Weisheit der Sterblichen!"
  },
  {
    "RowOffset": 625198,
    "RowId": 34416,
    "Text": "Offenbart mir euer Innerstes!"
  },
  {
    "RowOffset": 625238,
    "RowId": 34417,
    "Text": "Das ewige Spiel aus Frage und Antwort!"
  },
  {
    "RowOffset": 625290,
    "RowId": 34418,
    "Text": "Nicht alles, was glänzt, ist Gold!"
  },
  {
    "RowOffset": 625338,
    "RowId": 34419,
    "Text": "Lasst mich an euren Gedanken teilhaben."
  },
  {
    "RowOffset": 625390,
    "RowId": 34420,
    "Text": "Stärke allein ist nicht immer der weiseste Weg..."
  },
  {
    "RowOffset": 625458,
    "RowId": 34421,
    "Text": "Hm ... Deshalb sind also alle so begeistert von euch."
  },
  {
    "RowOffset": 625522,
    "RowId": 34422,
    "Text": "Taucht mit mir in die Wasser des Wissens!"
  },
  {
    "RowOffset": 625574,
    "RowId": 34423,
    "Text": "Was für kluge Kinder ihr doch seid..."
  },
  {
    "RowOffset": 625630,
    "RowId": 34424,
    "Text": ""
  },
  {
    "RowOffset": 625642,
    "RowId": 34425,
    "Text": ""
  },
  {
    "RowOffset": 625654,
    "RowId": 34426,
    "Text": ""
  },
  {
    "RowOffset": 625666,
    "RowId": 34427,
    "Text": ""
  },
  {
    "RowOffset": 625678,
    "RowId": 34428,
    "Text": ""
  },
  {
    "RowOffset": 625690,
    "RowId": 34429,
    "Text": ""
  },
  {
    "RowOffset": 625702,
    "RowId": 34500,
    "Text": "Euer Äther glänzt wahrlich verführerisch ..."
  },
  {
    "RowOffset": 625762,
    "RowId": 34501,
    "Text": "Aber nichts glänzt strahlender als mein Haar!"
  },
  {
    "RowOffset": 625822,
    "RowId": 34502,
    "Text": "Ihr seid nicht schnell genug!"
  },
  {
    "RowOffset": 625862,
    "RowId": 34503,
    "Text": "Ich verfehle mein Ziel nicht!"
  },
  {
    "RowOffset": 625902,
    "RowId": 34504,
    "Text": "Schmeckt meine Klinge!"
  },
  {
    "RowOffset": 625938,
    "RowId": 34505,
    "Text": "Übermut wird bestraft!"
  },
  {
    "RowOffset": 625974,
    "RowId": 34506,
    "Text": "Frei weht mein Haar im Wind! "
  },
  {
    "RowOffset": 626014,
    "RowId": 34507,
    "Text": "So fließend und stark!"
  },
  {
    "RowOffset": 626050,
    "RowId": 34508,
    "Text": "Ah, der Wind steht günstig wie nie!"
  },
  {
    "RowOffset": 626098,
    "RowId": 34509,
    "Text": "Spürt meine reißenden Böen!"
  },
  {
    "RowOffset": 626142,
    "RowId": 34510,
    "Text": "Mir scheint, es ist euch nicht stürmisch genug ..."
  },
  {
    "RowOffset": 626206,
    "RowId": 34511,
    "Text": "Sehen wir einmal, wie ihr mit diesem Sturm zurechtkommt!"
  },
  {
    "RowOffset": 626274,
    "RowId": 34512,
    "Text": "Ahahahahaha!"
  },
  {
    "RowOffset": 626298,
    "RowId": 34513,
    "Text": "Jetzt schneide ich euch in Stücke!"
  },
  {
    "RowOffset": 626346,
    "RowId": 34514,
    "Text": "Hyahahaha!"
  },
  {
    "RowOffset": 626370,
    "RowId": 34515,
    "Text": "Das gibt euch den Rest!"
  },
  {
    "RowOffset": 626406,
    "RowId": 34516,
    "Text": "Haltet gefälligst still!"
  },
  {
    "RowOffset": 626442,
    "RowId": 34517,
    "Text": "Ihr habt euch mit der Falschen angelegt!"
  },
  {
    "RowOffset": 626494,
    "RowId": 34518,
    "Text": "Hrrraaaah!"
  },
  {
    "RowOffset": 626518,
    "RowId": 34519,
    "Text": "Tot gefallt ihr mir besser!"
  },
  {
    "RowOffset": 626558,
    "RowId": 34520,
    "Text": "Ist das alles, was ihr könnt?"
  },
  {
    "RowOffset": 626602,
    "RowId": 34521,
    "Text": "Was für eine armselige Vorstellung!"
  },
  {
    "RowOffset": 626650,
    "RowId": 34522,
    "Text": "Das nennt ihr Deckung?!"
  },
  {
    "RowOffset": 626686,
    "RowId": 34523,
    "Text": "Da ihr nichts dazulernt, versuchen wir es noch einmal..."
  },
  {
    "RowOffset": 626758,
    "RowId": 34524,
    "Text": "Nicht ein Hauch Äther wird von euch übrig sein!"
  },
  {
    "RowOffset": 626818,
    "RowId": 34525,
    "Text": "Schluss mit den Spielchen ..."
  },
  {
    "RowOffset": 626858,
    "RowId": 34526,
    "Text": "Euer Dasein verpestet meine Luft!"
  },
  {
    "RowOffset": 626902,
    "RowId": 34527,
    "Text": ""
  },
  {
    "RowOffset": 626914,
    "RowId": 34528,
    "Text": ""
  },
  {
    "RowOffset": 626926,
    "RowId": 34529,
    "Text": ""
  },
  {
    "RowOffset": 626938,
    "RowId": 34530,
    "Text": ""
  },
  {
    "RowOffset": 626950,
    "RowId": 34531,
    "Text": ""
  },
  {
    "RowOffset": 626962,
    "RowId": 34532,
    "Text": ""
