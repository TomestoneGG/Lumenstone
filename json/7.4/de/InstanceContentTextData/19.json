    "RowOffset": 627766,
    "RowId": 34599,
    "Text": ""
  },
  {
    "RowOffset": 627778,
    "RowId": 34600,
    "Text": "Nein! Raus hier! Ich muss die Eindringlinge vernichten!"
  },
  {
    "RowOffset": 627846,
    "RowId": 34601,
    "Text": "Dieser riesige Körper! Das ist keine Hohe Wächterin mehr..."
  },
  {
    "RowOffset": 627922,
    "RowId": 34602,
    "Text": "Sie will uns den Boden unter den Füßen wegziehen. Ich schaffe uns hier einen neuen!"
  },
  {
    "RowOffset": 628018,
    "RowId": 34603,
    "Text": "Wir brauchen mehr Platz."
  },
  {
    "RowOffset": 628054,
    "RowId": 34604,
    "Text": "Vernichten! Ich werde euch vernichten! Verschwindeeet!"
  },
  {
    "RowOffset": 628122,
    "RowId": 34605,
    "Text": "Weicht den Angriffen aus! Ich verschaffe uns neuen Boden unter den Füßen!"
  },
  {
    "RowOffset": 628210,
    "RowId": 34606,
    "Text": "Sie will uns wieder den Boden wegziehen! Ganz schön hartnäckig. Also gut, dann erschaffe ich halt wieder einen neuen."
  },
  {
    "RowOffset": 628342,
    "RowId": 34607,
    "Text": "Sie hört nicht auf. Und es braucht Zeit, neuen Boden herbeizuzaubern."
  },
  {
    "RowOffset": 628434,
    "RowId": 34608,
    "Text": "Verdammt! Alles vernichtet. Schnell, wir brauchen neuen Boden!"
  },
  {
    "RowOffset": 628510,
    "RowId": 34609,
    "Text": "Es ist noch nicht vorbei. Ich werde uns woanders Boden erschaffen."
  },
  {
    "RowOffset": 628590,
    "RowId": 34610,
    "Text": "Wir müssen durchhalten! Ich werde den Boden noch einmal wiederherstellen!"
  },
  {
    "RowOffset": 628682,
    "RowId": 34611,
    "Text": "Zerstören, neu aufbauen. Zerstören, neu aufbauen. Ich habe es verstanden."
  },
  {
    "RowOffset": 628770,
    "RowId": 34612,
    "Text": "Agdistis besiegen"
  },
  {
    "RowOffset": 628798,
    "RowId": 34613,
    "Text": "Ich werde dich ...vernichten..."
  },
  {
    "RowOffset": 628850,
    "RowId": 34614,
    "Text": "Ich spüre eine Ätherfluktuation. Achtung, sie erschafft neues Leben!"
  },
  {
    "RowOffset": 628934,
    "RowId": 34615,
    "Text": "Ich vernichte euch, elende Eindringlinge!"
  },
  {
    "RowOffset": 628986,
    "RowId": 34616,
    "Text": "Ich bin ...Agdistis? Ist dieser Körper mein? Meine Kraft ist... die einer Hohen Wächterin!"
  },
  {
    "RowOffset": 629098,
    "RowId": 34617,
    "Text": "Geht das schon wieder los? Achtung, ich mache uns hier einen neuen Boden."
  },
  {
    "RowOffset": 629182,
    "RowId": 34618,
    "Text": "Ich lasse das nicht zu! Ich werde euch, alles, zerstören!"
  },
