    "Text": ""
  },
  {
    "RowOffset": 862410,
    "RowId": 41900,
    "Text": "Auf in den alles entscheidenden Kampf!"
  },
  {
    "RowOffset": 862462,
    "RowId": 41901,
    "Text": "Der Titelverteidiger im Schwergewicht macht seinen Auftritt!"
  },
  {
    "RowOffset": 862534,
    "RowId": 41902,
    "Text": "Bei euch muss ich mich nicht zurückhalten, oder?"
  },
  {
    "RowOffset": 862594,
    "RowId": 41903,
    "Text": "Man kann seinen Bewegungen kaum folgen!"
  },
  {
    "RowOffset": 862646,
    "RowId": 41904,
    "Text": "Könnt ihr den Überblick behalten?"
  },
  {
    "RowOffset": 862694,
    "RowId": 41905,
    "Text": "Etwas Spaß könnt ihr mir verzeihen, ja?"
  },
  {
    "RowOffset": 862746,
    "RowId": 41906,
    "Text": "Seht, wozu Fenrirs Seele fähig ist!"
  },
  {
    "RowOffset": 862794,
    "RowId": 41907,
    "Text": "Ooh! Er hat riesige Statuen erschaffen!"
  },
  {
    "RowOffset": 862846,
    "RowId": 41908,
    "Text": "Einfach filetiert! Das ist unser Stolzer Wolf!"
  },
  {
    "RowOffset": 862906,
    "RowId": 41909,
    "Text": "Nicht schlecht... Aber wie sieht es hiermit aus?"
  },
  {
    "RowOffset": 862970,
    "RowId": 41910,
    "Text": "Mal sehen, ob ihr das überstehen könnt!"
  },
  {
    "RowOffset": 863022,
    "RowId": 41911,
    "Text": "Ich gebe zu, das überrascht mich. Hehe, so langsam wird die Sache interessant!"
  },
  {
    "RowOffset": 863114,
    "RowId": 41912,
    "Text": "Selbst Stürme unterwerfen sich Fenrirs Macht!"
  },
  {
    "RowOffset": 863174,
    "RowId": 41913,
    "Text": "Das war's dann. Der Sieg gehört mir!"
  },
  {
    "RowOffset": 863222,
    "RowId": 41914,
    "Text": "Urgh... Ich werde nicht aufgeben...!"
  },
  {
    "RowOffset": 863278,
    "RowId": 41915,
    "Text": "Fenrir, gib mir auch den Rest deiner Kraft!"
  },
  {
    "RowOffset": 863334,
    "RowId": 41916,
    "Text": "Was mit mir auch geschieht... ich darf hier nicht verlieren!"
  },
  {
    "RowOffset": 863410,
    "RowId": 41917,
    "Text": "Da stimmt was nicht! Was hat Heulende Klinge nur vor...?!"
  },
  {
    "RowOffset": 863482,
    "RowId": 41918,
    "Text": "Da geht der Ring zu Bruch! Der Kampf verlagert sich nach unten!"
  },
  {
    "RowOffset": 863558,
    "RowId": 41919,
    "Text": "Schwebende Inseln...! Haben sie hier überhaupt genug Platz?!"
  },
  {
    "RowOffset": 863634,
    "RowId": 41920,
    "Text": "Schluss mit lustig. Macht euch bereit!"
  },
  {
    "RowOffset": 863686,
    "RowId": 41921,
    "Text": "Alles wird niedergemäht!"
  },
  {
    "RowOffset": 863722,
    "RowId": 41922,
    "Text": "Diese Insel ist im Weg!"
  },
  {
    "RowOffset": 863758,
    "RowId": 41923,
    "Text": "Er hat eine Insel zerschmettert! Wir setzen uns sofort an die Reparatur!"
  },
  {
    "RowOffset": 863842,
    "RowId": 41924,
    "Text": "Nichts hält der entfesselten Macht des Windes stand!"
  },
  {
    "RowOffset": 863914,
    "RowId": 41925,
    "Text": "Vor mir gibt es kein Entkommen!"
  },
  {
    "RowOffset": 863958,
    "RowId": 41926,
    "Text": "Mit all meiner Kraft... werde ich euch besiegen!"
  },
  {
    "RowOffset": 864022,
    "RowId": 41927,
    "Text": "Selbst wenn... es mich mein Leben kostet...!"
  },
  {
    "RowOffset": 864086,
    "RowId": 41928,
    "Text": "Ein verzweifelter Kampf auf beiden Seiten! Wen verlassen die Kräfte zuerst?!"
  },
  {
    "RowOffset": 864174,
    "RowId": 41929,
    "Text": "Eine Niederlage... kann ich... nicht akzeptieren!"
  },
  {
    "RowOffset": 864242,
    "RowId": 41930,
    "Text": "Ihr seid wirklich stark...! Aber gewinnen... Werde <i>iiiich</i>!"
  },
  {
    "RowOffset": 864330,
    "RowId": 41931,
    "Text": "Weicht ruhig aus, wenn ihr könnt!"
  },
  {
    "RowOffset": 864378,
    "RowId": 41932,
    "Text": "Ob ihr euch hiernach noch bewegen könnt?"
  },
  {
    "RowOffset": 864430,
    "RowId": 41933,
    "Text": "Heulende Klinge bezwingen"
  },
  {
    "RowOffset": 864466,
    "RowId": 41934,
    "Text": "Huooaah!"
  },
  {
    "RowOffset": 864486,
    "RowId": 41935,
    "Text": "Huah!"
  },
  {
    "RowOffset": 864502,
    "RowId": 41936,
    "Text": "Huah!"
  },
