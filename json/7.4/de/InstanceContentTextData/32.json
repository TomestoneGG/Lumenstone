  },
  {
    "RowOffset": 857126,
    "RowId": 41700,
    "Text": "Sinkt in die Schwärze wahrer Dunkelheit!"
  },
  {
    "RowOffset": 857178,
    "RowId": 41701,
    "Text": "Scharf schneidet unsere Schwärze!"
  },
  {
    "RowOffset": 857226,
    "RowId": 41702,
    "Text": "Das Nichts wird alles verschlingen!"
  },
  {
    "RowOffset": 857274,
    "RowId": 41703,
    "Text": "Alles Licht soll in uns vergehen!"
  },
  {
    "RowOffset": 857318,
    "RowId": 41704,
    "Text": "Hinab in den Abgrund!"
  },
  {
    "RowOffset": 857350,
    "RowId": 41705,
    "Text": "Ins Nichts!"
  },
  {
    "RowOffset": 857374,
    "RowId": 41706,
    "Text": "Ihr Maden, hinfort mit euch!"
  },
  {
    "RowOffset": 857414,
    "RowId": 41707,
    "Text": "Licht und Dunkel, beides halten wir in unseren Händen!"
  },
  {
    "RowOffset": 857482,
    "RowId": 41708,
    "Text": "Gebt euch der Stille der Dunkelheit hin..."
  },
  {
    "RowOffset": 857542,
    "RowId": 41709,
    "Text": "Auch der Tod ist nur ein Teil des allumfassenden Nichts!"
  },
  {
    "RowOffset": 857610,
    "RowId": 41710,
    "Text": "Dunkler Wind, wirble alles in die Finsternis!"
  },
  {
    "RowOffset": 857666,
    "RowId": 41711,
    "Text": "Kalter Tod, erfülle unsere Brust!"
  },
  {
    "RowOffset": 857714,
    "RowId": 41712,
    "Text": "Schwarzer Wind, erfülle unsere Brust!"
  },
  {
    "RowOffset": 857766,
    "RowId": 41713,
    "Text": "Nichts ... Nichts kann die Macht der Dunkelheit mehr aufhalten!"
  },
  {
    "RowOffset": 857842,
    "RowId": 41714,
    "Text": "Schweigt still wie stummer Stein!"
  },
  {
    "RowOffset": 857886,
    "RowId": 41715,
    "Text": "Gelingt euch der Griff nach der Freiheit?"
  },
