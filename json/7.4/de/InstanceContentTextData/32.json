  },
  {
    "RowOffset": 855802,
    "RowId": 41619,
    "Text": "Absolute Autorität in 1..."
  },
  {
    "RowOffset": 855846,
    "RowId": 41620,
    "Text": "Ha-Ha-HALlo... u-u-u-uNd AUf... AuFWiEDErsEhEN!"
  },
  {
    "RowOffset": 855914,
    "RowId": 41621,
    "Text": "ViE-VIe...En..Nk. ÄtHEr...In KÜrze be-BE-Be..."
  },
  {
    "RowOffset": 855978,
    "RowId": 41622,
    "Text": "HmM, im FaLl...F?!lE...Wirst <i>du</i>...?!"
  },
  {
    "RowOffset": 856038,
    "RowId": 41623,
    "Text": "Se-seHt DIE...eu ver...nDenE WElt!"
  },
  {
    "RowOffset": 856086,
    "RowId": 41624,
    "Text": "SeI-sEi-Seid... SEiD ihR glüCKLiCh?"
  },
  {
    "RowOffset": 856138,
    "RowId": 41625,
    "Text": "Fü-fÜ-Fü-füRChtEt...ch...nICHT!"
  },
  {
    "RowOffset": 856186,
    "RowId": 41626,
    "Text": "LaS...LAsST uN...laSsT UN...LAssT un...ÜBErWiNdEN!"
