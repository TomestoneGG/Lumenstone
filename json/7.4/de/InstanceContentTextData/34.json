[
  {
    "RowOffset": 884698,
    "RowId": 42609,
    "Text": "Da seid ihr ja endlich. Wir fangen simpel an, keine Sorge."
  },
  {
    "RowOffset": 884770,
    "RowId": 42610,
    "Text": "Endlose zu erschaffen, ist ein Leichtes für mich. Zwar sind sie keine Kämpfer, aber sehr gehorsam."
  },
  {
    "RowOffset": 884882,
    "RowId": 42611,
    "Text": "Vor allem, wenn ich ihnen befehle, Feinde zu beseitigen. Lasst mich eine passende Bühne vorbereiten."
  },
  {
    "RowOffset": 884994,
    "RowId": 42612,
    "Text": "Die Erinnerungen eines Arztes. Sein Alltag? Ein nicht enden wollender Kampf gegen den Tod."
  },
  {
    "RowOffset": 885098,
    "RowId": 42613,
    "Text": "So viel hält das System wohl nicht aus... Nützlich war es mir dennoch."
  },
  {
    "RowOffset": 885186,
    "RowId": 42614,
    "Text": "Ein Kerker erfüllt von den Gedanken seiner Insassen...\nBei solch einer Angriffslustigkeit braucht es gar keine Befehle."
  },
  {
    "RowOffset": 885326,
    "RowId": 42615,
    "Text": "Henker sind der Inbegriff von Loyalität. Jeder Sünder wird ohne Zögern beseitigt."
  },
  {
    "RowOffset": 885422,
    "RowId": 42616,
    "Text": "Gut genug. Kommt weiter."
  },
  {
    "RowOffset": 885458,
    "RowId": 42617,
    "Text": "Der allgegenwärtige Tod... Erinnerungen an eine Zeit, in der eine lebendige Rückkehr nicht mehr als ein Traum war."
  },
  {
    "RowOffset": 885590,
    "RowId": 42618,
    "Text": "Los, ihr Soldaten! Der Feind greift an! Verteidigt euer Land, bis zum letzten Atemzug!"
  },
  {
    "RowOffset": 885690,
    "RowId": 42619,
    "Text": "Mal sehen, zu was dieser Haufen Erinnerungen fähig ist..."
  },
  {
    "RowOffset": 885766,
    "RowId": 42620,
    "Text": "Wir befinden uns am Höhepunkt der Stromschlachten..."
  },
  {
    "RowOffset": 885834,
    "RowId": 42621,
    "Text": "Unzählige Leben- verloren durch reine Torheit."
  },
  {
    "RowOffset": 885898,
    "RowId": 42622,
    "Text": "Tagtäglich wurden die Kämpfe grausamer und brutaler..."
  },
  {
    "RowOffset": 885970,
    "RowId": 42623,
    "Text": "Die Bombenangriffe des Feindes rissen nicht ab."
  },
  {
    "RowOffset": 886030,
    "RowId": 42624,
    "Text": "Mit jedem Blitzschlag schieden weitere dahin..."
  },
  {
    "RowOffset": 886094,
    "RowId": 42625,
    "Text": "Wohin man auch blickte, stahl der Tod die Zukunft der Lebenden."
  },
  {
    "RowOffset": 886170,
    "RowId": 42626,
    "Text": "Die Zeit eurer Hinrichtung naht."
  },
  {
    "RowOffset": 886214,
    "RowId": 42627,
    "Text": "Rennt nur, für Sünder gibt es kein Entkommen."
  },
