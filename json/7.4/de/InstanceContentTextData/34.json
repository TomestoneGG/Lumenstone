  {
    "RowOffset": 896294,
    "RowId": 42995,
    "Text": ""
  },
  {
    "RowOffset": 896306,
    "RowId": 42996,
    "Text": ""
  },
  {
    "RowOffset": 896318,
    "RowId": 42997,
    "Text": ""
  },
  {
    "RowOffset": 896330,
    "RowId": 42998,
    "Text": ""
  },
  {
    "RowOffset": 896342,
    "RowId": 42999,
    "Text": ""
  },
  {
    "RowOffset": 896354,
    "RowId": 43000,
    "Text": "Schimmernde Säcke gesammelt"
  },
  {
    "RowOffset": 896394,
    "RowId": 43100,
    "Text": "Quans Höhle erobern"
  },
  {
    "RowOffset": 896426,
    "RowId": 43101,
    "Text": "Die Treno-Catblepus besiegen"
  },
  {
    "RowOffset": 896466,
    "RowId": 43102,
    "Text": "Die Treno-Ebene durchqueren"
  },
  {
    "RowOffset": 896506,
    "RowId": 43103,
    "Text": "Amdusias besiegen"
  },
  {
    "RowOffset": 896534,
    "RowId": 43104,
    "Text": "Treno-Stadt zurückerobern"
  },
  {
    "RowOffset": 896574,
    "RowId": 43105,
    "Text": "Den Donnergreif unschädlich machen"
  },
  {
    "RowOffset": 896622,
    "RowId": 43106,
    "Text": "Das nimmt ja gar kein Ende! Aber unsere Stadt überlassen wir den Biestern nicht!"
  },
  {
    "RowOffset": 896714,
    "RowId": 43107,
    "Text": "Seid ihr Reisende?! Geht Richtung Stadtzentrum, dort suchen wir Schutz!"
  },
  {
    "RowOffset": 896798,
    "RowId": 43300,
    "Text": "Hast du gerufen, mein Bäumlein?\nWas dich bedroht, soll meinen Zorn spüren!"
  },
  {
    "RowOffset": 896890,
    "RowId": 43400,
    "Text": "Ich verlass' mich voll und ganz auf dich!"
  },
  {
    "RowOffset": 896942,
    "RowId": 43401,
    "Text": "Er hat den ganzen Waggon von den Gleisen gerammt?!"
  },
  {
    "RowOffset": 897006,
    "RowId": 43402,
    "Text": "S-Sind das Kanonen?! Bring dich in Sicherheit!"
  },
  {
    "RowOffset": 897066,
    "RowId": 43403,
    "Text": "Noch ein Waggon weniger...! Stehst du noch?!"
  },
  {
    "RowOffset": 897126,
    "RowId": 43404,
    "Text": "Mit der Vorrichtung da kannst du hochspringen!"
  },
  {
    "RowOffset": 897186,
    "RowId": 43405,
    "Text": "Jetzt reicht's aber langsam mal!"
  },
  {
    "RowOffset": 897230,
    "RowId": 43406,
    "Text": "H-He, geht's dir gut?! Hallo?!"
  },
  {
    "RowOffset": 897274,
    "RowId": 43407,
    "Text": "Sind das... Arme aus Äther?!"
  },
  {
    "RowOffset": 897318,
    "RowId": 43408,
    "Text": "Uwah! Schnell, spring zum nächsten Waggon!"
  },
  {
    "RowOffset": 897374,
    "RowId": 43409,
    "Text": "Der hat sie doch nicht mehr alle!"
  },
  {
    "RowOffset": 897418,
    "RowId": 43410,
    "Text": "Verdammt, nicht schon wieder!"
  },
  {
    "RowOffset": 897458,
    "RowId": 43411,
    "Text": "Vorsicht, mach dich bereit!"
  },
  {
    "RowOffset": 897498,
    "RowId": 43412,
    "Text": "M-Mehr Waggons hat unser Zug nicht!"
  },
  {
    "RowOffset": 897546,
    "RowId": 43413,
    "Text": "Das sieht überhaupt nicht gut aus!"
  },
  {
    "RowOffset": 897594,
    "RowId": 43414,
    "Text": "Wie viel hält dieses Ding denn noch aus?!"
  },
  {
    "RowOffset": 897650,
    "RowId": 43500,
    "Text": "Vamp Fatale besiegen"
  },
  {
    "RowOffset": 897682,
    "RowId": 43501,
    "Text": "\\\\<kicher> Seid ihr bereit, um Gnade zu winseln?"
  },
  {
    "RowOffset": 897742,
    "RowId": 43502,
    "Text": "Die Kämpfe im Superschwergewicht haben offiziell begonnen!"
  },
  {
    "RowOffset": 897814,
    "RowId": 43503,
    "Text": "Werden die Herausforderer der Henkerin zum Opfer fallen?"
  },
  {
    "RowOffset": 897882,
    "RowId": 43504,
    "Text": "Zu mir, meine Diener!"
  },
  {
    "RowOffset": 897914,
    "RowId": 43505,
    "Text": "Wir fangen gerade erst an! Ich will euch flehen und jammern hören!"
  },
  {
    "RowOffset": 897994,
    "RowId": 43506,
    "Text": "Die Henkerin! Immer bereit, sich ein Blutbad einzulassen!"
  },
  {
    "RowOffset": 898062,
    "RowId": 43507,
    "Text": "Vorsicht, sonst ziert euer Blut gleich den Ring!"
  },
  {
    "RowOffset": 898122,
    "RowId": 43508,
    "Text": "Die Herausforderer wurden in die Enge getrieben!"
  },
  {
    "RowOffset": 898182,
    "RowId": 43509,
    "Text": "Euer Warten hat ein Ende...! Seid brave Diener und gebt mir euren Äther!"
  },
  {
    "RowOffset": 898270,
    "RowId": 43510,
    "Text": "Dieser Angriff! Sie entzieht den Zuschauern Äther!"
  },
  {
    "RowOffset": 898334,
    "RowId": 43511,
    "Text": "Gebt euch dem Schmerz hin!"
  },
  {
    "RowOffset": 898374,
    "RowId": 43512,
    "Text": "Vamp Fatale setzt ihren Äther frei! Der Ring ist komplett unter ihrer Kontrolle!"
  },
  {
    "RowOffset": 898466,
    "RowId": 43513,
    "Text": "Ihr wollt es also nicht anders... Wer nicht kniet, muss eben fühlen!"
  },
  {
    "RowOffset": 898550,
    "RowId": 43514,
    "Text": "Und zurück in die Folterkammer! Können die Herausforderer erneut entkommen?"
  },
  {
    "RowOffset": 898638,
    "RowId": 43515,
    "Text": "Aus welchen Höllen stammen nur all diese Waffen?"
  },
  {
    "RowOffset": 898698,
    "RowId": 43516,
    "Text": "Bildet euch ja nichts ein ...! Mehr...! Mehr Äther!"
  },
  {
    "RowOffset": 898762,
    "RowId": 43517,
    "Text": "Sie saugt dem Publikum wieder Äther ab! Sind die Zuschauer noch bei Bewusstsein?"
  },
  {
    "RowOffset": 898854,
    "RowId": 43518,
    "Text": "Niemand kann diesem Schmerz widerstehen!"
  },
  {
    "RowOffset": 898906,
    "RowId": 43519,
    "Text": "Diese Menge ist unglaublich! Was hat sie damit nur vor?"
  },
  {
    "RowOffset": 898974,
    "RowId": 43520,
    "Text": "Vor mir gibt es kein Entkommen!"
  },
  {
    "RowOffset": 899018,
    "RowId": 43521,
    "Text": "Nicht genug ...! Euer ganzer Äther gehört mir, bis auf den letzten Tropfen!"
  },
  {
    "RowOffset": 899106,
    "RowId": 43522,
    "Text": "Ihr Hunger nach Äther ist unstillbar! So langsam.... wird mir auch schummerig..."
  },
  {
    "RowOffset": 899206,
    "RowId": 43523,
    "Text": "Ihr hattet... eure Chance...!"
  },
  {
    "RowOffset": 899254,
    "RowId": 43524,
    "Text": "Jetzt müssen die Herausforderer Äther bluten!"
  },
  {
    "RowOffset": 899314,
    "RowId": 43525,
    "Text": "Werft euch endlich... vor mir nieder...!"
  },
