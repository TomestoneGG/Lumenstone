  },
  {
    "RowOffset": 887138,
    "RowId": 42700,
    "Text": "Wasser ... Licht ..."
  },
  {
    "RowOffset": 887170,
    "RowId": 42701,
    "Text": "Sprießen ... Wachsen ..."
  },
  {
    "RowOffset": 887206,
    "RowId": 42702,
    "Text": "Blüten, blüht!"
  },
  {
    "RowOffset": 887234,
    "RowId": 42703,
    "Text": "Wasser ... Licht ...\nNicht vergehen!"
  },
  {
    "RowOffset": 887286,
    "RowId": 42704,
    "Text": "Sprießen ... Wachsen!\nMehr und mehr!"
