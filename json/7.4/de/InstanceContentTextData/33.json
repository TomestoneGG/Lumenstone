  {
    "RowOffset": 870542,
    "RowId": 42199,
    "Text": ""
  },
  {
    "RowOffset": 870554,
    "RowId": 42200,
    "Text": "Ich hoooffe, ihr habt viel Infpiration mitgebracht!"
  },
  {
    "RowOffset": 870618,
    "RowId": 42201,
    "Text": "Zuckerschock heißt uns in ihrem Atelier willkommen!"
  },
  {
    "RowOffset": 870682,
    "RowId": 42202,
    "Text": "Dann mahalen wir direkt los!"
  },
  {
    "RowOffset": 870722,
    "RowId": 42203,
    "Text": "Das nenne ich Kunst zum Anfassen!"
  },
  {
    "RowOffset": 870766,
    "RowId": 42204,
    "Text": "Ich habe noch ganz viel Faharbe übrig!"
  },
  {
    "RowOffset": 870818,
    "RowId": 42205,
    "Text": "Ich fehe es genau vor mir! Das wird euch sicher gefahallen!"
  },
  {
    "RowOffset": 870890,
    "RowId": 42206,
    "Text": "Das Atelier hat sich in eine Wüste verwandelt!"
  },
  {
    "RowOffset": 870950,
    "RowId": 42207,
    "Text": "Ein guter Ahanfang. Aber wird sind noch lange nicht fehertig!"
  },
  {
    "RowOffset": 871022,
    "RowId": 42208,
    "Text": "Und waf wäre eine Wüste... ohne Kakteen!"
  },
  {
    "RowOffset": 871082,
    "RowId": 42209,
    "Text": "Da zischen die Nadeln durch die Luft! Aufgepasst!"
  },
  {
    "RowOffset": 871142,
    "RowId": 42210,
    "Text": "Hmm, da fehehlt noch waf... Ah, natürlich!"
  },
  {
    "RowOffset": 871202,
    "RowId": 42211,
    "Text": "Ist das etwa Treibsand?! Dem würde ich nicht zu nahe kommen!"
  },
  {
    "RowOffset": 871274,
    "RowId": 42212,
    "Text": "Ooh, da sieht sich wohl jemand den Sand von unten an!"
  },
  {
    "RowOffset": 871338,
    "RowId": 42213,
    "Text": "Mir kaham gerade eine neue Idee! Waf haltet ihr davon?"
  },
  {
    "RowOffset": 871406,
    "RowId": 42214,
    "Text": "Umwerfend! Der Fluss ist klarer als Kristall!"
  },
  {
    "RowOffset": 871462,
    "RowId": 42215,
    "Text": "Nein, nein, viel zu idyllisch! Da fehlt eine stürmische Note!"
  },
  {
    "RowOffset": 871538,
    "RowId": 42216,
    "Text": "Oooh, Zuckerschock hat den Fluss mit einem Regenschauer getrübt!"
  },
  {
    "RowOffset": 871614,
    "RowId": 42217,
    "Text": "Jeetzt aber! Zerstörung ist die wahre Effenz der Kunst!"
  },
  {
    "RowOffset": 871682,
    "RowId": 42218,
    "Text": "Was für eine gewaltige Sturmwolke! Das sieht gefährlich aus!"
  },
  {
    "RowOffset": 871758,
    "RowId": 42219,
    "Text": "Ich kann mein Kreativität nicht mehr zügeln! Exfplosion!"
  },
  {
    "RowOffset": 871830,
    "RowId": 42220,
    "Text": "Zuckerschock läuft Amok! Es strömt unaufhörlich Lava aus dem Vulkan!"
  },
  {
    "RowOffset": 871914,
    "RowId": 42221,
    "Text": "Normale Puhudings sind viel zu langweilig!"
  },
  {
    "RowOffset": 871970,
    "RowId": 42222,
    "Text": "Das gibt’s ja nicht! Sie hat die Bestien umgemalt!"
  },
  {
    "RowOffset": 872034,
    "RowId": 42223,
    "Text": "Waf sind eure Lieblingffarben?"
  },
  {
    "RowOffset": 872078,
    "RowId": 42224,
    "Text": "Wie wär ef... hiermit?"
  },
  {
    "RowOffset": 872118,
    "RowId": 42225,
    "Text": "Nicht eindrucksvoholl genug!"
  },
  {
    "RowOffset": 872158,
    "RowId": 42226,
    "Text": "Danke für all die Infpiration! Fo frei war meine Kunst noch nie!"
  },
  {
    "RowOffset": 872234,
    "RowId": 42227,
    "Text": "Zuckerschock bezwingen"
  },
  {
