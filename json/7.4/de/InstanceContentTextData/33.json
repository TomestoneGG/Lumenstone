  },
  {
    "RowOffset": 876018,
    "RowId": 42399,
    "Text": ""
  },
  {
    "RowOffset": 876030,
    "RowId": 42400,
    "Text": "Springhis Khan bezwingen"
  },
  {
    "RowOffset": 876066,
    "RowId": 42401,
    "Text": "Dann bringen wir diese Party mal in Schwung!"
  },
  {
    "RowOffset": 876122,
    "RowId": 42402,
    "Text": "Springhis Khan hat die Disco eröffnet!"
  },
  {
    "RowOffset": 876174,
    "RowId": 42403,
    "Text": "Könnt ihr mit meinen Schritten mithalten?"
  },
  {
    "RowOffset": 876230,
    "RowId": 42404,
    "Text": "Er schwingt direkt das Tanzbein!"
  },
  {
    "RowOffset": 876274,
    "RowId": 42405,
    "Text": "Und weiter! Heute wird getanzt bis zum Umfallen!"
  },
  {
    "RowOffset": 876334,
    "RowId": 42406,
    "Text": "Auf der Tanzfläche ist jeder ein Staaaar! Na los, keine Scheu!"
  },
  {
    "RowOffset": 876410,
    "RowId": 42407,
    "Text": "Auf ins Rrrrampenlicht, und hoch die Hände!"
  },
  {
    "RowOffset": 876466,
    "RowId": 42408,
    "Text": "Eine Aufforderung zum Tanz! Wie werden die Herausforderer reagieren?"
  },
  {
    "RowOffset": 876546,
    "RowId": 42409,
    "Text": "Mal sehen, was <i>ihr</i> für Schritte drauf habt!"
  },
  {
    "RowOffset": 876614,
    "RowId": 42410,
    "Text": "Dieser Party fehlt noch was! Los geht's!"
  },
  {
    "RowOffset": 876666,
    "RowId": 42411,
    "Text": "Jetzt bringen wir die Sohlen erst so richtig zum Glühen!"
  },
  {
    "RowOffset": 876734,
    "RowId": 42412,
    "Text": "Springhis Khan ist nicht mehr zu halten! Können die Herausforderer seinen Schritten folgen?!"
  },
  {
    "RowOffset": 876838,
    "RowId": 42413,
    "Text": "Bei diesem Tanzfieber hilft keine Medizin!"
  },
  {
    "RowOffset": 876894,
    "RowId": 42414,
    "Text": "Und jetzt das große Finale!"
  },
  {
    "RowOffset": 876934,
    "RowId": 42415,
    "Text": "Ihr seid der absolute Waaahnsinn! Genau so geht's!"
  },
  {
    "RowOffset": 876998,
    "RowId": 42416,
    "Text": "Wooh, nicht schlecht! Ihr bringt die Leute so richtig in Fahrt!"
  },
  {
    "RowOffset": 877074,
    "RowId": 42417,
    "Text": "He, ganz in Ordnung, aber da geht noch meeehr!"
  },
  {
    "RowOffset": 877134,
    "RowId": 42418,
    "Text": "Kommt schon, die Leute schlafen ja gleich ein!"
  },
  {
    "RowOffset": 877194,
    "RowId": 42419,
    "Text": "Wir drehen noch weiter auf! Los geht's!"
  },
  {
    "RowOffset": 877246,
    "RowId": 42420,
    "Text": "Zeit für eine Zugabe! Gebt euch dem Rhythmus hin!"
  },
  {
    "RowOffset": 877310,
    "RowId": 42421,
    "Text": "Und er legt noch einen drauf! An diesem Tanz kann man sich kaum sattsehen!"
  },
  {
    "RowOffset": 877398,
    "RowId": 42422,
    "Text": "Stolpert nicht über eure Füße, ja?"
  },
  {
    "RowOffset": 877446,
    "RowId": 42423,
    "Text": "Wir müssen noch etwas nachheizen! Los geht's!"
  },
  {
    "RowOffset": 877506,
    "RowId": 42424,
    "Text": "Auch die beste Party ist irgendwann vorbei!"
  },
  {
    "RowOffset": 877562,
    "RowId": 42425,
    "Text": "Ihr wart fantastisch! Lasst uns bald wieder zusammen tanzen!"
  },
