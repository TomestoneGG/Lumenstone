[
  {
    "RowOffset": 867962,
    "RowId": 42109,
    "Text": "Soldat S0 der Wacheinheit der Burg Alexandria meldet sich zu Diensten. Die Eindringlinge werden gemäß den Befehlen der Vizekommandantin umgehend eliminiert."
  },
  {
    "RowOffset": 868134,
    "RowId": 42110,
    "Text": "Beschränkungen aufgehoben... Starte Angriffsmanöver."
  },
  {
    "RowOffset": 868206,
    "RowId": 42111,
    "Text": "Ersatzwaffen aktiviert... Eliminierung eingeleitet."
  },
  {
    "RowOffset": 868274,
    "RowId": 42112,
    "Text": ""
  },
  {
    "RowOffset": 868286,
    "RowId": 42113,
    "Text": "Kritischer Schaden... System gestoppt... Verzeihung, Vize...kommandantin..."
  },
  {
    "RowOffset": 868386,
    "RowId": 42114,
    "Text": "Den Sockel durchqueren"
  },
  {
    "RowOffset": 868422,
    "RowId": 42115,
    "Text": "Gargant besiegen"
  },
  {
    "RowOffset": 868450,
    "RowId": 42116,
    "Text": "Den Außenbereich der Burg durchqueren"
  },
  {
    "RowOffset": 868502,
    "RowId": 42117,
    "Text": "Soldat S0 besiegen"
  },
  {
    "RowOffset": 868534,
    "RowId": 42118,
    "Text": "Den Innenbereich der Burg durchqueren"
  },
  {
    "RowOffset": 868582,
    "RowId": 42119,
    "Text": "Mechalith besiegen"
  },
  {
    "RowOffset": 868614,
    "RowId": 42120,
    "Text": "Scheinbar haben es sich hier auch einige Bestien gemütlich gemacht..."
  },
  {
    "RowOffset": 868702,
    "RowId": 42121,
    "Text": "正面のルートは塞がっているので、迂回して進みましょう。"
  },
  {
    "RowOffset": 868794,
    "RowId": 42122,
    "Text": "Es sollte in der Nähe Kontrollöffnungen geben, die ins Innere führen. Seht mal, ob ihr eine finden könnt."
  },
  {
    "RowOffset": 868914,
    "RowId": 42123,
    "Text": "Dieses Signal...! Scheint, als müssten wir uns zuerst um den hier kümmern."
  },
  {
    "RowOffset": 869006,
    "RowId": 42124,
    "Text": "Gute Arbeit. Die Kontrollöffnung sollte euch in das Innere der Burg führen."
  },
  {
    "RowOffset": 869094,
    "RowId": 42125,
    "Text": "Der Bau des Immerfrieds war wohl ein konstanter Kampf gegen den steigenden Wasserpegel."
  },
  {
    "RowOffset": 869194,
    "RowId": 42126,
    "Text": "Trotz allem haben sie die Burg nicht aufgegeben. Sie muss ihnen starken Halt gegeben haben..."
  },
  {
    "RowOffset": 869302,
    "RowId": 42127,
    "Text": "Dass sich die Wahrung gerade an solch einem besonderen Ort eingenistet hat..."
  },
  {
    "RowOffset": 869394,
    "RowId": 42128,
    "Text": "Was zum, wir hab... Besuch! ...reitet euch auf ... Angriff vo...!"
  },
  {
    "RowOffset": 869470,
    "RowId": 42129,
    "Text": "Ihr seid hier. Dann beginnen wir mit den Messungen."
  },
  {
    "RowOffset": 869534,
    "RowId": 42130,
    "Text": "So weit kein Problem, wie ich sehe."
  },
  {
    "RowOffset": 869582,
    "RowId": 42131,
    "Text": "Fahren wir mit den Messungen fort. Einmal hier hinten durch, ja?"
  },
  {
    "RowOffset": 869658,
    "RowId": 42132,
    "Text": "Immer noch nicht genug. Dann fahren wir zum Abschluss härtere Geschütze auf."
  },
