    "Text": ""
  },
  {
    "RowOffset": 873134,
    "RowId": 42300,
    "Text": "Bei meinem Schwert- Ich werde Ihre Hoheit beschützen!"
  },
  {
    "RowOffset": 873206,
    "RowId": 42301,
    "Text": "Was wagst du es, meine Erinnerung an Zelenia zu missbrauchen...!"
  },
  {
    "RowOffset": 873286,
    "RowId": 42302,
    "Text": "Nehmt dies!"
  },
  {
    "RowOffset": 873310,
    "RowId": 42303,
    "Text": "Ich werde mich nicht zurückhalten!"
  },
  {
    "RowOffset": 873358,
    "RowId": 42304,
    "Text": "Niederes Ungeziefer...!"
  },
  {
    "RowOffset": 873398,
    "RowId": 42305,
    "Text": "Euer Blut soll meine Klinge zieren!"
  },
  {
    "RowOffset": 873446,
    "RowId": 42306,
    "Text": "Mit einem Streich!"
  },
  {
    "RowOffset": 873478,
    "RowId": 42307,
    "Text": "Zerfallet!"
  },
  {
    "RowOffset": 873502,
    "RowId": 42308,
    "Text": "Fließe hernieder...!"
  },
  {
    "RowOffset": 873538,
    "RowId": 42309,
    "Text": "Brenne und berste!"
  },
  {
    "RowOffset": 873570,
    "RowId": 42310,
    "Text": "Spüret die Macht...!"
  },
  {
    "RowOffset": 873606,
    "RowId": 42311,
    "Text": "Meine heilige Klinge strecke Euch nieder!"
  },
  {
    "RowOffset": 873658,
    "RowId": 42312,
    "Text": "Entfessle dich!"
  },
  {
    "RowOffset": 873686,
    "RowId": 42313,
    "Text": "Diese Haltung...! Schnell, nicht stehen bleiben!"
  },
  {
    "RowOffset": 873750,
    "RowId": 42314,
    "Text": "Donnerschläge, dröhnet herab!"
  },
  {
    "RowOffset": 873794,
    "RowId": 42315,
    "Text": "Ihre Schwertkunst wurde perfekt imitiert...!"
  },
  {
    "RowOffset": 873854,
    "RowId": 42316,
    "Text": "Seid vorsichtig! Sie hat noch lange nicht ernst gemacht...!"
  },
  {
    "RowOffset": 873930,
    "RowId": 42317,
    "Text": "Stärke dich, mein Schwert...!"
  },
  {
    "RowOffset": 873978,
    "RowId": 42318,
    "Text": "Werdet Zeuge der wahren Kunst der königlichen Ritter von Alexandria!"
  },
  {
    "RowOffset": 874058,
    "RowId": 42319,
    "Text": "O treues Schwert... Die Pflicht ruft!"
  },
  {
    "RowOffset": 874110,
    "RowId": 42320,
    "Text": "Macht euch bereit...! Haltet Stand!"
  },
  {
    "RowOffset": 874162,
    "RowId": 42321,
    "Text": "Spürt die Kraft meiner Klinge...!"
  },
  {
    "RowOffset": 874214,
    "RowId": 42322,
    "Text": "Euer Ende wird kurz und schmerzlos sein!"
  },
  {
    "RowOffset": 874266,
    "RowId": 42323,
    "Text": "Das Jenseits erwartet Euch!"
  },
  {
    "RowOffset": 874306,
    "RowId": 42324,
    "Text": "Magie, sprudele hervor!"
  },
  {
    "RowOffset": 874342,
    "RowId": 42325,
    "Text": "Nehmt Abstand von dem Äthergramm...!"
  },
  {
    "RowOffset": 874394,
    "RowId": 42326,
    "Text": "Diese Art Äthergramm kann Magie leiten! Bleibt wachsam!"
  },
  {
    "RowOffset": 874462,
    "RowId": 42327,
    "Text": "Vorsicht, sie greift mit Schwert und Magie gemeinsam an!"
  },
  {
    "RowOffset": 874530,
    "RowId": 42328,
    "Text": "Unglaublich...! Ihr habt Zelenias Angriff wirklich durchschaut...!"
  },
  {
    "RowOffset": 874618,
    "RowId": 42329,
    "Text": "Passt auf, wo ihr steht! Lasst euch nicht treffen!"
  },
  {
    "RowOffset": 874682,
    "RowId": 42330,
    "Text": "Selbst wenn mein Leben auf dem Spiel steht...!"
  },
  {
    "RowOffset": 874746,
    "RowId": 42331,
    "Text": "Ich werde hier nicht fallen! Unter keinen Umständen!"
  },
  {
    "RowOffset": 874810,
    "RowId": 42332,
    "Text": "In einhundert Jahren wäret Ihr meiner nicht ebenbürtig!"
  },
  {
    "RowOffset": 874878,
    "RowId": 42333,
    "Text": "Seht nur, wie schwach Ihr seid..."
  },
  {
    "RowOffset": 874926,
    "RowId": 42334,
    "Text": "Ich hoffe, das wird Euch eine Lehre sein!"
  },
  {
    "RowOffset": 874978,
    "RowId": 42335,
    "Text": "Empfangt Eure gerechte Strafe!"
  },
  {
    "RowOffset": 875022,
    "RowId": 42336,
    "Text": "Ich werde meine Pflicht erfüllen... und Ihre Hoheit schützen!"
  },
  {
    "RowOffset": 875102,
    "RowId": 42337,
    "Text": "Ah, Zelenia...! Egal, wann und wo... Du warst immer...!"
  },
  {
    "RowOffset": 875182,
    "RowId": 42338,
    "Text": "Die Zelenia vor mir ist nur eine Kopie... Und dennoch...!"
  },
  {
    "RowOffset": 875258,
    "RowId": 42339,
    "Text": "O treues Schwert... Die Pflicht ruft!"
  },
