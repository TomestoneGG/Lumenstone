    "RowId": 9776,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowOffset": 618618,
    "RowId": 9777,
    "Dialogue": "Die Kostüme sind wirklich umwerfend!",
    "Slowly": false
  },
  {
    "RowOffset": 618670,
    "RowId": 9778,
    "Dialogue": "Was du alles erlebt hast! Möhrenstark!",
    "Slowly": false
  },
  {
    "RowOffset": 618726,
    "RowId": 9779,
    "Dialogue": "Siehst aus, als hättest du 'nen Freund gewonnen, Kleiner.",
    "Slowly": false
  },
  {
    "RowOffset": 618802,
    "RowId": 9780,
    "Dialogue": "Uga, uga!",
    "Slowly": false
  },
  {
    "RowOffset": 618826,
    "RowId": 9781,
    "Dialogue": "Yo! Eine Party ganz nach meinem Geschmack!",
    "Slowly": false
  },
  {
    "RowOffset": 618886,
    "RowId": 9782,
    "Dialogue": "Daf ift dihie perfekte Infpiration für mein nähächftef Werk!",
    "Slowly": false
  },
  {
    "RowOffset": 618966,
    "RowId": 9783,
    "Dialogue": "Schön weich bist du heute wieder, mein Kleiner.",
    "Slowly": false
  },
  {
    "RowOffset": 619030,
    "RowId": 9784,
    "Dialogue": "A-Aber du hast ja mich, um dich zu beschützen!",
    "Slowly": false
  },
  {
    "RowOffset": 619094,
    "RowId": 9785,
    "Dialogue": "Ob wir die Stadt wirklich schützen können...?",
    "Slowly": false
  },
  {
    "RowOffset": 619162,
    "RowId": 9786,
    "Dialogue": "Immer schön die Muskeln stählen!",
    "Slowly": false
  },
  {
    "RowOffset": 619214,
    "RowId": 9787,
    "Dialogue": "Damit wir immer schön den Dreck zertrümmern können!",
    "Slowly": false
  },
  {
    "RowOffset": 619286,
    "RowId": 9788,
    "Dialogue": "Und nach der Erfrischung wird gearbeitet.",
    "Slowly": false
  },
  {
    "RowOffset": 619342,
    "RowId": 9789,
    "Dialogue": "Lumulls Trunk tut mir wirklich immer gut.",
    "Slowly": false
  },
  {
    "RowOffset": 619398,
    "RowId": 9790,
    "Dialogue": "Nichts lieber als das!",
    "Slowly": false
