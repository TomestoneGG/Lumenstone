    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowOffset": 617334,
    "RowId": 9750,
    "Dialogue": "Komm, reiß dich zusammen!",
    "Slowly": false
  },
  {
    "RowOffset": 617378,
    "RowId": 9751,
    "Dialogue": "Autsch, tut das weh ...",
    "Slowly": false
  },
  {
    "RowOffset": 617418,
    "RowId": 9752,
    "Dialogue": "Sie blühen so hübsch...",
    "Slowly": false
  },
  {
    "RowOffset": 617462,
    "RowId": 9753,
    "Dialogue": "Keine Panik! Ich hab das im Griff!",
    "Slowly": false
  },
  {
    "RowOffset": 617514,
    "RowId": 9754,
    "Dialogue": "So sieht mir das aber nicht aus...",
    "Slowly": false
  },
  {
    "RowOffset": 617570,
    "RowId": 9755,
    "Dialogue": "Die Bestien... Sind sie weg?",
    "Slowly": false
  },
  {
    "RowOffset": 617618,
    "RowId": 9756,
    "Dialogue": "Ja doch. Komm, räumen wir auf. Es ist viel zu tun.",
    "Slowly": false
  },
  {
    "RowOffset": 617686,
    "RowId": 9757,
    "Dialogue": "Hast du gehört? Uns haben <i>Gäste</i> geholfen!",
    "Slowly": false
  },
  {
    "RowOffset": 617754,
    "RowId": 9758,
    "Dialogue": "Ich liebe einen guten Kräutertrunk nach dem ganzen Stress...",
    "Slowly": false
  },
  {
    "RowOffset": 617834,
    "RowId": 9759,
    "Dialogue": "Bringt es überhaupt etwas, zu evakuieren? Wir sind doch nirgendwo sicher, wenn er ankommt...",
    "Slowly": false
  },
  {
    "RowOffset": 617946,
    "RowId": 9760,
    "Dialogue": "Jaaa! Das müssen wir feiern!",
    "Slowly": false
  },
  {
    "RowOffset": 617990,
    "RowId": 9761,
    "Dialogue": "Wie lange ist es her, seit wir das letzte Mal Gäste hatten?",
    "Slowly": false
  },
  {
    "RowOffset": 618066,
    "RowId": 9762,
    "Dialogue": "Ich persönlich mag diese bittere Herbe ja.",
    "Slowly": false
  },
  {
    "RowOffset": 618126,
    "RowId": 9763,
    "Dialogue": "Wir müssen uns auf das Schlimmste vorbereiten...",
    "Slowly": false
  },
  {
    "RowOffset": 618194,
    "RowId": 9764,
    "Dialogue": "Ein Festmahl? Eine Parade?!",
    "Slowly": false
  },
  {
    "RowOffset": 618238,
    "RowId": 9765,
    "Dialogue": "Auf zum Großreinemachen!",
    "Slowly": false
  },
  {
    "RowOffset": 618286,
    "RowId": 9766,
    "Dialogue": "Du bist doch ein braver Junge... Nicht beißen, ja?",
    "Slowly": false
  },
  {
    "RowOffset": 618358,
    "RowId": 9767,
    "Dialogue": "Es wäre mal wieder Zeit für ein Kartenturnier...",
    "Slowly": false
  },
  {
    "RowOffset": 618430,
    "RowId": 9768,
    "Dialogue": "Wo sind denn die übrigen Zwölf geblieben?",
    "Slowly": false
  },
  {
    "RowOffset": 618490,
    "RowId": 9769,
