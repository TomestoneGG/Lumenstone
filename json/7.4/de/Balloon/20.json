    "Slowly": false
  },
  {
    "RowOffset": 612538,
    "RowId": 9667,
    "Dialogue": "Wihuwte, der verdammte Ganove ... Nicht noch mal!",
    "Slowly": false
  },
  {
    "RowOffset": 612606,
    "RowId": 9668,
    "Dialogue": "Endlose als Waffen ...?!",
    "Slowly": false
  },
  {
    "RowOffset": 612646,
    "RowId": 9669,
    "Dialogue": "Mein Volk... Ihr werdet nicht vergessen!",
    "Slowly": false
  },
  {
    "RowOffset": 612706,
    "RowId": 9670,
    "Dialogue": "Nur ein Weg führt nach vorne...",
    "Slowly": false
  },
  {
    "RowOffset": 612758,
    "RowId": 9671,
    "Dialogue": "Die Furcht der Endlosen ...",
    "Slowly": false
  },
  {
    "RowOffset": 612802,
    "RowId": 9672,
    "Dialogue": "Zu welch Grausamkeit er bereit ist ...",
    "Slowly": false
  },
  {
    "RowOffset": 612858,
    "RowId": 9673,
    "Dialogue": "Calyx...",
    "Slowly": false
  },
  {
    "RowOffset": 612886,
    "RowId": 9674,
    "Dialogue": "Setzen wir diesem Albtraum ein Ende!",
    "Slowly": false
  },
  {
    "RowOffset": 612938,
    "RowId": 9675,
    "Dialogue": "Das Spiel ist vorbei, Calyx.",
    "Slowly": false
  },
  {
    "RowOffset": 612982,
    "RowId": 9676,
    "Dialogue": "Geschafft!",
    "Slowly": false
  },
  {
    "RowOffset": 613010,
    "RowId": 9677,
    "Dialogue": "War das wirklich alles ...?",
    "Slowly": false
  },
  {
    "RowOffset": 613054,
    "RowId": 9678,
    "Dialogue": "Etwas stimmt nicht ...",
    "Slowly": false
  },
  {
    "RowOffset": 613094,
    "RowId": 9679,
    "Dialogue": "Das ist unsere Gelegenheit. Das Terminal!",
    "Slowly": false
  },
  {
    "RowOffset": 613150,
    "RowId": 9680,
    "Dialogue": "Damit sollte Calyx all seine Munition verschossen haben.",
    "Slowly": false
  },
  {
    "RowOffset": 613222,
    "RowId": 9681,
    "Dialogue": "Ein Primae, hm ...?",
    "Slowly": false
  },
  {
    "RowOffset": 613258,
    "RowId": 9682,
    "Dialogue": "Was machen wir nur ohne Geode ...",
    "Slowly": false
  },
  {
    "RowOffset": 613306,
    "RowId": 9683,
    "Dialogue": "Solange wir hier Vorräte lagern, müssen wir sie überwachen.",
    "Slowly": false
  },
  {
    "RowOffset": 613386,
    "RowId": 9684,
    "Dialogue": "Verdammt ... Ich kann das nicht glauben!",
    "Slowly": false
  },
  {
    "RowOffset": 613442,
    "RowId": 9685,
    "Dialogue": "Alles normal. Nichts zu berichten.",
    "Slowly": false
  },
  {
    "RowOffset": 613494,
    "RowId": 9686,
    "Dialogue": "Ach, Geode ...",
    "Slowly": false
  },
  {
    "RowOffset": 613526,
    "RowId": 9687,
    "Dialogue": "Die Wumme geht an Genolt.",
    "Slowly": false
  },
  {
    "RowOffset": 613566,
    "RowId": 9688,
    "Dialogue": "Ich kann einfach nicht ...",
    "Slowly": false
  },
  {
    "RowOffset": 613610,
    "RowId": 9689,
    "Dialogue": "Zeit für eine Pause.",
    "Slowly": false
  },
  {
    "RowOffset": 613646,
    "RowId": 9690,
    "Dialogue": "In solchen Zeiten müssen wir uns mehr denn je zusammenreißen und den Blick nach vorne richten.",
    "Slowly": false
  },
  {
    "RowOffset": 613758,
    "RowId": 9691,
    "Dialogue": "So langsam muss ich wohl eine Genehmigung für mehr Teile bei der Verwaltung beantragen.",
    "Slowly": false
  },
  {
    "RowOffset": 613862,
    "RowId": 9692,
    "Dialogue": "Egal, was auch geschieht, Geode ist mit uns ...",
    "Slowly": false
  },
  {
    "RowOffset": 613926,
    "RowId": 9693,
    "Dialogue": "Wir entwickeln hier neue Hochsicherheits-Schaltkreise.",
    "Slowly": false
  },
  {
    "RowOffset": 613998,
    "RowId": 9694,
    "Dialogue": "Die unterirdische Resonanz in diesem Gebiet... Da liegt was Ordentliches begraben.",
    "Slowly": false
  },
  {
    "RowOffset": 614102,
    "RowId": 9695,
    "Dialogue": "Scheint, als gäbe es hier noch eine Menge Phaennit zu holen.",
    "Slowly": false
  },
  {
    "RowOffset": 614178,
    "RowId": 9696,
    "Dialogue": "Ob auf dem Mond oder Phaenna, der Erkundungswille ist, was zählt!",
    "Slowly": false
  },
  {
    "RowOffset": 614262,
    "RowId": 9697,
    "Dialogue": "Ein Mecha-Einsatz... Das macht mich ganz nervös...",
    "Slowly": false
  },
  {
    "RowOffset": 614338,
    "RowId": 9698,
    "Dialogue": "Den Kosmobohrer könnte ich im Schlaf bedienen!",
    "Slowly": false
  },
  {
    "RowOffset": 614402,
    "RowId": 9699,
    "Dialogue": "Wo versteckt sich das Phaennit?",
    "Slowly": false
  },
  {
    "RowOffset": 614450,
    "RowId": 9700,
    "Dialogue": "Saubere Arbeit!",
    "Slowly": false
  },
  {
    "RowOffset": 614482,
    "RowId": 9701,
    "Dialogue": "Der Pilot hat sich ganz schön ins Zeug gelegt.",
    "Slowly": false
  },
  {
    "RowOffset": 614546,
    "RowId": 9702,
    "Dialogue": "Kristallartiges Glas, so weit das Auge reicht...",
    "Slowly": false
  },
  {
    "RowOffset": 614614,
    "RowId": 9703,
    "Dialogue": "Phaennas Natur ist wirklich einzigartig!",
    "Slowly": false
  },
  {
    "RowOffset": 614670,
    "RowId": 9704,
    "Dialogue": "Den Mecha-Einsatz schaff ich mit links!",
    "Slowly": false
  },
  {
    "RowOffset": 614726,
    "RowId": 9705,
    "Dialogue": "Eine Mission in der Grotte, ja?",
    "Slowly": false
  },
  {
    "RowOffset": 614774,
    "RowId": 9706,
    "Dialogue": "Regulier vorsichtig die Stärke... und dann saug alles weg!",
    "Slowly": false
  },
  {
    "RowOffset": 614854,
    "RowId": 9707,
    "Dialogue": "Hat der Kosmosauger wirklich so eine enorme Saugkraft?!",
    "Slowly": false
  },
  {
    "RowOffset": 614926,
    "RowId": 9708,
    "Dialogue": "Fantastischer Einsatz, vielen Dank!",
    "Slowly": false
  },
  {
    "RowOffset": 614978,
    "RowId": 9709,
    "Dialogue": "Die Sternenebner sind der reinste Wahnsinn!",
    "Slowly": false
  },
  {
    "RowOffset": 615038,
    "RowId": 9710,
    "Dialogue": "Hierher mit den zersplitterten Kristallen!",
    "Slowly": false
  },
  {
    "RowOffset": 615098,
    "RowId": 9711,
    "Dialogue": "Packt alles zur Analyse in den Feldsucher rein!",
    "Slowly": false
  },
  {
    "RowOffset": 615162,
    "RowId": 9712,
    "Dialogue": "Zersplittert die korrumpierten Riesenkristalle mit den Sternenläufern!",
    "Slowly": false
  },
  {
    "RowOffset": 615250,
    "RowId": 9713,
    "Dialogue": "Das schwere Karottengeschütz... übertrifft selbst meine wildesten Vorstellungen...!",
    "Slowly": false
  },
  {
    "RowOffset": 615358,
    "RowId": 9714,
    "Dialogue": "Bringt die Fungus-Asche hier rüber!",
    "Slowly": false
  },
  {
    "RowOffset": 615410,
    "RowId": 9715,
    "Dialogue": "Mit dem Feldsucher können wir auch die versteckten Fungi ausfindig machen!",
    "Slowly": false
  },
  {
    "RowOffset": 615502,
    "RowId": 9716,
    "Dialogue": "Schneidet die Riesenfungi mit den Sternenebnern in Stücke!",
    "Slowly": false
  },
  {
    "RowOffset": 615578,
    "RowId": 9717,
    "Dialogue": "Haha, gegen den Klingenlauf haben diese Fungi keine Chance!",
    "Slowly": false
  },
  {
    "RowOffset": 615654,
    "RowId": 9718,
    "Dialogue": "Das gesammelte Phaennit kann hier rüber!",
    "Slowly": false
  },
  {
    "RowOffset": 615710,
    "RowId": 9719,
    "Dialogue": "Die Feldsucher scheinen auch auf diesem Planeten ohne Probleme zu laufen.",
    "Slowly": false
  },
  {
    "RowOffset": 615798,
    "RowId": 9720,
    "Dialogue": "Erst Energie sammeln, dann mit dem Strahl auf die Treibsandgruben zielen!",
    "Slowly": false
  },
  {
    "RowOffset": 615886,
    "RowId": 9721,
    "Dialogue": "Wenn ihr die Ionenenergie hier einsaugt, wird sie im Mecha abgespeichert.",
    "Slowly": false
  },
  {
    "RowOffset": 615974,
    "RowId": 9722,
    "Dialogue": "Die eingesaugten Glassplitter bitte hierher!",
    "Slowly": false
  },
  {
    "RowOffset": 616034,
    "RowId": 9723,
    "Dialogue": "So, lieber Feldsucher... Sei brav und finde uns noch mehr Glaskristalle!",
    "Slowly": false
  },
  {
    "RowOffset": 616126,
    "RowId": 9724,
    "Dialogue": "Zerstückelt die großen Glaskristalle mit den Sternenebnern!",
    "Slowly": false
  },
  {
    "RowOffset": 616202,
    "RowId": 9725,
    "Dialogue": "Dem Plasma-Klingenlauf will man wirklich nicht im Weg stehen...!",
    "Slowly": false
  },
  {
    "RowOffset": 616286,
    "RowId": 9726,
    "Dialogue": "先生も飾りタマゴと共に\n木の根元でじっと…フフ…",
    "Slowly": false
  },
  {
    "RowOffset": 616374,
    "RowId": 9727,
    "Dialogue": "ホッホウ！\n皆、似合っておりますな！",
    "Slowly": false
  },
  {
    "RowOffset": 616446,
    "RowId": 9728,
    "Dialogue": "噂の魔物も\n対処できたらしいな",
    "Slowly": false
  },
  {
    "RowOffset": 616510,
    "RowId": 9729,
    "Dialogue": "祝祭なんだから\nいいだろ！",
    "Slowly": false
  },
  {
    "RowOffset": 616566,
    "RowId": 9730,
    "Dialogue": "チッ\n視界が悪い…",
    "Slowly": false
  },
  {
    "RowOffset": 616610,
    "RowId": 9731,
    "Dialogue": "こういうデザインも\nたまにはいいですね",
    "Slowly": false
  },
  {
    "RowOffset": 616686,
    "RowId": 9732,
    "Dialogue": "ククク…\n似合ってるぜ",
    "Slowly": false
  },
  {
    "RowOffset": 616738,
    "RowId": 9733,
    "Dialogue": "Die Milalla haben sich all die Jahre lang geweigert, Treno aufzugeben...",
    "Slowly": false
  },
  {
    "RowOffset": 616830,
    "RowId": 9734,
    "Dialogue": "Dank der Barriere merkt man kaum etwas von dem Blitzäther, der außerhalb wütet.",
    "Slowly": false
  },
  {
    "RowOffset": 616930,
    "RowId": 9735,
    "Dialogue": "Wenn es Verletzte gibt, müssen wir uns nur umso mehr beeilen...",
    "Slowly": false
  },
  {
    "RowOffset": 617014,
    "RowId": 9736,
    "Dialogue": "Gut, fürs Erste scheint Ruhe eingekehrt zu sein. Hoffentlich sind die Bewohner in Sicherheit.",
    "Slowly": false
  },
  {
    "RowOffset": 617126,
    "RowId": 9737,
    "Dialogue": "",
    "Slowly": false
  },
