  {
    "RowOffset": 9994,
    "RowId": 256,
    "Text": "Sieg durch einen aufgenommenen Ziegel, ohne Pong oder Chi auszurufen."
  },
  {
    "RowOffset": 10074,
    "RowId": 257,
    "Text": "Sieg nach einem Ausruf von Riichi."
  },
  {
    "RowOffset": 10122,
    "RowId": 258,
    "Text": "Sieg in dem Zug, in dem Riichi ausgerufen wurde."
  },
  {
    "RowOffset": 10182,
    "RowId": 259,
    "Text": "Sieg mit dem Ersatzziegel nach einem Kang."
  },
  {
    "RowOffset": 10238,
    "RowId": 260,
    "Text": "Sieg mit einem Ziegel, den ein Gegner für ein Kang verwendet hat."
  },
  {
    "RowOffset": 10318,
    "RowId": 261,
    "Text": "Sieg bei Aufnahme des letzten Ziegels einer Hand."
  },
  {
    "RowOffset": 10378,
    "RowId": 262,
    "Text": "Sieg bei Anforderung des letzten Ziegels einer Hand."
  },
  {
    "RowOffset": 10442,
    "RowId": 263,
    "Text": "Sieg mit einer Hand, die aus Folgen und einem Paar besteht, das keine Yaku-Ziegel verwendet, und mit zwei oder mehr Arten von Ziegeln vervollständigt werden kann."
  },
  {
    "RowOffset": 10618,
    "RowId": 264,
    "Text": "Sieg nur mit Farbziegeln und ohne Randziegel."
  },
  {
    "RowOffset": 10674,
    "RowId": 265,
    "Text": "Sieg nur mit Farbziegeln und ohne Randziegel."
  },
  {
    "RowOffset": 10730,
    "RowId": 266,
    "Text": "Sieg mit zwei identischen Folgen mit den gleichen Nummern der gleichen Farbe."
  },
  {
    "RowOffset": 10818,
    "RowId": 267,
    "Text": "Sieg mit einem Yaku-Ziegel."
  },
  {
    "RowOffset": 10858,
    "RowId": 268,
    "Text": "Sieg mit einem Drilling (oder Kang) aus Ostwind-Yaku-Ziegeln."
  },
  {
    "RowOffset": 10930,
    "RowId": 269,
    "Text": "Sieg mit einem Drilling (oder Kang) aus Südwind-Yaku-Ziegeln."
  },
  {
    "RowOffset": 11006,
    "RowId": 270,
    "Text": "Sieg mit einem Drilling (oder Kang) aus Westwind-Yaku-Ziegeln."
  },
  {
    "RowOffset": 11082,
    "RowId": 271,
    "Text": "Sieg mit einem Drilling (oder Kang) aus Nordwind-Yaku-Ziegeln."
  },
  {
    "RowOffset": 11158,
    "RowId": 272,
    "Text": "Sieg in einer Ostwindrunde mit Ostwind-Platzziegeln."
  },
  {
    "RowOffset": 11222,
    "RowId": 273,
    "Text": "Sieg in einer Südwindrunde mit Südwind-Platzziegeln."
  },
  {
    "RowOffset": 11290,
    "RowId": 274,
    "Text": "Sieg in einer Westwindrunde mit Westwind-Platzziegeln."
  },
  {
    "RowOffset": 11358,
    "RowId": 275,
    "Text": "Sieg in einer Nordwindrunde mit Nordwind-Platzziegeln."
  },
  {
    "RowOffset": 11426,
    "RowId": 276,
    "Text": "Sieg mit einem Drilling (oder Kang) aus Weißer-Drache-Yaku-Ziegeln."
  },
  {
    "RowOffset": 11506,
    "RowId": 277,
    "Text": "Sieg mit einem Drilling (oder Kang) aus Grüner-Drache-Yaku-Ziegeln."
  },
  {
    "RowOffset": 11586,
    "RowId": 278,
    "Text": "Sieg mit einem Drilling (oder Kang) aus Roter-Drache-Yaku-Ziegeln."
  },
  {
    "RowOffset": 11666,
    "RowId": 279,
    "Text": "Gibt Bonus-Han, ist aber selbst kein Yaku."
  },
  {
    "RowOffset": 11722,
    "RowId": 280,
    "Text": "Ausruf von Riichi im ersten Zug und unmittelbarer Sieg im Anschluss. "
  },
  {
    "RowOffset": 11802,
    "RowId": 281,
    "Text": "Sieg mit der gleichen Folge in jeder Farbe."
  },
  {
    "RowOffset": 11858,
    "RowId": 282,
    "Text": "Sieg mit drei Folgen der gleichen Farbe, die sowohl 1, 2, 3 als auch 4, 5, 6 und 7, 8, 9 bilden."
  },
  {
    "RowOffset": 11966,
    "RowId": 283,
    "Text": "Sieg, bei dem alle Figuren Randziegel oder Bildziegel enthalten."
  },
  {
    "RowOffset": 12042,
    "RowId": 284,
    "Text": "Sieg mit vier Drillingen (oder Kang) und einem Paar."
  },
  {
    "RowOffset": 12106,
    "RowId": 285,
    "Text": "Sieg mit drei Drillingen mit der gleichen Nummer in jeder Farbe."
  },
  {
    "RowOffset": 12182,
    "RowId": 286,
    "Text": "Sieg mit vier Drillingen (oder Kang) und einem Paar, bei dem alle Randziegel oder Bildziegel enthalten."
  },
  {
    "RowOffset": 12298,
    "RowId": 287,
    "Text": "Sieg mit drei Drillingen (oder Kang) ohne Pong auszurufen."
  },
  {
    "RowOffset": 12370,
    "RowId": 288,
    "Text": "Sieg mit drei Kang."
  },
  {
    "RowOffset": 12402,
    "RowId": 289,
    "Text": "Sieg mit zwei Drillingen und einem Paar aus Drachenziegeln."
  },
  {
    "RowOffset": 12474,
    "RowId": 290,
    "Text": "Sieg mit sieben Paaren."
  },
  {
    "RowOffset": 12510,
    "RowId": 291,
    "Text": "Sieg mit Randziegeln in jeder Figur."
  },
  {
    "RowOffset": 12558,
    "RowId": 292,
    "Text": "Sieg mit zwei Sets aus zwei identischen Folgen."
  },
  {
    "RowOffset": 12618,
    "RowId": 293,
    "Text": "Sieg nur mit Farbziegeln einer Farbe und Bildziegeln."
  },
  {
    "RowOffset": 12682,
    "RowId": 294,
    "Text": "Sieg nur mit Farbziegeln einer Farbe."
  },
  {
    "RowOffset": 12730,
    "RowId": 295,
    "Text": "Sieg, nachdem alle Ziegel aufgenommen wurden und nur Randziegel und Bildziegel abgelegt wurden."
  },
  {
    "RowOffset": 12838,
    "RowId": 296,
    "Text": "(Yakuman) Der Spielleiter gewinnt mit dem ersten aufgenommenen Ziegel."
  },
  {
    "RowOffset": 12922,
    "RowId": 297,
    "Text": "(Yakuman) Ein Nicht-Spielleiter gewinnt mit dem ersten aufgenommenen Ziegel."
  },
  {
    "RowOffset": 13010,
    "RowId": 298,
    "Text": "(Yakuman) Bilde eine Hand, die nur aus Farbziegeln einer Farbe besteht, und bei der mit jeder Nummer eine vollständige Hand ausgerufen werden kann."
  },
  {
    "RowOffset": 13170,
    "RowId": 299,
    "Text": "(Yakuman) Bilde eine Hand, die nur aus Farbziegeln einer Farbe besteht, und rufe eine vollständige Hand mit einer beliebigen Nummer aus."
  },
  {
    "RowOffset": 13318,
    "RowId": 300,
    "Text": "(Yakuman) Sieg mit drei Drillingen aus Drachenziegeln."
  },
  {
    "RowOffset": 13386,
    "RowId": 301,
    "Text": "(Yakuman) Sieg mit vier Drillingen aus Windziegeln."
  },
  {
    "RowOffset": 13450,
    "RowId": 302,
    "Text": "(Yakuman) Sieg mit drei Drillingen und einem Paar aus Windziegeln."
  },
  {
    "RowOffset": 13530,
    "RowId": 303,
    "Text": "(Yakuman) Sieg mit vier Drillingen (oder Kang), ohne Pong auszurufen."
  },
  {
    "RowOffset": 13610,
    "RowId": 304,
    "Text": "(Yakuman) Sieg mit vier Drillingen (oder Kang), ohne Pong auszurufen. Abschluss durch Aufnahme des Ziegels, der ein Paar vervollständigt."
  },
  {
    "RowOffset": 13762,
    "RowId": 305,
    "Text": "(Yakuman) Sieg mit vier Kang."
  },
  {
    "RowOffset": 13802,
    "RowId": 306,
    "Text": "(Yakuman) Sieg mit ausschließlich Bildziegeln."
  },
  {
    "RowOffset": 13870,
    "RowId": 307,
    "Text": "(Yakuman) Sieg mit vier Drillingen (oder Kang), die nur Randziegel enthalten."
  },
  {
    "RowOffset": 13958,
    "RowId": 308,
    "Text": "(Yakuman) Sieg nur mit grünen Ziegeln."
  },
  {
    "RowOffset": 14010,
    "RowId": 309,
    "Text": "(Yakuman) Sieg mit allen Randziegeln und allen Arten von Bildziegeln."
  },
  {
    "RowOffset": 14090,
    "RowId": 310,
    "Text": "(Yakuman) Sieg mit allen Randziegeln und allen Arten von Bildziegeln. Abschluss durch Aufnahme des Ziegels, der ein Paar vervollständigt."
  },
  {
    "RowOffset": 14242,
    "RowId": 311,
    "Text": "Gibt Bonus-Han, ist aber selbst kein Yaku."
  },
  {
    "RowOffset": 14298,
    "RowId": 312,
    "Text": "Gibt Bonus-Han, ist aber selbst kein Yaku."
  },
  {
    "RowOffset": 14354,
    "RowId": 313,
    "Text": "(Yakuman) Sieg mit drei Drillingen aus Drachenziegeln. Der Spieler, der die Vervollständigung des dritten Drillings erlaubt hat, muss eine Punktestrafe zahlen."
  },
  {
    "RowOffset": 14526,
    "RowId": 314,
    "Text": "(Yakuman) Sieg mit vier Drillingen aus Windziegeln. Der Spieler, der die Vervollständigung des vierten Drillings erlaubt hat, muss eine Punktestrafe zahlen."
  },
