  },
  {
    "RowOffset": 7606,
    "RowId": 172,
    "Text": "Ein Spieler hatte neun oder mehr verschiedene Arten von Farbziegeln und Bildziegeln, einschließlich Randziegel."
  },
  {
    "RowOffset": 7730,
    "RowId": 173,
    "Text": "Vier Spieler waren in Riichi."
  },
  {
    "RowOffset": 7770,
    "RowId": 174,
    "Text": "Drei Spieler haben gleichzeitig eine vollständige Hand ausgerufen."
  },
  {
    "RowOffset": 7850,
    "RowId": 175,
    "Text": "Es wurden vier Kang gebildet."
  },
  {
    "RowOffset": 7890,
    "RowId": 176,
    "Text": "Alle Spieler haben in der ersten Runde den gleichen Windziegel abgelegt."
  },
  {
    "RowOffset": 7974,
    "RowId": 177,
    "Text": "Erhaltene Punkte"
  },
  {
    "RowOffset": 8002,
    "RowId": 178,
    "Text": "Bei einem Unentschieden müssen <span style=\"color: #ff7b1a;\">alle Spieler, die keine vollständige Hand ausrufen können</span>, den <span style=\"color: #ffff66;\">Spielern, die eine vollständige Hand ausrufen können</span>, Punkte bezahlen."
  },
  {
    "RowOffset": 8230,
    "RowId": 179,
    "Text": "Tenpai!"
  },
  {
    "RowOffset": 8250,
    "RowId": 180,
    "Text": "Noten"
  },
  {
    "RowOffset": 8266,
    "RowId": 181,
    "Text": "Gesamte Rangpunkte"
  },
  {
    "RowOffset": 8298,
    "RowId": 182,
    "Text": "<Num>IntegerParameter(1)</Num><If(GreaterThan(IntegerParameter(2),0))>/<Num>IntegerParameter(2)</Num><Else/> </If>"
  },
  {
    "RowOffset": 8334,
    "RowId": 183,
    "Text": "Derzeitiger Rang"
  },
  {
    "RowOffset": 8362,
    "RowId": 184,
    "Text": "Bis zum nächsten Rang:"
  },
  {
    "RowOffset": 8398,
    "RowId": 185,
    "Text": "Punkte"
  },
  {
    "RowOffset": 8418,
    "RowId": 186,
    "Text": "<If(GreaterThan(IntegerParameter(1),0))> +<Num>IntegerParameter(1)</Num><Else/> <Num>IntegerParameter(1)</Num></If>"
  },
  {
    "RowOffset": 8458,
    "RowId": 187,
    "Text": "<Num>IntegerParameter(1)</Num> Alle"
  },
  {
    "RowOffset": 8482,
    "RowId": 188,
    "Text": "<Num>IntegerParameter(1)</Num> - <Num>IntegerParameter(2)</Num>"
  },
  {
    "RowOffset": 8510,
    "RowId": 189,
    "Text": "Honba <Num>IntegerParameter(1)</Num>"
  },
  {
    "RowOffset": 8534,
    "RowId": 190,
    "Text": "Bitte warte darauf, dass alle Spieler ihre Runde beenden."
