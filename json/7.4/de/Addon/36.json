[
  {
    "RowOffset": 851522,
    "RowId": 17500,
    "Text": "Umkämpft"
  },
  {
    "RowOffset": 851542,
    "RowId": 17501,
    "Text": "Besetzung durch <switch(IntegerParameter(1),<Icon>51</Icon><span style=\"color: #ffc8c8;\">den Mahlstrom</span>,<Icon>52</Icon><span style=\"color: #ffffc0;\">die Bruderschaft</span>,<Icon>53</Icon><span style=\"color: #ffc0ff;\">die Legion</span>)> im Gange!"
  },
  {
    "RowOffset": 851718,
    "RowId": 17502,
    "Text": "Besetzt"
  },
  {
    "RowOffset": 851738,
    "RowId": 17503,
    "Text": "<switch(IntegerParameter(1),<Icon>51</Icon><span style=\"color: #ffc8c8;\">Der Mahlstrom</span>,<Icon>52</Icon><span style=\"color: #ffffc0;\">Die Bruderschaft</span>,<Icon>53</Icon><span style=\"color: #ffc0ff;\">Die Legion</span>)> hat einen Triumphpunkt von <switch(IntegerParameter(2),Rang B,Rang A,Rang S)> besetzt!"
  },
  {
    "RowOffset": 851954,
    "RowId": 17504,
    "Text": "<Num>IntegerParameter(1)</Num> Sek. bis zum Schneefall!"
  },
  {
    "RowOffset": 851998,
    "RowId": 17505,
    "Text": "Es beginnt zu schneien!"
  },
  {
    "RowOffset": 852034,
    "RowId": 17506,
    "Text": "<Num>IntegerParameter(1)</Num> Sek. bis zur Aurora!"
  },
  {
    "RowOffset": 852074,
    "RowId": 17507,
    "Text": "Eine Aurora erfüllt den Himmel!"
  },
  {
    "RowOffset": 852118,
    "RowId": 17508,
    "Text": "IMPORT"
  },
  {
    "RowOffset": 852138,
    "RowId": 17509,
    "Text": ""
  },
  {
    "RowOffset": 852150,
    "RowId": 17510,
    "Text": "Gib den Code des Strategiebretts ein, das du importieren möchtest, und wähle „Importieren“."
  },
  {
    "RowOffset": 852258,
    "RowId": 17511,
    "Text": "●廃止"
  },
  {
    "RowOffset": 852278,
    "RowId": 17512,
    "Text": "Aus der Zwischenablage einfügen"
  },
  {
    "RowOffset": 852322,
    "RowId": 17513,
    "Text": "●廃止"
  },
  {
    "RowOffset": 852342,
    "RowId": 17514,
    "Text": "●廃止"
  },
  {
    "RowOffset": 852362,
    "RowId": 17515,
    "Text": "Importieren"
  },
  {
    "RowOffset": 852386,
    "RowId": 17516,
    "Text": "EXPORT"
  },
  {
    "RowOffset": 852406,
    "RowId": 17517,
    "Text": ""
  },
  {
    "RowOffset": 852418,
    "RowId": 17518,
    "Text": "Für das Strategiebrett wurde ein teilbarer Code generiert."
  },
  {
    "RowOffset": 852490,
    "RowId": 17519,
    "Text": "Name"
  },
  {
    "RowOffset": 852506,
    "RowId": 17520,
    "Text": "Schließen"
  },
  {
    "RowOffset": 852530,
    "RowId": 17521,
    "Text": ""
  },
  {
    "RowOffset": 852542,
    "RowId": 17522,
    "Text": "In die Zwischenablage kopieren"
  },
  {
    "RowOffset": 852586,
    "RowId": 17523,
    "Text": "Schließen"
  },
  {
    "RowOffset": 852610,
    "RowId": 17524,
    "Text": "Speichern"
  },
  {
    "RowOffset": 852630,
    "RowId": 17525,
    "Text": "Das Strategiebrett wurde erfolgreich geladen. Als „<String>StringParameter(1)</String>“ speichern?"
  },
  {
    "RowOffset": 852714,
    "RowId": 17526,
    "Text": ":"
  },
  {
    "RowOffset": 852726,
    "RowId": 17527,
    "Text": "Wähle den Ordner aus, in dem „<String>StringParameter(1)</String>“ gespeichert werden soll."
  },
