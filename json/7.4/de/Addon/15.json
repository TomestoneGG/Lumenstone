  },
  {
    "RowOffset": 422186,
    "RowId": 7107,
    "Text": "Aktueller Titel"
  },
  {
    "RowOffset": 422214,
    "RowId": 7108,
    "Text": "Kategorie: <String>StringParameter(1)</String>"
  },
  {
    "RowOffset": 422242,
    "RowId": 7109,
    "Text": "Titel: <String>StringParameter(1)</String>"
  },
  {
    "RowOffset": 422266,
    "RowId": 7110,
