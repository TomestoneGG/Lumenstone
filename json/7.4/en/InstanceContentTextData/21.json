  {
    "RowOffset": 614958,
    "RowId": 35699,
    "Text": ""
  },
  {
    "RowOffset": 614970,
    "RowId": 35700,
    "Text": "The archfiend of fire has no equal!"
  },
  {
    "RowOffset": 615018,
    "RowId": 35701,
    "Text": "You've strength worthy enough of pride."
  },
  {
    "RowOffset": 615070,
    "RowId": 35702,
    "Text": "But will it be enough?"
  },
  {
    "RowOffset": 615106,
    "RowId": 35703,
    "Text": "I am one with the flames..."
  },
  {
    "RowOffset": 615146,
    "RowId": 35704,
    "Text": "Yaaaaaargh!"
  },
  {
    "RowOffset": 615170,
    "RowId": 35705,
    "Text": "You are the first to behold this form."
  },
  {
    "RowOffset": 615222,
    "RowId": 35706,
    "Text": ""
  },
  {
    "RowOffset": 615234,
    "RowId": 35707,
    "Text": ""
  },
  {
    "RowOffset": 615246,
    "RowId": 35708,
    "Text": "Flames to lick at your heels."
  },
  {
    "RowOffset": 615286,
    "RowId": 35709,
    "Text": "The glory of fire!"
  },
  {
    "RowOffset": 615318,
    "RowId": 35710,
    "Text": "So brightly do the flames burn!"
  },
  {
    "RowOffset": 615362,
    "RowId": 35711,
    "Text": "To ashes with you!"
  },
  {
    "RowOffset": 615394,
    "RowId": 35712,
    "Text": "Look now on my essence made pure..."
  },
  {
    "RowOffset": 615442,
    "RowId": 35713,
    "Text": "Destruction incarnate!"
  },
  {
    "RowOffset": 615478,
    "RowId": 35714,
    "Text": "Burn!"
  },
  {
    "RowOffset": 615494,
    "RowId": 35715,
    "Text": "All will burn!"
  },
  {
    "RowOffset": 615522,
    "RowId": 35716,
    "Text": "Begone!"
  },
  {
    "RowOffset": 615542,
    "RowId": 35717,
    "Text": "Naught but ash will remain!"
  },
  {
    "RowOffset": 615582,
    "RowId": 35718,
    "Text": "The flames rise higher!"
  },
  {
    "RowOffset": 615618,
    "RowId": 35719,
    "Text": "Darkest flames to me!"
  },
  {
    "RowOffset": 615650,
    "RowId": 35720,
    "Text": "I shall tear you asunder!"
  },
  {
    "RowOffset": 615686,
    "RowId": 35721,
    "Text": "Come, O Dark!"
  },
  {
    "RowOffset": 615710,
    "RowId": 35722,
    "Text": "Hyaaaaaah!"
  },
  {
    "RowOffset": 615734,
    "RowId": 35723,
    "Text": "'Tis time to bring this to an end."
  },
  {
    "RowOffset": 615782,
    "RowId": 35724,
    "Text": "My flames shall never die!"
  },
  {
    "RowOffset": 615822,
    "RowId": 35725,
    "Text": "I shall restore you to full strength."
  },
  {
    "RowOffset": 615870,
    "RowId": 35726,
    "Text": "Do not disappoint me."
  },
  {
    "RowOffset": 615902,
    "RowId": 35727,
    "Text": "Allow me to show you real flame!"
  },
  {
    "RowOffset": 615946,
    "RowId": 35728,
    "Text": "To me, servants of flame!"
  },
  {
    "RowOffset": 615982,
    "RowId": 35729,
    "Text": "My flames shall consume all!"
  },
