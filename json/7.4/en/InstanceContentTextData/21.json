  },
  {
    "RowOffset": 611386,
    "RowId": 35499,
    "Text": ""
  },
  {
    "RowOffset": 611398,
    "RowId": 35500,
    "Text": "A deal is a deal...<<key>>I cannot let you pass."
  },
  {
    "RowOffset": 611454,
    "RowId": 35501,
    "Text": ""
  },
  {
    "RowOffset": 611466,
    "RowId": 35502,
    "Text": "Ah, this land brims with life... Ripe for the harvest!"
  },
  {
    "RowOffset": 611534,
    "RowId": 35503,
    "Text": "Not good..."
  },
  {
    "RowOffset": 611558,
    "RowId": 35504,
    "Text": "Such insolence! I will not be denied!"
  },
  {
    "RowOffset": 611606,
    "RowId": 35505,
    "Text": "And now you're mine!"
  },
  {
    "RowOffset": 611638,
    "RowId": 35506,
    "Text": "I can't..."
  },
  {
    "RowOffset": 611662,
    "RowId": 35507,
    "Text": "Thank goodness we're not too late. Can you still fight?"
  },
  {
    "RowOffset": 611730,
    "RowId": 35508,
    "Text": "Aye..."
  },
  {
    "RowOffset": 611750,
    "RowId": 35509,
    "Text": "Hah hah hah! Yes, more mortals come to slaughter!"
  },
  {
    "RowOffset": 611810,
    "RowId": 35510,
    "Text": "My strength is spent...<<key>>I'll only get in your way."
  },
  {
    "RowOffset": 611874,
    "RowId": 35511,
    "Text": ""
  },
  {
    "RowOffset": 611886,
    "RowId": 35512,
    "Text": "Chin up! We'll get through this together!"
  },
  {
    "RowOffset": 611938,
    "RowId": 35513,
    "Text": "Split up!"
  },
  {
    "RowOffset": 611958,
    "RowId": 35514,
    "Text": "Stay sharp!"
  },
  {
    "RowOffset": 611982,
    "RowId": 35515,
    "Text": "Watch out!"
  },
  {
    "RowOffset": 612006,
    "RowId": 35516,
    "Text": "Not finished yet!"
  },
  {
    "RowOffset": 612034,
    "RowId": 35517,
    "Text": "I will enjoy draining your aether, watching as the life dims in your eyes."
  },
  {
    "RowOffset": 612122,
    "RowId": 35518,
    "Text": "We must weather this together!"
  },
  {
    "RowOffset": 612166,
    "RowId": 35519,
    "Text": "Resistance is futile!"
  },
  {
    "RowOffset": 612198,
    "RowId": 35520,
    "Text": "If you would deny me my feast, then begone! To ashes with you!"
  },
  {
    "RowOffset": 612274,
    "RowId": 35521,
    "Text": "Do not let them get away!"
  },
  {
    "RowOffset": 612310,
    "RowId": 35522,
    "Text": "Die! Die! DIE!!!"
  },
  {
    "RowOffset": 612338,
    "RowId": 35523,
    "Text": "This has gone on long enough!"
  },
  {
    "RowOffset": 612378,
    "RowId": 35524,
    "Text": "I will finish it. Now!"
  },
  {
    "RowOffset": 612414,
    "RowId": 35525,
    "Text": "Let's buy her some time!"
  },
  {
    "RowOffset": 612450,
    "RowId": 35526,
    "Text": "I am your end!"
  },
  {
    "RowOffset": 612478,
    "RowId": 35527,
    "Text": "No! NO! Why won't you die!?"
  },
  {
    "RowOffset": 612518,
    "RowId": 35528,
    "Text": "Defeat the voidsent horde"
  },
  {
    "RowOffset": 612554,
    "RowId": 35529,
    "Text": "Coordinate with your comrades and defeat the voidsent horde"
  },
  {
    "RowOffset": 612626,
    "RowId": 35530,
    "Text": "Protect Zero until she is ready to retaliate"
  },
  {
    "RowOffset": 612682,
    "RowId": 35531,
    "Text": "Defeat Andromalius"
  },
  {
    "RowOffset": 612714,
    "RowId": 35532,
    "Text": ""
  },
  {
    "RowOffset": 612726,
    "RowId": 35533,
    "Text": "Zero's concentration has been broken."
  },
