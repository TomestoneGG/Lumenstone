  {
    "RowOffset": 532678,
    "RowId": 32800,
    "Text": "Arrive at the undersea entrance"
  },
  {
    "RowOffset": 532722,
    "RowId": 32801,
    "Text": "Clear the undersea entrance"
  },
  {
    "RowOffset": 532762,
    "RowId": 32802,
    "Text": "Arrive at the Threshold of Bounty"
  },
  {
    "RowOffset": 532806,
    "RowId": 32803,
    "Text": "Clear the Threshold of Bounty"
  },
  {
    "RowOffset": 532846,
    "RowId": 32804,
    "Text": "Arrive at Weaver's Warding"
  },
  {
    "RowOffset": 532886,
    "RowId": 32805,
    "Text": "Defeat the Kapikulu"
  },
  {
    "RowOffset": 532918,
    "RowId": 32806,
    "Text": "Unrecognized aetherial signature...\nBrazen thief! You will proceed no further!"
  },
  {
    "RowOffset": 533010,
    "RowId": 32807,
    "Text": "Turn back, treasure seeker, or this vault will be your tomb."
  },
  {
    "RowOffset": 533082,
    "RowId": 32808,
    "Text": "Your greed will prove your undoing..."
  },
  {
    "RowOffset": 533130,
    "RowId": 32809,
    "Text": "Warning. This vault is under my protection.\nFailure to withdraw will invite chastisement."
  },
  {
    "RowOffset": 533234,
    "RowId": 32810,
    "Text": "Spin and fumble!\nStumble and fall!"
  },
  {
    "RowOffset": 533282,
    "RowId": 32811,
    "Text": "Leave now, and live.\nThis is your final warning."
  },
  {
    "RowOffset": 533346,
    "RowId": 32812,
    "Text": "Willful trespass confirmed.\nYou have chosen...death."
  },
  {
    "RowOffset": 533414,
    "RowId": 32813,
    "Text": "All intruders will be slain!"
  },
  {
    "RowOffset": 533454,
    "RowId": 32814,
    "Text": "Glyph of passage detected.\nConfirming bearer's identity..."
  },
