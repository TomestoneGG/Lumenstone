  },
  {
    "RowOffset": 811042,
    "RowId": 42400,
    "Text": "Defeat Dancing Green"
  },
  {
    "RowOffset": 811074,
    "RowId": 42401,
    "Text": "Are you ready to get down?"
  },
  {
    "RowOffset": 811114,
    "RowId": 42402,
    "Text": "The upstart's cruiserweight campaign begins!"
  },
  {
    "RowOffset": 811170,
    "RowId": 42403,
    "Text": "Can you keep up with the rhythm?"
  },
  {
    "RowOffset": 811214,
    "RowId": 42404,
    "Text": "Dancing Green is pulling out all the stops with these steps!"
  },
  {
    "RowOffset": 811286,
    "RowId": 42405,
    "Text": "We're just getting started! Keep groovin', baby!"
  },
  {
    "RowOffset": 811346,
    "RowId": 42406,
    "Text": "On the dance floor, everyone's a star!"
  },
  {
    "RowOffset": 811398,
    "RowId": 42407,
    "Text": "Bask in the spotlight and burn, baby, burn!"
  },
  {
    "RowOffset": 811454,
    "RowId": 42408,
    "Text": "An invitation to dance! How will the challenger respond?"
  },
  {
    "RowOffset": 811522,
    "RowId": 42409,
    "Text": "C'mon, show me your moves!"
  },
  {
    "RowOffset": 811562,
    "RowId": 42410,
    "Text": "You're up, dancers!"
  },
  {
    "RowOffset": 811594,
    "RowId": 42411,
    "Text": "Let's turn up the heat! Try to keep up, now!"
  },
  {
    "RowOffset": 811650,
    "RowId": 42412,
    "Text": "The fever's taken hold! Can the upstart keep up with Dancing Green?"
  },
  {
    "RowOffset": 811730,
    "RowId": 42413,
    "Text": "Dance like there's no tomorrow!"
  },
  {
    "RowOffset": 811774,
    "RowId": 42414,
    "Text": "Let's finish with style!"
  },
  {
    "RowOffset": 811810,
    "RowId": 42415,
    "Text": "You're burnin' up the dance floor, baby!"
  },
  {
    "RowOffset": 811862,
    "RowId": 42416,
    "Text": "Groovy moves! The crowd's lovin' it!"
  },
  {
    "RowOffset": 811910,
    "RowId": 42417,
    "Text": "Not bad, but I reckon you've got more in you!"
  },
  {
    "RowOffset": 811966,
    "RowId": 42418,
    "Text": "Hey, what're you tryin' to do, put the crowd to sleep?"
  },
  {
    "RowOffset": 812034,
    "RowId": 42419,
    "Text": "Back to it, dancers!"
  },
  {
    "RowOffset": 812066,
    "RowId": 42420,
    "Text": "Yeah, baby! I feel the fever comin' on again!"
  },
  {
    "RowOffset": 812122,
    "RowId": 42421,
    "Text": "The night's reached a fever pitch! All eyes are on Dancing Green!"
  },
  {
    "RowOffset": 812198,
    "RowId": 42422,
    "Text": "Show us some electrifying moves!"
  },
  {
    "RowOffset": 812242,
    "RowId": 42423,
    "Text": "Dancers, take it away!"
  },
  {
    "RowOffset": 812278,
    "RowId": 42424,
    "Text": "Let's bring the night to a scorchin' close!"
  },
  {
    "RowOffset": 812334,
    "RowId": 42425,
    "Text": "That was one helluva party! Let's do it again sometime!"
  },
