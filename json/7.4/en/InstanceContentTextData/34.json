    "RowId": 42700,
    "Text": "Water... Light... Need...!"
  },
  {
    "RowId": 42701,
    "Text": "Sprout, sprout... Sprout, sprout...!"
  },
  {
    "RowId": 42702,
    "Text": "Bloooooom... Every blossom bloooooom...!"
  },
  {
    "RowId": 42703,
    "Text": "Water... Light... Wither not...!"
  },
  {
    "RowId": 42704,
    "Text": "Sprout more! More sprouts!"
