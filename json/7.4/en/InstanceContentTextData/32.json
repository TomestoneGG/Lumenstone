  {
    "RowOffset": 803262,
    "RowId": 42100,
    "Text": "This machine has long guarded these crumbling halls."
  },
  {
    "RowOffset": 803326,
    "RowId": 42101,
    "Text": "Let us introduce more weaponry."
  },
  {
    "RowOffset": 803370,
    "RowId": 42102,
    "Text": "So be it. We proceed to the next phase."
  },
  {
    "RowOffset": 803422,
    "RowId": 42103,
    "Text": "Perhaps a new approach to assess your adaptability."
  },
  {
    "RowOffset": 803486,
    "RowId": 42104,
    "Text": "Were you to die here, it would save me trouble later."
  },
  {
    "RowOffset": 803550,
    "RowId": 42105,
    "Text": "Still alive. How unfortunate. "
  },
  {
    "RowOffset": 803594,
    "RowId": 42106,
    "Text": "I'm beginning to understand how you were able to defeat Queen Eternal."
  },
  {
    "RowOffset": 803678,
    "RowId": 42107,
    "Text": "Let us see what this yields."
  },
  {
    "RowOffset": 803718,
    "RowId": 42108,
    "Text": "How will you handle this?"
  }
