    "RowOffset": 181902,
    "RowId": 7102,
    "Text": "Embrace the serenity... Renounce the hatreds that consume you..."
  },
  {
    "RowOffset": 181978,
    "RowId": 7103,
    "Text": "And scatter them like dust in the wind..."
  },
  {
    "RowOffset": 182030,
    "RowId": 7104,
    "Text": "Forgive them, my beloved..."
