  },
  {
    "RowOffset": 168158,
    "RowId": 4605,
    "Text": "Souls adrift...my embrace...come hither...♪"
  },
  {
    "RowOffset": 168214,
    "RowId": 4606,
    "Text": "Songs...the sea...forever...with me...♪"
  },
  {
    "RowOffset": 168266,
    "RowId": 4607,
    "Text": "Broken...a cry...dreams of glory...come to die...♪"
  },
  {
    "RowOffset": 168330,
    "RowId": 4608,
    "Text": "Ocean...shame...fated ones...in flames...♪"
  },
  {
    "RowOffset": 168386,
    "RowId": 4609,
    "Text": "My song...silenced...in darkness...quiet..."
  },
  {
    "RowOffset": 168442,
    "RowId": 4610,
    "Text": "Urggghhh! I'll gut any of ye what lays a hand on me muse!"
  },
  {
    "RowOffset": 168510,
    "RowId": 4611,
    "Text": "Scurvy dogs... Ye know not love! Aggghhh..."
  },
  {
    "RowOffset": 168566,
    "RowId": 4612,
    "Text": "L-Land!? Land ho! Diamanda, I've come...urgh...home..."
  },
