    "RowOffset": 182370,
    "RowId": 7300,
    "Text": "Defeat Anchag"
  },
  {
    "RowOffset": 182394,
    "RowId": 7301,
    "Text": "Defeat the boogyman"
  },
  {
    "RowOffset": 182426,
    "RowId": 7302,
    "Text": "Defeat Ferdiad"
  },
  {
    "RowOffset": 182454,
    "RowId": 7303,
    "Text": "Guests? But <i>you</i> weren't invited! Well, no matter─you shall have a splendid performance all the same!"
  },
  {
    "RowOffset": 182578,
    "RowId": 7304,
    "Text": "I had th-thought to play you for fools─but none are more fool than I..."
  },
  {
    "RowOffset": 182662,
    "RowId": 7305,
    "Text": "150 seconds to Crash Down..."
  },
  {
    "RowOffset": 182702,
