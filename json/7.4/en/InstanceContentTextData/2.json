    "Text": ""
  },
  {
    "RowOffset": 177734,
    "RowId": 6400,
    "Text": "Clear the interring chamber"
  },
  {
    "RowOffset": 177774,
    "RowId": 6401,
    "Text": "Clear the Tomb of King Galvanth the Dominator"
  },
  {
    "RowOffset": 177830,
    "RowId": 6402,
    "Text": "Clear Eternal Calm"
  },
  {
    "RowOffset": 177862,
    "RowId": 6403,
    "Text": "Urgh... I <i>told</i> them she was weird...but they wouldn't listen..."
  },
  {
    "RowOffset": 177946,
    "RowId": 6404,
    "Text": "I...I can't move my body! Help me!"
  },
  {
    "RowOffset": 177994,
    "RowId": 6405,
    "Text": "\\\\<huff> \\\\<puff> I thought I was done for... I owe you one..."
  },
  {
    "RowOffset": 178066,
    "RowId": 6406,
    "Text": "I...I can't stand being here any longer. I'll see you outside!"
  },
  {
    "RowOffset": 178142,
    "RowId": 6407,
    "Text": "Thank you ever so much for coming to our wedding! Your body means the world to Avere!"
  },
  {
    "RowOffset": 178238,
    "RowId": 6408,
    "Text": "Hm? Where are our witnesses? The ceremony can't begin without them!"
  },
  {
    "RowOffset": 178318,
    "RowId": 6409,
    "Text": "Your wait is over, my love! All you have ever dreamed of is right here!"
  },
  {
    "RowOffset": 178402,
    "RowId": 6410,
    "Text": "To have and to hold, for better or for worse, for richer or for poorer..."
  },
  {
    "RowOffset": 178486,
    "RowId": 6411,
    "Text": "In sickness and in health, to love and to cherish...till death us do part!"
  },
  {
    "RowOffset": 178574,
    "RowId": 6412,
    "Text": "Oh, Avere! I can feel the strength of your love inside me!"
  },
  {
    "RowOffset": 178646,
    "RowId": 6413,
    "Text": "Nooo... Please don't go... Don't leave me alone..."
  },
  {
    "RowOffset": 178710,
    "RowId": 6414,
    "Text": "Aaaaaaaaah!"
  },
  {
    "RowOffset": 178734,
    "RowId": 6415,
    "Text": ""
