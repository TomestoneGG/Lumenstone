  },
  {
    "RowOffset": 169534,
    "RowId": 4802,
    "Text": "Defeat Ouranos"
  },
  {
    "RowOffset": 169562,
    "RowId": 4803,
    "Text": "BURN, BURN!\nALL IS BURN!"
  },
  {
    "RowOffset": 169602,
    "RowId": 4804,
    "Text": "BURN, BURN!\nHM? WHERE IS BURN?"
  },
  {
    "RowOffset": 169646,
    "RowId": 4805,
    "Text": "Biggy is big! Biggy is strong!\nNo one stands up to Biggy!"
  },
  {
    "RowOffset": 169718,
    "RowId": 4806,
    "Text": "Biggy's muscles bulge!\nOw-ow-ow..."
  },
  {
    "RowOffset": 169766,
    "RowId": 4807,
    "Text": "Biggy has only begun to fight!"
  },
  {
    "RowOffset": 169810,
    "RowId": 4808,
    "Text": "Biggy is small, but Biggy's heart is big!"
  },
  {
    "RowOffset": 169862,
    "RowId": 4809,
    "Text": "Aieeeeee!\nBiggy's too young to die!"
  },
  {
    "RowOffset": 169914,
    "RowId": 4810,
    "Text": "YOU KILL MY SON?\nI KILL YOU!"
  },
  {
    "RowOffset": 169958,
    "RowId": 4811,
    "Text": "MY SONS...\nI...FAIL...YOU..."
  },
  {
    "RowOffset": 170002,
    "RowId": 4812,
    "Text": "CUTE WRIGGLY-WIGGLIES!\nCRUSH PUNY ONES!"
  },
  {
    "RowOffset": 170058,
    "RowId": 4813,
    "Text": ""
  },
  {
    "RowOffset": 170070,
