  },
  {
    "RowOffset": 170154,
    "RowId": 4900,
    "Text": "Hearken unto me, brave Mogglesguard! These villains shall threaten you no more!"
  },
  {
    "RowOffset": 170246,
    "RowId": 4901,
    "Text": "Lend me your strength, and I shall purge our enemies from Thornmarch!"
  },
  {
    "RowOffset": 170326,
    "RowId": 4902,
    "Text": "You shall suffer for your transgressions against my subjects!"
  },
  {
    "RowOffset": 170398,
    "RowId": 4903,
    "Text": "Hold fast, Mogglesguard! Together we shall cast them out!"
  },
  {
    "RowOffset": 170466,
    "RowId": 4904,
    "Text": "Mogglesguard, to arms! Your king has need of you!"
  },
  {
    "RowOffset": 170526,
    "RowId": 4905,
    "Text": "Receive of my body, Mogglesguard! Let my strength become yours!"
  },
  {
    "RowOffset": 170602,
    "RowId": 4906,
    "Text": "Begone, pomless ones! Torment my subjects no more!"
  },
  {
    "RowOffset": 170666,
    "RowId": 5000,
    "Text": "Clear the White Hall"
  },
  {
    "RowOffset": 170698,
    "RowId": 5001,
    "Text": "Clear the Red Hall"
  },
  {
    "RowOffset": 170730,
    "RowId": 5002,
    "Text": "Defeat Halicarnassus"
  },
  {
    "RowOffset": 170762,
    "RowId": 5003,
    "Text": "Slake my hunger and know true glory!"
  },
  {
    "RowOffset": 170810,
    "RowId": 5004,
    "Text": "I shall feast upon your very soul!"
  },
  {
    "RowOffset": 170858,
    "RowId": 5005,
    "Text": "I still hunger...\nBring me more...more!"
  },
  {
    "RowOffset": 170914,
    "RowId": 5006,
    "Text": "Your souls are mine at last!"
  },
  {
    "RowOffset": 170954,
    "RowId": 5007,
    "Text": "Tiny Keys"
  },
  {
    "RowOffset": 170974,
    "RowId": 5008,
    "Text": ""
