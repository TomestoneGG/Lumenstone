  },
  {
    "RowOffset": 182958,
    "RowId": 7403,
    "Text": "Defeat the five-headed dragon"
  },
  {
    "RowOffset": 182998,
    "RowId": 7404,
    "Text": "Clear the Jaws"
  },
  {
    "RowOffset": 183026,
    "RowId": 7405,
    "Text": "Defeat Cerberus"
  },
  {
    "RowOffset": 183054,
    "RowId": 7406,
    "Text": "Defeat the Cloud of Darkness"
  },
  {
    "RowOffset": 183094,
    "RowId": 7407,
    "Text": "Atomos Prime"
  },
  {
    "RowOffset": 183118,
    "RowId": 7408,
    "Text": "Regenerative Capability"
  },
  {
    "RowOffset": 183154,
    "RowId": 7409,
    "Text": "I spy with my giant eye...prey for the hunting!"
  },
  {
    "RowOffset": 183214,
    "RowId": 7410,
    "Text": "Round and round the hand does go.\nWho will it slaughter? Nobody knows!"
  },
  {
    "RowOffset": 183298,
    "RowId": 7411,
    "Text": "N-No, my fate is grown dark before my eye..."
  },
  {
    "RowOffset": 183354,
    "RowId": 7412,
    "Text": "Grrrrrrrrr!"
  },
  {
    "RowOffset": 183378,
    "RowId": 7413,
    "Text": "In darkness, all is as one. Be it hope or despair, everything is mine to devour."
  },
  {
    "RowOffset": 183470,
    "RowId": 7414,
    "Text": "The light of your world will fade amidst the darkness!"
  },
  {
    "RowOffset": 183538,
    "RowId": 7415,
    "Text": "The void shall consume all that is!"
  },
  {
    "RowOffset": 183586,
    "RowId": 7416,
    "Text": "Darkness take you all!"
  },
  {
    "RowOffset": 183622,
    "RowId": 7417,
    "Text": "You cannot overcome what does not exist!\nOf darkness I am born...and to darkness I shall return!"
  },
  {
    "RowOffset": 183734,
    "RowId": 7418,
    "Text": "Grrraaaaaawr!"
  },
  {
    "RowOffset": 183758,
    "RowId": 7419,
    "Text": ""
  },
  {
    "RowOffset": 183770,
    "RowId": 7420,
    "Text": ""
  },
  {
    "RowOffset": 183782,
    "RowId": 7500,
    "Text": "Clear the <i>Agrius</i> hull"
  },
  {
    "RowOffset": 183826,
    "RowId": 7501,
    "Text": "Deactivate the Garlean barriers"
  },
  {
    "RowOffset": 183870,
    "RowId": 7502,
    "Text": "Clear the ceruleum spill"
  },
  {
    "RowOffset": 183906,
    "RowId": 7503,
    "Text": "Defeat ???"
  },
  {
    "RowOffset": 183930,
    "RowId": 7504,
    "Text": "Come, then. Thou shalt be weighed in the balances."
  },
  {
    "RowOffset": 183994,
    "RowId": 7505,
    "Text": "Receive of my breath, and ye shall live once more."
  },
  {
    "RowOffset": 184058,
    "RowId": 7506,
    "Text": "Into thee I place my spirit. Rise, my child, and join in the chorus."
  },
  {
    "RowOffset": 184138,
    "RowId": 7507,
    "Text": "Come forth, children of my children, as a cloud to cover the land."
  },
  {
    "RowOffset": 184218,
    "RowId": 7508,
    "Text": "Hearken to me, mortal, and thou shalt know I am thy lord."
  },
  {
    "RowOffset": 184286,
    "RowId": 7509,
    "Text": "Heh heh heh. So thou art gifted..."
  },
  {
    "RowOffset": 184334,
    "RowId": 7510,
    "Text": "Come, then. Thou shalt be weighed in the balances."
  },
  {
    "RowOffset": 184398,
    "RowId": 7511,
    "Text": "Into thee I place my spirit. Rise, my child, and join in the chorus."
  },
  {
    "RowOffset": 184478,
    "RowId": 7512,
    "Text": "I bid thee rise, my child, and join in the chorus once more."
  },
  {
    "RowOffset": 184550,
    "RowId": 7513,
    "Text": "How bold thy defiance."
  },
  {
    "RowOffset": 184586,
    "RowId": 7514,
    "Text": "Yet full of fear is thy heart."
  },
  {
    "RowOffset": 184630,
    "RowId": 7515,
    "Text": "Heh heh heh. So thou art gifted..."
  },
  {
    "RowOffset": 184678,
    "RowId": 7516,
    "Text": "Hearken to me, mortal, and thou shalt know I am thy lord."
  },
  {
    "RowOffset": 184746,
