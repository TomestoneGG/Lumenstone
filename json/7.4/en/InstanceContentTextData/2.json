  },
  {
    "RowOffset": 175426,
    "RowId": 6104,
    "Text": "Man the cannon whilst\nwe bleed the beast!"
  },
  {
    "RowOffset": 175482,
    "RowId": 6105,
    "Text": "Heavy fortifications!\nFire with care!"
  },
  {
    "RowOffset": 175534,
    "RowId": 6106,
    "Text": "...D-Down to the last man?\nWe have failed..."
  },
  {
    "RowOffset": 175594,
    "RowId": 6107,
    "Text": ""
  },
  {
    "RowOffset": 175606,
    "RowId": 6108,
    "Text": ""
  },
  {
    "RowOffset": 175618,
    "RowId": 6109,
    "Text": ""
  },
  {
    "RowOffset": 175630,
    "RowId": 6110,
    "Text": ""
  },
  {
    "RowOffset": 175642,
    "RowId": 6200,
    "Text": "Thou art brave, Bringer of Light.\nYet bravery alone shall not convince me of thy worth!"
  },
  {
    "RowOffset": 175746,
    "RowId": 6201,
    "Text": "Prove thy words are more than empty banter!"
  },
  {
    "RowOffset": 175802,
    "RowId": 6202,
    "Text": "This battle shall decide thy fate.\nCanst thou weather mine awakened ire!?"
  },
  {
    "RowOffset": 175890,
    "RowId": 6203,
    "Text": "Thy judgment is nigh...\nTo me, mine arbiters!"
  },
  {
    "RowOffset": 175950,
    "RowId": 6204,
    "Text": "Art thou truly of man?\nThy strength exceeds mine expectations..."
  },
  {
    "RowOffset": 176030,
    "RowId": 6205,
    "Text": "I pronounce thy sentence!\nBy the radiance of eld be thee judged!"
  },
  {
    "RowOffset": 176110,
    "RowId": 6300,
    "Text": "Clear the Ladder of Ascension"
  },
  {
    "RowOffset": 176150,
    "RowId": 6301,
    "Text": "Defeat Scylla"
  },
  {
    "RowOffset": 176174,
    "RowId": 6302,
    "Text": "Clear the Braid"
  },
  {
    "RowOffset": 176202,
    "RowId": 6303,
    "Text": "Defeat Glasya Labolas"
  },
  {
    "RowOffset": 176234,
    "RowId": 6304,
    "Text": "Clear the Golden Sacristy"
  },
  {
    "RowOffset": 176270,
    "RowId": 6305,
    "Text": "Defeat Amon"
  },
  {
    "RowOffset": 176294,
    "RowId": 6306,
    "Text": "Defeat Xande"
  },
  {
    "RowOffset": 176318,
    "RowId": 6307,
    "Text": "Glasya Labolas Charge"
  },
  {
    "RowOffset": 176350,
    "RowId": 6308,
    "Text": "My hounds hunger for man-flesh!"
  },
  {
    "RowOffset": 176394,
    "RowId": 6309,
    "Text": "You think me an aberration, do you!? Denials are futile─I can <i>smell</i> your vile thoughts!"
  },
  {
    "RowOffset": 176506,
    "RowId": 6310,
    "Text": "You shall pay dearly for making mock of my appearance!"
  },
  {
    "RowOffset": 176574,
    "RowId": 6311,
    "Text": "Scorch their insolent hides, my hounds!"
  },
  {
    "RowOffset": 176626,
    "RowId": 6312,
    "Text": "The hounds...grow silent... Finally...I may rest..."
  },
  {
    "RowOffset": 176690,
    "RowId": 6313,
    "Text": "You who would bare steel against the emperor. You shall not pass so long as I draw breath!"
  },
  {
    "RowOffset": 176794,
    "RowId": 6314,
    "Text": "Activating support protocol...\nCharging energy stores!"
  },
  {
    "RowOffset": 176862,
    "RowId": 6315,
    "Text": "Ignorant savages! You will rue the day you set foot within this tower!"
  },
  {
    "RowOffset": 176946,
    "RowId": 6316,
    "Text": "Energy stores replenished...\nIn the name of Emperor Xande, I shall annihilate you!"
  },
  {
    "RowOffset": 177042,
    "RowId": 6317,
    "Text": "Activating defense protocol...\nBe it steel or sorcery, your weapons shall not avail you!"
  },
  {
    "RowOffset": 177146,
    "RowId": 6318,
    "Text": "That my defenses...could be breached..."
  },
  {
    "RowOffset": 177198,
    "RowId": 6319,
    "Text": "My, my, such unruly guests. 'Twould seem a little diversion is in order."
  },
  {
    "RowOffset": 177282,
    "RowId": 6320,
    "Text": "That will do for the opening act. Let the curtains rise for the main attraction!"
  },
  {
    "RowOffset": 177374,
    "RowId": 6321,
    "Text": "Inconceivable...\nBeware, Your Majesty... Danger approaches..."
  },
  {
    "RowOffset": 177450,
    "RowId": 6322,
    "Text": "Not in use"
  },
  {
    "RowOffset": 177474,
    "RowId": 6323,
    "Text": "Mine is the power of darkness! Even the stars must bend to my will!"
  },
  {
    "RowOffset": 177554,
    "RowId": 6324,
    "Text": "I shall crush all who dare oppose me!"
  },
  {
    "RowOffset": 177602,
    "RowId": 6325,
    "Text": "My defeat...means nothing... Darkness...shall devour all..."
  },
  {
    "RowOffset": 177674,
    "RowId": 6326,
    "Text": ""
  },
  {
    "RowOffset": 177686,
    "RowId": 6327,
    "Text": ""
  },
  {
    "RowOffset": 177698,
    "RowId": 6328,
    "Text": ""
