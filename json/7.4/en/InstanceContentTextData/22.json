    "Text": ""
  },
  {
    "RowOffset": 625118,
    "RowId": 36200,
    "Text": "Eat, fight... Eat, fight..."
  },
  {
    "RowOffset": 625158,
    "RowId": 36201,
    "Text": "Death brings me no peace... Such is my fate..."
  },
  {
    "RowOffset": 625218,
    "RowId": 36202,
    "Text": "Few can wield such power as mine!"
  },
  {
    "RowOffset": 625262,
    "RowId": 36203,
    "Text": "Entertain me, my darlings!"
  },
  {
    "RowOffset": 625302,
    "RowId": 36204,
    "Text": "My every breath is laced with magicks!"
  },
  {
    "RowOffset": 625354,
    "RowId": 36205,
    "Text": "Another...fleeting diversion..."
  },
  {
    "RowOffset": 625398,
    "RowId": 36206,
    "Text": "Always more killin' to be done... And I'm always happy to oblige!"
  },
  {
    "RowOffset": 625474,
    "RowId": 36207,
    "Text": "Make it fun for me, eh?"
  },
  {
    "RowOffset": 625510,
    "RowId": 36208,
    "Text": "The first drops are always the sweetest!"
  },
  {
    "RowOffset": 625562,
    "RowId": 36209,
    "Text": "Ungh... Guess my time's up..."
  },
  {
    "RowOffset": 625602,
    "RowId": 36210,
    "Text": "GRAAAHHH!"
  },
  {
    "RowOffset": 625622,
    "RowId": 36211,
    "Text": "GRRRHH!"
  },
  {
    "RowOffset": 625642,
    "RowId": 36212,
    "Text": "Disturbed once again...?"
  },
  {
    "RowOffset": 625678,
    "RowId": 36213,
    "Text": "Crumble and die!"
  },
  {
    "RowOffset": 625706,
    "RowId": 36214,
    "Text": "My strength is without equal!"
  },
  {
    "RowOffset": 625746,
    "RowId": 36215,
    "Text": "This <i>shouldn't</i> kill you..."
  },
  {
    "RowOffset": 625794,
    "RowId": 36216,
    "Text": "It ain't a fight till the dying begins!"
  },
  {
    "RowOffset": 625846,
    "RowId": 36217,
    "Text": "I've had enough of you!"
  },
  {
    "RowOffset": 625882,
    "RowId": 36218,
    "Text": "I'll leave you bloody and battered!"
  },
  {
    "RowOffset": 625930,
    "RowId": 36219,
    "Text": "You will suffer!"
  },
  {
    "RowOffset": 625958,
    "RowId": 36220,
    "Text": "For Lady Athena!"
  },
  {
    "RowOffset": 625986,
    "RowId": 36221,
    "Text": "The end...comes!"
  },
  {
    "RowOffset": 626014,
    "RowId": 36222,
    "Text": "It isn't over!"
  },
  {
    "RowOffset": 626042,
    "RowId": 36223,
    "Text": "Defeat Kokytos"
  },
  {
    "RowOffset": 626070,
    "RowId": 36224,
    "Text": "Flames take you!"
  },
  {
    "RowOffset": 626098,
    "RowId": 36225,
    "Text": "Ice bind you!"
  },
