  },
  {
    "RowOffset": 715230,
    "RowId": 39000,
    "Text": "Defeat Samidare!"
  },
  {
    "RowOffset": 715258,
    "RowId": 39001,
    "Text": "I'm taking back what you stole!"
  },
  {
    "RowOffset": 715302,
    "RowId": 39002,
    "Text": "With this artifact, her mastery is mine to wield!"
  },
  {
    "RowOffset": 715362,
    "RowId": 39003,
    "Text": "Even her command over beasts! Now, come forth, and swarm my foes!"
  },
  {
    "RowOffset": 715438,
    "RowId": 39004,
    "Text": "Let us see how fleet of foot you are!"
  },
  {
    "RowOffset": 715486,
    "RowId": 39005,
    "Text": "Crush them!"
  },
  {
    "RowOffset": 715510,
    "RowId": 39006,
    "Text": "There are so many... But I can bury them in a volley of arrows!"
  },
  {
    "RowOffset": 715586,
    "RowId": 39007,
    "Text": ""
  },
  {
    "RowOffset": 715598,
    "RowId": 39008,
    "Text": "Hmph, stubborn fools! Very well, I shall borrow the might of that brutish Oronir!"
  },
  {
    "RowOffset": 715690,
    "RowId": 39009,
    "Text": "You will scuttle about no more!"
  },
  {
    "RowOffset": 715734,
    "RowId": 39010,
    "Text": "Now to deliver the coup de grâce with that Dotharli devil!"
  },
  {
    "RowOffset": 715806,
    "RowId": 39011,
    "Text": "Hahaha! Naught of you will remain!"
  },
  {
    "RowOffset": 715854,
    "RowId": 39012,
    "Text": "Damn you! So be it─I will assume <i>her</i> form..."
  },
  {
    "RowOffset": 715922,
    "RowId": 39013,
    "Text": "Tremble before the mighty auspice, Tamamo Gozen!"
  },
  {
    "RowOffset": 715982,
    "RowId": 39014,
    "Text": "I have a bad feeling about this─get away from him, quickly!"
  },
  {
    "RowOffset": 716054,
    "RowId": 39015,
    "Text": "I'm not finished yet!"
  },
  {
    "RowOffset": 716086,
    "RowId": 39016,
    "Text": "A curse to spell your doom..."
  },
  {
    "RowOffset": 716126,
    "RowId": 39017,
    "Text": "I shall drink deep of the ambient aether and render you to ash!"
  },
  {
    "RowOffset": 716202,
    "RowId": 39018,
    "Text": "Such baleful energy... We'll be in trouble if we don't do something!"
  },
  {
    "RowOffset": 716282,
    "RowId": 39019,
    "Text": "10 seconds to Ninety-ninefold Curse"
  },
  {
    "RowOffset": 716330,
    "RowId": 39020,
    "Text": "5 seconds to Ninety-ninefold Curse"
  },
  {
    "RowOffset": 716378,
    "RowId": 39021,
    "Text": "4 seconds"
  },
  {
    "RowOffset": 716398,
    "RowId": 39022,
    "Text": "3 seconds"
  },
  {
    "RowOffset": 716418,
    "RowId": 39023,
    "Text": "2 seconds"
  },
  {
    "RowOffset": 716438,
    "RowId": 39024,
    "Text": "1 second"
  },
  {
    "RowOffset": 716458,
    "RowId": 39025,
    "Text": ""
  },
  {
    "RowOffset": 716470,
    "RowId": 39026,
    "Text": "\\\\<pant> You...\\\\<pant>...survived...?"
  },
  {
    "RowOffset": 716518,
    "RowId": 39027,
    "Text": "It matters not! So long as I have this power, my victory is assured!"
  },
  {
    "RowOffset": 716598,
    "RowId": 39028,
    "Text": "No! I will not lose to vermin like you!"
  },
  {
    "RowOffset": 716650,
    "RowId": 39029,
    "Text": "Destroy the filthy shackle and free Kuiyki!"
  },
  {
    "RowOffset": 716706,
    "RowId": 39030,
    "Text": "Destroy the balls of naught!"
  },
  {
    "RowOffset": 716746,
    "RowId": 39031,
    "Text": "Take it if you dare─from the hands of I'toca herself!"
  },
  {
    "RowOffset": 716814,
    "RowId": 39032,
    "Text": "He's winded! Now's our chance!"
  },
