  {
    "RowOffset": 717662,
    "RowId": 39100,
    "Text": "The Honey B. Lovely show has begun!"
  },
  {
    "RowOffset": 717710,
    "RowId": 39101,
    "Text": "Here comes her fearsome venom strike!"
  },
  {
    "RowOffset": 717758,
    "RowId": 39102,
    "Text": "Now to savor the sweet sting of Honey B.'s charms."
  },
  {
    "RowOffset": 717822,
    "RowId": 39103,
    "Text": "Oh, she's definitely feeling your love!"
  },
  {
    "RowOffset": 717874,
    "RowId": 39104,
    "Text": "Can the challenger resist the irresistible!? I know I can't."
  },
  {
    "RowOffset": 717946,
    "RowId": 39105,
    "Text": "Alas, her charms were not to be denied!"
  },
  {
    "RowOffset": 717998,
    "RowId": 39106,
    "Text": "What's this? Honey B. has changed her routine!"
  },
  {
    "RowOffset": 718058,
    "RowId": 39107,
    "Text": "What a clash! Neither side is willing to yield!"
  },
  {
    "RowOffset": 718118,
    "RowId": 39108,
    "Text": "Let's put on a lovely show for the audience, hmm?"
  },
  {
    "RowOffset": 718178,
    "RowId": 39109,
    "Text": "A little taste to make it interesting."
  },
  {
    "RowOffset": 718230,
    "RowId": 39110,
    "Text": "This may sting a little."
  },
  {
    "RowOffset": 718266,
    "RowId": 39111,
    "Text": "Careful now, this is very, very deadly!"
  },
  {
    "RowOffset": 718318,
    "RowId": 39112,
    "Text": "Submit to your lovely queen!"
  },
  {
    "RowOffset": 718358,
    "RowId": 39113,
    "Text": "B is for brilliant!"
  },
  {
    "RowOffset": 718390,
    "RowId": 39114,
    "Text": "I'm having so much fun, aren't you?"
  },
  {
    "RowOffset": 718438,
    "RowId": 39115,
    "Text": "No hard feelings if I kill you?"
  },
  {
    "RowOffset": 718482,
    "RowId": 39116,
    "Text": "Oooh, what a delightful battle this is!"
  },
  {
    "RowOffset": 718534,
    "RowId": 39117,
    "Text": "Hope you're ready for me to steal your heart!"
  },
  {
    "RowOffset": 718590,
    "RowId": 39118,
    "Text": "I'll make you mine!"
  },
  {
    "RowOffset": 718622,
    "RowId": 39119,
    "Text": "Who's my obedient little bee?"
  },
  {
    "RowOffset": 718662,
    "RowId": 39120,
    "Text": "Is everyone having a good time?"
  },
  {
    "RowOffset": 718706,
    "RowId": 39121,
    "Text": "What? Oh, you're kidding me, it didn't work?"
  },
  {
    "RowOffset": 718762,
    "RowId": 39122,
    "Text": "Your support means the world to me, everyone!"
  },
  {
    "RowOffset": 718818,
    "RowId": 39123,
    "Text": "What? No one rejects me... No one!"
  },
  {
    "RowOffset": 718866,
    "RowId": 39124,
    "Text": "B is for beat you to a bloody pulp!"
  },
  {
    "RowOffset": 718914,
    "RowId": 39125,
    "Text": "We're just getting started.♪"
  },
  {
    "RowOffset": 718958,
    "RowId": 39126,
    "Text": "Nobody steals the spotlight from me!"
  },
  {
    "RowOffset": 719006,
    "RowId": 39127,
    "Text": "Enough is enough! Get off my stage!"
  },
  {
    "RowOffset": 719054,
    "RowId": 39128,
    "Text": "It's curtains for you!"
  },
  {
    "RowOffset": 719090,
    "RowId": 39129,
    "Text": "Defeat Honey B. Lovely"
  },
  {
    "RowOffset": 719126,
