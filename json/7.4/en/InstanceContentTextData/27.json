[
  {
    "RowOffset": 714042,
    "RowId": 38926,
    "Text": "You think we care about your stupid pride!?<Key>8205243</Key>This is for Mamook! We cannot lose!"
  },
  {
    "RowOffset": 714142,
    "RowId": 38927,
    "Text": "Oho! The great Bakool Ja Ja needs help, I see!"
  },
  {
    "RowOffset": 714202,
    "RowId": 38928,
    "Text": "Send your whole army! You still won't win!<Key>8205060</Key>I will prove that my allies are right to believe in me."
  },
  {
    "RowOffset": 714318,
    "RowId": 38929,
    "Text": "Such confidence... What changed? She wasn't like this before!"
