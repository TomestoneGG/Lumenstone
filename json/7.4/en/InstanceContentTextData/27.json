  },
  {
    "RowOffset": 721322,
    "RowId": 39229,
    "Text": "1 second to Saga of Dawn and Duty..."
  },
  {
    "RowOffset": 721370,
    "RowId": 39230,
    "Text": "How is this?"
  },
