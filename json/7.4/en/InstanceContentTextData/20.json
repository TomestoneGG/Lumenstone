    "Text": ""
  },
  {
    "RowOffset": 596994,
    "RowId": 35000,
    "Text": "Rest eternal in the dark depths of this prison."
  },
  {
    "RowOffset": 597054,
    "RowId": 35001,
    "Text": "From fulgent flame my servants rise!"
  },
  {
    "RowOffset": 597102,
    "RowId": 35002,
    "Text": "Leave naught but ash in your wake!"
  },
  {
    "RowOffset": 597150,
    "RowId": 35003,
    "Text": "Go forth, and sate your boundless hunger!"
  },
  {
    "RowOffset": 597202,
    "RowId": 35004,
    "Text": "You have but glimpsed my power..."
  },
  {
    "RowOffset": 597246,
    "RowId": 35005,
    "Text": "Behold the fruits of sacrifice!"
  },
  {
    "RowOffset": 597290,
    "RowId": 35006,
    "Text": "Sear flesh from bone!"
  },
  {
    "RowOffset": 597322,
    "RowId": 35007,
    "Text": "Perish in flame's embrace!"
  },
  {
    "RowOffset": 597362,
    "RowId": 35008,
    "Text": "You will know my rage!"
  },
  {
    "RowOffset": 597398,
    "RowId": 35009,
    "Text": "Be crushed underfoot!"
  },
  {
    "RowOffset": 597430,
    "RowId": 35010,
    "Text": "You are prey to be consumed!"
  },
  {
    "RowOffset": 597470,
    "RowId": 35011,
    "Text": "Out of my sight!"
  },
  {
    "RowOffset": 597498,
    "RowId": 35012,
    "Text": "A fitting death!"
  },
  {
    "RowOffset": 597526,
    "RowId": 35013,
    "Text": "I tire of this farce!"
  },
  {
    "RowOffset": 597558,
    "RowId": 35014,
    "Text": "I shall see my wish fulfilled."
  },
  {
    "RowOffset": 597602,
    "RowId": 35015,
    "Text": "Let seep sorrow into your heart."
  },
  {
    "RowOffset": 597646,
    "RowId": 35016,
    "Text": "Fools, braying before a god!"
  },
  {
    "RowOffset": 597686,
    "RowId": 35017,
    "Text": "Godhood is within my grasp... I need only reach..."
  },
  {
    "RowOffset": 597750,
    "RowId": 35018,
    "Text": "Even should my vessel crumble..."
  },
  {
    "RowOffset": 597794,
    "RowId": 35019,
    "Text": "I shall take hold...of my reward!"
  },
  {
    "RowOffset": 597838,
    "RowId": 35020,
    "Text": "Yes... Hehehe... At last!"
  },
  {
    "RowOffset": 597874,
    "RowId": 35021,
    "Text": "Receive of me death...and be honored!"
  },
  {
    "RowOffset": 597922,
    "RowId": 35022,
    "Text": "This is the end..."
  },
  {
    "RowOffset": 597954,
    "RowId": 35023,
    "Text": "Rejoice, and partake of my gift!"
  },
  {
    "RowOffset": 597998,
    "RowId": 35024,
    "Text": "Your soul undone!"
  },
  {
    "RowOffset": 598026,
    "RowId": 35025,
    "Text": "My will is absolute!"
  },
  {
    "RowOffset": 598058,
    "RowId": 35026,
    "Text": "Embrace annihilation!"
  },
  {
    "RowOffset": 598090,
    "RowId": 35027,
    "Text": "Gorge upon the dregs of chaos!"
  },
  {
    "RowOffset": 598134,
    "RowId": 35028,
    "Text": "Surrender to oblivion!"
  },
  {
    "RowOffset": 598170,
    "RowId": 35029,
    "Text": "Athena... How I long for our reunion..."
  },
  {
    "RowOffset": 598222,
    "RowId": 35030,
    "Text": "If I must tear this wretched world down...I shall!"
  },
  {
    "RowOffset": 598286,
    "RowId": 35031,
    "Text": "How dare you defy Lahabrea!"
  },
  {
    "RowOffset": 598326,
    "RowId": 35032,
    "Text": "Your feeble flame must be snuffed out!"
  },
  {
    "RowOffset": 598378,
    "RowId": 35033,
    "Text": "Defeat Hephaistos"
  },
  {
    "RowOffset": 598406,
    "RowId": 35034,
    "Text": ""
