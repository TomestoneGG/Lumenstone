  {
    "RowOffset": 609570,
    "RowId": 35400,
    "Text": "Connection to biological organism Artorius stable. Initiate elimination protocol."
  },
  {
    "RowOffset": 609662,
    "RowId": 35401,
    "Text": "Deploying Dimensional Bla─ Bzzzt... This...sword... I remember...you..."
  },
  {
    "RowOffset": 609746,
    "RowId": 35402,
    "Text": "Deploying Dimensional Blade. Power output comparable to original weapon."
  },
  {
    "RowOffset": 609830,
    "RowId": 35403,
    "Text": "Phlegethon...dear friend... I...am...here."
  },
  {
    "RowOffset": 609886,
    "RowId": 35404,
    "Text": "Maximizing aether output in preparation for thermal divide..."
  },
  {
    "RowOffset": 609958,
    "RowId": 35405,
    "Text": "All aether cores free. Initiate paradox protocol─releasing extinction waves!"
  },
  {
    "RowOffset": 610050,
    "RowId": 35406,
    "Text": "Damage to biological organism exceeds safe levels. Regenerative processes impeded─ Bzzzt... Release...me..."
  },
  {
    "RowOffset": 610170,
    "RowId": 35407,
    "Text": "Intruders persist. Enemies of the empire must be purged."
  },
  {
    "RowOffset": 610238,
    "RowId": 35408,
    "Text": "Generating attack module. Initiate synchronous strike."
  },
