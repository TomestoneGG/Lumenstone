  {
    "RowId": 40200,
    "Text": "Defeat the Brute Bomber"
  },
  {
    "RowId": 40201,
    "Text": "I'll blow you to smithereens!"
  },
  {
    "RowId": 40202,
    "Text": "The Brute Bomber has muscled his way into the ring!"
  },
  {
    "RowId": 40203,
    "Text": "Don't mind me, throat's a bit parched!"
  },
  {
    "RowId": 40204,
    "Text": "Banned compound detected. Combatant disqualified."
  },
  {
    "RowId": 40205,
    "Text": "Out of the way, tin can!"
  },
  {
    "RowId": 40206,
    "Text": "My word, he just assaulted the referee! The scoundrel!"
  },
  {
    "RowId": 40207,
    "Text": "No more distractions!"
  },
  {
    "RowId": 40208,
    "Text": "No, I need somethin' fiery!"
  },
  {
    "RowId": 40209,
    "Text": "The Brute Bomber is embiggening himself!"
  },
  {
    "RowId": 40210,
    "Text": "It's still not enough! More...I need more!"
  },
  {
    "RowId": 40211,
    "Text": "This man has absolutely no respect for the rules!"
  },
  {
    "RowId": 40212,
    "Text": "Get ready for an explosion of pain!"
  },
  {
    "RowId": 40213,
    "Text": "Kaboom! The Bombarian Special!"
  },
  {
    "RowId": 40214,
    "Text": "You should know that I have a short fuse!"
  },
  {
    "RowId": 40215,
    "Text": "This is going to be a blast!"
  },
  {
    "RowId": 40216,
    "Text": "The infernal Fusefield! How will the challenger respond!?"
  },
  {
    "RowId": 40217,
    "Text": "Now we're playing by my rules!"
  },
  {
    "RowId": 40218,
    "Text": "Oho, Chain Deathmatch! There's no escaping those adamant links!"
  },
  {
    "RowId": 40219,
    "Text": "I can't lose! I won't!"
  },
  {
    "RowId": 40220,
    "Text": "The Brute Bomber is desperate!"
  },
  {
    "RowId": 40221,
    "Text": "Your time's up!"
  },
