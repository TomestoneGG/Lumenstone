  },
  {
    "RowOffset": 753150,
    "RowId": 40398,
    "Text": ""
  },
  {
    "RowOffset": 753162,
    "RowId": 40399,
    "Text": ""
  },
  {
    "RowOffset": 753174,
    "RowId": 40400,
    "Text": "Let the victor's reign be sanctioned by the blood of the fallen."
  },
  {
    "RowOffset": 753250,
    "RowId": 40401,
    "Text": "I need more power!"
  },
  {
    "RowOffset": 753282,
    "RowId": 40402,
    "Text": "Graaah... Hraaah... Hraaagh!"
  },
  {
    "RowOffset": 753322,
    "RowId": 40403,
    "Text": "More! I need more!"
  },
  {
    "RowOffset": 753354,
    "RowId": 40404,
    "Text": "What visions are these?"
  },
  {
    "RowOffset": 753390,
    "RowId": 40405,
    "Text": "Out of my way!"
  },
  {
    "RowOffset": 753418,
    "RowId": 40406,
    "Text": "Is this my weakness, given shape?"
  },
  {
    "RowOffset": 753462,
    "RowId": 40407,
    "Text": "Down with you!"
  },
  {
    "RowOffset": 753490,
    "RowId": 40408,
    "Text": "No limits will bind me!"
  },
  {
    "RowOffset": 753526,
    "RowId": 40409,
    "Text": "Begone, along with my pitiful past!"
  },
  {
    "RowOffset": 753574,
    "RowId": 40410,
    "Text": "Yaaaaaarrrgh!"
  },
  {
    "RowOffset": 753598,
    "RowId": 40411,
    "Text": "You're in my way... All of you, in my way!"
  },
  {
    "RowOffset": 753654,
    "RowId": 40412,
    "Text": "<i>I</i> am the worthy king!"
  },
  {
    "RowOffset": 753698,
    "RowId": 40413,
    "Text": "There is no miracle!"
  },
  {
    "RowOffset": 753730,
    "RowId": 40414,
    "Text": "I trust only in myself!"
  },
  {
    "RowOffset": 753766,
    "RowId": 40415,
    "Text": ""
  },
  {
    "RowOffset": 753778,
    "RowId": 40416,
    "Text": "This is my path!"
  },
  {
    "RowOffset": 753806,
    "RowId": 40417,
    "Text": ""
  },
  {
    "RowOffset": 753818,
    "RowId": 40418,
    "Text": "Hahahahaha! It's mine─the ultimate power!"
  },
  {
    "RowOffset": 753874,
    "RowId": 40419,
    "Text": "This power is proof of my authority!"
  },
  {
    "RowOffset": 753922,
    "RowId": 40420,
    "Text": "Creation yields to my command!"
  },
  {
    "RowOffset": 753966,
    "RowId": 40421,
    "Text": "My will resonates within reality!"
  },
  {
    "RowOffset": 754010,
    "RowId": 40422,
    "Text": "All is mine to make and unmake!"
  },
  {
    "RowOffset": 754054,
    "RowId": 40423,
    "Text": "Such might befits a ruler─befits <i>me</i>!"
  },
  {
