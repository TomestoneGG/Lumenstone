  },
  {
    "RowOffset": 708934,
    "RowId": 38746,
    "Text": "Attempting extermination via multiple armaments."
  },
  {
    "RowOffset": 708994,
    "RowId": 38747,
    "Text": "Commencing final attack sequence."
  },
  {
    "RowOffset": 709038,
    "RowId": 38748,
    "Text": "Attempting annihilation via high-powered energy discharge."
  },
  {
    "RowOffset": 709110,
