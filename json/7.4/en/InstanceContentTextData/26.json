    "RowId": 38700,
    "Text": "Clear the Dream She Lived"
  },
  {
    "RowOffset": 707050,
    "RowId": 38701,
    "Text": "Defeat Antivirus X"
  },
  {
    "RowOffset": 707082,
    "RowId": 38702,
    "Text": "Clear the Dream She Lost"
  },
  {
    "RowOffset": 707118,
    "RowId": 38703,
    "Text": "Defeat Amalgam"
  },
  {
    "RowOffset": 707146,
    "RowId": 38704,
    "Text": "Clear My Dream Everlasting"
  },
  {
    "RowOffset": 707186,
    "RowId": 38705,
    "Text": "Defeat Eliminator"
  },
  {
    "RowOffset": 707214,
    "RowId": 38706,
    "Text": ""
  },
  {
    "RowOffset": 707226,
    "RowId": 38707,
