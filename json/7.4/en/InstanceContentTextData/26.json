  {
    "RowOffset": 712498,
    "RowId": 38900,
    "Text": "Defeat Bakool Ja Ja!"
  },
  {
    "RowOffset": 712530,
    "RowId": 38901,
    "Text": "Defeat Bakool Ja Ja's minions!"
  },
  {
    "RowOffset": 712574,
    "RowId": 38902,
    "Text": "Emerge victorious!"
  },
  {
    "RowOffset": 712606,
    "RowId": 38903,
    "Text": "Come, you mangy house cat, so I can rip you to pieces!"
  },
  {
    "RowOffset": 712674,
    "RowId": 38904,
    "Text": "I'll make you eat dirt!"
  },
  {
    "RowOffset": 712710,
    "RowId": 38905,
    "Text": "No more tricks, Bakool Ja Ja! We're settling this here and now!"
  },
  {
    "RowOffset": 712786,
    "RowId": 38906,
    "Text": "Still playing the part of the brave warrior. "
  },
  {
    "RowOffset": 712842,
    "RowId": 38907,
    "Text": "This rite has taught me so much...<Key>8205051</Key>About my nation, my people, and myself!"
  },
  {
    "RowOffset": 712934,
    "RowId": 38908,
    "Text": "Allow me, Brother!"
  },
  {
    "RowOffset": 712966,
    "RowId": 38909,
    "Text": "My magic should be more than enough for Miss Mittens!"
  },
  {
    "RowOffset": 713030,
    "RowId": 38910,
    "Text": "I finally understand what it means to live in peace.<Key>8205053</Key>To greet each day in safety and happiness."
  },
  {
    "RowOffset": 713146,
    "RowId": 38911,
    "Text": "Irritating pest!"
  },
  {
    "RowOffset": 713174,
    "RowId": 38912,
    "Text": "It's time we finished her, Brother."
  },
  {
    "RowOffset": 713222,
    "RowId": 38913,
    "Text": "This is the end for you, kitten!"
  },
  {
    "RowOffset": 713266,
    "RowId": 38914,
    "Text": "Know your place!"
  },
  {
    "RowOffset": 713294,
    "RowId": 38915,
    "Text": "How do you like this?<Key>8205225</Key>Heeere kitty, kitty, kitty, kitty, kitty!"
  },
  {
    "RowOffset": 713378,
    "RowId": 38916,
    "Text": "It's not enough to claim the title of Dawnservant.<Key>8205055</Key>I must carry on Papa's legacy─his love for our people!"
  },
  {
    "RowOffset": 713506,
    "RowId": 38917,
    "Text": "Miss Mittens...is no longer amusing me, Brother!"
  },
  {
    "RowOffset": 713566,
    "RowId": 38918,
    "Text": "Flea-ridden upstart! Why won't you die!?"
  },
  {
    "RowOffset": 713618,
    "RowId": 38919,
    "Text": "Fine! I'll show you the true power of the blessed!"
  },
  {
    "RowOffset": 713682,
    "RowId": 38920,
    "Text": "I will be the next Dawnservant! And I'll protect my people's happiness to the last!"
  },
  {
    "RowOffset": 713778,
    "RowId": 38921,
    "Text": "That's why there's no way...I'll ever lose...to the likes...of you!"
  },
  {
    "RowOffset": 713858,
    "RowId": 38922,
    "Text": "What!? But that was everything I had!"
  },
  {
    "RowOffset": 713906,
    "RowId": 38923,
    "Text": "Argh, I can't stand it anymore! Attack!"
  },
  {
    "RowOffset": 713958,
    "RowId": 38924,
    "Text": "This is our fight! Stay out of it!"
  },
  {
    "RowOffset": 714006,
    "RowId": 38925,
    "Text": "You bring shame upon us!"
  }
]