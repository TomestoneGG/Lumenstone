  },
  {
    "RowOffset": 699610,
    "RowId": 38400,
    "Text": "Arrive at the punutiy pool"
  },
  {
    "RowOffset": 699650,
    "RowId": 38401,
    "Text": "Clear the punutiy pool"
  },
  {
    "RowOffset": 699686,
    "RowId": 38402,
    "Text": "Arrive at Drowsie's grotto"
  },
  {
    "RowOffset": 699726,
    "RowId": 38403,
    "Text": "Clear Drowsie's grotto"
  },
  {
    "RowOffset": 699762,
    "RowId": 38404,
    "Text": "Arrive at Breathcatch"
  },
  {
    "RowOffset": 699794,
    "RowId": 38405,
    "Text": "Defeat Apollyon"
  },
  {
    "RowOffset": 699822,
    "RowId": 38406,
    "Text": "There was a boat like ours up ahead.\nCould be Zoraal Ja, or... Oh gods, is it Bakool Ja Ja?"
  },
  {
    "RowOffset": 699930,
    "RowId": 38407,
    "Text": "Forget who else is on the river right now─we have company!"
  },
  {
    "RowOffset": 700002,
    "RowId": 38408,
    "Text": "We're in for some rain, it seems..."
  },
  {
    "RowOffset": 700050,
    "RowId": 38409,
    "Text": "Yes, come closer! We have something for you..."
  },
  {
    "RowOffset": 700110,
    "RowId": 38410,
    "Text": "Gah, this is not going to plan!\nWe'll just have to improvise..."
  },
  {
    "RowOffset": 700190,
    "RowId": 38411,
    "Text": "See you upriver...if you make it that far!"
  },
  {
    "RowOffset": 700246,
    "RowId": 38412,
    "Text": "The harness is broken.\nI'm sorry, but we have to pull over to the bank."
  },
  {
    "RowOffset": 700334,
    "RowId": 38413,
    "Text": "See if there's a route overland. We'll try to catch up to you later!"
  },
  {
    "RowOffset": 700414,
    "RowId": 38414,
    "Text": "What strange happenstance. Hath some misfortune befallen thy vessel?"
  },
  {
    "RowOffset": 700494,
    "RowId": 38415,
    "Text": "Apologies, friends─it seems you'll be taking the long way around!"
  },
  {
    "RowOffset": 700574,
    "RowId": 38416,
    "Text": "That <i>is</i> Bakool Ja Ja ahead of us! Be ready for anything!"
  },
  {
    "RowOffset": 700654,
    "RowId": 38417,
    "Text": "Crippling our boat was a cowardly move..."
  },
  {
    "RowOffset": 700706,
    "RowId": 38418,
    "Text": "Erenville! We're losing speed!"
  },
  {
    "RowOffset": 700750,
    "RowId": 38419,
    "Text": "We won't be going anywhere until we can make repairs."
  },
  {
    "RowOffset": 700814,
    "RowId": 38420,
    "Text": "A gift! Courtesy of the blessed siblings!"
  },
  {
