  },
  {
    "RowOffset": 701226,
    "RowId": 38500,
    "Text": "Defeat the Dawnservant!"
  },
  {
    "RowOffset": 701262,
    "RowId": 38501,
    "Text": "Give it your all─I want a fight to remember!"
  },
  {
    "RowOffset": 701322,
    "RowId": 38502,
    "Text": "Let's test the waters!"
  },
  {
    "RowOffset": 701358,
    "RowId": 38503,
    "Text": "They didn't even blink."
  },
  {
    "RowOffset": 701394,
    "RowId": 38504,
    "Text": "You can do better than that!"
  },
  {
    "RowOffset": 701434,
    "RowId": 38505,
    "Text": "Have you ever fought a viper?"
  },
  {
    "RowOffset": 701474,
    "RowId": 38506,
    "Text": "I see you know the viper style..."
  },
  {
    "RowOffset": 701518,
    "RowId": 38507,
    "Text": "Hah! Let's see how you handle this!"
  },
  {
    "RowOffset": 701566,
    "RowId": 38508,
    "Text": "The spearman did not lie. Very well, then!"
  },
  {
    "RowOffset": 701622,
    "RowId": 38509,
    "Text": "Resolve and Reason kindle..."
  },
  {
    "RowOffset": 701662,
    "RowId": 38510,
    "Text": "Oh, right."
  },
  {
    "RowOffset": 701686,
    "RowId": 38511,
    "Text": ""
  },
  {
    "RowOffset": 701698,
    "RowId": 38512,
    "Text": "No more holding back!"
  },
  {
    "RowOffset": 701730,
    "RowId": 38513,
    "Text": "We're far from finished!"
  },
  {
    "RowOffset": 701766,
    "RowId": 38514,
    "Text": "Hah! Did you think you had my measure?"
  },
  {
    "RowOffset": 701818,
    "RowId": 38515,
    "Text": "You fight well indeed!"
  },
  {
    "RowOffset": 701854,
    "RowId": 38516,
    "Text": "You really are formidable!"
  },
  {
    "RowOffset": 701894,
    "RowId": 38517,
    "Text": "Now we'll see what you're truly made of..."
  },
  {
    "RowOffset": 701950,
    "RowId": 38518,
    "Text": "That will do! You've shown me more than enough!"
  },
  {
    "RowOffset": 702010,
    "RowId": 38519,
    "Text": "Hraaaaaargh!"
  },
  {
