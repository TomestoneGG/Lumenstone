    "RowOffset": 709618,
    "RowId": 38800,
    "Text": "Arrive in Hangar 8"
  },
  {
    "RowOffset": 709650,
    "RowId": 38801,
    "Text": "Defeat the Vanguard commander R8"
  },
  {
    "RowOffset": 709694,
    "RowId": 38802,
    "Text": "Arrive in the safety inspection chamber"
  },
  {
    "RowOffset": 709746,
    "RowId": 38803,
    "Text": "Defeat Protector"
  },
  {
    "RowOffset": 709774,
    "RowId": 38804,
    "Text": "Arrive in the Vanguard control room"
  },
  {
    "RowOffset": 709822,
    "RowId": 38805,
    "Text": "Defeat Zander the Snakeskinner"
  },
  {
    "RowOffset": 709866,
    "RowId": 38806,
    "Text": "Alert. Alert. Intruders detected. Engaging defense turrets."
  },
  {
    "RowOffset": 709938,
    "RowId": 38807,
    "Text": "Vanguard is under attack! Vanguard is under attack! All units prepare for battle!"
  },
  {
    "RowOffset": 710030,
    "RowId": 38808,
    "Text": "Enemy sighted. R7 sentries, prepare to engage."
  },
  {
    "RowOffset": 710090,
    "RowId": 38809,
    "Text": "Dammit all... Power the Crossbridge and release the beasts! We can stop them there!"
  },
  {
    "RowOffset": 710186,
    "RowId": 38810,
    "Text": "Send in reinforcements! The commander will not tolerate failure!"
  },
  {
    "RowOffset": 710262,
    "RowId": 38811,
    "Text": "Warning: intruders detected. Initializing extermination protocol."
  },
  {
    "RowOffset": 710338,
    "RowId": 38812,
    "Text": "Wingblade engaged. Preparing high-speed maneuvers."
  },
  {
    "RowOffset": 710402,
    "RowId": 38813,
    "Text": "Redeploying wingblade. Thrusters engaged."
  },
  {
    "RowOffset": 710454,
    "RowId": 38814,
    "Text": "Combat proficiency exceeds expected parameters. Requesting reinforcements."
  },
  {
    "RowOffset": 710542,
    "RowId": 38815,
    "Text": "Authorization to disengage limiters granted. All units─commence firing."
  },
  {
    "RowOffset": 710626,
    "RowId": 38816,
    "Text": "All units─prepare for aerial bombardment."
  },
  {
    "RowOffset": 710682,
    "RowId": 38817,
    "Text": "Initiating secondary directive: electrope weapon testing."
  },
  {
    "RowOffset": 710750,
    "RowId": 38818,
    "Text": "You truly believe yourself a match for us? The audacity!"
  },
  {
    "RowOffset": 710818,
    "RowId": 38819,
    "Text": "On your knees!"
  },
  {
    "RowOffset": 710846,
    "RowId": 38820,
    "Text": "You still stand. Impressive..."
  },
  {
    "RowOffset": 710890,
    "RowId": 38821,
    "Text": "H-How...? How could you... Ugh..."
  },
  {
    "RowOffset": 710934,
    "RowId": 38822,
    "Text": "All right. No more games!"
  },
  {
    "RowOffset": 710970,
    "RowId": 38823,
    "Text": "You'll pay for the souls you've made me waste this day."
  },
  {
    "RowOffset": 711038,
    "RowId": 38824,
    "Text": "Give up now and I'll make this quick!"
  },
  {
    "RowOffset": 711086,
    "RowId": 38825,
    "Text": "None can survive the serpent's art!"
  },
  {
    "RowOffset": 711134,
    "RowId": 38826,
    "Text": "I'll tear you limb from limb!"
  },
  {
    "RowOffset": 711174,
    "RowId": 38827,
    "Text": "Zoraal Ja will have your head on a pike!"
  },
  {
    "RowOffset": 711226,
    "RowId": 38828,
    "Text": "Know your place!"
  },
  {
    "RowOffset": 711254,
    "RowId": 38829,
    "Text": "吹き飛べ、塵芥の如くッ……！"
  },
  {
    "RowOffset": 711310,
    "RowId": 38830,
    "Text": "Intruders detected... Initiating purge protocol."
  },
  {
    "RowOffset": 711370,
    "RowId": 38831,
    "Text": ""
  },
  {
    "RowOffset": 711382,
    "RowId": 38832,
    "Text": "Turrets deployed. Commencing remote volley."
  },
  {
    "RowOffset": 711438,
    "RowId": 38833,
    "Text": "Restricting enemy movement. Electrofencing activated."
  },
  {
    "RowOffset": 711502,
    "RowId": 38834,
    "Text": ""
  },
  {
    "RowOffset": 711514,
    "RowId": 38835,
    "Text": "Enemy breach imminent. Relaying emergency signal."
  },
  {
    "RowOffset": 711574,
    "RowId": 38836,
    "Text": "I call on the soul of the serpent, the great devourer. Give me the strength to destroy our enemies."
  },
  {
    "RowOffset": 711686,
    "RowId": 38837,
    "Text": "Enemy vital signs detected... Initiating raze protocol."
  },
