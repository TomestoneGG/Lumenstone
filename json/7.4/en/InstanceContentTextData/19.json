    "Text": ""
  },
  {
    "RowOffset": 588094,
    "RowId": 34429,
    "Text": ""
  },
  {
    "RowOffset": 588106,
    "RowId": 34500,
    "Text": "Such rich, exquisite aether..."
  },
  {
    "RowOffset": 588150,
    "RowId": 34501,
    "Text": "My hair shimmers with anticipation!"
  },
  {
    "RowOffset": 588198,
    "RowId": 34502,
    "Text": "On your guard!"
  },
  {
    "RowOffset": 588226,
    "RowId": 34503,
    "Text": "Have at you!"
  },
  {
    "RowOffset": 588250,
    "RowId": 34504,
    "Text": "Fall!"
  },
  {
    "RowOffset": 588266,
    "RowId": 34505,
    "Text": "Try this!"
  },
  {
    "RowOffset": 588286,
    "RowId": 34506,
    "Text": "My locks are as the wind..."
  },
  {
    "RowOffset": 588326,
    "RowId": 34507,
    "Text": "Supple, strong, and free!"
  },
  {
    "RowOffset": 588362,
    "RowId": 34508,
    "Text": "Ah, a fair wind blows!"
  },
  {
    "RowOffset": 588398,
    "RowId": 34509,
    "Text": "You feel it too, do you not?"
  },
  {
    "RowOffset": 588438,
    "RowId": 34510,
    "Text": "You've done well to last this long..."
  },
  {
    "RowOffset": 588486,
    "RowId": 34511,
    "Text": "But the battle has only just begun!"
  },
  {
    "RowOffset": 588534,
    "RowId": 34512,
    "Text": "Ahahahaha!"
  },
  {
    "RowOffset": 588558,
    "RowId": 34513,
    "Text": "I'll slaughter you all!"
  },
  {
    "RowOffset": 588594,
    "RowId": 34514,
    "Text": "Dodge this if you can!"
  },
  {
    "RowOffset": 588630,
    "RowId": 34515,
    "Text": "I'll make it quick!"
  },
  {
    "RowOffset": 588662,
    "RowId": 34516,
    "Text": "Feel my fury!"
  },
  {
    "RowOffset": 588686,
    "RowId": 34517,
    "Text": "Know your place!"
  },
  {
    "RowOffset": 588714,
    "RowId": 34518,
    "Text": "You can't escape the storm!"
  },
  {
    "RowOffset": 588754,
    "RowId": 34519,
    "Text": "I'll break your every bone!"
  },
  {
    "RowOffset": 588794,
    "RowId": 34520,
    "Text": "Don't underestimate me!"
  },
  {
    "RowOffset": 588830,
    "RowId": 34521,
    "Text": "Begone from my sight!"
  },
  {
    "RowOffset": 588862,
    "RowId": 34522,
    "Text": "The insolence!"
  },
  {
    "RowOffset": 588890,
    "RowId": 34523,
    "Text": "Let's try this again!"
  },
  {
    "RowOffset": 588922,
    "RowId": 34524,
    "Text": "There will be nothing left of you! Nothing!"
  },
  {
    "RowOffset": 588978,
    "RowId": 34525,
    "Text": "The time for play is over."
  },
  {
    "RowOffset": 589018,
    "RowId": 34526,
    "Text": "You won't leave my domain alive!"
  },
  {
    "RowOffset": 589062,
