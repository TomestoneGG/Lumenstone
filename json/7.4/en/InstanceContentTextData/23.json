  },
  {
    "RowOffset": 649674,
    "RowId": 36800,
    "Text": "I am Asura, and on battle I thrive."
  },
  {
    "RowOffset": 649722,
    "RowId": 36801,
    "Text": "Have you the courage and strength to face me?"
  },
  {
    "RowOffset": 649778,
    "RowId": 36802,
    "Text": "Will you dodge or will you bleed?"
  },
  {
    "RowOffset": 649822,
    "RowId": 36803,
    "Text": "You've not time to blink!"
  },
  {
    "RowOffset": 649858,
    "RowId": 36804,
    "Text": "Tremble before the might of the Manusya!"
  },
  {
    "RowOffset": 649910,
    "RowId": 36805,
    "Text": "Come forth, embodiment of carnage!"
  },
  {
    "RowOffset": 649958,
    "RowId": 36806,
    "Text": "Revel on the bloody field of war!"
  },
  {
    "RowOffset": 650002,
    "RowId": 36807,
    "Text": "The spirit of battle awakens!"
  },
  {
    "RowOffset": 650042,
    "RowId": 36808,
    "Text": "Behold the sixfold blade!"
  },
  {
    "RowOffset": 650078,
    "RowId": 36809,
    "Text": "The face of battle is ever changing..."
  },
  {
    "RowOffset": 650130,
    "RowId": 36810,
    "Text": "The frail shall fall!"
  },
  {
    "RowOffset": 650162,
    "RowId": 36811,
    "Text": "The weak shall perish!"
  },
  {
    "RowOffset": 650198,
    "RowId": 36812,
    "Text": "Show me your steel!"
  },
  {
    "RowOffset": 650230,
    "RowId": 36813,
    "Text": "I am unrelenting!"
  },
  {
    "RowOffset": 650258,
    "RowId": 36814,
    "Text": "I will scatter your bones!"
