    "Text": ""
  },
  {
    "RowOffset": 647814,
    "RowId": 36700,
    "Text": "If you would oppose our crusade, then come!"
  },
  {
    "RowOffset": 647870,
    "RowId": 36701,
    "Text": "But know that none shall deny us salvation."
  },
  {
    "RowOffset": 647926,
    "RowId": 36702,
    "Text": "I will free us from the wheel!"
  },
  {
    "RowOffset": 647970,
    "RowId": 36703,
    "Text": "I will suffer no obstacles!"
  },
  {
    "RowOffset": 648010,
    "RowId": 36704,
    "Text": "You wretch!"
  },
  {
    "RowOffset": 648034,
    "RowId": 36705,
    "Text": "Such is your power?"
  },
  {
    "RowOffset": 648066,
    "RowId": 36706,
    "Text": "No matter the foe, I will stay the course..."
  },
  {
    "RowOffset": 648122,
    "RowId": 36707,
    "Text": "Look to the heavens for your doom!"
  },
  {
    "RowOffset": 648170,
    "RowId": 36708,
    "Text": "Ware my rime-kissed blades!"
  },
  {
    "RowOffset": 648210,
    "RowId": 36709,
    "Text": "A raging gale to rend you asunder!"
  },
  {
    "RowOffset": 648258,
    "RowId": 36710,
    "Text": "This place shall be your tomb!"
  },
  {
    "RowOffset": 648302,
    "RowId": 36711,
    "Text": "Let lightning surge!"
  },
  {
    "RowOffset": 648334,
    "RowId": 36712,
    "Text": "Come forth, my servant of shadow!"
  },
  {
    "RowOffset": 648378,
    "RowId": 36713,
    "Text": "Dragon! Hear me and obey!"
  },
  {
    "RowOffset": 648414,
    "RowId": 36714,
    "Text": "With abyssal dark and hero's blade, I bring my people liberation!"
  },
  {
    "RowOffset": 648490,
    "RowId": 36715,
    "Text": "You shall know true terror!"
  },
  {
    "RowOffset": 648530,
    "RowId": 36716,
    "Text": "Crush them!"
  },
  {
    "RowOffset": 648554,
    "RowId": 36717,
    "Text": "Begone!"
  },
  {
    "RowOffset": 648574,
    "RowId": 36718,
    "Text": "Bathe them in black flame!"
  },
  {
    "RowOffset": 648614,
    "RowId": 36719,
    "Text": "Render unto me your all!"
  },
  {
    "RowOffset": 648650,
    "RowId": 36720,
    "Text": "My meteors will extinguish your Light!"
  },
  {
    "RowOffset": 648702,
    "RowId": 36721,
    "Text": "Our salvation is at hand!"
  },
  {
    "RowOffset": 648738,
    "RowId": 36722,
    "Text": ""
  },
