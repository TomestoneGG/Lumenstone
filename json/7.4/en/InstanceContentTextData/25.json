  {
    "RowOffset": 691918,
    "RowId": 38100,
    "Text": "Arrive in the calmgrounds"
  },
  {
    "RowOffset": 691954,
    "RowId": 38101,
    "Text": "Clear the calmgrounds"
  },
  {
    "RowOffset": 691986,
    "RowId": 38102,
    "Text": "Arrive on Morgardar Ridge"
  },
  {
    "RowOffset": 692022,
    "RowId": 38103,
    "Text": "Clear Morgardar Ridge"
  },
  {
    "RowOffset": 692054,
    "RowId": 38104,
    "Text": "Arrive in Karryor the Resting"
  },
  {
    "RowOffset": 692094,
    "RowId": 38105,
    "Text": "Defeat Gurfurlur"
  },
  {
    "RowOffset": 692122,
    "RowId": 38106,
    "Text": "You've caught up.\nSeems I've been toying too much with my prey."
  },
  {
    "RowOffset": 692202,
    "RowId": 38107,
    "Text": ""
  },
  {
    "RowOffset": 692214,
    "RowId": 38108,
    "Text": "Bah... That was unintended."
  },
  {
    "RowOffset": 692254,
    "RowId": 38109,
    "Text": "You'll have to find another path. Think of it as an added test of your resourcefulness..."
  },
  {
    "RowOffset": 692354,
    "RowId": 38110,
    "Text": ""
  },
  {
    "RowOffset": 692366,
    "RowId": 38111,
    "Text": "Prove you are worthy to rule!"
  },
  {
    "RowOffset": 692406,
    "RowId": 38112,
    "Text": "Chronicles of eld... Recount the fury of erupting peaks!"
  },
  {
    "RowOffset": 692474,
    "RowId": 38113,
    "Text": "Chronicles of eld... Retell the hunger of roiling waters!"
  },
  {
    "RowOffset": 692542,
    "RowId": 38114,
    "Text": "Chronicles of eld... Recall the cruelty of merciless storms!"
  },
  {
    "RowOffset": 692614,
    "RowId": 38115,
    "Text": "I will take the measure of your resolve!"
  },
  {
    "RowOffset": 692666,
    "RowId": 38116,
    "Text": "Implacable strength of the mountain be mine..."
  },
  {
    "RowOffset": 692726,
    "RowId": 38117,
    "Text": "Spirit of my brethren, your thunder roars!"
  },
  {
    "RowOffset": 692782,
    "RowId": 38118,
    "Text": "That you should endure my fury..."
  },
  {
    "RowOffset": 692826,
    "RowId": 38119,
    "Text": "Feel the weight of history carved in stone!"
  },
  {
    "RowOffset": 692882,
    "RowId": 38120,
    "Text": "我が守り、崩せるか……！？"
  },
  {
    "RowOffset": 692934,
    "RowId": 38121,
    "Text": "Travelers on the mountain? How delightful!\nDo stay and play a while!"
  },
  {
    "RowOffset": 693018,
    "RowId": 38122,
    "Text": "Come to me, snowkin! Join the fun!"
  },
  {
    "RowOffset": 693066,
    "RowId": 38123,
    "Text": "Wait for it... Now, freeze!"
  },
  {
    "RowOffset": 693106,
    "RowId": 38124,
    "Text": "雪玉固めて、ゴロゴロドーン！"
  },
  {
    "RowOffset": 693162,
    "RowId": 38125,
    "Text": "Come to me, snowkin, large and small!"
  },
  {
    "RowOffset": 693210,
    "RowId": 38126,
    "Text": ""
  },
  {
    "RowOffset": 693222,
    "RowId": 38127,
    "Text": ""
  },
  {
    "RowOffset": 693234,
    "RowId": 38128,
    "Text": ""
  },
  {
    "RowOffset": 693246,
    "RowId": 38129,
    "Text": ""
  },
  {
    "RowOffset": 693258,
    "RowId": 38130,
    "Text": ""
  },
  {
    "RowOffset": 693270,
    "RowId": 38200,
    "Text": "Clear the hover docks"
  },
  {
    "RowOffset": 693302,
    "RowId": 38201,
    "Text": "Clear the resource transport elevator"
  },
  {
    "RowOffset": 693350,
    "RowId": 38202,
    "Text": "Defeat Herpekaris"
  },
  {
    "RowOffset": 693378,
    "RowId": 38203,
    "Text": "Clear the soul management division"
  },
  {
    "RowOffset": 693426,
    "RowId": 38204,
    "Text": "Defeat Deceiver"
  },
  {
    "RowOffset": 693454,
    "RowId": 38205,
    "Text": "Clear the soul research division"
  },
  {
    "RowOffset": 693498,
    "RowId": 38206,
    "Text": "Defeat Ambrose the Undeparted"
  },
  {
    "RowOffset": 693538,
    "RowId": 38207,
    "Text": ""
  },
  {
    "RowOffset": 693550,
    "RowId": 38208,
    "Text": ""
  },
  {
    "RowOffset": 693562,
    "RowId": 38209,
    "Text": ""
  },
  {
    "RowOffset": 693574,
    "RowId": 38210,
    "Text": "I see you've arrived. Follow the path and you'll soon see the entrance. Be careful now."
  },
  {
    "RowOffset": 693674,
    "RowId": 38211,
    "Text": "Whew, the diversion did the trick. Let's push straight to the middle level!"
  },
  {
    "RowOffset": 693762,
    "RowId": 38212,
    "Text": "There should be another freight elevator further in. Use it to head up."
  },
  {
    "RowOffset": 693846,
    "RowId": 38213,
    "Text": "Oh dear, this one looks like trouble..."
  },
  {
    "RowOffset": 693898,
    "RowId": 38214,
    "Text": "It's nothing they can't handle. I'll activate the elevator to keep you moving."
  }
]