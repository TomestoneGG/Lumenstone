  },
  {
    "RowOffset": 758250,
    "RowId": 40600,
    "Text": "I hope you're ready to be ripped to shreds!"
  },
  {
    "RowOffset": 758306,
    "RowId": 40601,
    "Text": "Our challenger's first opponent: Black Cat!"
  },
  {
    "RowOffset": 758362,
    "RowId": 40602,
    "Text": "Can they hold their own against her feline ferocity!?"
  },
  {
    "RowOffset": 758426,
    "RowId": 40603,
    "Text": "These claws rend all!"
  },
  {
    "RowOffset": 758458,
    "RowId": 40604,
    "Text": "Here it comes! Black Cat's lithe and lethal maneuver! "
  },
  {
    "RowOffset": 758526,
    "RowId": 40605,
    "Text": "My riiing!"
  },
  {
    "RowOffset": 758550,
    "RowId": 40606,
    "Text": "Ahem. Please bear with us while we repair the ring."
  },
  {
    "RowOffset": 758614,
    "RowId": 40607,
    "Text": "I sharpened these just for you!"
  },
  {
    "RowOffset": 758658,
    "RowId": 40608,
    "Text": "Can you dodge this, I wonder."
  },
  {
    "RowOffset": 758698,
    "RowId": 40609,
    "Text": "I'll gut you like a cod!"
  },
  {
    "RowOffset": 758734,
    "RowId": 40610,
    "Text": "Going up!"
  },
  {
    "RowOffset": 758754,
    "RowId": 40611,
    "Text": "Coming down!"
  },
  {
    "RowOffset": 758778,
    "RowId": 40612,
    "Text": "From my lives nine, my soul I split!"
  },
  {
    "RowOffset": 758826,
    "RowId": 40613,
    "Text": "Look alive, folks, because this cat has nine."
  },
  {
    "RowOffset": 758882,
    "RowId": 40614,
    "Text": "To me, echo of my soul!"
  },
  {
    "RowOffset": 758918,
    "RowId": 40615,
    "Text": "Go forth, shadow of my heart!"
  },
  {
    "RowOffset": 758958,
    "RowId": 40616,
    "Text": "It begins─Black Cat's feral onslaught! "
  },
  {
    "RowOffset": 759010,
    "RowId": 40617,
    "Text": "Hah!"
  },
  {
    "RowOffset": 759026,
    "RowId": 40618,
    "Text": "You're mincemeat!"
  },
  {
    "RowOffset": 759054,
    "RowId": 40619,
    "Text": "Try this!"
  },
  {
    "RowOffset": 759074,
    "RowId": 40620,
    "Text": "I've toyed with you enough."
  },
  {
    "RowOffset": 759114,
    "RowId": 40621,
    "Text": "Unenhanced as you are, you never stood a chance."
  },
  {
    "RowOffset": 759174,
    "RowId": 40622,
    "Text": "Defeat Black Cat"
  },
