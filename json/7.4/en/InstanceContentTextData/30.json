    "RowOffset": 762906,
    "RowId": 40800,
    "Text": "グ、ギィヤアアアア！"
  },
  {
    "RowOffset": 762950,
    "RowId": 40801,
    "Text": "Ice shall be thy tomb!"
  },
  {
    "RowOffset": 762986,
    "RowId": 40802,
    "Text": "プギャァアア！"
  },
  {
    "RowOffset": 763018,
    "RowId": 40803,
    "Text": "グゥ、ググガアア……！"
  },
  {
    "RowOffset": 763062,
    "RowId": 40804,
    "Text": "ギイィィィ！\u3000ギイィィィ！"
  },
  {
    "RowOffset": 763114,
    "RowId": 40805,
    "Text": "グギャ、ギャア……！"
  },
  {
    "RowOffset": 763158,
    "RowId": 40806,
    "Text": "ピギィヤアアアアアアアアア！"
  },
  {
    "RowOffset": 763214,
    "RowId": 40807,
    "Text": "ピィギィィ！"
  },
  {
    "RowOffset": 763246,
    "RowId": 40808,
    "Text": "フグゥゥ……！"
  },
  {
    "RowOffset": 763278,
    "RowId": 40809,
    "Text": "グゥゥギャア！"
  },
  {
    "RowOffset": 763310,
    "RowId": 40810,
    "Text": "ギギ……ギィ！"
  },
  {
    "RowOffset": 763342,
    "RowId": 40811,
    "Text": "ギ、ギャガァァァ！"
  },
  {
    "RowOffset": 763382,
    "RowId": 40812,
    "Text": "フグゥゥ……フゥ、ギャア……！"
