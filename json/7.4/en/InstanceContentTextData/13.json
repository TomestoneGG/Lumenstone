  },
  {
    "RowOffset": 465142,
    "RowId": 26400,
    "Text": "Defeat the Shadowkeeper"
  },
  {
    "RowOffset": 465178,
    "RowId": 26401,
    "Text": "By your sacrifice, a warrior born...\nI will show you no mercy, and expect none in return!"
  },
  {
    "RowOffset": 465282,
    "RowId": 26402,
    "Text": "I am the Shadowkeeper!\nThere is no escape from me!"
  },
  {
    "RowOffset": 465346,
    "RowId": 26403,
    "Text": "Cloaked in shadow, I lie in wait!"
  },
  {
    "RowOffset": 465390,
    "RowId": 26404,
    "Text": "Death stalks at every turn!"
  },
  {
    "RowOffset": 465430,
    "RowId": 26405,
    "Text": "Your shadow is mine to command!"
  },
  {
    "RowOffset": 465474,
    "RowId": 26406,
    "Text": "Stabbed in the back, in more ways than one!"
  },
  {
    "RowOffset": 465530,
    "RowId": 26407,
    "Text": "My world, consumed by Darkness. The source of my power..."
  },
  {
    "RowOffset": 465598,
    "RowId": 26408,
    "Text": "All shadow is my dominion, and yours is no exception!"
  },
  {
    "RowOffset": 465662,
    "RowId": 26409,
    "Text": "For all your strength, you are helpless to resist!"
  },
  {
    "RowOffset": 465726,
    "RowId": 26410,
    "Text": "This is the end of our adventure.\nYou meant the world to me..."
  },
