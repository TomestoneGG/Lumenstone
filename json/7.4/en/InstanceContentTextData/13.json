    "Text": ""
  },
  {
    "RowOffset": 471682,
    "RowId": 26779,
    "Text": "Something's coming... Don't forget about that copy."
  },
  {
    "RowOffset": 471746,
    "RowId": 26780,
    "Text": "An energy signal! Watch which way it turns."
  },
