  {
    "RowOffset": 532114,
    "RowId": 3359,
    "Description": "Reduces damage taken by self and nearby party members by 25%.\n<span style=\"color: #00cc22;\">Duration:</span> 10s\nCan only be executed while the <span style=\"color: #ff7b1a;\">Adrenaline Gauge</span> is full."
  },
  {
    "RowOffset": 532314,
    "RowId": 3360,
    "Description": "Delivers an attack with a potency of 10,000.\nDamage dealt is not affected by increased or decreased damage effects applied by players.\nCan only be executed while the <span style=\"color: #ff7b1a;\">Adrenaline Gauge</span> is full."
  },
  {
    "RowOffset": 532546,
    "RowId": 3361,
    "Description": "Deals magic damage to enemies near point of impact with a potency of 4,000.\n<span style=\"color: #00cc22;\">Additional Effect:</span> Increases target's damage taken by 25%\n<span style=\"color: #00cc22;\">Duration:</span> 10s\nDamage dealt is not affected by increased or decreased damage effects applied by players.\nCan only be executed while the <span style=\"color: #ff7b1a;\">Adrenaline Gauge</span> is full."
  },
  {
    "RowOffset": 532938,
    "RowId": 3362,
    "Description": "Restores 50% of own HP and the HP of all nearby party members.\n<span style=\"color: #00cc22;\">Additional Effect:</span> Removes <span style=\"color: #ffff66;\">Stun</span>, <span style=\"color: #ffff66;\">Sleep</span>, <span style=\"color: #ffff66;\">Bind</span>, <span style=\"color: #ffff66;\">Heavy</span>, and <span style=\"color: #ffff66;\">Silence</span>\nCan only be executed while the <span style=\"color: #ff7b1a;\">Adrenaline Gauge</span> is full."
  },
