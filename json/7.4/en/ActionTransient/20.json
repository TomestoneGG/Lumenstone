    "RowId": 9638,
    "Description": ""
  },
  {
    "RowOffset": 780234,
    "RowId": 9639,
    "Description": "Increases damage dealt by 10%.\n<span style=\"color: #00cc22;\">Duration:</span> 6s\n<span style=\"color: #00cc22;\">Additional Effect: </span>Increases damage dealt by next weaponskill by 10%\n<span style=\"color: #00cc22;\">Duration:</span> 6s"
  },
  {
    "RowOffset": 780454,
    "RowId": 9640,
    "Description": "Increases damage dealt by self and nearby party members by 10%.\n<span style=\"color: #00cc22;\">Duration:</span> 10s"
  },
