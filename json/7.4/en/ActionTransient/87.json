  {
    "RowOffset": 1848818,
    "RowId": 43243,
    "Description": "Delivers an attack with a potency of 8,000 to all nearby enemies.\n<span style=\"color: #00cc22;\">Additional Effect: </span>Increases target's damage taken by 25%\n<span style=\"color: #00cc22;\">Duration: </span>10s"
  },
  {
    "RowOffset": 1849022,
    "RowId": 43244,
    "Description": "Reduces damage taken by 50% while increasing HP recovered by healing actions by 25%.\n<span style=\"color: #00cc22;\">Duration: </span>15s"
  },
  {
    "RowOffset": 1849158,
    "RowId": 43245,
    "Description": "Delivers an attack with a potency of 8,000.\n<span style=\"color: #00cc22;\">Additional Effect: </span>30-yalm knockback\nRemoves <span style=\"color: #ffff66;\">Guard</span> from enemies under its effect."
  },
  {
    "RowOffset": 1849350,
    "RowId": 43246,
    "Description": "Increases damage dealt by 10%, and converts 100% of damage dealt into HP.\n<span style=\"color: #00cc22;\">Duration: </span>10s"
  },
  {
    "RowOffset": 1849478,
    "RowId": 43247,
    "Description": "Increases movement speed by 100% and grants immunity to <span style=\"color: #ffff66;\">Stun</span>, <span style=\"color: #ffff66;\">Heavy</span>, <span style=\"color: #ffff66;\">Bind</span>, <span style=\"color: #ffff66;\">Silence</span>, <span style=\"color: #ffff66;\">Deep Freeze</span>, and knockback and draw-in effects.\n<span style=\"color: #00cc22;\">Duration: </span>4s\nEffect ends when riding a mount."
  },
  {
    "RowOffset": 1849818,
    "RowId": 43248,
    "Description": "Delivers an attack with a potency of 6,000.\nPotency increases up to 18,000 as the target's HP decreases, reaching its maximum value when the target has 25% HP or less.\nRecast time resets upon earning a kill or an assist."
  },
  {
    "RowOffset": 1850058,
    "RowId": 43249,
    "Description": "Reduces cast time and recast time of spells and weaponskills by 10%, and increases movement speed by 33% for self and nearby party members.\nThis action's effects extend through obstructions.\n<span style=\"color: #00cc22;\">Duration: </span>12s"
  },
  {
    "RowOffset": 1850306,
    "RowId": 43250,
    "Description": "Increases damage dealt by a party member or self by 25%, and reduces damage taken by 25%.\n<span style=\"color: #00cc22;\">Duration: </span>15s"
  },
  {
    "RowOffset": 1850450,
    "RowId": 43251,
    "Description": "Delivers an attack with a potency of 12,000.\nIgnores the effects of <span style=\"color: #ffff66;\">Guard</span> when dealing damage."
  },
  {
    "RowOffset": 1850582,
    "RowId": 43252,
    "Description": "Deals magic damage to enemies at the designated area with a potency of 20,000.\nThis action's effects extend through obstructions.\nYou cannot move while casting, nor can you cancel the spell once cast."
  },
  {
    "RowOffset": 1850802,
    "RowId": 43253,
    "Description": "自身に一定量のダメージを防ぐバリアを張る。\n<span style=\"color: #00cc22;\">バリア量：</span>回復力15000相当\n<span style=\"color: #00cc22;\">効果時間：</span>10秒"
  },
  {
    "RowOffset": 1850990,
    "RowId": 43254,
    "Description": "Reduces damage dealt and healing potency of target and all enemies nearby it by 33%.\n<span style=\"color: #00cc22;\">Duration: </span>10s"
  },
  {
    "RowOffset": 1851126,
    "RowId": 43255,
    "Description": "Restores target's HP.\n<span style=\"color: #00cc22;\">Cure Potency: </span>15,000"
  },
  {
    "RowOffset": 1851206,
    "RowId": 43256,
    "Description": "Creates a barrier around self and all nearby party members that absorbs damage equivalent to a heal of 12,000 potency.\nThis action's effects extend through obstructions.\n<span style=\"color: #00cc22;\">Duration: </span>10s"
  },
  {
    "RowOffset": 1851430,
    "RowId": 43257,
    "Description": "Deals unaspected damage with a potency of 9,000 to target and all enemies nearby it.\n<span style=\"color: #00cc22;\">Additional Effect: </span>Reduces target's HP recovered by healing actions by 33%\n<span style=\"color: #00cc22;\">Duration: </span>10s"
  },
  {
    "RowOffset": 1851670,
    "RowId": 43258,
    "Description": ""
  },
  {
    "RowOffset": 1851682,
    "RowId": 43259,
    "Description": "Executes assigned role action.\nCan only be used in Frontlines and Rival Wings."
