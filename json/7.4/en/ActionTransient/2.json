  },
  {
    "RowOffset": 462030,
    "RowId": 798,
    "Description": "Deals fire damage with a potency of 80.\n\n※This action cannot be assigned to a hotbar."
  },
  {
    "RowOffset": 462134,
    "RowId": 799,
    "Description": "Creates a barrier around self and nearby party members.\n<span style=\"color: #00cc22;\">Duration:</span> 20s\n<span style=\"color: #00cc22;\">Barrier Effect:</span> When barrier is struck, increases striker's physical vulnerability by 2%\n<span style=\"color: #00cc22;\">Duration:</span> 4s\nWhen <span style=\"color: #ffff66;\">Obey</span> is active, will only execute upon command."
  },
  {
    "RowOffset": 462478,
    "RowId": 800,
    "Description": "Deals fire damage to all nearby enemies with a potency of 250 for the first enemy, and 50% less for all remaining enemies.\n\n※This action cannot be assigned to a hotbar."
  },
  {
    "RowOffset": 462666,
    "RowId": 801,
    "Description": "Deals fire damage with a potency of 300 to all enemies in a cone before it.\n<span style=\"color: #00cc22;\">Additional Effect:</span> Fire damage over time\n<span style=\"color: #00cc22;\">Potency:</span> 20\n<span style=\"color: #00cc22;\">Duration:</span> 15s\n\n※This action cannot be assigned to a hotbar."
  },
  {
    "RowOffset": 462954,
    "RowId": 802,
    "Description": "Restores target's HP.\n<span style=\"color: #00cc22;\">Cure Potency:</span> <If(Equal(PlayerParameter(68),28))><If(GreaterThanOrEqualTo(PlayerParameter(72),85))>180<Else/>150</If><Else/>150</If>\n\n※This action cannot be assigned to a hotbar."
  },
  {
    "RowOffset": 463106,
    "RowId": 803,
    "Description": "Gradually restores the HP of all nearby party members.\n<span style=\"color: #00cc22;\">Cure Potency:</span> 80\n<span style=\"color: #00cc22;\">Duration:</span> 21s\n\n※This action cannot be assigned to a hotbar."
  },
  {
    "RowOffset": 463310,
    "RowId": 804,
    "Description": "Increases magic defense of self and nearby party members by 20%.\n<span style=\"color: #00cc22;\">Duration:</span> 20s\nWhen <span style=\"color: #ffff66;\">Obey</span> is active, will only execute upon command."
  },
  {
    "RowOffset": 463506,
    "RowId": 805,
    "Description": "Increases healing magic potency of all nearby party members by 10%, while reducing magic damage taken by all nearby party members by 5%.\n<span style=\"color: #00cc22;\">Duration:</span> 20s\nEffect cannot be stacked with <span style=\"color: #ffff66;\">Seraphic Illumination</span>.\n\n※This action cannot be assigned to a hotbar."
  },
