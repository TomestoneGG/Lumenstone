    "Description": "Deals wind damage with a potency of 150 to target and all enemies nearby it.\n\n※This action cannot be assigned to a hotbar."
  },
  {
    "RowOffset": 461598,
    "RowId": 795,
    "Description": "Increases target's magic damage taken by 10%.\n<span style=\"color: #00cc22;\">Duration:</span> 15s\nWhen <span style=\"color: #ffff66;\">Obey</span> is active, will only execute upon command."
  },
  {
    "RowOffset": 461778,
    "RowId": 796,
    "Description": "Deals wind damage with a potency of 350 to target and all enemies nearby it.\n\n※This action cannot be assigned to a hotbar."
  },
  {
    "RowOffset": 461922,
