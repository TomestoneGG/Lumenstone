    "RowId": 9781,
    "Dialogue": "Hey, hey! This is my kind of party!",
    "Slowly": false
  },
  {
    "RowId": 9782,
    "Dialogue": "And perfect inspiration for my next piece, I might add!",
    "Slowly": false
  },
  {
    "RowId": 9783,
    "Dialogue": "Well, well, well! You're looking fluffy again today!",
    "Slowly": false
  },
