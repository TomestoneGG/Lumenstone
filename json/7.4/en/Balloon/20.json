    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowOffset": 585994,
    "RowId": 9776,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowOffset": 586010,
    "RowId": 9777,
    "Dialogue": "Now this is what I call chic, dahling!",
    "Slowly": false
  },
  {
    "RowOffset": 586066,
    "RowId": 9778,
    "Dialogue": "My word! You tell your tales of adventure so...so <i>eloquently</i>!",
    "Slowly": false
  },
  {
    "RowOffset": 586154,
    "RowId": 9779,
    "Dialogue": "It seems you've made a friend, little one.",
    "Slowly": false
  },
  {
    "RowOffset": 586214,
    "RowId": 9780,
    "Dialogue": "Ook ook!",
    "Slowly": false
  },
  {
    "RowOffset": 586238,
    "RowId": 9781,
    "Dialogue": "Hey, hey! This is my kind of party!",
    "Slowly": false
  },
  {
    "RowOffset": 586290,
    "RowId": 9782,
    "Dialogue": "And perfect inspiration for my next piece, I might add!",
    "Slowly": false
  },
  {
    "RowOffset": 586362,
    "RowId": 9783,
    "Dialogue": "Well, well, well! You're looking fluffy again today!",
    "Slowly": false
  },
  {
    "RowOffset": 586430,
    "RowId": 9784,
    "Dialogue": "And I'll protect you!\n...Wait. Um.",
    "Slowly": false
  },
  {
    "RowOffset": 586482,
    "RowId": 9785,
    "Dialogue": "Treno... I'll always protect you...",
    "Slowly": false
  },
  {
    "RowOffset": 586534,
    "RowId": 9786,
    "Dialogue": "O muscles, grow!",
    "Slowly": false
  },
  {
    "RowOffset": 586566,
    "RowId": 9787,
    "Dialogue": "O rubble, bugger off!",
    "Slowly": false
  },
  {
    "RowOffset": 586602,
    "RowId": 9788,
    "Dialogue": "Then let's get to work!",
    "Slowly": false
  },
  {
    "RowOffset": 586642,
    "RowId": 9789,
    "Dialogue": "Ahhh, I feel right as rain!",
    "Slowly": false
  },
  {
    "RowOffset": 586686,
    "RowId": 9790,
    "Dialogue": "Leave it to me!",
    "Slowly": false
  },
