    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowOffset": 584894,
    "RowId": 9749,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowOffset": 584910,
    "RowId": 9750,
    "Dialogue": "Where does it hurt!?",
    "Slowly": false
  },
  {
    "RowOffset": 584946,
    "RowId": 9751,
    "Dialogue": "Right h─ Ouch!",
    "Slowly": false
  },
  {
    "RowOffset": 584978,
    "RowId": 9752,
    "Dialogue": "These ones're coming along beautifully.",
    "Slowly": false
  },
  {
    "RowOffset": 585034,
    "RowId": 9753,
    "Dialogue": "I can handle it! Sure I can!",
    "Slowly": false
  },
  {
    "RowOffset": 585078,
    "RowId": 9754,
    "Dialogue": "You don't sound very sure!",
    "Slowly": false
  },
  {
    "RowOffset": 585122,
    "RowId": 9755,
    "Dialogue": "Is it over...?",
    "Slowly": false
  },
  {
    "RowOffset": 585154,
    "RowId": 9756,
    "Dialogue": "The fight's over. The real work's just begun!",
    "Slowly": false
  },
  {
    "RowOffset": 585214,
    "RowId": 9757,
    "Dialogue": "Did you hear? We have <i>visitors</i>!",
    "Slowly": false
  },
  {
    "RowOffset": 585270,
    "RowId": 9758,
    "Dialogue": "Ah, Sleepless Rhapsody...",
    "Slowly": false
  },
  {
    "RowOffset": 585310,
    "RowId": 9759,
    "Dialogue": "And if the Doomtrain crashes into the shelter!?",
    "Slowly": false
  },
  {
    "RowOffset": 585374,
    "RowId": 9760,
    "Dialogue": "How should we celebrate?",
    "Slowly": false
  },
  {
    "RowOffset": 585414,
    "RowId": 9761,
    "Dialogue": "Visitors! How many years has it been?",
    "Slowly": false
  },
  {
    "RowOffset": 585466,
    "RowId": 9762,
    "Dialogue": "Love a good kick to the tongue after a hard day!",
    "Slowly": false
  },
  {
    "RowOffset": 585530,
    "RowId": 9763,
    "Dialogue": "We must prepare for the worst...",
    "Slowly": false
  },
  {
    "RowOffset": 585578,
    "RowId": 9764,
    "Dialogue": "A proper carnival, I'd say!",
    "Slowly": false
  },
  {
    "RowOffset": 585622,
    "RowId": 9765,
    "Dialogue": "We'll need this cleared away first...",
    "Slowly": false
  },
  {
    "RowOffset": 585674,
    "RowId": 9766,
    "Dialogue": "You're a good boy...right? You won't bite...right?",
    "Slowly": false
  },
  {
    "RowOffset": 585742,
    "RowId": 9767,
    "Dialogue": "Why is it so long until the tournament? My deck is ready already!",
    "Slowly": false
  },
  {
    "RowOffset": 585822,
    "RowId": 9768,
    "Dialogue": "That's one...but where are the other twelve!?",
    "Slowly": false
  },
  {
    "RowOffset": 585882,
    "RowId": 9769,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowOffset": 585898,
    "RowId": 9770,
    "Dialogue": "",
    "Slowly": false
  },
  {
