    "TextData": "Silver Cactuars"
  },
  {
    "RowOffset": 57898,
    "RowId": 3002,
    "TextData": "Bronze Cactuars"
  },
  {
    "RowOffset": 57926,
    "RowId": 3003,
    "TextData": "Jump to the finish!"
  },
