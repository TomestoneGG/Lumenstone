  {
    "RowOffset": 57594,
    "RowId": 2900,
    "TextData": "Pot of Plunder"
  },
  {
    "RowOffset": 57622,
    "RowId": 2901,
    "TextData": "Gimme an elixir! Gimme one, and I'll make it worth your while!"
  },
  {
    "RowOffset": 57698,
    "RowId": 2902,
    "TextData": "Thank you for the elixir! Take care, and good luck!"
  },
  {
    "RowOffset": 57762,
    "RowId": 2903,
    "TextData": "Got any more elixirs? Maybe I can find another treasure if you do..."
  },
  {
    "RowOffset": 57842,
    "RowId": 3000,
    "TextData": "Gilded Cactuars"
  },
  {
    "RowOffset": 57870,
