  {
    "RowOffset": 9810,
    "RowId": 256,
    "Text": "Win with a drawn tile, without calling pon or chi."
  },
  {
    "RowOffset": 9874,
    "RowId": 257,
    "Text": "Win after calling riichi."
  },
  {
    "RowOffset": 9910,
    "RowId": 258,
    "Text": "Win on the turn after calling riichi."
  },
  {
    "RowOffset": 9958,
    "RowId": 259,
    "Text": "Win with the replacement tile after forming a kan."
  },
  {
    "RowOffset": 10022,
    "RowId": 260,
    "Text": "Win with a tile used by an opponent to form a kan."
  },
  {
    "RowOffset": 10086,
    "RowId": 261,
    "Text": "Win by drawing the last tile of the hand."
  },
  {
    "RowOffset": 10138,
    "RowId": 262,
    "Text": "Win by claiming the last tile of the hand."
  },
  {
    "RowOffset": 10194,
    "RowId": 263,
    "Text": "Win with a hand that consists of straights and a pair that does not use yaku tiles, and can be completed with two or more types of tile."
  },
  {
    "RowOffset": 10342,
    "RowId": 264,
    "Text": "Win with only number tiles and no terminals."
  },
  {
    "RowOffset": 10398,
    "RowId": 265,
    "Text": "Win with only number tiles and no terminals."
  },
  {
    "RowOffset": 10454,
    "RowId": 266,
    "Text": "Win with two identical straights of the same numbers in the same suit."
  },
  {
    "RowOffset": 10538,
    "RowId": 267,
    "Text": "Win with a yaku tile."
  },
  {
    "RowOffset": 10570,
    "RowId": 268,
    "Text": "Win with a triplet (or kan) of east wind yaku tiles."
  },
  {
    "RowOffset": 10634,
    "RowId": 269,
    "Text": "Win with a triplet (or kan) of south wind yaku tiles."
  },
  {
    "RowOffset": 10698,
    "RowId": 270,
    "Text": "Win with a triplet (or kan) of west wind yaku tiles."
  },
  {
    "RowOffset": 10762,
    "RowId": 271,
    "Text": "Win with a triplet (or kan) of north wind yaku tiles."
  },
  {
    "RowOffset": 10826,
    "RowId": 272,
    "Text": "Win with east round and east seat tiles."
  },
  {
    "RowOffset": 10878,
    "RowId": 273,
    "Text": "Win with south round and south seat tiles."
  },
  {
    "RowOffset": 10934,
    "RowId": 274,
    "Text": "Win with west round and west seat tiles."
  },
  {
    "RowOffset": 10986,
    "RowId": 275,
    "Text": "Win with north round and north seat tiles."
  },
  {
    "RowOffset": 11042,
    "RowId": 276,
    "Text": "Win with a triplet (or kan) of white dragon yaku tiles."
  },
  {
    "RowOffset": 11110,
    "RowId": 277,
    "Text": "Win with a triplet (or kan) of green dragon yaku tiles."
  },
  {
    "RowOffset": 11178,
    "RowId": 278,
    "Text": "Win with a triplet (or kan) of red dragon yaku tiles."
  },
  {
    "RowOffset": 11242,
    "RowId": 279,
    "Text": "Awards bonus han but is not a yaku by itself."
  },
  {
    "RowOffset": 11298,
    "RowId": 280,
    "Text": "Declare riichi on the first turn, then win immediately after."
  },
  {
    "RowOffset": 11370,
    "RowId": 281,
    "Text": "Win with the same straight in each suit."
  },
  {
    "RowOffset": 11422,
    "RowId": 282,
    "Text": "Win with three straights of the same suit, forming 1, 2, 3, and 4, 5, 6, and 7, 8, 9."
  },
  {
    "RowOffset": 11518,
    "RowId": 283,
    "Text": "Win with all melds containing terminals or honor tiles."
  },
  {
    "RowOffset": 11586,
    "RowId": 284,
    "Text": "Win with four triplets (or kan) and a pair."
  },
  {
    "RowOffset": 11642,
    "RowId": 285,
    "Text": "Win with three triplets of the same number in each suit."
  },
  {
    "RowOffset": 11710,
    "RowId": 286,
    "Text": "Win with four triplets (or kan) and a pair all containing only terminals or honor tiles."
  },
  {
    "RowOffset": 11810,
    "RowId": 287,
    "Text": "Win with three triplets (or kan) without calling pon. "
  },
  {
    "RowOffset": 11878,
    "RowId": 288,
    "Text": "Win with three kan."
  },
  {
    "RowOffset": 11910,
    "RowId": 289,
    "Text": "Win with two triplets and a pair of dragon tiles."
  },
  {
    "RowOffset": 11970,
    "RowId": 290,
    "Text": "Win with seven pairs."
  },
  {
    "RowOffset": 12002,
    "RowId": 291,
    "Text": "Win with terminals in each meld."
  },
  {
    "RowOffset": 12046,
    "RowId": 292,
    "Text": "Win with two sets of two identical straights."
  },
  {
    "RowOffset": 12102,
    "RowId": 293,
    "Text": "Win using only number tiles from one suit and honor tiles."
  },
  {
    "RowOffset": 12174,
    "RowId": 294,
    "Text": "Win using only number tiles from one suit."
  },
  {
    "RowOffset": 12230,
    "RowId": 295,
    "Text": "After all tiles have been drawn, win by having discarded only terminals and honor tiles."
  },
  {
    "RowOffset": 12330,
    "RowId": 296,
    "Text": "(Yakuman) The dealer wins on the first tile drawn."
  },
  {
    "RowOffset": 12394,
    "RowId": 297,
    "Text": "(Yakuman) Any non-dealer wins on the first tile drawn."
  },
  {
    "RowOffset": 12462,
    "RowId": 298,
    "Text": "(Yakuman) Form a hand using only number tiles from one suit, where it is possible to call a winning hand using any number."
  },
  {
    "RowOffset": 12598,
    "RowId": 299,
    "Text": "(Yakuman) Form a hand using only number tiles from one suit, calling a winning hand using any number."
  },
  {
    "RowOffset": 12710,
    "RowId": 300,
    "Text": "(Yakuman) Win with three triplets of dragon tiles."
  },
  {
    "RowOffset": 12774,
    "RowId": 301,
    "Text": "(Yakuman) Win with four triplets of wind tiles."
  },
  {
    "RowOffset": 12834,
    "RowId": 302,
    "Text": "(Yakuman) Win with three triplets and a pair of wind tiles."
  },
  {
    "RowOffset": 12906,
    "RowId": 303,
    "Text": "(Yakuman) Win with four triplets (or kan) without calling pon."
  },
  {
    "RowOffset": 12982,
    "RowId": 304,
    "Text": "(Yakuman) Win with four triplets (or kan) without calling pon, winning on the tile that completes a pair."
  },
  {
    "RowOffset": 13098,
    "RowId": 305,
    "Text": "(Yakuman) Win with four kan."
  },
  {
    "RowOffset": 13138,
    "RowId": 306,
    "Text": "(Yakuman) Win with only honor tiles."
  },
  {
    "RowOffset": 13186,
    "RowId": 307,
    "Text": "(Yakuman) Win with four triplets (or kan) containing only terminals."
  },
  {
    "RowOffset": 13266,
    "RowId": 308,
    "Text": "(Yakuman) Win using only green tiles."
  },
  {
    "RowOffset": 13314,
    "RowId": 309,
    "Text": "(Yakuman) Win with all terminals and each type of honor tile."
  },
  {
    "RowOffset": 13386,
    "RowId": 310,
    "Text": "(Yakuman) Win with all terminals and each type of honor tile, winning on the tile that completes a pair."
  },
  {
    "RowOffset": 13502,
    "RowId": 311,
    "Text": "Awards bonus han but is not a yaku by itself."
  },
  {
    "RowOffset": 13558,
    "RowId": 312,
    "Text": "Awards bonus han but is not a yaku by itself."
  },
  {
    "RowOffset": 13614,
    "RowId": 313,
    "Text": "(Yakuman) Win with three triplets of dragon tiles. If another player allowed the third triplet to be called, they must pay a penalty."
  },
  {
    "RowOffset": 13758,
    "RowId": 314,
    "Text": "(Yakuman) Win with four triplets of wind tiles. If another player allowed the fourth triplet to be called, they must pay a penalty."
  },
