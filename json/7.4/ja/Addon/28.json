    "Text": "TREASURE ACQUISITION"
  },
  {
    "RowOffset": 810598,
    "RowId": 13872,
    "Text": "TREASURE ACQUISITION"
  },
  {
    "RowOffset": 810630,
    "RowId": 13873,
    "Text": "参戦可能なクリティカルエンゲージメントはありません。"
