[
  {
    "RowOffset": 986950,
    "RowId": 17500,
    "Text": "争奪中"
  },
  {
    "RowOffset": 986970,
    "RowId": 17501,
    "Text": "<switch(IntegerParameter(1),<Icon>51</Icon><span style=\"color: #ffc8c8;\">黒渦団 占拠中！</span>,<Icon>52</Icon><span style=\"color: #ffffc0;\">双蛇党 占拠中！</span>,<Icon>53</Icon><span style=\"color: #ffc0ff;\">不滅隊 占拠中！</span>)>"
  },
  {
    "RowOffset": 987146,
    "RowId": 17502,
    "Text": "占拠済み"
  },
  {
    "RowOffset": 987170,
    "RowId": 17503,
    "Text": "<switch(IntegerParameter(1),<Icon>51</Icon><span style=\"color: #ffc8c8;\">黒渦団</span>,<Icon>52</Icon><span style=\"color: #ffffc0;\">双蛇党</span>,<Icon>53</Icon><span style=\"color: #ffc0ff;\">不滅隊</span>)>が<switch(IntegerParameter(2),ランクB,ランクA,ランクS)>のオブジェクトを制圧した！"
  },
  {
    "RowOffset": 987394,
    "RowId": 17504,
    "Text": "雪発生まで<Num>IntegerParameter(1)</Num>秒！"
  },
  {
    "RowOffset": 987434,
    "RowId": 17505,
    "Text": "あたりに雪が降り始めた！"
  },
  {
    "RowOffset": 987482,
    "RowId": 17506,
    "Text": "オーロラ発生まで<Num>IntegerParameter(1)</Num>秒！"
  },
  {
    "RowOffset": 987530,
    "RowId": 17507,
    "Text": "オーロラが発生した！"
  },
  {
    "RowOffset": 987574,
    "RowId": 17508,
    "Text": "Import"
  },
  {
    "RowOffset": 987594,
    "RowId": 17509,
    "Text": "共有コードの読み込み"
  },
  {
