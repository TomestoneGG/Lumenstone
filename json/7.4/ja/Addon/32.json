  },
  {
    "RowOffset": 901318,
    "RowId": 15782,
    "Text": "CHANGE ACTION SETTINGS"
  },
  {
    "RowOffset": 901354,
    "RowId": 15783,
    "Text": "置き換え設定"
  },
  {
    "RowOffset": 901386,
    "RowId": 15784,
    "Text": "置き換えの条件を満たした場合に、\n以下アクションの置き換えを行うかどうかを設定します。"
  },
  {
    "RowOffset": 901530,
    "RowId": 15785,
    "Text": "アクションの置き換えを有効にする"
  },
  {
    "RowOffset": 901590,
    "RowId": 15786,
    "Text": "誤発動防止用リキャストタイムを有効にする"
  },
  {
    "RowOffset": 901662,
    "RowId": 15787,
    "Text": "決定"
  },
  {
    "RowOffset": 901682,
    "RowId": 15788,
    "Text": "キャンセル"
  },
  {
    "RowOffset": 901710,
    "RowId": 15789,
    "Text": "このまま閉じると設定が破棄されます。\nよろしいですか？"
  },
  {
    "RowOffset": 901806,
    "RowId": 15790,
    "Text": "ホットバー登録が可能な採集アクションの一覧です。"
  },
  {
    "RowOffset": 901890,
    "RowId": 15791,
    "Text": "ホットバー登録が可能な製作アクションの一覧です"
  },
  {
    "RowOffset": 901970,
    "RowId": 15792,
    "Text": "ボタン連打での誤発動を防ぐため、\n置き換え時にリキャストタイムが設定されます。"
  },
