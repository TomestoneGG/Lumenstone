  },
  {
    "RowOffset": 972698,
    "RowId": 17011,
    "Text": "評価値："
  },
  {
    "RowOffset": 972722,
    "RowId": 17012,
    "Text": "\u3000<If(GreaterThan(IntegerParameter(2),0))>NQ<Else/>HQ</If> = <Num>IntegerParameter(1)</Num>点"
  },
