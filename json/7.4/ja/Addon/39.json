    "RowOffset": 1031950,
    "RowId": 102551,
    "Text": "投票除名"
  },
  {
    "RowOffset": 1031974,
    "RowId": 102552,
    "Text": "<String>StringParameter(1)</String>の投票除名を開始します。"
  },
  {
    "RowOffset": 1032030,
    "RowId": 102553,
    "Text": "除名する理由を選択してください。"
  },
