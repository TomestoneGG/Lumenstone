  },
  {
    "RowOffset": 1021090,
    "RowId": 102314,
    "Text": ""
  },
  {
    "RowOffset": 1021102,
    "RowId": 102315,
    "Text": "ホームポイントは<sheet(PlaceName,<sheet(Aetheryte,IntegerParameter(1),8)>,0)>に登録されています。\n変更しますか？"
  },
  {
    "RowOffset": 1021230,
