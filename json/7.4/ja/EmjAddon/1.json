  {
    "RowOffset": 5038,
    "RowId": 66,
    "Text": "●対戦者選択"
  },
  {
    "RowOffset": 5070,
    "RowId": 67,
    "Text": "●麻雀を始める"
  },
  {
    "RowOffset": 5102,
    "RowId": 68,
    "Text": "●戻る"
  },
  {
    "RowOffset": 5122,
