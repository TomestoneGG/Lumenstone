  {
    "RowOffset": 609862,
    "RowId": 4062,
    "Description": "重圧を与える特殊弾。ただし、大型兵器には効果がない"
  },
  {
    "RowOffset": 609950,
    "RowId": 4063,
    "Description": "生物を感電させる特殊弾。ただし、機械兵器には効果がない"
  },
  {
    "RowOffset": 610042,
    "RowId": 4064,
    "Description": "装甲を溶かす特殊弾"
  },
  {
    "RowOffset": 610082,
    "RowId": 4065,
    "Description": "対象を引き寄せる特殊兵装"
  },
  {
    "RowOffset": 610130,
