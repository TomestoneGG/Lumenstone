  },
  {
    "RowOffset": 819526,
    "RowId": 37000,
    "Text": "テミスの撃破"
  },
  {
    "RowOffset": 819558,
    "RowId": 37001,
    "Text": "何故かな、心が沸き立つのを感じるよ……！"
  },
  {
    "RowOffset": 819630,
    "RowId": 37002,
    "Text": "この技で、君を判じよう……！"
  },
  {
    "RowOffset": 819686,
    "RowId": 37003,
    "Text": "光と闇……君を裁くのはどちらかな？"
  },
  {
    "RowOffset": 819750,
    "RowId": 37004,
    "Text": "杖はこう使う、友人からの提案だ！"
  },
  {
    "RowOffset": 819810,
    "RowId": 37005,
    "Text": "光と闇の均衡を保てるかな……？"
  },
  {
    "RowOffset": 819866,
    "RowId": 37006,
    "Text": "エリディブスとして、君を調停しよう！"
  },
  {
    "RowOffset": 819934,
    "RowId": 37007,
    "Text": "集いし魔力よ……疾く奔れ……！"
  },
  {
    "RowOffset": 819990,
    "RowId": 37008,
    "Text": "くらえ、エメトセルク仕込みの術式だ！"
  },
  {
    "RowOffset": 820058,
    "RowId": 37009,
    "Text": "私の存在を核に、幻体を創造しよう！"
  },
  {
    "RowOffset": 820122,
    "RowId": 37010,
    "Text": "より強靭な幻体の創造を……！"
  },
  {
    "RowOffset": 820178,
    "RowId": 37011,
    "Text": "参ったな、これほど心躍るとは……！"
  },
  {
    "RowOffset": 820242,
    "RowId": 37012,
    "Text": "私は調停者……その命は絶対だ！"
  },
  {
    "RowOffset": 820298,
    "RowId": 37013,
    "Text": "君という存在を、調停する！"
  },
  {
    "RowOffset": 820350,
    "RowId": 37014,
    "Text": "ずっと、この戦いを追い求めてきた……！"
  },
  {
    "RowOffset": 820418,
    "RowId": 37015,
    "Text": "だが、至福の時間も……そろそろ終いだ！"
  },
