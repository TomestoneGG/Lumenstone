  {
    "RowOffset": 812606,
    "RowId": 36699,
    "Text": ""
  },
  {
    "RowOffset": 812618,
    "RowId": 36700,
    "Text": "来い、聖戦を阻む者よ！"
  },
  {
    "RowOffset": 812662,
    "RowId": 36701,
    "Text": "お前を斃し、すべての救済を成し遂げよう！"
  },
  {
    "RowOffset": 812734,
    "RowId": 36702,
    "Text": "この世界を救うのだ！"
  },
  {
    "RowOffset": 812778,
    "RowId": 36703,
    "Text": "邪魔をするな！"
  },
  {
    "RowOffset": 812810,
    "RowId": 36704,
    "Text": "おのれえええ！！"
  },
  {
    "RowOffset": 812846,
    "RowId": 36705,
    "Text": "これがお前たちの力か……。"
  },
  {
    "RowOffset": 812898,
    "RowId": 36706,
    "Text": "どれほどの猛者であろうとも……！"
  },
  {
    "RowOffset": 812958,
    "RowId": 36707,
    "Text": "下れ、降り注げ……！"
  },
  {
    "RowOffset": 813002,
    "RowId": 36708,
    "Text": "凍てついた刃で……！"
  },
  {
    "RowOffset": 813046,
    "RowId": 36709,
    "Text": "風よ、荒れ狂え！"
  },
  {
    "RowOffset": 813082,
    "RowId": 36710,
    "Text": "力のままに粉砕せよ……！"
  },
  {
    "RowOffset": 813130,
    "RowId": 36711,
    "Text": "炸裂し、数多に奔れ！"
  },
  {
    "RowOffset": 813174,
    "RowId": 36712,
    "Text": "黒竜よ、来たれ！"
  },
  {
    "RowOffset": 813210,
    "RowId": 36713,
    "Text": "我が命に応えよ、黒竜！"
  },
  {
    "RowOffset": 813254,
    "RowId": 36714,
    "Text": "貴様の力と我が剣技、真髄を見せるとしよう！"
  },
  {
    "RowOffset": 813330,
    "RowId": 36715,
    "Text": "真の恐怖を味わうがいい！"
  },
  {
    "RowOffset": 813378,
    "RowId": 36716,
    "Text": "打ち砕け……！"
  },
  {
    "RowOffset": 813410,
    "RowId": 36717,
    "Text": "さあ、喰らいつけ！"
  },
  {
    "RowOffset": 813450,
    "RowId": 36718,
    "Text": "黒竜よ、その力で焼き尽くせ！"
  },
  {
    "RowOffset": 813506,
    "RowId": 36719,
    "Text": "黒竜よ、すべての力を絞り出せ！"
  },
  {
    "RowOffset": 813562,
    "RowId": 36720,
    "Text": "パワーをメテオに！"
  },
  {
    "RowOffset": 813602,
    "RowId": 36721,
    "Text": "お前たちの世界、いただくぞ……！"
  },
  {
