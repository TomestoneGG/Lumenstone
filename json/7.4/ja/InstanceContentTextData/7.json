  {
    "RowOffset": 360650,
    "RowId": 18000,
    "Text": "崩れかけた橋への到達"
  },
  {
    "RowOffset": 360694,
    "RowId": 18001,
    "Text": "背徳の皇帝マティウスの撃破"
  },
  {
    "RowOffset": 360746,
    "RowId": 18002,
    "Text": "王宮前広場への到達"
  },
  {
    "RowOffset": 360786,
    "RowId": 18003,
    "Text": "統制者ハシュマリムの撃破"
  },
  {
    "RowOffset": 360834,
    "RowId": 18004,
    "Text": "ガラムサイズ水路への到達"
  },
  {
    "RowOffset": 360882,
    "RowId": 18005,
    "Text": "ガラムサイズ水路の突破"
  },
  {
    "RowOffset": 360926,
    "RowId": 18006,
    "Text": "人馬王ロフォカレの撃破"
  },
  {
    "RowOffset": 360970,
    "RowId": 18007,
    "Text": "ルザリア神殿跡への到達"
  },
  {
    "RowOffset": 361014,
    "RowId": 18008,
    "Text": "冷血剣アルガスの撃破"
  },
  {
    "RowOffset": 361058,
    "RowId": 18009,
    "Text": ""
  },
  {
    "RowOffset": 361070,
    "RowId": 18010,
    "Text": ""
  },
  {
    "RowOffset": 361082,
    "RowId": 18011,
    "Text": "“ほう、我を見てなお、戦う意志を示すとは……。\nよかろう、新たな統治の始まりを告げる、贄としようぞ。”"
  },
  {
    "RowOffset": 361250,
    "RowId": 18012,
    "Text": "“ま、まさか……この力が、破れようとは……！”"
  },
  {
    "RowOffset": 361330,
    "RowId": 18013,
    "Text": "“我は……万物を治める者……\nふたたび現世に、正しき法則をもたらさん……。”"
  },
  {
    "RowOffset": 361458,
    "RowId": 18014,
    "Text": "“我が法則を……超えると……いうのか…………！”"
  },
  {
    "RowOffset": 361542,
    "RowId": 18015,
    "Text": "“聞こえる……聞こえるぞ、群れを成す敵の足音が……！\nさあ、構えよ、我はロフォカレ、人馬王なり！”"
  },
  {
    "RowOffset": 361702,
    "RowId": 18016,
    "Text": "“よき戦いであった……これぞ、我が求め…………。”"
  },
  {
    "RowOffset": 361790,
    "RowId": 18017,
    "Text": "“今更\u3000後悔して神に祈っても無駄だ！\n朕の剣を受けてみよ！”"
  },
  {
    "RowOffset": 361894,
    "RowId": 18018,
    "Text": "“朕に……神に楯突くとは生意気なッ！”"
  },
  {
    "RowOffset": 361962,
    "RowId": 18019,
    "Text": "“逃げ惑えッ！\u3000羊どもよッ！”"
  },
  {
    "RowOffset": 362018,
    "RowId": 18020,
    "Text": "“贄の分際でッ！”"
  },
  {
    "RowOffset": 362058,
    "RowId": 18021,
    "Text": "“家畜に神はいないッ！”"
  },
  {
    "RowOffset": 362106,
    "RowId": 18022,
    "Text": "“死をもって償うのだッ！”"
  },
  {
    "RowOffset": 362158,
    "RowId": 18023,
    "Text": "“家畜は所詮家畜ぞ\u3000身の程を知れいッ！”"
  },
  {
    "RowOffset": 362230,
    "RowId": 18024,
    "Text": "“「真なる神」の力を見せてやろうぞッ！\n朕の仮面の啓示に従え！！”"
  },
  {
    "RowOffset": 362342,
    "RowId": 18025,
    "Text": "“「偽りの神」の力を見せてやろうぞッ！\n朕の仮面の啓示に従え！！”"
  },
  {
    "RowOffset": 362454,
    "RowId": 18026,
    "Text": "“啓示を授けようッ！”"
  },
  {
    "RowOffset": 362498,
    "RowId": 18027,
    "Text": "“神罰を受けよッ！”"
  },
  {
    "RowOffset": 362542,
    "RowId": 18028,
    "Text": "“ちょこまかと五月蠅いムシケラめッ！\nさらなる絶望を！\u3000死を与えようぞッ！”"
  },
  {
    "RowOffset": 362670,
    "RowId": 18029,
    "Text": "“虚無の力をここに！\nダークアルテマ！！”"
  },
  {
    "RowOffset": 362746,
    "RowId": 18030,
    "Text": "“輝ける「聖石」よ……！\n進軍を告げるラッパとなり、我が兵たちをここに！”"
  },
  {
    "RowOffset": 362870,
    "RowId": 18031,
    "Text": "“我が戦車の車輪は、天をも駆ける！\nゆくぞ……！”"
  },
  {
    "RowOffset": 362958,
    "RowId": 18032,
    "Text": "“見よ！\u3000そして、怖れよ！\nこれこそが輝ける「聖石」の力なるぞ！”"
  },
  {
    "RowOffset": 363070,
    "RowId": 18033,
    "Text": "“ハッハッハッハッ！\u3000まだ戦意が消えておらぬとは……！\nならば、あとは獣同然、血みどろで戦い続けるのみよ！”"
  },
  {
    "RowOffset": 363246,
    "RowId": 18034,
    "Text": "“我に合見えし不幸を呪うがよい！\n星よ降れ！\u3000星天爆撃打！”"
  },
  {
    "RowOffset": 363350,
    "RowId": 18035,
    "Text": "“地獄の鬼の首折る刃の空に舞う、\n無限地獄の百万由旬……冥界恐叫打！”"
  },
  {
    "RowOffset": 363470,
    "RowId": 18036,
    "Text": "“眠りの底なす漆黒の呪唱をして、\n慈悲なる光を払わん！\u3000暗黒！”"
  },
  {
    "RowOffset": 363578,
    "RowId": 18037,
    "Text": "“漆黒の闇より出でよ……我が分身よ！”"
  },
  {
    "RowOffset": 363646,
    "RowId": 18038,
    "Text": "“万物を治める統制の塔よ、そそり立て！”"
  },
  {
    "RowOffset": 363718,
    "RowId": 18039,
    "Text": "“この大地に、あまねく我が支配をもたらさん……！”"
  },
  {
    "RowOffset": 363806,
    "RowId": 18040,
    "Text": "“あくまでも支配に抗おうというのか……！”"
  },
  {
    "RowOffset": 363882,
    "RowId": 18041,
    "Text": "“大地よ震え、抗う者どもを埋葬せよ……\nランドワスター！”"
  },
  {
    "RowOffset": 363982,
    "RowId": 18042,
    "Text": "“耐え抜く者がいようとは、驚いた……だが！”"
  },
  {
    "RowOffset": 364062,
    "RowId": 18043,
    "Text": "“抗う者どもよ、断ち斬らん！”"
  },
  {
    "RowOffset": 364118,
    "RowId": 18044,
    "Text": "“命の法則さえ、我にひれ伏す……！\n砂よ石よ、立ち上がりて兵となれ！”"
  },
  {
    "RowOffset": 364238,
    "RowId": 18045,
    "Text": "“我が刃よ、燃え上がれ！”"
  },
  {
    "RowOffset": 364290,
    "RowId": 18046,
    "Text": "“地の底に流れる暗き水よ……\n沸き上がりて、我の力となれ！”"
  },
  {
    "RowOffset": 364394,
    "RowId": 18047,
    "Text": "“さあ、我が盾となりし、氷の女神よ……！\n剣となりて、舞い踊れ！”"
  },
  {
    "RowOffset": 364506,
    "RowId": 18048,
    "Text": "“氷の女神よ、我が元に戻り盾となれ……！”"
  },
  {
    "RowOffset": 364582,
    "RowId": 18049,
    "Text": "“生ける盾よ、悪意の刃より、我を護れ……！”"
  },
  {
    "RowOffset": 364662,
    "RowId": 18050,
    "Text": "“水よ、凍りて、さらなる力を我にもたらせ……！”"
  },
  {
    "RowOffset": 364746,
    "RowId": 18051,
    "Text": "“毒よ、流れて、肉を蝕む沼となれ……！”"
  },
  {
    "RowOffset": 364818,
    "RowId": 18052,
    "Text": "“未だ抵抗を続けるか……小さき者どもよ……！”"
  },
  {
    "RowOffset": 364898,
    "RowId": 18053,
    "Text": "“余興は終わりだ……我が魔力を解き放たん！”"
  },
  {
    "RowOffset": 364978,
    "RowId": 18054,
    "Text": "“なんと……この冷気を耐え抜くか……！”"
  },
  {
    "RowOffset": 365050,
    "RowId": 18055,
    "Text": "“凍てつく波動よ、我が都に静寂を……！”"
  },
  {
    "RowOffset": 365122,
    "RowId": 18056,
    "Text": "正面に見えるのが、旧ダルマスカ王国の都ラバナスタ……\nボクたちの目的地は、その奥にあります！"
  },
  {
    "RowOffset": 365274,
    "RowId": 18057,
    "Text": "な、なんだッ！？\u3000紅い鳥の群れが……！"
  },
  {
    "RowOffset": 365342,
    "RowId": 18058,
    "Text": "橋の上に異形の化け物が……！\nそれに、この冷気……気を付けてください！"
  },
  {
    "RowOffset": 365462,
    "RowId": 18059,
    "Text": "お見事です、シドおじさんが推薦するだけはありますね。\nしかし、あの化け物はいったい……？"
  },
  {
    "RowOffset": 365606,
    "RowId": 18060,
    "Text": "どうやら、シーク族の盗人のようですね……。\n住民が去ったのをいいことに、卑しい連中め！"
  },
  {
    "RowOffset": 365750,
    "RowId": 18061,
    "Text": "大規模な反乱があったとは聞いていましたが、\nこの崩壊ぶりは……まさか、先ほどの化け物が……？"
  },
  {
    "RowOffset": 365902,
    "RowId": 18062,
    "Text": "ここにも盗人か……。\n異形の存在が徘徊する街で、よくもまぁ……。"
  },
  {
    "RowOffset": 366010,
    "RowId": 18063,
    "Text": "また、異形の化け物が……！\nラバナスタで、何があったというんだ……！"
  },
  {
    "RowOffset": 366126,
    "RowId": 18064,
    "Text": "やりましたね……。\nこの先から地下に降りられそうです、慎重に先に進みましょう。"
  },
  {
    "RowOffset": 366258,
    "RowId": 18065,
    "Text": "ここは、ガラムサイズ水路……。\n増改築が繰り返され、かなり水深が深いところもあるとか……。"
  },
  {
    "RowOffset": 366406,
    "RowId": 18066,
    "Text": "ただの妖異や魔物の類いではありませんね……。\nこの奥には、それだけの秘密があるということか……。"
  },
  {
    "RowOffset": 366562,
    "RowId": 18067,
    "Text": "あなた方に護衛をお任せして正解でした。\nさあ、いよいよ最深部です……気を引き締めてください！"
  },
  {
    "RowOffset": 366714,
    "RowId": 18068,
    "Text": "なんて、壮麗な遺跡群なんだ……！\n間違いありません、ここがイヴァリースの王都「ルザリア」ですッ！"
  },
  {
    "RowOffset": 366870,
    "RowId": 18069,
    "Text": "ボクにも感じられるほどの、異様な気配……。\n気を付けてくださいッ！"
  },
  {
    "RowOffset": 366982,
    "RowId": 18070,
    "Text": ""
  },
  {
    "RowOffset": 366994,
    "RowId": 18071,
    "Text": "“ブリザガ・ピラー……我が贄に氷の烙印を授けよ！”"
  },
  {
    "RowOffset": 367082,
    "RowId": 18072,
    "Text": "“影よ立ち上がり、朕の敵を討てッ！”"
  },
  {
    "RowOffset": 367150,
    "RowId": 18073,
    "Text": "“それで凌いだつもりか！？\n聖石が秘めたる力、見せてくれようぞッ！”"
  },
  {
    "RowOffset": 367266,
    "RowId": 18074,
    "Text": "“我が征くは、闇の覇道……見切れはしまい！”"
  },
  {
    "RowOffset": 367346,
    "RowId": 18075,
    "Text": "“さあ、我が槍の穂先は、貴様たちの首を狙っておるぞ？”"
  },
  {
    "RowOffset": 367438,
    "RowId": 18076,
    "Text": "“闇を払っただと！？\nこざかしい、奴らめ！”"
  },
  {
    "RowOffset": 367518,
    "RowId": 18077,
    "Text": "“暗闇の中で恐怖に溺れるがいい！”"
  },
  {
    "RowOffset": 367582,
    "RowId": 18078,
    "Text": "“大地の手、より固くその身を捕らえ、\n汝の枷とならん！\u3000抱締！”"
  },
  {
    "RowOffset": 367690,
    "RowId": 18079,
    "Text": ""
  },
  {
    "RowOffset": 367702,
    "RowId": 18080,
    "Text": ""
  },
  {
    "RowOffset": 367714,
    "RowId": 18100,
    "Text": "おぉ、バハムート！\nその御力を得て、大いなる御業の成就のため刻をかせぎましょう！"
  },
  {
    "RowOffset": 367846,
    "RowId": 18101,
    "Text": "この消えゆく命を燃やし、\n我が神の御業を阻む、虫ケラどもを封じましょうぞ！"
  },
  {
    "RowOffset": 367970,
    "RowId": 18102,
    "Text": "テラフレア詠唱完了まで\u300010"
  },
  {
    "RowOffset": 368022,
    "RowId": 18103,
    "Text": "テラフレア詠唱完了まで\u30005"
  },
  {
    "RowOffset": 368070,
    "RowId": 18104,
    "Text": "テラフレア詠唱完了まで\u30004"
  },
  {
    "RowOffset": 368118,
    "RowId": 18105,
    "Text": "テラフレア詠唱完了まで\u30003"
  },
  {
    "RowOffset": 368166,
    "RowId": 18106,
    "Text": "テラフレア詠唱完了まで\u30002"
  },
  {
    "RowOffset": 368214,
    "RowId": 18107,
    "Text": "テラフレア詠唱完了まで\u30001"
  },
  {
    "RowOffset": 368262,
    "RowId": 18108,
    "Text": ""
  },
  {
    "RowOffset": 368274,
