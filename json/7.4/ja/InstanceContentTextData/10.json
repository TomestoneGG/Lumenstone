[
  {
    "RowOffset": 460878,
    "RowId": 22686,
    "Text": ""
  },
  {
    "RowOffset": 460890,
    "RowId": 22687,
    "Text": ""
  },
  {
    "RowOffset": 460902,
    "RowId": 22700,
    "Text": "ランジートの体力を削れ！"
  },
  {
    "RowOffset": 460950,
    "RowId": 22701,
    "Text": "ランジートの体力をさらに削れ！"
  },
  {
    "RowOffset": 461006,
    "RowId": 22702,
    "Text": "コンテンツアクションで、窮地から抜け出せ！"
  },
  {
    "RowOffset": 461082,
    "RowId": 22703,
    "Text": "コンテンツアクションで、ソイルを放て！"
  },
  {
    "RowOffset": 461150,
    "RowId": 22704,
    "Text": "ランジートの体力を削り、チャンスを待て！"
  },
  {
    "RowOffset": 461222,
    "RowId": 22705,
    "Text": "コンテンツアクションで、窮地から抜け出せ！"
  },
  {
    "RowOffset": 461298,
    "RowId": 22706,
    "Text": "コンテンツアクションで、再びソイルを放て！"
  },
  {
    "RowOffset": 461374,
    "RowId": 22707,
    "Text": "ランジートの体力を削り、チャンスを待て！"
  },
  {
    "RowOffset": 461446,
    "RowId": 22708,
    "Text": "コンテンツアクションで、窮地から抜け出せ！"
  },
  {
    "RowOffset": 461522,
    "RowId": 22709,
    "Text": "ランジートの攻撃を耐え抜け！"
  },
  {
    "RowOffset": 461578,
    "RowId": 22710,
    "Text": "コンテンツアクションで、窮地から抜け出せ！"
  },
  {
    "RowOffset": 461654,
    "RowId": 22711,
    "Text": "コンテンツアクションで、最後のソイルを放て！"
  },
  {
    "RowOffset": 461734,
    "RowId": 22712,
    "Text": ""
  },
  {
    "RowOffset": 461746,
    "RowId": 22713,
    "Text": "なんて圧だ……\nだが、今回ばかりは、何としてでも俺が勝つ！"
  },
  {
    "RowOffset": 461846,
    "RowId": 22714,
    "Text": "よく吠える……。\nその舌で、あの娘を騙したのであろう。"
  },
  {
    "RowOffset": 461942,
    "RowId": 22715,
    "Text": "騙すどころか、黙っていたさ。\nそれでもあいつは、自分で歩き出した……！"
  },
  {
    "RowOffset": 462062,
    "RowId": 22716,
    "Text": "終わらぬ闘争、悲しみの宿命に向けてか？\n……抜かせッ！"
  },
  {
    "RowOffset": 462158,
    "RowId": 22717,
    "Text": "さすがに手強い……。\n攻撃が、ことごとく捌かれる……！"
  },
  {
    "RowOffset": 462254,
    "RowId": 22718,
    "Text": "無駄なことを……。\n我が奥義をもって、捻り潰してやろう！"
  },
  {
    "RowOffset": 462350,
    "RowId": 22719,
    "Text": "我が血を受けし、獣よ来たれ！"
  },
  {
    "RowOffset": 462406,
    "RowId": 22720,
    "Text": "これぞ我が武器、我が衣……！"
  },
  {
    "RowOffset": 462462,
    "RowId": 22721,
    "Text": "ハッ、いよいよ化け物じみてきたじゃないか……！"
  },
  {
    "RowOffset": 462542,
    "RowId": 22722,
    "Text": "……あの娘に、歩み続けろと言うのか。\nかように希望なき世界を……。"
  },
  {
    "RowOffset": 462654,
    "RowId": 22723,
    "Text": "いいや、彼女たちはきっと……\n自らの手で、世界の明日を取り戻す。"
  },
  {
    "RowOffset": 462762,
    "RowId": 22724,
    "Text": "かつての我らも、その夢を見た。\n結果、幾人の巫女が殉じたことか……！"
  },
  {
    "RowOffset": 462878,
    "RowId": 22725,
    "Text": "くそっ……。\nミンフィリアのソイルを放つ隙がない……！"
  },
  {
    "RowOffset": 462974,
    "RowId": 22726,
    "Text": "隙を作れるとしたら、方法はひとつだけ……\n命を懸けた「あの技」なら……。"
  },
  {
    "RowOffset": 463094,
    "RowId": 22727,
    "Text": "よく足掻く……が、これまでだ。\nこの一撃で潰えるがいい！"
  },
  {
    "RowOffset": 463190,
    "RowId": 22728,
    "Text": "もとより、ここを死に場所とする覚悟だ。\nつきあってもらうぞ、ランジート！"
  },
  {
    "RowOffset": 463310,
    "RowId": 22729,
    "Text": "まずいな……負荷が高い……長くは維持できないか……。"
  },
  {
    "RowOffset": 463402,
    "RowId": 22730,
    "Text": "それでも、この状態なら……！\nソイルを放って、渾身の一撃を叩き込める！"
  },
  {
    "RowOffset": 463522,
    "RowId": 22731,
    "Text": "オオォォ……ッ！\n貴様、「死」という「無」に踏みこんだな……！"
  },
  {
    "RowOffset": 463630,
    "RowId": 22732,
    "Text": "グッ……そうとも……\n俺の命で、あいつが進めるなら、安いもんだ……！"
  },
  {
    "RowOffset": 463746,
    "RowId": 22733,
    "Text": "……ランジート。\n小さなレディたちは大抵、家族が思うより強かだ。"
  },
  {
    "RowOffset": 463854,
    "RowId": 22734,
    "Text": "そしていつの間にか、遠くを歩んでいる……\n籠になんて、閉じ込めておけるものか。"
  },
  {
    "RowOffset": 463986,
    "RowId": 22735,
    "Text": "その程度で、父きどりとは！\n片腹痛いわ……ッ！"
  },
  {
    "RowOffset": 464070,
    "RowId": 22736,
    "Text": "今がチャンスだ！\nもう一度、「あの技」を使う……！"
  },
  {
    "RowOffset": 464158,
    "RowId": 22737,
    "Text": "うぐっ……ハァハァ……\n慎重に近づいて……ソイルを……！"
  },
  {
    "RowOffset": 464254,
    "RowId": 22738,
    "Text": "反逆者風情が！\n貴様の曲芸など、見破ってくれるわ！"
  },
  {
    "RowOffset": 464342,
    "RowId": 22739,
    "Text": "ヌゥゥゥッ……またもや！\nだが、同じ技を二度も見せたな……！"
  },
  {
    "RowOffset": 464446,
    "RowId": 22740,
    "Text": "長期戦はマズい……。\nこうなったら……あの1発に、すべてを賭ける！"
  },
  {
    "RowOffset": 464558,
    "RowId": 22741,
    "Text": "まだ屈さぬか……。\nしかし、貴様はもはや窮鼠よ……。"
  },
  {
    "RowOffset": 464650,
    "RowId": 22742,
    "Text": "倒れるものかよッ！\nさあ、持ってくれよ、俺の身体……！"
  },
  {
    "RowOffset": 464746,
    "RowId": 22743,
    "Text": "ぜぇ……ぜぇ……。\nこれで、ミンフィリアに託された、あのソイルを……。"
  },
  {
    "RowOffset": 464866,
    "RowId": 22744,
    "Text": "見破ったりッ！"
  },
  {
    "RowOffset": 464898,
    "RowId": 22745,
    "Text": "捉えられた……！？\nクソッ、もう一度気配を消して……！"
  },
  {
    "RowOffset": 464994,
    "RowId": 22746,
    "Text": "愚か者めが……！\n何度やっても同じことよ！"
  },
  {
    "RowOffset": 465070,
    "RowId": 22747,
    "Text": "ぐっ……ハァハァ……\n同じ技じゃ、もう通じない……。"
  },
  {
    "RowOffset": 465162,
    "RowId": 22748,
    "Text": "ちくしょう……体が動かない……。\n技の連発で、負荷をかけすぎた……。"
  },
  {
    "RowOffset": 465278,
    "RowId": 22749,
    "Text": "万策尽きたか……。\nこのまま、葬り去ってやろう。"
  },
  {
    "RowOffset": 465362,
    "RowId": 22750,
    "Text": "このままじゃ負けだ……。\nイチかバチか、やるしかない……！"
  },
  {
    "RowOffset": 465462,
    "RowId": 22751,
    "Text": "負荷を限界まで上げ……己を完全に消し去る……ッ！"
  },
  {
    "RowOffset": 465546,
    "RowId": 22752,
    "Text": "虫の息で、目だけギラつかせおって。\nだがそれも、ここで仕舞いだ……！"
  },
  {
    "RowOffset": 465662,
    "RowId": 22753,
    "Text": "いいや……刺し違えてでも、お前を倒す！\n命脈ごと気配を断て……ソウルレスインビジブル！"
  },
  {
    "RowOffset": 465806,
    "RowId": 22754,
    "Text": "気配が……完全に消えた……ッ！？"
  },
  {
    "RowOffset": 465866,
    "RowId": 22755,
    "Text": "オォォォォォ……ッ！\nならば、すべてを破壊しつくすまでよッ！"
  },
  {
    "RowOffset": 465970,
    "RowId": 22756,
    "Text": "うおおおぉぉぉぉッ！"
  },
  {
    "RowOffset": 466014,
    "RowId": 22757,
    "Text": "……お前たちがついてるんだ、俺は負けないさ。\nそうだろ、ミンフィリア……アシリア……。"
  },
  {
    "RowOffset": 466158,
    "RowId": 22758,
    "Text": "ぐっ……これ以上は持たない……早くソイルを……！"
  },
  {
    "RowOffset": 466242,
    "RowId": 22759,
    "Text": ""
  },
  {
    "RowOffset": 466254,
    "RowId": 22760,
    "Text": ""
  },
  {
    "RowOffset": 466266,
    "RowId": 22761,
    "Text": "逃げられぬ以上、何もできずに果てるのみよ！"
  },
  {
    "RowOffset": 466342,
    "RowId": 22762,
    "Text": "いいや……\n積み重ねた戦いをもって、この秘技を行使する！"
  },
  {
    "RowOffset": 466438,
    "RowId": 22763,
    "Text": "鼠ごときの分際で……ッ！"
  },
  {
    "RowOffset": 466486,
    "RowId": 22800,
    "Text": "我はリヴァイアサン……\n失われた水底より来たりし、渦巻く者……！"
  },
  {
    "RowOffset": 466594,
    "RowId": 22801,
    "Text": "我がアギトは、岩をも砕く……！"
  },
  {
    "RowOffset": 466650,
    "RowId": 22802,
    "Text": "大洋は氾濫し、すべてを洗い流す……\n命の水よ牙を剥け、大海嘯！"
  },
  {
    "RowOffset": 466758,
    "RowId": 22803,
    "Text": "何者も海を統べること、叶わぬと知れ……\nヒトは、ただ揺られ、流され、翻弄されるのみ……！"
  },
  {
    "RowOffset": 466902,
    "RowId": 22804,
    "Text": "寄セテハ返スガ、波ノ定メ……\n全テヲ呑ミ込ムマデ、満チヨ、大海嘯！"
  },
  {
    "RowOffset": 467014,
    "RowId": 22805,
    "Text": "ガアアァァァァァ……\n満チル……満チル……水ノ力……目覚メノ刻、来レリ！"
  },
  {
    "RowOffset": 467134,
    "RowId": 22806,
    "Text": "始原ノ刻ヨリ、波ハ止マルコトヲ知ラズ！"
  },
  {
    "RowOffset": 467202,
    "RowId": 22807,
    "Text": "コノ星ガ終ワルマデ、波ハ止マルコトナシ！"
  },
  {
    "RowOffset": 467274,
    "RowId": 22808,
    "Text": "失ワレシ水底ヨリ、絶望ノ叫ビヲ聞ケ……！\n全テヲ押シ流ソウ、永遠ニ……！"
  },
  {
    "RowOffset": 467394,
    "RowId": 22809,
    "Text": "死ノ底ニ沈メ……！！"
  },
  {
    "RowOffset": 467438,
    "RowId": 22810,
    "Text": "“大丈夫ですか、<split(<String>ObjectParameter(1)</String>, ,1)>さん！？\nエデンの力を使って、どうにか足場を再生してみます！”"
  },
  {
    "RowOffset": 467586,
    "RowId": 22811,
    "Text": "“お、お待たせしました……！\n周囲のエーテルに干渉して、足場を再生します！”"
  },
  {
    "RowOffset": 467714,
    "RowId": 22812,
    "Text": "何度、壊されたって、エデンの力で……！"
  },
  {
    "RowOffset": 467782,
    "RowId": 22813,
    "Text": "足場の再生を行います……！"
  },
  {
    "RowOffset": 467834,
    "RowId": 22814,
    "Text": "<sheet(BNpcName,8486,0)>の撃破"
  },
  {
    "RowOffset": 467874,
    "RowId": 22815,
    "Text": ""
  },
  {
    "RowOffset": 467886,
    "RowId": 22900,
    "Text": "レンダ・レイの仇討ちの真実を追体験せよ！"
  },
  {
    "RowOffset": 467958,
    "RowId": 22901,
    "Text": ""
  },
  {
    "RowOffset": 467970,
    "RowId": 22902,
    "Text": ""
  },
  {
    "RowOffset": 467982,
    "RowId": 22903,
    "Text": "バラム・キツェー！\n仲間の仇だ、お前を討ち取ってやる……！"
  },
  {
    "RowOffset": 468082,
    "RowId": 22904,
    "Text": "もう以前のアタシじゃない！\n「ダグリングアロー」で、その咆哮を止めてみせる！"
  },
  {
    "RowOffset": 468210,
    "RowId": 22905,
    "Text": "成功した！ これなら、勝てる……！"
  },
  {
    "RowOffset": 468270,
    "RowId": 22906,
    "Text": "くっ……耳が……。\n「ダグリングアロー」で……咆哮を止めないと……。"
  },
  {
    "RowOffset": 468386,
    "RowId": 22907,
    "Text": "うう……負けるものか……。\n今度こそ、「ダグリングアロー」を成功させなきゃ……。"
  },
  {
    "RowOffset": 468518,
    "RowId": 22908,
    "Text": "うぁ……またも……。\n「ダグリングアロー」を成功させないと、勝ち目がない……。"
  },
  {
    "RowOffset": 468650,
    "RowId": 22909,
    "Text": "うぐぐ……アイツが咆哮を上げる前に……\n「ダグリングアロー」を放つ……それさえできれば……。"
  },
  {
    "RowOffset": 468802,
    "RowId": 22910,
    "Text": "お前を倒して、仲間の無念を晴らす！"
  },
  {
    "RowOffset": 468866,
    "RowId": 22911,
    "Text": "これはアタシの仇討ち。\nだから、自分ひとりで果たしてみせるんだ……。"
  },
  {
    "RowOffset": 468982,
    "RowId": 22912,
    "Text": "あのときのアタシに、いまほどの力があれば、\n仲間を失うこともなかったのに……。"
  },
  {
    "RowOffset": 469114,
    "RowId": 22913,
    "Text": "咆哮を上げる力もなくなったか？\nいまが好機だ、一気に仕留める！"
  },
  {
    "RowOffset": 469222,
    "RowId": 22914,
    "Text": "な、なんだ……？\nアイツから強力な力を感じる……まだそんな力が……？"
  },
  {
    "RowOffset": 469338,
    "RowId": 22915,
    "Text": "ぐはッ！\nそ、そんな……アタシひとりじゃ……勝てな……い。"
  },
  {
    "RowOffset": 469438,
    "RowId": 22916,
    "Text": "バカ野郎！\u3000ひとりで無茶しやがって……！"
  },
  {
    "RowOffset": 469510,
    "RowId": 22917,
    "Text": "どうやら、間に合ったようだな……。"
  },
  {
    "RowOffset": 469574,
    "RowId": 22918,
    "Text": "大丈夫！？\u3000いま、ケガを治してあげる……！"
  },
  {
    "RowOffset": 469650,
    "RowId": 22919,
    "Text": "やれやれ……とんだじゃじゃ馬だな。\nいや、お前の場合、じゃじゃ猫か……。"
  },
  {
    "RowOffset": 469770,
    "RowId": 22920,
    "Text": "とにかく、無事なようでよかったです。"
  },
  {
    "RowOffset": 469838,
    "RowId": 22921,
    "Text": "みんな……どうして？\nわざわざ、アタシのために……？"
  },
  {
    "RowOffset": 469930,
    "RowId": 22922,
    "Text": "話は奴を片付けてからだ！\nまだやれるな、レンダ？"
  },
  {
    "RowOffset": 470014,
    "RowId": 22923,
    "Text": "レンダと私が狙われてる！\n仲間を巻き込まないよう、離れて！"
  },
  {
    "RowOffset": 470114,
    "RowId": 22924,
    "Text": "皆、ナイルベルトのもとに集まるんだ！\n敵の攻撃を分散させるぞ！"
  },
  {
    "RowOffset": 470222,
    "RowId": 22925,
    "Text": "また咆哮を？\u3000させるものかッ……！"
  },
  {
    "RowOffset": 470286,
    "RowId": 22926,
    "Text": "何度でも止めてみせる！"
  },
  {
    "RowOffset": 470330,
    "RowId": 22927,
    "Text": "くっ……失敗した……！"
  },
  {
    "RowOffset": 470374,
    "RowId": 22928,
    "Text": "安心しろ、レンダ。\nオレが護るから、落ち着くんだ。"
  },
  {
    "RowOffset": 470462,
    "RowId": 22929,
    "Text": "私がいる限り、誰も死なせないからね！"
  },
  {
    "RowOffset": 470530,
    "RowId": 22930,
    "Text": "何度でも止めてみせる！"
  },
  {
    "RowOffset": 470574,
    "RowId": 22931,
    "Text": "やるじゃないか、その調子だ！"
  },
  {
    "RowOffset": 470630,
    "RowId": 22932,
    "Text": "みんなで力を合わせましょう！"
  },
  {
    "RowOffset": 470686,
    "RowId": 22933,
    "Text": "レンダ！\u3000ナイルベルト！\nラミットのもとに集まれ！"
  },
  {
    "RowOffset": 470774,
    "RowId": 22934,
    "Text": "奴が力を溜め始めた！\n大技が来る前に、一気にたたみかけるぞ……！"
  },
  {
    "RowOffset": 470882,
    "RowId": 22935,
    "Text": "みんな、私のもとに集まって！\u3000力を高めるの！"
  },
  {
    "RowOffset": 470962,
    "RowId": 22936,
    "Text": "バラム・キツェー！\n仲間とともに、お前を討ち取ってやる……！"
  },
  {
    "RowOffset": 471066,
    "RowId": 22937,
    "Text": "手ごたえが変わった！？\u3000硬化しやがったぞ！"
  },
  {
    "RowOffset": 471142,
    "RowId": 22938,
    "Text": "咆哮さえ止めれば、お前なんか……！"
  },
  {
    "RowOffset": 471206,
    "RowId": 22939,
    "Text": "うぁ……落ち着けアタシ。\n「ダグリングアロー」で咆哮を止めるんだ。"
  },
  {
    "RowOffset": 471318,
    "RowId": 22940,
    "Text": "うう……「ダグリングアロー」さえ……放てば……。"
  },
  {
    "RowOffset": 471402,
    "RowId": 22941,
    "Text": "くっ……絶対に止められるはず……やらなきゃ……！！"
  },
  {
    "RowOffset": 471490,
    "RowId": 22942,
    "Text": "アイツが咆哮を上げる前に、「ダグリングアロー」を放つんだ！"
  },
  {
    "RowOffset": 471590,
    "RowId": 22943,
    "Text": "この調子で、止め続けてやる！"
  },
  {
    "RowOffset": 471646,
    "RowId": 22944,
    "Text": "吠えさせるものか！\u3000「ダグリングアロー」で止めてやる！"
  },
  {
    "RowOffset": 471738,
    "RowId": 22945,
    "Text": ""
  },
  {
    "RowOffset": 471750,
    "RowId": 22946,
    "Text": ""
  },
  {
    "RowOffset": 471762,
    "RowId": 22947,
    "Text": ""
  },
  {
    "RowOffset": 471774,
    "RowId": 22948,
    "Text": ""
  },
  {
    "RowOffset": 471786,
    "RowId": 22949,
    "Text": ""
  },
  {
    "RowOffset": 471798,
    "RowId": 22950,
    "Text": ""
  },
  {
    "RowOffset": 471810,
    "RowId": 23000,
    "Text": "さあ、己に命ありと叫ぶなら、私を倒してみせよ……！"
  },
  {
    "RowOffset": 471898,
    "RowId": 23001,
    "Text": "やはり、肉体の枷を外さねばならないか……。"
  },
  {
    "RowOffset": 471974,
    "RowId": 23002,
    "Text": "これが最古の魔道士だ……！\n拝せよ、弱き命ども！"
  },
  {
    "RowOffset": 472058,
    "RowId": 23003,
    "Text": "戒律王ゾディアークの名において、我、ハーデスが命ず……！"
  },
  {
    "RowOffset": 472154,
    "RowId": 23004,
    "Text": "まどろみに沈む同胞よ、その力を果てなる漆黒と成せ……！"
  },
  {
    "RowOffset": 472246,
    "RowId": 23005,
    "Text": "虚栄の世界に終焉を！"
  },
  {
    "RowOffset": 472290,
    "RowId": 23006,
    "Text": "光の力が暴走……いや、違う……！"
  },
  {
    "RowOffset": 472350,
    "RowId": 23007,
    "Text": "なんという……なんという、忌々しき輝き……！"
  },
  {
    "RowOffset": 472430,
    "RowId": 23008,
    "Text": "その輝きが、世界を……命を分断したッ！"
  },
  {
    "RowOffset": 472498,
    "RowId": 23009,
    "Text": "あの悲劇、繰り返させてなるものかッ！"
  },
  {
    "RowOffset": 472566,
    "RowId": 23010,
    "Text": "戒律王の権能によりて、ふたたび闇を広げん！"
  },
  {
    "RowOffset": 472642,
    "RowId": 23011,
    "Text": "終わりだ、光の化け物よ……。"
  },
  {
    "RowOffset": 472698,
    "RowId": 23012,
    "Text": "お前たちの想いを糧に、真なる世界を再生しよう。"
  },
  {
    "RowOffset": 472778,
    "RowId": 23013,
    "Text": "我が手が掴む……この星の未来を！"
  },
  {
    "RowOffset": 472838,
    "RowId": 23014,
    "Text": "友の祈りよ、明日への望みよ！\u3000翼とならん！"
  },
  {
    "RowOffset": 472914,
    "RowId": 23015,
    "Text": "理（ことわり）への干渉こそが、魔道の真髄よ！"
  },
  {
    "RowOffset": 472994,
    "RowId": 23016,
    "Text": "滅びの言の葉を届けよう……！"
  },
  {
    "RowOffset": 473050,
    "RowId": 23017,
    "Text": "光の使徒よ、闇に沈め！"
  },
  {
    "RowOffset": 473094,
    "RowId": 23018,
    "Text": "邪魔だ、散れ！"
  },
  {
    "RowOffset": 473126,
    "RowId": 23019,
    "Text": "闇よ、魔力を我に！"
  },
  {
    "RowOffset": 473166,
    "RowId": 23020,
    "Text": "我が魂に、亀裂を入れるか……化け物め……！"
  },
  {
    "RowOffset": 473242,
    "RowId": 23021,
    "Text": "魔法のなんたるかを知るがいい！"
  },
  {
    "RowOffset": 473298,
    "RowId": 23022,
    "Text": "多重詠唱……逃げ惑え！"
  },
  {
    "RowOffset": 473342,
    "RowId": 23023,
    "Text": "これぞ闇の力！"
  },
  {
    "RowOffset": 473374,
    "RowId": 23024,
    "Text": "堕ちよ、絶望の底に……！"
  },
  {
    "RowOffset": 473422,
    "RowId": 23025,
    "Text": "冥きに眠る同胞たちよ……夢に抱きし想いを我に……！"
  },
  {
    "RowOffset": 473510,
    "RowId": 23026,
    "Text": "その想い、その願い、その祈りのすべてを、私が背負おう！"
  },
  {
    "RowOffset": 473602,
    "RowId": 23027,
    "Text": "なりそこないどもめ……！\nその輝きを、覆い尽くしてくれよう……！"
  },
  {
    "RowOffset": 473710,
    "RowId": 23028,
    "Text": "我が同胞たちよ、叫ぶがいい……！"
  },
  {
    "RowOffset": 473770,
    "RowId": 23029,
    "Text": "我らの想い、我らの願い、我らの祈りが、未来を掴むのだ……！"
  },
  {
    "RowOffset": 473870,
    "RowId": 23030,
    "Text": "そして、真なる世界の再創造を完遂するッ……！"
  },
  {
    "RowOffset": 473950,
    "RowId": 23031,
    "Text": "すべてを呑み込む深淵の存在よ……！"
  },
  {
    "RowOffset": 474014,
    "RowId": 23032,
    "Text": "光を喰らいて、闇へと還せ！\u3000ダージャ！"
  },
  {
    "RowOffset": 474082,
    "RowId": 23033,
    "Text": "なりそこないが、よく耐える……！\nが、その強き想いを踏み砕いてこその勝利か……！"
  },
  {
    "RowOffset": 474214,
    "RowId": 23100,
    "Text": "聞け、大地の叫びを……感じよ、大地の重みを……\nそして、沈め、大地の怒りによって……！"
  },
  {
    "RowOffset": 474358,
    "RowId": 23101,
    "Text": "我が身を鎧いし堅き地殻よ……！\n手甲となりて、敵を潰せ！"
  },
  {
    "RowOffset": 474454,
    "RowId": 23102,
    "Text": "逃れられると思うなよ……！"
  },
  {
    "RowOffset": 474506,
    "RowId": 23103,
    "Text": "轢き潰してくれようぞ……！"
  },
  {
    "RowOffset": 474558,
    "RowId": 23104,
    "Text": "我が身を鎧いし堅き地殻よ……！\n車輪となりて、大地を駆けよ！"
  },
  {
    "RowOffset": 474662,
    "RowId": 23105,
    "Text": "大地の怒りに砕け散れ！！"
  },
  {
    "RowOffset": 474710,
    "RowId": 23106,
    "Text": "我は、そなたの心を映す鏡……\nまだ足りぬ、あの恐怖に比肩せぬと感じるならば……！"
  },
  {
    "RowOffset": 474842,
    "RowId": 23107,
    "Text": "我は、その心にこそ応えよう……！\n命育む土の力よ、今ここに覚醒せよッ！"
  },
  {
    "RowOffset": 474962,
    "RowId": 23108,
    "Text": "大地よ、立ち上がれッ！"
  },
  {
    "RowOffset": 475006,
    "RowId": 23109,
    "Text": "沈み崩れて、命の苗床となるがいいッ！"
  },
  {
    "RowOffset": 475074,
    "RowId": 23110,
    "Text": "よくぞ、耐えてくれる……！\nならば見せよう、大地の力のすべてをッ！"
  },
  {
    "RowOffset": 475186,
    "RowId": 23111,
    "Text": "<sheet(BNpcName,8350,0)>の撃破"
  },
  {
    "RowOffset": 475226,
    "RowId": 23112,
    "Text": "ヌオオオオオオッ！\n我が内から湧きいずる大地の怒りは止められん！"
  },
  {
    "RowOffset": 475334,
    "RowId": 23113,
    "Text": "大地が生み出す、本物の恐怖を見せてくれよう！"
  },
  {
    "RowOffset": 475414,
    "RowId": 23114,
    "Text": "呑まれたな、恐怖に……！\nその心の弱さを、地の底で悔やむがいいッ！！"
  },
  {
    "RowOffset": 475530,
    "RowId": 23200,
    "Text": "<sheet(BNpcName,8345,0)>の撃破"
  },
  {
    "RowOffset": 475570,
    "RowId": 23201,
    "Text": ""
  },
  {
    "RowOffset": 475582,
    "RowId": 23300,
    "Text": "全力で来い……！\n私もまた 在るべき姿で 迎え撃ってやろう……！"
  },
  {
    "RowOffset": 475686,
    "RowId": 23301,
    "Text": "魔法のなんたるかを知るがいい！"
  },
  {
    "RowOffset": 475742,
    "RowId": 23302,
    "Text": "多重詠唱……逃げ惑え！"
  },
  {
    "RowOffset": 475786,
    "RowId": 23303,
    "Text": "これぞ闇の力！"
  },
  {
    "RowOffset": 475818,
    "RowId": 23304,
    "Text": "我が魔力で圧倒しよう……！"
  },
  {
    "RowOffset": 475870,
    "RowId": 23305,
    "Text": "なりそこないどもが……！"
  },
  {
    "RowOffset": 475918,
    "RowId": 23306,
    "Text": "異界から魂を呼び集めてまで抗うとは……！"
  },
  {
    "RowOffset": 475990,
    "RowId": 23307,
    "Text": "ならば私は、同胞たちの権能を以て戦おう！"
  },
  {
    "RowOffset": 476062,
    "RowId": 23308,
    "Text": "想いにより、影を創らん……！"
  },
  {
    "RowOffset": 476118,
    "RowId": 23309,
    "Text": "来たれ、尊厳王……！"
  },
  {
    "RowOffset": 476162,
    "RowId": 23310,
    "Text": "深淵の司祭よ、そして、死せる殉教者よ、立ち上がれ！"
  },
  {
    "RowOffset": 476250,
    "RowId": 23311,
    "Text": "その強き願いは、魂の境界さえ超えた……！"
  },
  {
    "RowOffset": 476322,
    "RowId": 23312,
    "Text": "さあ、ここからが想いの削り合いだ……！"
  },
  {
    "RowOffset": 476390,
    "RowId": 23313,
    "Text": "冥きに眠る同胞たちよ……夢に抱きし想いを我に……！"
  },
  {
    "RowOffset": 476478,
    "RowId": 23314,
    "Text": "その想い、その願い、その祈りのすべてを、私が背負おう！"
  },
  {
    "RowOffset": 476570,
    "RowId": 23315,
    "Text": "これが最古の魔道士だ……！\n拝せよ、弱き命ども！"
  },
  {
    "RowOffset": 476654,
    "RowId": 23316,
    "Text": "我が手が掴む……この星の未来を！"
  },
  {
    "RowOffset": 476714,
    "RowId": 23317,
    "Text": "同胞たちよ、想え……！"
  },
  {
    "RowOffset": 476758,
    "RowId": 23318,
    "Text": "同胞たちよ、強く願え……！"
  },
  {
    "RowOffset": 476810,
    "RowId": 23319,
    "Text": "同胞たちよ、心束ねて祈れ……！"
  },
  {
    "RowOffset": 476866,
    "RowId": 23320,
    "Text": "理（ことわり）への干渉こそが、魔道の真髄よ！"
  },
  {
    "RowOffset": 476946,
    "RowId": 23321,
    "Text": "滅びの言の葉を届けよう……！"
  },
  {
    "RowOffset": 477002,
    "RowId": 23322,
    "Text": "邪魔だ、散れ！"
  },
  {
    "RowOffset": 477034,
    "RowId": 23323,
    "Text": "闇よ、魔力を我に！"
  },
  {
    "RowOffset": 477074,
    "RowId": 23324,
    "Text": "堕ちよ、絶望の底に……！"
  },
  {
    "RowOffset": 477122,
    "RowId": 23325,
    "Text": "戒律王ゾディアークの名において、我、ハーデスが命ず……！"
  },
  {
    "RowOffset": 477218,
    "RowId": 23326,
    "Text": "まどろみに沈む同胞よ、その力を果てなる漆黒と成せ……！"
  },
  {
    "RowOffset": 477310,
    "RowId": 23327,
    "Text": "虚栄の世界に終焉を！"
  },
  {
    "RowOffset": 477354,
    "RowId": 23328,
    "Text": "光の力が暴走……いや、違う……！"
  },
  {
    "RowOffset": 477414,
    "RowId": 23329,
    "Text": "なんという……なんという、忌々しき輝き……！"
  },
  {
    "RowOffset": 477494,
    "RowId": 23330,
    "Text": "だが、それでもなお、負けはしない……！"
  },
  {
    "RowOffset": 477562,
    "RowId": 23331,
    "Text": "救われるべきは、我々なのだ……！"
  },
  {
    "RowOffset": 477622,
    "RowId": 23332,
    "Text": "深き闇に呑まれよ……！"
  },
  {
    "RowOffset": 477666,
    "RowId": 23333,
    "Text": "この星は……我らのもの……！\n決して、手放すものか……！"
  },
  {
    "RowOffset": 477762,
    "RowId": 23334,
    "Text": "塵すら残さず、消え去るがいい……！"
  },
  {
    "RowOffset": 477826,
    "RowId": 23335,
    "Text": "これで終わりだ……なりそこない……！"
  },
  {
    "RowOffset": 477894,
    "RowId": 23336,
    "Text": "その輝きが、世界を……命を分断したッ！"
  },
  {
    "RowOffset": 477962,
    "RowId": 23337,
    "Text": "あの悲劇、繰り返させてなるものかッ！"
  },
  {
    "RowOffset": 478030,
    "RowId": 23338,
    "Text": "戒律王の権能によりて、ふたたび闇を広げん！"
  },
  {
    "RowOffset": 478106,
    "RowId": 23339,
    "Text": "終わりだ、光の化け物よ……。"
  },
  {
    "RowOffset": 478162,
    "RowId": 23340,
    "Text": "お前たちの想いを糧に、真なる世界を再生しよう。"
  },
  {
    "RowOffset": 478242,
    "RowId": 23341,
    "Text": "我が魂に、亀裂を入れるか……化け物め……！"
  },
  {
    "RowOffset": 478318,
    "RowId": 23342,
    "Text": "友の祈りよ、明日への望みよ！\u3000翼とならん！"
  },
  {
    "RowOffset": 478394,
    "RowId": 23343,
    "Text": "所詮は、この程度か……闇に呑まれて消え去るがいい……！"
  },
  {
    "RowOffset": 478486,
    "RowId": 23344,
    "Text": "さらばだ、小さき者たちよ……！"
  },
  {
    "RowOffset": 478542,
    "RowId": 23345,
    "Text": "気高き威厳で、大地を震わせるがいい……！"
  },
  {
    "RowOffset": 478614,
    "RowId": 23346,
    "Text": "決して揺るがぬ信念の炎と、冷徹なる決意の氷で、\n抗う者どもに死をもたらせ……！"
  },
  {
    "RowOffset": 478746,
    "RowId": 23347,
    "Text": "その何者よりも色濃き魂で、薄き魂を侵食せよ……！"
  },
  {
    "RowOffset": 478830,
    "RowId": 23400,
    "Text": "兵棋の間への到達"
  },
  {
    "RowOffset": 478866,
    "RowId": 23401,
    "Text": "兵棋の間の突破"
  },
  {
    "RowOffset": 478898,
    "RowId": 23402,
    "Text": "春の泉への到達"
  },
  {
    "RowOffset": 478930,
    "RowId": 23403,
    "Text": "春の泉の突破"
  },
  {
    "RowOffset": 478962,
    "RowId": 23404,
    "Text": "演奏の間への到達"
  },
  {
    "RowOffset": 478998,
    "RowId": 23405,
    "Text": "我が宮殿に、客を招いた覚えはないぞ！\n立ち去らぬというなら……！"
  },
  {
    "RowOffset": 479106,
    "RowId": 23406,
    "Text": "さあ、ホウキたち……掃除の時間だ……！"
  },
  {
    "RowOffset": 479174,
    "RowId": 23407,
    "Text": "なかなか、やりおるが……次の一手はどうかな？"
  },
  {
    "RowOffset": 479254,
    "RowId": 23408,
    "Text": "やはり、久々の運動は身体に堪えるの……。\nここは一旦、退かせてもらおう。"
  },
  {
    "RowOffset": 479374,
    "RowId": 23409,
    "Text": "汚れを発見、サッサカサー！"
  },
  {
    "RowOffset": 479426,
    "RowId": 23410,
    "Text": "またまた汚れて、サッサカサー！"
  },
  {
    "RowOffset": 479482,
    "RowId": 23411,
    "Text": "あらあら、この庭園に客人だなんて、\nいったい、いつぶりかしら……？"
  },
  {
    "RowOffset": 479594,
    "RowId": 23412,
    "Text": "可愛らしい小さな命……\n私の歌で育ちなさい♪"
  },
  {
    "RowOffset": 479674,
    "RowId": 23413,
    "Text": "働き者の下僕たち……\n私の子らを守りなさい！"
  },
  {
    "RowOffset": 479754,
    "RowId": 23414,
    "Text": "嗚呼……なんてこと……庭園の花が散っていく……。"
  },
  {
    "RowOffset": 479838,
    "RowId": 23415,
    "Text": "行け、ルゴス！\n汚らわしい侵入者を、灰にしてしまうのだ！"
  },
  {
    "RowOffset": 479934,
    "RowId": 23416,
    "Text": "ルゴスが燃やすは必滅の炎……！\n宿主を灰にするまで、決して消えることはない……！"
  },
  {
    "RowOffset": 480066,
    "RowId": 23417,
    "Text": ""
  },
  {
    "RowOffset": 480078,
    "RowId": 23418,
    "Text": "ルゴスの撃破"
  },
  {
    "RowOffset": 480110,
    "RowId": 23419,
    "Text": "出合え……宮殿の守り手たち……！"
  },
  {
    "RowOffset": 480170,
    "RowId": 23420,
    "Text": "動き出せ、不在の騎士よ……！"
  },
  {
    "RowOffset": 480226,
    "RowId": 23421,
    "Text": "冷たき鉄に、仮初の魂を吹き込もう……！"
  },
  {
    "RowOffset": 480294,
    "RowId": 23422,
    "Text": "動き出せ、気高き騎士甲冑よ……！"
  },
  {
    "RowOffset": 480354,
    "RowId": 23423,
    "Text": "我が使い魔よ、無作法な連中の相手を……！"
  },
  {
    "RowOffset": 480426,
    "RowId": 23424,
    "Text": "木々よ、立ち上がれ……！"
  },
  {
    "RowOffset": 480474,
    "RowId": 23425,
    "Text": "美しき花たち、庭園を守るのだ……！"
  },
  {
    "RowOffset": 480538,
    "RowId": 23426,
    "Text": "ええい、しつこい連中だ……！"
  },
  {
    "RowOffset": 480594,
    "RowId": 23427,
    "Text": "エルフの傑作美術も、こうすれば……！"
  },
  {
    "RowOffset": 480662,
    "RowId": 23428,
    "Text": "古のエルフ王と、その守護騎士たち……\n宮殿を侵す者たちが現れたぞ！"
  },
  {
    "RowOffset": 480774,
    "RowId": 23429,
    "Text": "しまった……シャンデリアが……！？"
  },
  {
    "RowOffset": 480838,
    "RowId": 23430,
    "Text": "去れ……！\n命惜しくば、ただちに立ち去るがいい……！"
  },
  {
    "RowOffset": 480930,
    "RowId": 23431,
    "Text": "ホウキたちよ、掃除だけは続けるようにな……！"
  },
  {
    "RowOffset": 481010,
    "RowId": 23432,
    "Text": "力づくというのは不本意ではあるが……\n仕方あるまい……。"
  },
  {
    "RowOffset": 481106,
    "RowId": 23433,
    "Text": "こうなったら、庭園で迎え撃たねば……。"
  },
  {
    "RowOffset": 481174,
    "RowId": 23434,
    "Text": "リャナンシーよ……！\nこの者らを排除するのだ……！"
  },
  {
    "RowOffset": 481262,
    "RowId": 23435,
    "Text": "なんと、手づからに魂を鍛え上げた、\nリャナンシーまで、倒されてしまうとは……！"
  },
  {
    "RowOffset": 481394,
    "RowId": 23436,
    "Text": "使い魔たち、晩餐の準備はいい……\n侵入者の迎撃だ……！"
  },
  {
    "RowOffset": 481490,
    "RowId": 23437,
    "Text": "晩餐の相手は、幻影たちだけで十分だというに……。"
  },
  {
    "RowOffset": 481574,
    "RowId": 23438,
    "Text": "偉大なるレイクランドの初代王よ……！\nふたたび目覚め、侵入者を斬り伏せるのだ……！"
  },
  {
    "RowOffset": 481710,
    "RowId": 23439,
    "Text": "どうせなら、この幻影たちにも、\n戦う力を与えておくべきだったか……？"
  },
  {
    "RowOffset": 481826,
    "RowId": 23440,
    "Text": "絵に描かれし、勇猛なる騎士たちよ……！"
  },
  {
    "RowOffset": 481894,
    "RowId": 23500,
    "Text": "倉庫Aの突破"
  },
  {
    "RowOffset": 481922,
    "RowId": 23501,
    "Text": "倉庫Bの突破"
  },
  {
    "RowOffset": 481950,
    "RowId": 23502,
    "Text": "検品場の突破"
  },
  {
    "RowOffset": 481982,
    "RowId": 23503,
    "Text": "倉庫Cの突破"
  },
  {
    "RowOffset": 482010,
    "RowId": 23504,
    "Text": "前部甲板の突破"
  },
  {
    "RowOffset": 482042,
    "RowId": 23505,
    "Text": "後部甲板の突破"
  },
  {
    "RowOffset": 482074,
    "RowId": 23506,
    "Text": "……な、なんだ？\nこの耳障りな音は？"
  },
  {
    "RowOffset": 482142,
    "RowId": 23507,
    "Text": "警報だ……。\n我々の侵入に敵が感づいたらしい。"
  },
  {
    "RowOffset": 482226,
    "RowId": 23508,
    "Text": "……敵だって？"
  },
  {
    "RowOffset": 482258,
    "RowId": 23509,
    "Text": "機械生命体だ。今にわかる……。"
  },
  {
    "RowOffset": 482314,
    "RowId": 23510,
    "Text": "機械生命体とは、一体何者なのだ？"
  },
  {
    "RowOffset": 482374,
    "RowId": 23511,
    "Text": "あれは、意思を持った機械。\n今は操られて、凶暴化している。"
  },
  {
    "RowOffset": 482474,
    "RowId": 23512,
    "Text": "侵入者発見、排除シーケンスニ移行……。"
  },
  {
    "RowOffset": 482542,
    "RowId": 23513,
    "Text": "敵脅威、多数……攻撃を開始……。"
  },
  {
    "RowOffset": 482602,
    "RowId": 23514,
    "Text": "全機に通達、射撃を開始セヨ……。"
  },
  {
    "RowOffset": 482662,
    "RowId": 23515,
    "Text": "囲まれた！？\n周囲からの射撃に警戒を……！"
  },
  {
    "RowOffset": 482738,
    "RowId": 23516,
    "Text": "全機に通達、狙撃を開始セヨ……。"
  },
  {
    "RowOffset": 482798,
    "RowId": 23517,
    "Text": "敵の攻撃ユニットからエネルギー反応！\n立ち止まると狙い撃ちされるぞ！"
  },
  {
    "RowOffset": 482914,
    "RowId": 23518,
    "Text": "全機に通達、爆撃を開始セヨ……。"
  },
  {
    "RowOffset": 482974,
    "RowId": 23519,
    "Text": "空爆する気か……！\n回避行動に専念するんだ！"
  },
  {
    "RowOffset": 483054,
    "RowId": 23520,
    "Text": "全機に通達、レーザー攻撃を開始セヨ……。"
  },
  {
    "RowOffset": 483126,
    "RowId": 23521,
    "Text": "高エネルギー反応を検知……\n来るぞッ……！"
  },
  {
    "RowOffset": 483202,
    "RowId": 23522,
    "Text": "全機に通達、全力攻撃……全力攻撃……！"
  },
  {
    "RowOffset": 483270,
    "RowId": 23523,
    "Text": "警戒セヨ……警戒セヨ……\n侵入者……防衛網ヲ突破…………"
  },
  {
    "RowOffset": 483366,
    "RowId": 23524,
    "Text": "貴方たちが来てくれて助かった。"
  },
  {
    "RowOffset": 483422,
    "RowId": 23525,
    "Text": "ヨソ者たちを連れてきて、正解だったな。"
  },
  {
    "RowOffset": 483490,
    "RowId": 23526,
    "Text": "私ひとりでは対抗できなかっただろう。\n引き続き支援を頼む……。"
  },
  {
    "RowOffset": 483598,
    "RowId": 23527,
    "Text": "むむむ……足場がないじゃないか！"
  },
  {
    "RowOffset": 483658,
    "RowId": 23528,
    "Text": "そこに転がっている箱型の機械……\n「ポッド」を掴んで！"
  },
  {
    "RowOffset": 483754,
    "RowId": 23529,
    "Text": "この機械にぶら下がるだって？\n大丈夫なのか……？"
  },
  {
    "RowOffset": 483838,
    "RowId": 23530,
    "Text": "小型の機械生命体だが、何を仕掛けてくるか……。\n油断しないで。"
  },
  {
    "RowOffset": 483946,
    "RowId": 23531,
    "Text": "増援を呼んだか……すべて排除するぞ！"
  },
  {
    "RowOffset": 484014,
    "RowId": 23532,
    "Text": "一通り蹴散らしたようだ。\n……先を進むぞ。"
  },
  {
    "RowOffset": 484090,
    "RowId": 23533,
    "Text": "こんな遺跡が、ドヴェルガル山脈の下に眠っていたなんて……。"
  },
  {
    "RowOffset": 484190,
    "RowId": 23534,
    "Text": "機械生命体の生産工場だ。\nここを潰さない限り、その脅威は消えない……。"
  },
  {
    "RowOffset": 484310,
    "RowId": 23535,
    "Text": "こちらから進めそうだ。\n行くぞ……！"
  },
  {
    "RowOffset": 484378,
    "RowId": 23536,
    "Text": "検体の投入を確認シマシタ。コレより、性能評価テストを開始シマス。"
  },
  {
    "RowOffset": 484486,
    "RowId": 23537,
    "Text": "気をつけて。何か……\n嫌な予感がする……"
  },
  {
    "RowOffset": 484558,
    "RowId": 23538,
    "Text": "皆サンノ尊い犠牲ガ、私タチをヨリ強くシマス。"
  },
  {
    "RowOffset": 484638,
    "RowId": 23539,
    "Text": "全方位に敵性反応を確認……\n敵の攻撃に備えて！"
  },
  {
    "RowOffset": 484722,
    "RowId": 23540,
    "Text": "検体レベルを確認\n皆サン、とても素晴ラシイ動きです。"
  },
  {
    "RowOffset": 484814,
    "RowId": 23541,
    "Text": "次のプロセスへ移行。 \n繰り返シ痛メツケ、耐久性を確認シマス。"
  },
  {
    "RowOffset": 484918,
    "RowId": 23542,
    "Text": "壁が動いた……！？ \nまた外壁から仕掛けてくるぞ！"
  },
  {
    "RowOffset": 485006,
    "RowId": 23543,
    "Text": "テスト結果を評価……。\n剛性、柔軟性トモニ、記録を大幅に更新シテイマス。"
  },
  {
    "RowOffset": 485126,
    "RowId": 23544,
    "Text": "プロセスを再実行シマス。 \n判断の妥当性ト反応速度を評価シマス。"
  },
  {
    "RowOffset": 485234,
    "RowId": 23545,
    "Text": "想定を大幅に上回るスコアです。 \n皆サンヲ、イレギュラーな個体と認定シマス。"
  },
  {
    "RowOffset": 485358,
    "RowId": 23546,
    "Text": "私たちを機械生命体と誤認しているのか……？"
  },
  {
    "RowOffset": 485434,
    "RowId": 23547,
    "Text": "異常を検知、スコア偽装の可能性ガアリマス。\nコレハ、重大な規定違反です。"
  },
  {
    "RowOffset": 485554,
    "RowId": 23548,
    "Text": "測定ヲ中止。\n検体廃棄プロセスに移行シマス。"
  },
  {
    "RowOffset": 485634,
    "RowId": 23549,
    "Text": "私たちを排除するつもりだ！敵の破壊を急いで！"
  },
  {
    "RowOffset": 485714,
    "RowId": 23550,
    "Text": "対象の残存を確認。\n廃棄プロセスを再試行シマス。"
  },
  {
    "RowOffset": 485798,
    "RowId": 23551,
    "Text": "規定違反です……規定違反です……。\n廃棄プロセスを、再試行……。"
  },
  {
    "RowOffset": 485906,
    "RowId": 23552,
    "Text": "廃棄処分に失敗。\n警告、警告、直ちに処分を受け入レテクダサイ。"
  },
  {
    "RowOffset": 486014,
    "RowId": 23553,
    "Text": "危険、危険……\n直ちに破壊を受け入レテクダサイ。"
  },
  {
    "RowOffset": 486098,
    "RowId": 23554,
    "Text": "壊レテクださい。壊れてクダサい。壊レテクダサイ。\n壊レろ。壊れロ。壊レロ。"
  },
  {
    "RowOffset": 486222,
    "RowId": 23555,
    "Text": "どうシテ！\u3000どウシて！\u3000ドウして？\u3000ドうしテ？\nドウシテ……ドウシテ……"
  },
  {
    "RowOffset": 486342,
    "RowId": 23556,
    "Text": "壊れ……コワ……コココ……\nコ……コワレ……ワレワレワレ……"
  },
  {
    "RowOffset": 486446,
    "RowId": 23557,
    "Text": "システ……異常ヲ検出……タ。……評価テスト……中断……修復ヲ要求……。"
  },
  {
    "RowOffset": 486562,
    "RowId": 23558,
    "Text": "……中央のハッチから、下に降りられそうだ。\n行くぞ……！"
  },
  {
    "RowOffset": 486658,
    "RowId": 23559,
    "Text": "機械生命体の残骸が……。\nまだ動く機体がいるかもしれない、気を付けて。"
  },
  {
    "RowOffset": 486778,
    "RowId": 23560,
    "Text": ""
  },
  {
    "RowOffset": 486790,
    "RowId": 23561,
    "Text": "機械生命体はどうやって動いているのだろう……？"
  },
  {
    "RowOffset": 486870,
    "RowId": 23562,
    "Text": "機械生命体には、コアとなるパーツがある。\nそれを破壊しない限り、止まることはない。"
  },
  {
    "RowOffset": 487006,
    "RowId": 23563,
    "Text": "見ろ、手前の足場に何かあるぞ！"
  },
  {
    "RowOffset": 487062,
    "RowId": 23564,
    "Text": "飛行ユニットか……\nちょうどいい、アレを使わせてもらおう。"
  },
  {
    "RowOffset": 487162,
    "RowId": 23565,
    "Text": "飛行ユニットが敵にハッキングされた！？\nアレを止めるぞ……！"
  },
  {
    "RowOffset": 487266,
    "RowId": 23566,
    "Text": "よし、飛行ユニットの制御を掌握した。\n先行して敵を排除する……私に続いて……！"
  },
  {
    "RowOffset": 487398,
    "RowId": 23567,
    "Text": "前方に超大型兵器を捕捉……\n警戒を……！"
  },
  {
    "RowOffset": 487470,
    "RowId": 23568,
    "Text": "私ノ名前ハ「エンゲルス」。\n製造番号ハ110―C。"
  },
  {
    "RowOffset": 487550,
    "RowId": 23569,
    "Text": "巨大なアームで攻撃してくるぞ！\n動きの隙を見逃すな……！"
  },
  {
    "RowOffset": 487646,
    "RowId": 23570,
    "Text": "エネルギー充填開始……。"
  },
  {
    "RowOffset": 487694,
    "RowId": 23571,
    "Text": "敵増援を多数確認……\nミサイル全弾発射……数を減らす！"
  },
  {
    "RowOffset": 487790,
    "RowId": 23572,
    "Text": "残った武装で、戦闘を続行する……！"
  },
  {
    "RowOffset": 487854,
    "RowId": 23573,
    "Text": "対象ノ殲滅ヲ、開始スル……。"
  },
  {
    "RowOffset": 487910,
    "RowId": 23574,
    "Text": "対象ノ生存ヲ、確認……。\n攻撃パターン変更……。"
  },
  {
    "RowOffset": 487994,
    "RowId": 23575,
    "Text": "潜行した……！？\n周辺の索敵を開始する……！"
  },
  {
    "RowOffset": 488074,
    "RowId": 23576,
    "Text": "下方に敵性反応……！\nこっちへ来るんだ！"
  },
  {
    "RowOffset": 488146,
    "RowId": 23577,
    "Text": "敵性反応接近！\u3000来るぞ……！"
  },
  {
    "RowOffset": 488202,
    "RowId": 23578,
    "Text": "対象ノ生存ヲ、確認……。\n攻撃パターン変更……。"
  },
  {
    "RowOffset": 488286,
    "RowId": 23579,
    "Text": "拡散焼尽ミサイルスタンバイ……\n回避行動ヲ制限シ、圧殺スル……。"
  },
  {
    "RowOffset": 488394,
    "RowId": 23580,
    "Text": "敵のアームを破壊しろ……急げ！"
  },
  {
    "RowOffset": 488450,
    "RowId": 23581,
    "Text": "追加兵装ノ必要性ヲ確認……\n「マルクス」起動……！"
  },
  {
    "RowOffset": 488538,
    "RowId": 23582,
    "Text": "追加兵装だと……？\n何をするつもりだ……！"
  },
  {
    "RowOffset": 488614,
    "RowId": 23583,
    "Text": "システム領域ニ……深刻ナ損……傷。早急ナ修復……ヲ要請スル……。"
  },
  {
    "RowOffset": 488722,
    "RowId": 23584,
    "Text": "アンドロイドの反応を検知……\n見つけたぞ……！"
  },
  {
    "RowOffset": 488806,
    "RowId": 23585,
    "Text": "あっ、ズルいぞ、飛べるからって……！\nこうなったら、デカブツの体をよじ登るしかないぞ！"
  },
  {
    "RowOffset": 488950,
    "RowId": 23586,
    "Text": "またポッドとかいう機械があったぞ。\nコイツに掴まって、先に進もう！"
  },
  {
    "RowOffset": 489062,
    "RowId": 23587,
    "Text": "抵抗するつもりなら……\n２Ｐもろとも根絶やしにする……！"
  },
  {
    "RowOffset": 489158,
    "RowId": 23588,
    "Text": "９Ｓ……\n貴方を排除する……！"
  },
  {
    "RowOffset": 489218,
    "RowId": 23589,
    "Text": "大型機械生命体を従属化する……！"
  },
  {
    "RowOffset": 489278,
    "RowId": 23590,
    "Text": "ハッキングか……！\n巨大なアームで攻撃してくるぞ！"
  },
  {
    "RowOffset": 489366,
    "RowId": 23591,
    "Text": "敵座標を捕捉！\u3000ミサイル発射！"
  },
  {
    "RowOffset": 489422,
    "RowId": 23592,
    "Text": "大型戦車を従属化する……！"
  },
  {
    "RowOffset": 489474,
    "RowId": 23593,
    "Text": "機械生命体からエネルギー供給を……？\n先にあの戦車を破壊するんだ！！"
  },
  {
    "RowOffset": 489590,
    "RowId": 23594,
    "Text": "クソッ……破損個体の自爆ユニットを起動する！"
  },
  {
    "RowOffset": 489670,
    "RowId": 23595,
    "Text": "爆発するぞ、身を隠すんだ！"
  },
  {
    "RowOffset": 489722,
    "RowId": 23596,
    "Text": "全てを……破壊するッ……！"
  },
  {
    "RowOffset": 489774,
    "RowId": 23597,
    "Text": "ハッキングでミサイルを集めているのか……！"
  },
  {
    "RowOffset": 489850,
    "RowId": 23598,
    "Text": "粉々に砕けちれェェェッ！"
  },
  {
    "RowOffset": 489898,
    "RowId": 23599,
    "Text": "バリアを展開する……！\n急いで私の下へ！"
  },
  {
    "RowOffset": 489970,
    "RowId": 23600,
    "Text": "２Ｐ……絶対にオマエを……殺ス！"
  },
  {
    "RowOffset": 490030,
    "RowId": 23601,
    "Text": "飛行形態に移行するッ！"
  },
  {
    "RowOffset": 490074,
    "RowId": 23602,
    "Text": "飛行ユニットを使うつもりか……\n見失わないように、目視で確認して！"
  },
  {
    "RowOffset": 490186,
    "RowId": 23603,
    "Text": "いくぞッ！"
  },
  {
    "RowOffset": 490214,
    "RowId": 23604,
    "Text": "まだだッ！"
  },
  {
    "RowOffset": 490242,
    "RowId": 23605,
    "Text": "逃さないッ！"
  },
  {
    "RowOffset": 490274,
    "RowId": 23606,
    "Text": "敵機が飛び去った方角から、多数の熱源反応を検知……！\n距離を取るんだ！"
  },
  {
    "RowOffset": 490394,
    "RowId": 23607,
    "Text": "また仕掛けてくるぞ！\n敵機が旋回した方角からの攻撃に備えるんだ！"
  },
  {
    "RowOffset": 490502,
    "RowId": 23608,
    "Text": "機体に一定の衝撃を与えたことで、\nハッキングが一時的に解除されるはずだ！"
  },
  {
    "RowOffset": 490622,
    "RowId": 23609,
    "Text": "この白い粉はなんだろう……。\n空から降ってきている……？"
  },
  {
    "RowOffset": 490718,
    "RowId": 23610,
    "Text": "いや……ここは地下だ、空なんかない。\n何かの粉塵が、この階層全体に舞い上がっているようだな。"
  },
  {
    "RowOffset": 490870,
    "RowId": 23611,
    "Text": "ゲホゲホ……身体に悪いものじゃないといいけど……。"
  },
  {
    "RowOffset": 490958,
    "RowId": 23612,
    "Text": ""
  },
