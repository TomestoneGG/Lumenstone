  {
    "RowOffset": 174346,
    "RowId": 4800,
    "Text": "喚きの立坑の踏破"
  },
  {
    "RowOffset": 174382,
    "RowId": 4801,
    "Text": "嘆きの立坑の踏破"
  },
  {
    "RowOffset": 174418,
    "RowId": 4802,
    "Text": "復讐のウラノスの撃破"
  },
  {
    "RowOffset": 174462,
    "RowId": 4803,
    "Text": "モエロ、モエロ！\nオデのホノオでモエぢまえ～！"
  },
  {
    "RowOffset": 174546,
    "RowId": 4804,
    "Text": "ウガァ……\nオデのホノオが…キエぢまう……"
  },
  {
    "RowOffset": 174622,
    "RowId": 4805,
    "Text": "ウォォ、オレサマ、ビィギー！\nビッグデ、ムキムキ、スプリガァァァン！"
  },
  {
    "RowOffset": 174738,
    "RowId": 4806,
    "Text": "ムキムキ、ハガレテ、コンチクショー！"
  },
  {
    "RowOffset": 174806,
    "RowId": 4807,
    "Text": "マダマダ、タタカウ、コンニャロー！"
  },
  {
    "RowOffset": 174870,
    "RowId": 4808,
    "Text": "ムキムキ、ナクテモ、ココロハ、ビッグ！\nオマエラ、ゼンイン、ミチヅレダー！"
  },
  {
    "RowOffset": 174994,
    "RowId": 4809,
    "Text": "ビィギー、モウダメ、コウサンダ……"
  },
  {
    "RowOffset": 175058,
    "RowId": 4810,
    "Text": "オデのムスゴ、コロしたのオメかァ！？\nフクシュウ、フクシュウ、フクシュウだァ！！！"
  },
  {
    "RowOffset": 175194,
    "RowId": 4811,
    "Text": "ムスゴたちよ……スマヌ……"
  },
  {
    "RowOffset": 175246,
    "RowId": 4812,
    "Text": "オデのカワイイ、イモムシちゅわん！\nジャマなチビども、ツブしちまえェ！！！"
  },
  {
    "RowOffset": 175370,
    "RowId": 4813,
    "Text": ""
  },
  {
    "RowOffset": 175382,
    "RowId": 4814,
    "Text": ""
  },
  {
    "RowOffset": 175394,
    "RowId": 4815,
    "Text": ""
  },
  {
    "RowOffset": 175406,
    "RowId": 4816,
    "Text": ""
  },
  {
    "RowOffset": 175418,
    "RowId": 4817,
    "Text": ""
  },
  {
    "RowOffset": 175430,
    "RowId": 4818,
    "Text": ""
  },
  {
    "RowOffset": 175442,
    "RowId": 4819,
    "Text": ""
  },
  {
    "RowOffset": 175454,
    "RowId": 4820,
    "Text": ""
  },
  {
    "RowOffset": 175466,
    "RowId": 4900,
    "Text": "家臣たちよ、ワルモノを裁くクポーッ！"
  },
  {
    "RowOffset": 175534,
    "RowId": 4901,
    "Text": "家臣たちの忠義を、力に変えるクポーッ！"
  },
  {
    "RowOffset": 175602,
    "RowId": 4902,
    "Text": "メメント・モーグリ！\u3000モグを記憶せよクポーッ！"
  },
  {
    "RowOffset": 175682,
    "RowId": 4903,
    "Text": "家臣たちよ、連携して戦うべしクポーッ！"
  },
  {
    "RowOffset": 175750,
    "RowId": 4904,
    "Text": "家臣団よ、出陣せよクポーッ！"
  },
  {
    "RowOffset": 175806,
    "RowId": 4905,
    "Text": "さあ！\u3000回復してやろうクポ！"
  },
  {
    "RowOffset": 175862,
    "RowId": 4906,
    "Text": "もうひといきクポ！\u3000パワーをメテオに！"
  },
  {
    "RowOffset": 175930,
    "RowId": 5000,
    "Text": "白百合の間の突破"
  },
  {
    "RowOffset": 175966,
    "RowId": 5001,
    "Text": "紅薔薇の間の突破"
  },
  {
    "RowOffset": 176002,
    "RowId": 5002,
    "Text": "ハリカルナッソスの撃破"
  },
  {
    "RowOffset": 176046,
    "RowId": 5003,
    "Text": "我が血肉となる光栄に浴せ！"
  },
  {
    "RowOffset": 176098,
    "RowId": 5004,
    "Text": "魂捧げ、我が糧となれ！"
  },
  {
    "RowOffset": 176142,
    "RowId": 5005,
    "Text": "贄を、もっと贄を……"
  },
  {
    "RowOffset": 176186,
    "RowId": 5006,
    "Text": "魂を捧げるとの誓い……\n今こそ果たしてもらうぞ！"
  },
  {
    "RowOffset": 176270,
    "RowId": 5007,
    "Text": "小さな鍵所持数"
  },
  {
    "RowOffset": 176302,
    "RowId": 5008,
    "Text": ""
  },
  {
    "RowOffset": 176314,
    "RowId": 5009,
    "Text": ""
  },
  {
    "RowOffset": 176326,
    "RowId": 5010,
    "Text": ""
  },
  {
    "RowOffset": 176338,
    "RowId": 5100,
    "Text": "さあ、第一の修練区画だ！\n魔法人形を相手に、小手調べといこうか！"
  },
  {
    "RowOffset": 176446,
    "RowId": 5101,
    "Text": ""
  },
  {
    "RowOffset": 176458,
    "RowId": 5102,
    "Text": "第二の修練区画へ進むがいい！\n猛獣、魔獣が相手になるぞ！"
  },
  {
    "RowOffset": 176554,
    "RowId": 5103,
    "Text": ""
  },
  {
    "RowOffset": 176566,
    "RowId": 5104,
    "Text": "最後の修練区画まで、よく来たな！\nいよいよ、本物の剣闘士たちのお出ましだぞ！"
  },
  {
    "RowOffset": 176694,
    "RowId": 5105,
    "Text": ""
  },
  {
    "RowOffset": 176706,
    "RowId": 5106,
    "Text": "マメットを討伐"
  },
  {
    "RowOffset": 176738,
    "RowId": 5107,
    "Text": "ピュラクモンの撃破"
  },
  {
    "RowOffset": 176778,
    "RowId": 5108,
    "Text": "魔獣を討伐"
  },
  {
    "RowOffset": 176806,
    "RowId": 5109,
    "Text": "カトブレパスの撃破"
  },
  {
    "RowOffset": 176846,
    "RowId": 5110,
    "Text": "剣闘士を討伐"
  },
  {
    "RowOffset": 176878,
    "RowId": 5111,
    "Text": "すべての敵の撃破"
  },
  {
    "RowOffset": 176914,
    "RowId": 5112,
    "Text": "さて、最後は集団戦の訓練と洒落込もうじゃないか！"
  },
  {
    "RowOffset": 176998,
    "RowId": 5113,
    "Text": "ほほ～う、一流の剣闘士たちを退けるとは～。\n大導師ムムエポと、我がシモベがお相手しましょう～！"
  },
  {
    "RowOffset": 177154,
    "RowId": 5114,
    "Text": "アルダネス聖櫃堂に伝わる古代魔法！\nこの呪縛には～手も足もでないでしょう～？"
  },
  {
    "RowOffset": 177282,
    "RowId": 5115,
    "Text": "……なんとっ！？\n完全呪縛に、抗ったというのですか～？"
  },
  {
    "RowOffset": 177378,
    "RowId": 5116,
    "Text": "さあ～逃げまどいなさ～い！\n我が魔力を束ねし～呪いの雷から～！"
  },
  {
    "RowOffset": 177486,
    "RowId": 5117,
    "Text": ""
  },
  {
    "RowOffset": 177498,
    "RowId": 5118,
    "Text": ""
  },
  {
    "RowOffset": 177510,
    "RowId": 5119,
    "Text": ""
  },
  {
    "RowOffset": 177522,
    "RowId": 5120,
    "Text": ""
  },
  {
    "RowOffset": 177534,
    "RowId": 5200,
    "Text": "我が海域を侵すか、光に穢れし者よ！"
  },
  {
    "RowOffset": 177598,
    "RowId": 5201,
    "Text": "清浄なる青き水を以て、穢れ清めん！"
  },
  {
    "RowOffset": 177662,
    "RowId": 5202,
    "Text": "我が水の力……\n全てを押し流し、全てを浄化する力！"
  },
  {
    "RowOffset": 177750,
    "RowId": 5203,
    "Text": "ぬぅ、小細工を弄したか……\nなれば真なる力を解き放つのみ！"
  },
  {
    "RowOffset": 177850,
    "RowId": 5204,
    "Text": "これが光の加護……\n我が力を水泡に帰すとは……"
  },
  {
    "RowOffset": 177934,
    "RowId": 5205,
    "Text": "属性変換エーテル"
  },
  {
    "RowOffset": 177970,
    "RowId": 5206,
    "Text": "我が水の力にて、押し流してくれようぞ！"
  },
  {
    "RowOffset": 178038,
    "RowId": 5207,
    "Text": "ぬぅ、小細工を弄したか……"
  },
  {
    "RowOffset": 178090,
    "RowId": 5208,
    "Text": ""
  },
  {
    "RowOffset": 178102,
    "RowId": 5209,
    "Text": ""
  },
  {
    "RowOffset": 178114,
    "RowId": 5210,
    "Text": ""
  },
  {
    "RowOffset": 178126,
    "RowId": 5300,
    "Text": "「避難地の前庭」への進路確保"
  },
  {
    "RowOffset": 178182,
    "RowId": 5301,
    "Text": "小さな鍵所持数"
  },
  {
    "RowOffset": 178214,
    "RowId": 5302,
    "Text": "囚われのゴブリンの解放"
  },
  {
    "RowOffset": 178258,
    "RowId": 5303,
    "Text": "「ブレイフロクスの芥場」への進路確保"
  },
  {
    "RowOffset": 178326,
    "RowId": 5304,
    "Text": "「野営地」の関門の突破"
  },
  {
    "RowOffset": 178370,
    "RowId": 5305,
    "Text": "チーズレシピは\u3000門外不出！\n我は\u3000秘密の守護者なり～！！"
  },
  {
    "RowOffset": 178466,
    "RowId": 5306,
    "Text": "シュコォ、シュコォ……\n邪魔する者は\u3000抹殺だ～！！"
  },
  {
    "RowOffset": 178554,
    "RowId": 5307,
    "Text": "シュコォ、シュコォ……\n目標発見\u3000作戦開始\u3000ブレイフロクス捕まえろ～！"
  },
  {
    "RowOffset": 178674,
    "RowId": 5308,
    "Text": "青の手\u3000科学は\u3000世界イチ～！\nゴブリガードで\u3000蹴散らすど～！！"
  },
  {
    "RowOffset": 178782,
    "RowId": 5309,
    "Text": ""
  },
  {
    "RowOffset": 178794,
    "RowId": 5310,
    "Text": ""
  },
  {
    "RowOffset": 178806,
    "RowId": 5400,
    "Text": "平和の残滓の突破"
  },
  {
    "RowOffset": 178842,
    "RowId": 5401,
    "Text": "白魔道士の塔の突破"
  },
  {
    "RowOffset": 178882,
    "RowId": 5402,
    "Text": "ディアボロスの撃破"
  },
  {
    "RowOffset": 178922,
    "RowId": 5403,
    "Text": "我の眠りをさまたげる者は、誰だ？\nアムダプールの魔道士ども……いや、違うな？"
  },
  {
    "RowOffset": 179050,
    "RowId": 5404,
    "Text": "夜の闇束ね、我が盾と成さん……\n我を阻むこと叶わぬと知れ！"
  },
  {
    "RowOffset": 179150,
    "RowId": 5405,
    "Text": "暗き闇紡ぎて、死を知らせる弔鐘と成せ！\nルイナスオーメン！"
  },
  {
    "RowOffset": 179250,
    "RowId": 5406,
    "Text": "長き眠りで、我が力も衰えたか……"
  },
  {
    "RowOffset": 179310,
    "RowId": 5407,
    "Text": ""
  },
  {
    "RowOffset": 179322,
    "RowId": 5408,
    "Text": ""
  },
  {
    "RowOffset": 179334,
    "RowId": 5409,
    "Text": ""
  },
  {
    "RowOffset": 179346,
    "RowId": 5410,
    "Text": ""
  },
  {
    "RowOffset": 179358,
    "RowId": 5501,
    "Text": "来たな冒険者、お前に勝って武器をいただくぜ！\nゆくぞ、エンキドゥ！\u3000我が心の友よ！"
  },
  {
    "RowOffset": 179494,
    "RowId": 5502,
    "Text": "オレが悪かった……。"
  },
  {
    "RowOffset": 179538,
    "RowId": 5503,
    "Text": "8人でこられちゃ……。"
  },
  {
    "RowOffset": 179582,
    "RowId": 5504,
    "Text": "手も足もでないぜ……。"
  },
  {
    "RowOffset": 179626,
    "RowId": 5505,
    "Text": "……てのは、ウソだけどな！！"
  },
  {
    "RowOffset": 179682,
    "RowId": 5506,
    "Text": "こいつを食らえっ！\nうおおおっ！\u3000メガフレアっ！！"
  },
  {
    "RowOffset": 179770,
    "RowId": 5507,
    "Text": "……ありゃ？\u3000メガフレアが出ない？\n最強の槍じゃないのかー！"
  },
  {
    "RowOffset": 179874,
    "RowId": 5508,
    "Text": "急用を思いだしたぜ！！\n必ず戻って来るからなっ！"
  },
  {
    "RowOffset": 179958,
    "RowId": 5509,
    "Text": "行け、エンキドゥ！\n大好物の蛙だぞ！"
  },
  {
    "RowOffset": 180026,
    "RowId": 5510,
    "Text": "も、もういいだろ！\nお前らしつこすぎだぞ！"
  },
  {
    "RowOffset": 180102,
    "RowId": 5511,
    "Text": "……上等だぜ。\nこのギルガメッシュ様を倒せるかな？"
  },
  {
    "RowOffset": 180190,
    "RowId": 5512,
    "Text": "しぶといヤツらだぜ……。"
  },
  {
    "RowOffset": 180238,
    "RowId": 5513,
    "Text": "これなるはエオルゼアいちの強者……\nその名も、剣豪ギルガメッシュ！"
  },
  {
