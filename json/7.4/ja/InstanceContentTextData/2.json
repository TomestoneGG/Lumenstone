  },
  {
    "RowOffset": 181490,
    "RowId": 6100,
    "Text": "ゴリニチの撃破"
  },
  {
    "RowOffset": 181522,
    "RowId": 6101,
    "Text": "クカフェラの撃破"
  },
  {
    "RowOffset": 181558,
    "RowId": 6102,
    "Text": "主格納庫の鍵を入手"
  },
  {
    "RowOffset": 181598,
    "RowId": 6103,
    "Text": "ギルヴェガノスの撃破"
  },
  {
    "RowOffset": 181642,
    "RowId": 6104,
    "Text": "ヤツは我らが抑える！\n対竜カノン砲で援護してくれ！"
  },
  {
    "RowOffset": 181730,
    "RowId": 6105,
    "Text": "クソッ！\u3000防御を固めたか！\nうかつに砲撃するんじゃないぞ！"
  },
  {
    "RowOffset": 181830,
    "RowId": 6106,
    "Text": "……ぜ、全滅だと！？\n奪還作戦は……失敗だ……"
  },
  {
    "RowOffset": 181914,
    "RowId": 6107,
    "Text": ""
  },
  {
    "RowOffset": 181926,
    "RowId": 6108,
    "Text": ""
  },
  {
    "RowOffset": 181938,
    "RowId": 6109,
    "Text": ""
  },
  {
    "RowOffset": 181950,
    "RowId": 6110,
    "Text": ""
  },
  {
    "RowOffset": 181962,
    "RowId": 6200,
    "Text": "来たか、光の者よ……\n貴様の力、測らせてもらおうぞ！"
  },
  {
    "RowOffset": 182054,
    "RowId": 6201,
    "Text": "これより裁きを下す……心せよ！"
  },
  {
    "RowOffset": 182110,
    "RowId": 6202,
    "Text": "ファファファ、久方ぶりの戦い……\n我が技もさえてきよったわ！"
  },
  {
    "RowOffset": 182214,
    "RowId": 6203,
    "Text": "審判の時は近い……\n集え、裁断者たちよ！"
  },
  {
    "RowOffset": 182286,
    "RowId": 6204,
    "Text": "お主、一体……？\nこれがヒトの可能性なのか……。"
  },
  {
    "RowOffset": 182370,
    "RowId": 6205,
    "Text": "輝ける古の知に照らし、\n我、汝に厳正なる審判を降さん！"
  },
  {
    "RowOffset": 182466,
    "RowId": 6300,
    "Text": "至天の階段の踏破"
  },
  {
    "RowOffset": 182502,
    "RowId": 6301,
    "Text": "妖艶のスキュラの撃破"
  },
  {
    "RowOffset": 182546,
    "RowId": 6302,
    "Text": "螺旋回廊の踏破"
  },
  {
    "RowOffset": 182578,
    "RowId": 6303,
    "Text": "不壊のガーディアンの撃破"
  },
  {
    "RowOffset": 182626,
    "RowId": 6304,
    "Text": "黄金回廊の踏破"
  },
  {
    "RowOffset": 182658,
    "RowId": 6305,
    "Text": "異才のアモンの撃破"
  },
  {
    "RowOffset": 182698,
    "RowId": 6306,
    "Text": "始皇帝ザンデの撃破"
  },
  {
    "RowOffset": 182738,
    "RowId": 6307,
    "Text": "ガーディアン：エネルギー充填率"
  },
  {
    "RowOffset": 182794,
    "RowId": 6308,
    "Text": "グルルルルル……犬が……\n犬どもが求めておるぞ、貴様らの肉を！"
  },
  {
    "RowOffset": 182902,
    "RowId": 6309,
    "Text": "おぞましい……妾の姿を、そう思ったな？\n許さぬ、許さぬ、許さぬぞォォォ！"
  },
  {
    "RowOffset": 183022,
    "RowId": 6310,
    "Text": "おのれ、おのれ、おのれェェェ！\n貴様らも、妾をあざ笑うのかァァァ！"
  },
  {
    "RowOffset": 183134,
    "RowId": 6311,
    "Text": "吠えろ犬ども！\n無礼な輩を燃やしつくせェェェ！"
  },
  {
    "RowOffset": 183218,
    "RowId": 6312,
    "Text": "あぁ……犬どもの声が……消えてゆく……\nこれで、ようやく……眠れ……。"
  },
  {
    "RowOffset": 183338,
    "RowId": 6313,
    "Text": "我は帝国の守護者。\nこれより先、一歩たりとも進ませんぞ！"
  },
  {
    "RowOffset": 183434,
    "RowId": 6314,
    "Text": "支援機構始動……\nエネルギー充填開始！"
  },
  {
    "RowOffset": 183506,
    "RowId": 6315,
    "Text": "陛下に仇なす愚民ども！\nその愚かさを身を以て思い知れ！"
  },
  {
    "RowOffset": 183602,
    "RowId": 6316,
    "Text": "充填率100％……\n消えよ、陛下に仇なす愚民ども！"
  },
  {
    "RowOffset": 183686,
    "RowId": 6317,
    "Text": "防御装置起動！\n不壊たるゆえんを見せてくれる！"
  },
  {
    "RowOffset": 183770,
    "RowId": 6318,
    "Text": "み、見事なり……\n我が守りを、打ち崩すとは……。"
  },
  {
    "RowOffset": 183854,
    "RowId": 6319,
    "Text": "おやおや、随分と無粋な客ですネ……\nせめて、華々しくお散りなサイ！"
  },
  {
    "RowOffset": 183966,
    "RowId": 6320,
    "Text": "もう余興は十分でショウ……\nそろそろ、幕引きとさせていただきますヨ！"
  },
  {
    "RowOffset": 184082,
    "RowId": 6321,
    "Text": "ま、まさか、このワタシが……\n陛下……こ奴らは、危険……ですゾ……。"
  },
  {
    "RowOffset": 184198,
    "RowId": 6322,
    "Text": "ザンデ／戦闘開始時※未使用"
  },
  {
    "RowOffset": 184250,
    "RowId": 6323,
    "Text": "力を……闇の力を感じるぞ……\nさあ、星すら統べる我が魔力を見よ！"
  },
  {
    "RowOffset": 184358,
    "RowId": 6324,
    "Text": "ファファファ……我が覇道を阻まんとする者よ。\n暗き星に、押しつぶされるがいい！"
  },
  {
    "RowOffset": 184490,
    "RowId": 6325,
    "Text": "グフッ……私を倒しても……無駄だ……\n全ては、闇に……包まれるのだ……。"
  },
  {
    "RowOffset": 184610,
    "RowId": 6326,
    "Text": ""
  },
  {
    "RowOffset": 184622,
    "RowId": 6327,
    "Text": ""
  },
  {
    "RowOffset": 184634,
    "RowId": 6328,
    "Text": ""
  },
  {
    "RowOffset": 184646,
    "RowId": 6329,
    "Text": ""
  },
  {
    "RowOffset": 184658,
    "RowId": 6330,
    "Text": ""
  },
  {
    "RowOffset": 184670,
    "RowId": 6400,
    "Text": "壺室の踏破"
  },
  {
    "RowOffset": 184698,
    "RowId": 6401,
    "Text": "絶対王ガルヴァンスの墓の踏破"
  },
  {
    "RowOffset": 184754,
    "RowId": 6402,
    "Text": "幽寂の円環の踏破"
  },
  {
    "RowOffset": 184790,
    "RowId": 6403,
    "Text": "だから、あたしは……嫌いだったのよ……\nキモチ悪い……やつ……。"
  },
  {
    "RowOffset": 184898,
    "RowId": 6404,
    "Text": "み、身動きがとれない！\n誰か……誰か、助けてくれぇ！"
  },
  {
    "RowOffset": 184990,
    "RowId": 6405,
    "Text": "はぁ、はぁ、はぁ……。\nた、助かった……恩に着るぜ……。"
  },
  {
    "RowOffset": 185086,
    "RowId": 6406,
    "Text": "な、なんで俺が、こんな目に……。\nアイツに関わるのは、もう懲り懲りだ……。"
  },
  {
    "RowOffset": 185210,
    "RowId": 6407,
    "Text": "ふふふ……わたしたちの結婚式にようこそ……\nあなた、あの冒険者が来てくれたわよ？"
  },
  {
    "RowOffset": 185342,
    "RowId": 6408,
    "Text": "立会人さん、どこなの？\nもう式は始まっているわ、来てちょうだい！"
  },
  {
    "RowOffset": 185450,
    "RowId": 6409,
    "Text": "わかってる、わかってるわ……\n新しい身体が欲しいよね？"
  },
  {
    "RowOffset": 185546,
    "RowId": 6410,
    "Text": "病める時も、健やかなる時も……\nわたしたちは、ずっと一緒……永遠に……。"
  },
  {
    "RowOffset": 185666,
    "RowId": 6411,
    "Text": "だから、させない……\n邪魔はさせないわ！"
  },
  {
    "RowOffset": 185738,
    "RowId": 6412,
    "Text": "感じるわ、愛を感じるわ！\nアヴィールの愛をぉぉぉぉぉぉ！"
  },
  {
    "RowOffset": 185834,
    "RowId": 6413,
    "Text": "あぁ、行かないで、アヴィール……\nわたしを、ひとりぼっちにしないで……。"
  },
  {
    "RowOffset": 185954,
    "RowId": 6414,
    "Text": "キシャァァァァァ！！！"
  },
  {
    "RowOffset": 185998,
    "RowId": 6415,
    "Text": ""
  },
  {
    "RowOffset": 186010,
    "RowId": 6416,
    "Text": ""
  },
  {
    "RowOffset": 186022,
    "RowId": 6417,
    "Text": ""
  },
  {
    "RowOffset": 186034,
    "RowId": 6418,
    "Text": ""
  },
  {
    "RowOffset": 186046,
    "RowId": 6419,
    "Text": ""
  },
  {
    "RowOffset": 186058,
    "RowId": 6420,
    "Text": ""
  },
  {
    "RowOffset": 186070,
    "RowId": 6500,
    "Text": "太陽石を入手する"
  },
  {
    "RowOffset": 186106,
    "RowId": 6501,
    "Text": "ダメージド・アーゼマジャッジの撃破"
  },
  {
    "RowOffset": 186170,
    "RowId": 6502,
    "Text": "月光石を入手する"
  },
  {
    "RowOffset": 186206,
    "RowId": 6503,
    "Text": "サボテンダー・エンペラトリスの撃破"
  },
  {
    "RowOffset": 186270,
    "RowId": 6504,
    "Text": "大星石を入手する"
  },
  {
    "RowOffset": 186306,
    "RowId": 6505,
    "Text": "魔法仕掛けの謎を解く"
  },
  {
    "RowOffset": 186350,
    "RowId": 6506,
    "Text": "アーゼマヴァイスジェレントの撃破"
  },
  {
    "RowOffset": 186410,
    "RowId": 6507,
    "Text": "グゴゴゴゴゴ……"
  },
  {
    "RowOffset": 186446,
    "RowId": 6508,
    "Text": ""
  },
  {
    "RowOffset": 186458,
    "RowId": 6509,
    "Text": ""
  },
  {
    "RowOffset": 186470,
    "RowId": 6510,
    "Text": ""
  },
  {
    "RowOffset": 186482,
    "RowId": 6600,
    "Text": "カーラボスの撃破"
  },
  {
    "RowOffset": 186518,
    "RowId": 6601,
    "Text": "潮の抜け道の突破"
  },
  {
    "RowOffset": 186554,
    "RowId": 6602,
    "Text": "マディソン元船長の撃破"
  },
  {
    "RowOffset": 186598,
    "RowId": 6603,
    "Text": "ヘールスティム副長の撃破"
  },
  {
    "RowOffset": 186646,
    "RowId": 6604,
    "Text": "クラーケンの撃破"
  },
  {
    "RowOffset": 186682,
    "RowId": 6605,
    "Text": "船員どもめ、不甲斐ない奴らだ！\n水神様から授かったこの力で、粉砕してくれる！"
  },
  {
    "RowOffset": 186810,
    "RowId": 6606,
    "Text": "おい、オメェら、シャキっとしねぇか！"
  },
  {
    "RowOffset": 186878,
    "RowId": 6607,
    "Text": "オメェらも、はやく戦いやがれ！"
  },
  {
    "RowOffset": 186934,
    "RowId": 6608,
    "Text": "くそぉぉぉ、腑抜けちまいやがって、\n海賊根性を見せてみろやぁぁぁ！"
  },
  {
    "RowOffset": 187046,
    "RowId": 6609,
    "Text": "せ、船長……すんませ……ゲフッ……"
  },
  {
    "RowOffset": 187110,
    "RowId": 6610,
    "Text": "お、お前は、いつぞやの冒険者！？\nこんな姿になったのは、お前のせいなんだぞ！"
  },
  {
    "RowOffset": 187238,
    "RowId": 6611,
    "Text": "はやく手を貸すんだ、野郎ども！\nまた水神様のお仕置きを受けたくないだろ！"
  },
  {
    "RowOffset": 187358,
    "RowId": 6612,
    "Text": "また負ける訳には、いかねぇんだよ！"
  },
  {
    "RowOffset": 187422,
    "RowId": 6613,
    "Text": "イタ、イタタタタ……\nこれまた洒落にならんぞ！"
  },
  {
    "RowOffset": 187506,
    "RowId": 6614,
    "Text": "やべぇ、本当にやべぇ……\n野郎ども、後はまかせたぜ！？"
  },
  {
    "RowOffset": 187602,
    "RowId": 6615,
    "Text": "またまた大事な用を、\n思い出しちまったぜッ！"
  },
  {
    "RowOffset": 187682,
    "RowId": 6616,
    "Text": "こ、こっちにくるんじゃねぇ！\u3000離れやがれッ……！"
  },
  {
    "RowOffset": 187766,
    "RowId": 6617,
    "Text": "イタタタ……クソッ、狙いが外れた！？\u3000やってくれるぜ！"
  },
  {
    "RowOffset": 187858,
    "RowId": 6700,
    "Text": "トンベリの救出"
  },
  {
    "RowOffset": 187890,
    "RowId": 6701,
    "Text": "角折のコヘージャの撃破"
  },
  {
    "RowOffset": 187934,
    "RowId": 6702,
    "Text": "防衛線の突破"
  },
  {
    "RowOffset": 187966,
    "RowId": 6703,
    "Text": "濡肌のゾルージャの撃破"
  },
  {
    "RowOffset": 188010,
    "RowId": 6704,
    "Text": "囚われのトンベリの解放"
  },
  {
    "RowOffset": 188054,
