  },
  {
    "RowOffset": 181234,
    "RowId": 6001,
    "Text": "サスカッチの撃破"
  },
  {
    "RowOffset": 181270,
    "RowId": 6002,
    "Text": "謎めいた石板の収集"
  },
  {
    "RowOffset": 181310,
    "RowId": 6003,
    "Text": "ショールムの撃破"
  },
  {
    "RowOffset": 181346,
    "RowId": 6004,
    "Text": "間欠泉の突破"
  },
  {
    "RowOffset": 181378,
    "RowId": 6005,
    "Text": "クラーケンの腕と触腕の撃破"
  },
  {
    "RowOffset": 181430,
