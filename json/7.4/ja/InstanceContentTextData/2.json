  },
  {
    "RowOffset": 194274,
    "RowId": 7702,
    "Text": "ビブリオタフの撃破"
  },
  {
    "RowOffset": 194314,
    "RowId": 7703,
    "Text": "うごごご！\u3000ここまでか……\nだが、我が主の封印は、地下深くで解かれるのだ！"
  },
  {
    "RowOffset": 194438,
    "RowId": 7704,
    "Text": "油が回って……\nうごごご！\u3000小癪な奴らめ！"
  },
  {
    "RowOffset": 194514,
    "RowId": 7705,
    "Text": ""
  },
  {
    "RowOffset": 194526,
