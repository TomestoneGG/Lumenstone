  },
  {
    "RowOffset": 960274,
    "RowId": 40800,
    "Text": "グ、ギィヤアアアア！"
  },
  {
    "RowOffset": 960318,
    "RowId": 40801,
    "Text": "氷漬けになるがいい……！"
  },
  {
    "RowOffset": 960366,
    "RowId": 40802,
    "Text": "プギャァアア！"
  },
  {
    "RowOffset": 960398,
    "RowId": 40803,
    "Text": "グゥ、ググガアア……！"
  },
  {
    "RowOffset": 960442,
    "RowId": 40804,
    "Text": "ギイィィィ！\u3000ギイィィィ！"
  },
  {
    "RowOffset": 960494,
    "RowId": 40805,
    "Text": "グギャ、ギャア……！"
  },
  {
    "RowOffset": 960538,
    "RowId": 40806,
    "Text": "ピギィヤアアアアアアアアア！"
  },
  {
    "RowOffset": 960594,
    "RowId": 40807,
    "Text": "ピィギィィ！"
  },
  {
    "RowOffset": 960626,
    "RowId": 40808,
    "Text": "フグゥゥ……！"
  },
  {
    "RowOffset": 960658,
    "RowId": 40809,
    "Text": "グゥゥギャア！"
  },
  {
    "RowOffset": 960690,
    "RowId": 40810,
    "Text": "ギギ……ギィ！"
  },
  {
    "RowOffset": 960722,
    "RowId": 40811,
    "Text": "ギ、ギャガァァァ！"
  },
  {
    "RowOffset": 960762,
    "RowId": 40812,
    "Text": "フグゥゥ……フゥ、ギャア……！"
  },
