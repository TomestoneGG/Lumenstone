  },
  {
    "RowOffset": 957026,
    "RowId": 40698,
    "Text": ""
  },
  {
    "RowOffset": 957038,
    "RowId": 40699,
    "Text": ""
  },
  {
    "RowOffset": 957050,
    "RowId": 40700,
    "Text": "強烈な一撃！\nこれは効いたかァ～！？"
  },
  {
    "RowOffset": 957118,
    "RowId": 40701,
    "Text": "得意技を喰らったァ！\nしかし、なんとか耐えている！"
  },
  {
    "RowOffset": 957206,
    "RowId": 40702,
    "Text": "華麗に攻撃をかわしたァ！"
  },
  {
    "RowOffset": 957254,
    "RowId": 40703,
    "Text": "見事に攻撃を見切っているぞ！？"
  },
  {
    "RowOffset": 957310,
    "RowId": 40704,
    "Text": "お～っと！\n挑戦者、ここでダウ～ン！"
  },
  {
    "RowOffset": 957378,
    "RowId": 40705,
    "Text": "挑戦者がダウン！\n立ち上がれるかァ～！？"
  },
  {
    "RowOffset": 957450,
    "RowId": 40706,
    "Text": "挑戦者、なんとか立ち上がったァ～！"
  },
  {
    "RowOffset": 957514,
    "RowId": 40707,
    "Text": "立ち上がったァ！\nだが、挑戦者はピンチ！"
  },
  {
    "RowOffset": 957586,
    "RowId": 40708,
    "Text": "必殺技が炸裂！渾身の一撃だァ～！"
  },
  {
    "RowOffset": 957646,
    "RowId": 40709,
    "Text": "治癒魔法が発動！\n起死回生なるかァ～！？"
  },
  {
    "RowOffset": 957718,
    "RowId": 40710,
    "Text": "ここで守りを固める！\n鉄壁の防御だァ～！"
  },
  {
    "RowOffset": 957790,
    "RowId": 40711,
    "Text": "なんと、挑戦者がリングアウトだァ～！"
  },
  {
    "RowOffset": 957858,
    "RowId": 40712,
    "Text": "実況はメテムでお送りしました！"
  },
  {
    "RowOffset": 957914,
    "RowId": 40713,
    "Text": "まともに喰らった！\nこのまま立っていられるかァ～？"
  },
  {
    "RowOffset": 958002,
    "RowId": 40714,
    "Text": "おっと！\n挑戦者、大丈夫かァ～？"
  },
  {
    "RowOffset": 958062,
    "RowId": 40715,
    "Text": "これは、かわせなかったァ～！"
  },
  {
    "RowOffset": 958118,
    "RowId": 40716,
    "Text": "痛手を負ったがァ～\nまだまだ倒れない！"
  },
  {
    "RowOffset": 958190,
    "RowId": 40717,
    "Text": "余裕で攻撃をかわしたァ！"
  },
  {
    "RowOffset": 958238,
    "RowId": 40718,
    "Text": "アメージング！\n得意技を見切ったァ～！"
  },
  {
    "RowOffset": 958310,
    "RowId": 40719,
    "Text": "落ち着いて攻撃を避けているぞ！"
  },
  {
    "RowOffset": 958366,
    "RowId": 40720,
    "Text": "素晴らしい動き！\nすべてを見通している！？"
  },
  {
    "RowOffset": 958442,
    "RowId": 40721,
    "Text": "オー・マイ・ガッシュ！\n挑戦者が倒れたァ～！"
  },
  {
    "RowOffset": 958522,
    "RowId": 40722,
    "Text": "挑戦者、ダウン！\nさァ、立ち上がれるかァ～！？"
  },
  {
    "RowOffset": 958606,
    "RowId": 40723,
    "Text": "挑戦者、復活！\n巻き返せるかァ～！？"
  },
  {
    "RowOffset": 958674,
    "RowId": 40724,
    "Text": "立ち上がったぞォ！\nだが、油断はできない！"
  },
  {
    "RowOffset": 958750,
    "RowId": 40725,
    "Text": "これは痛い！\nどうした、挑戦者ァ～？"
  },
  {
    "RowOffset": 958818,
    "RowId": 40726,
    "Text": "避け切れなかったァ～！"
  },
  {
    "RowOffset": 958862,
    "RowId": 40727,
    "Text": "喰らった！\n油断は禁物だァ～！"
  },
  {
    "RowOffset": 958922,
    "RowId": 40728,
    "Text": "挑戦者に直撃！\nだが、倒れることはない！"
  },
  {
    "RowOffset": 958994,
    "RowId": 40729,
    "Text": "挑戦者、さすがの動きだァ！"
  },
  {
    "RowOffset": 959046,
    "RowId": 40730,
    "Text": "アンビリーバボー！\n巧みに回避したァ～！"
  },
  {
    "RowOffset": 959118,
    "RowId": 40731,
    "Text": "冷静に対処しているぞォ～！"
  },
  {
    "RowOffset": 959170,
    "RowId": 40732,
    "Text": "挑戦者、\n攻撃を当てさせません！"
  },
  {
    "RowOffset": 959230,
    "RowId": 40733,
    "Text": "お～っと！\n挑戦者が倒れてしまったァ！"
  },
  {
    "RowOffset": 959302,
    "RowId": 40734,
    "Text": "ここでダウン！\nさあ、復活できるかァ～？"
  },
  {
    "RowOffset": 959374,
    "RowId": 40735,
    "Text": "立ち上がったぞォ！\n挑戦者は諦めない！"
  },
  {
    "RowOffset": 959446,
    "RowId": 40736,
    "Text": "戦線復帰！\nここから挽回なるかァ～！？"
  },
