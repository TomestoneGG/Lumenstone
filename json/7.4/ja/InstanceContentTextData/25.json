  },
  {
    "RowOffset": 865606,
    "RowId": 37997,
    "Text": ""
  },
  {
    "RowOffset": 865618,
    "RowId": 37998,
    "Text": ""
  },
  {
    "RowOffset": 865630,
    "RowId": 37999,
    "Text": ""
  },
  {
    "RowOffset": 865642,
    "RowId": 38000,
    "Text": "闇に沈みて幾星霜……ついに時が満ちた……！"
  },
  {
    "RowOffset": 865718,
    "RowId": 38001,
    "Text": "月に淀みし、すべての闇よ……。"
  },
  {
    "RowOffset": 865774,
    "RowId": 38002,
    "Text": "集いて爆ぜよ……！"
  },
  {
    "RowOffset": 865814,
    "RowId": 38003,
    "Text": "完全なる闇は、あらゆる光を逃がさない……。"
  },
  {
    "RowOffset": 865890,
    "RowId": 38004,
    "Text": "希望なき世界を知りなさい……！"
  },
  {
    "RowOffset": 865946,
    "RowId": 38005,
    "Text": "私の爪は、次元すら切り裂く……！"
  },
  {
    "RowOffset": 866006,
    "RowId": 38006,
    "Text": "遠くへ……もっと遠くへ……！"
  },
  {
    "RowOffset": 866062,
    "RowId": 38007,
    "Text": "あの壁の向こうに、帰るべき世界が……！"
  },
  {
    "RowOffset": 866130,
    "RowId": 38008,
    "Text": "ここはどこ……私は、なぜこんなところに……。"
  },
  {
    "RowOffset": 866210,
    "RowId": 38009,
    "Text": "どうして邪魔をするの……？"
  },
  {
    "RowOffset": 866262,
    "RowId": 38010,
    "Text": "私は、帰りたいだけなのに……！"
  },
  {
    "RowOffset": 866318,
    "RowId": 38011,
    "Text": "瞳に残りしは、月に寄り添う綺羅星……。"
  },
  {
    "RowOffset": 866386,
    "RowId": 38012,
    "Text": "ともに夜空に輝かん……！"
  },
  {
    "RowOffset": 866434,
    "RowId": 38013,
    "Text": "果たしましょう、私の願い……誰かの願い……。"
  },
  {
    "RowOffset": 866514,
    "RowId": 38014,
    "Text": "命の巡りに還るときが来た……。"
  },
  {
    "RowOffset": 866570,
    "RowId": 38015,
    "Text": "この力で、すべてを救済する！"
  },
  {
    "RowOffset": 866626,
    "RowId": 38016,
    "Text": "どうして！？\n私の願いが間違っているとでも言うの……？"
  },
  {
    "RowOffset": 866722,
    "RowId": 38017,
    "Text": "邪魔をするならば、溶けよ……！"
  },
  {
    "RowOffset": 866778,
    "RowId": 38018,
    "Text": "目障りな光、散りなさい……！"
  },
  {
    "RowOffset": 866834,
    "RowId": 38019,
    "Text": "この世界では、誰も救ってはくれない。"
  },
  {
    "RowOffset": 866902,
    "RowId": 38020,
    "Text": "光り輝くあたたかな場所へ、今……！"
  },
  {
    "RowOffset": 866966,
    "RowId": 38021,
    "Text": "その魂も喰らってやろう……！"
  },
  {
    "RowOffset": 867022,
    "RowId": 38022,
    "Text": "嗚呼、内なる闇が溢れ出る……！"
  },
  {
    "RowOffset": 867078,
    "RowId": 38023,
    "Text": "闇の中ではすべてが溶け合う……！"
  },
  {
    "RowOffset": 867138,
    "RowId": 38024,
    "Text": "意識など、いっそ失い忘れれば……！"
  },
  {
    "RowOffset": 867202,
    "RowId": 38025,
    "Text": "その肉体、闇に染めてみせよう……！"
  },
  {
    "RowOffset": 867266,
    "RowId": 38026,
    "Text": "零の闇に、生まれいでよ……。"
  },
  {
    "RowOffset": 867322,
    "RowId": 38027,
    "Text": "産声を上げた命の輝き、星の輝き……。"
  },
  {
    "RowOffset": 867390,
    "RowId": 38028,
    "Text": "栄えよ、栄えよ、健やかに……！"
  },
  {
    "RowOffset": 867446,
    "RowId": 38029,
    "Text": "もう一度、その傍らに寄り添えたなら……。"
  },
  {
    "RowOffset": 867518,
    "RowId": 38030,
    "Text": "返せ、私の愛しき世界をッ！"
  },
  {
    "RowOffset": 867570,
    "RowId": 38031,
    "Text": "消えて……消えなさい……邪魔者は全部……！"
  },
  {
    "RowOffset": 867646,
    "RowId": 38032,
    "Text": "闇とは無、無とは零……。"
  },
