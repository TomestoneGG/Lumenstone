  {
    "RowOffset": 868498,
    "RowId": 38100,
    "Text": "凪の露営地への到達"
  },
  {
    "RowOffset": 868538,
    "RowId": 38101,
    "Text": "凪の露営地の突破"
  },
  {
    "RowOffset": 868574,
    "RowId": 38102,
    "Text": "モーガァダー天壁の登頂"
  },
  {
    "RowOffset": 868618,
    "RowId": 38103,
    "Text": "モーガァ王屯所の突破"
  },
  {
    "RowOffset": 868662,
    "RowId": 38104,
    "Text": "カーリョー陵墓への到達"
  },
  {
    "RowOffset": 868706,
    "RowId": 38105,
    "Text": "グーフールーの撃破"
  },
  {
    "RowOffset": 868746,
    "RowId": 38106,
    "Text": "お前たちに追いつかれようとは、\n遊びが過ぎたか……。"
  },
  {
    "RowOffset": 868838,
    "RowId": 38107,
    "Text": ""
  },
  {
    "RowOffset": 868850,
    "RowId": 38108,
    "Text": "チッ……強すぎたか……。"
  },
  {
    "RowOffset": 868898,
    "RowId": 38109,
    "Text": "行く手を阻むつもりはなかったが、これも時の運、\nせいぜい、ほかの路を探すことだ……。"
  },
  {
    "RowOffset": 869038,
    "RowId": 38110,
    "Text": ""
  },
  {
    "RowOffset": 869050,
    "RowId": 38111,
    "Text": "王の器を示してみせろ……！"
  },
  {
    "RowOffset": 869102,
    "RowId": 38112,
    "Text": "古の記録よ……荒ぶる山々の憤怒を……！"
  },
  {
    "RowOffset": 869170,
    "RowId": 38113,
    "Text": "古の記録よ……すべてを飲み込む濁流を……！"
  },
  {
    "RowOffset": 869246,
    "RowId": 38114,
    "Text": "古の記録よ……無慈悲なる嵐を……！"
  },
  {
    "RowOffset": 869310,
    "RowId": 38115,
    "Text": "お前たちの力、この拳でも測らせてもらおう！"
  },
  {
    "RowOffset": 869386,
    "RowId": 38116,
    "Text": "大いなる山より、この身に力を……！"
  },
  {
    "RowOffset": 869450,
    "RowId": 38117,
    "Text": "ヨカフイの魂よ、轟き渡れ！"
  },
  {
    "RowOffset": 869502,
    "RowId": 38118,
    "Text": "この技に耐えるとは……！"
  },
  {
    "RowOffset": 869550,
    "RowId": 38119,
    "Text": "石に刻まれし歴史を知れ……！"
  },
  {
    "RowOffset": 869606,
    "RowId": 38120,
    "Text": "我が守り、崩せるか……！？"
  },
  {
    "RowOffset": 869658,
    "RowId": 38121,
    "Text": "おやおや旅人サンなんて、珍しい！\n……遊んで遊んで！"
  },
  {
    "RowOffset": 869750,
    "RowId": 38122,
    "Text": "ゆきゆき集まれ、ミンナで遊ぼ！"
  },
  {
    "RowOffset": 869806,
    "RowId": 38123,
    "Text": "ミンナ凍って、カッチコチ！"
  },
  {
    "RowOffset": 869858,
    "RowId": 38124,
    "Text": "雪玉固めて、ゴロゴロドーン！"
  },
  {
    "RowOffset": 869914,
    "RowId": 38125,
    "Text": "ゆきゆき集まれ、全員集合！"
  },
  {
    "RowOffset": 869966,
    "RowId": 38126,
    "Text": ""
  },
  {
    "RowOffset": 869978,
    "RowId": 38127,
    "Text": ""
  },
  {
    "RowOffset": 869990,
    "RowId": 38128,
    "Text": ""
  },
