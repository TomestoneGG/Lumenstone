  },
  {
    "RowOffset": 749350,
    "RowId": 34999,
    "Text": ""
  },
  {
    "RowOffset": 749362,
    "RowId": 35000,
    "Text": "この昏き牢獄を、終のしとねとしてやろう……！"
  },
  {
    "RowOffset": 749442,
    "RowId": 35001,
    "Text": "我が炎は、愛しき獣と化す！"
  },
  {
    "RowOffset": 749494,
    "RowId": 35002,
    "Text": "燃え上がれ、猛き獣よ！"
  },
  {
    "RowOffset": 749538,
    "RowId": 35003,
    "Text": "炎獣よ、貪り喰らえ！"
  },
  {
    "RowOffset": 749582,
    "RowId": 35004,
    "Text": "私を、ほかの半神と同じと思うな……。"
  },
  {
    "RowOffset": 749650,
    "RowId": 35005,
    "Text": "我が身すら捧げた成果、とくと見ろ！"
  },
  {
    "RowOffset": 749714,
    "RowId": 35006,
    "Text": "灼熱よ……走れッ！"
  },
  {
    "RowOffset": 749754,
    "RowId": 35007,
    "Text": "炎獄の力を受けるがいい！"
  },
  {
    "RowOffset": 749802,
    "RowId": 35008,
    "Text": "今の私は、いささか凶暴だッ！"
  },
  {
    "RowOffset": 749858,
    "RowId": 35009,
    "Text": "轢き殺すッ！"
  },
  {
    "RowOffset": 749890,
    "RowId": 35010,
    "Text": "進め、荒ぶる身躯よ！"
  },
  {
    "RowOffset": 749934,
    "RowId": 35011,
    "Text": "消し飛べッ！"
  },
  {
    "RowOffset": 749966,
    "RowId": 35012,
    "Text": "思い知るがいい！"
  },
  {
    "RowOffset": 750002,
    "RowId": 35013,
    "Text": "そこまでだ！"
  },
  {
    "RowOffset": 750034,
    "RowId": 35014,
    "Text": "我が、願いのために……！"
  },
  {
    "RowOffset": 750082,
    "RowId": 35015,
    "Text": "絶望とともに眠れ！"
  },
  {
    "RowOffset": 750122,
    "RowId": 35016,
    "Text": "神に逆らうなど、愚かしい！"
  },
  {
    "RowOffset": 750174,
    "RowId": 35017,
    "Text": "半神では及ばぬとて……\nまだ、終わらんよ……！"
  },
  {
    "RowOffset": 750258,
    "RowId": 35018,
    "Text": "たとえ、この肉体が崩壊しようとも……！"
  },
  {
    "RowOffset": 750326,
    "RowId": 35019,
    "Text": "さらなる変化を……転身を成す！"
  },
  {
    "RowOffset": 750382,
    "RowId": 35020,
    "Text": "こ、こここれぞ、キュウキョク……ノッ！"
  },
  {
    "RowOffset": 750450,
    "RowId": 35021,
    "Text": "消エヨ……小サきっ、命ッ！"
  },
  {
    "RowOffset": 750502,
    "RowId": 35022,
    "Text": "これで終わりだ……小さき命よ……。"
  },
  {
    "RowOffset": 750566,
    "RowId": 35023,
    "Text": "我ガ遺伝子を、分け与えヨウ！"
  },
  {
    "RowOffset": 750622,
    "RowId": 35024,
    "Text": "そノ……魂、分離セヨッ！"
  },
  {
    "RowOffset": 750670,
    "RowId": 35025,
    "Text": "我ガ意の……意のままニ踊れッ！"
  },
  {
    "RowOffset": 750726,
    "RowId": 35026,
    "Text": "ショウメツ、消滅セヨッ！"
  },
  {
    "RowOffset": 750774,
    "RowId": 35027,
    "Text": "混沌ヲ喰らえッ！"
  },
  {
    "RowOffset": 750810,
    "RowId": 35028,
    "Text": "ソろソロ、落ちロッ！"
  },
  {
    "RowOffset": 750854,
    "RowId": 35029,
    "Text": "アテナと……また、会うのダッ！"
  },
  {
    "RowOffset": 750910,
    "RowId": 35030,
    "Text": "全て！\u3000すベテ朽チようともッ！"
  },
  {
    "RowOffset": 750966,
    "RowId": 35031,
    "Text": "ラハブレアの、力ダ……！"
  },
  {
    "RowOffset": 751014,
    "RowId": 35032,
    "Text": "コレデ、最後ダ……小さき、アワレな命ヨ！！"
  },
  {
    "RowOffset": 751090,
    "RowId": 35033,
    "Text": "ヘファイストスの撃破"
  },
