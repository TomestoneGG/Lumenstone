  },
  {
    "RowOffset": 756474,
    "RowId": 35199,
    "Text": ""
  },
  {
    "RowOffset": 756486,
    "RowId": 35200,
    "Text": "待ちに待った大一番……ガッカリさせてくれるなよ！？"
  },
  {
    "RowOffset": 756574,
    "RowId": 35201,
    "Text": "そんなんじゃ、びくともしねぇぜ？"
  },
  {
    "RowOffset": 756634,
    "RowId": 35202,
    "Text": "水のカイナッツォの力、見せてやるぜ！"
  },
  {
    "RowOffset": 756702,
    "RowId": 35203,
    "Text": "四天王の恐ろしさ、とくと味わえ！"
  },
  {
    "RowOffset": 756762,
    "RowId": 35204,
    "Text": "俺様の本気を……くらいやがれェ！！"
  },
  {
    "RowOffset": 756826,
    "RowId": 35205,
    "Text": "なんだとぉ？\u3000こいつぁたまげた……！"
  },
  {
    "RowOffset": 756894,
    "RowId": 35206,
    "Text": "楽しくなってきたぜ！\u3000グヘヘヘヘ！"
  },
  {
    "RowOffset": 756958,
    "RowId": 35207,
    "Text": "いいぞ、最後の戦いにふさわしい……！"
  },
  {
    "RowOffset": 757026,
    "RowId": 35208,
    "Text": "カタカタカタ……基礎訓練ヲ開始。\n戦闘時間ヲ計測スル……。"
  },
  {
    "RowOffset": 757126,
    "RowId": 35209,
    "Text": "隙ヲ逃サズ、確実ニ致命傷ヲ与エヨ……。"
  },
  {
    "RowOffset": 757194,
    "RowId": 35210,
    "Text": "基礎訓練ヲ終了。\nカタカタカタ……複合訓練ニ移行スル。"
  },
  {
    "RowOffset": 757290,
    "RowId": 35211,
    "Text": "常ニ冷静カツ適切ナ対処ヲ……。"
  },
  {
    "RowOffset": 757346,
    "RowId": 35212,
    "Text": "日々ノ鍛錬ガ、己ノ命ヲ救ウト心得ヨ……。"
  },
  {
    "RowOffset": 757418,
    "RowId": 35213,
    "Text": "カタカタカタ……戦闘評価、第十二階位。\nソノ実力、最低位妖異ノ如シト心得ヨ……。"
  },
  {
    "RowOffset": 757550,
    "RowId": 35214,
    "Text": "カタカタカタ……戦闘評価、第九階位。\n基礎鍛錬ヲ続ケ、ヨリ上位ノ階位ヲ目指スベシ……。"
  },
  {
    "RowOffset": 757694,
    "RowId": 35215,
    "Text": "カタカタカタ……戦闘評価、第七階位。\nマズマズノ記録……戦士級妖異ニモ劣ラヌト、認メヨウ……。"
  },
  {
    "RowOffset": 757850,
    "RowId": 35216,
    "Text": "カタカタカタ……戦闘評価、第五階位。\n騎士級ノ妖異ニ伍スル、実力ト認定スル……。"
  },
  {
    "RowOffset": 757982,
    "RowId": 35217,
    "Text": "カタカタカタ……戦闘評価、第三階位。\n生前ノ「がらてあ」ニ、匹敵スル実力ト認メヨウ……。"
  },
  {
    "RowOffset": 758126,
    "RowId": 35218,
    "Text": "カタカタカタ……戦闘評価、第二階位。\nコノ記録、「るーるす」様ノミガ達成セシ偉業ナリ……。"
  },
  {
    "RowOffset": 758274,
    "RowId": 35219,
    "Text": "カタカタカタ……戦闘評価、第一階位。\n魔王級ノ妖異ニ、匹敵……ソノ力ハ、一族ノ誇リナリ……。"
  },
  {
    "RowOffset": 758426,
    "RowId": 35220,
    "Text": "カタカタカタ……戦闘評価、良好。\n「どるしら」嬢ニ並ブ記録トハ、驚キダ……。"
  },
  {
    "RowOffset": 758554,
    "RowId": 35221,
    "Text": "雪獣の帝座への到達"
  },
  {
    "RowOffset": 758594,
    "RowId": 35222,
    "Text": "雪獣の帝座の突破"
  },
  {
    "RowOffset": 758630,
    "RowId": 35223,
    "Text": "フォルム・メッソルムへの到達"
  },
  {
    "RowOffset": 758686,
    "RowId": 35224,
    "Text": "フォルム・メッソルムの突破"
  },
  {
    "RowOffset": 758738,
    "RowId": 35225,
    "Text": "青炎の棘への到達"
  },
  {
    "RowOffset": 758774,
    "RowId": 35226,
    "Text": "カイナッツォの撃破"
  },
  {
    "RowOffset": 758814,
    "RowId": 35227,
    "Text": "視界が悪いから、気をつけてくれよ！"
  },
  {
    "RowOffset": 758878,
    "RowId": 35228,
    "Text": "おっと、開けたところに出たなァ。\nくれぐれも落ちなさんなよ！"
  },
  {
    "RowOffset": 758982,
    "RowId": 35229,
    "Text": "獣たちの気が立っていやがる……。\nここからはマンモスじゃ登れねぇから、歩いて行ってくれ！"
  },
