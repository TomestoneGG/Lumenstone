  {
    "RowOffset": 783178,
    "RowId": 36199,
    "Text": ""
  },
  {
    "RowOffset": 783190,
    "RowId": 36200,
    "Text": "タタカウ……古キ魂、喰ッテ、タタカウ……！"
  },
  {
    "RowOffset": 783266,
    "RowId": 36201,
    "Text": "アタシは死んだはず……\n戦い続ける運命なのね"
  },
  {
    "RowOffset": 783346,
    "RowId": 36202,
    "Text": "二重詠唱の驚異、味わいなさい！"
  },
  {
    "RowOffset": 783402,
    "RowId": 36203,
    "Text": "ほーら、踊ってもらうわよ！"
  },
  {
    "RowOffset": 783454,
    "RowId": 36204,
    "Text": "アタシの「言葉」は魔力を帯びる……！"
  },
  {
    "RowOffset": 783522,
    "RowId": 36205,
    "Text": "出番は終わり……みたいね……。"
  },
  {
    "RowOffset": 783578,
    "RowId": 36206,
    "Text": "闘うために呼ばれるとは……\nいいぜ、暴れてやる！"
  },
  {
    "RowOffset": 783662,
    "RowId": 36207,
    "Text": "せいぜい、楽しませてくれよ！"
  },
  {
    "RowOffset": 783718,
    "RowId": 36208,
    "Text": "この程度じゃ終われないよなあ！"
  },
  {
    "RowOffset": 783774,
    "RowId": 36209,
    "Text": "チィ……時間切れかよ……！"
  },
  {
    "RowOffset": 783826,
    "RowId": 36210,
    "Text": "ガァァァァウッ！"
  },
  {
    "RowOffset": 783862,
    "RowId": 36211,
    "Text": "グガァァァッ！"
  },
  {
    "RowOffset": 783894,
    "RowId": 36212,
    "Text": "また呼び起こされたというの……？"
  },
  {
    "RowOffset": 783954,
    "RowId": 36213,
    "Text": "蹂躙してあげる！"
  },
  {
    "RowOffset": 783990,
    "RowId": 36214,
    "Text": "アタシの魔法を受けてみなさい！"
  },
  {
    "RowOffset": 784046,
    "RowId": 36215,
    "Text": "これくらいは凌いでちょうだい！"
  },
  {
    "RowOffset": 784102,
    "RowId": 36216,
    "Text": "もっと……もっとやり合おうぜ！"
  },
  {
    "RowOffset": 784158,
    "RowId": 36217,
    "Text": "吹っ飛ばしてやる！"
  },
  {
    "RowOffset": 784198,
    "RowId": 36218,
    "Text": "オラオラオラ、オラ！"
  },
  {
    "RowOffset": 784242,
    "RowId": 36219,
    "Text": "その身に苦痛を！"
  },
  {
    "RowOffset": 784278,
    "RowId": 36220,
    "Text": "アテナ様のために……！"
  },
  {
    "RowOffset": 784322,
    "RowId": 36221,
    "Text": "これで……オワリ、ダッ！"
  },
  {
    "RowOffset": 784370,
    "RowId": 36222,
    "Text": "まだまだぁ！"
  },
  {
    "RowOffset": 784402,
    "RowId": 36223,
    "Text": "コキュートスの撃破"
  },
  {
    "RowOffset": 784442,
    "RowId": 36224,
    "Text": "爆ぜよ！"
  },
  {
    "RowOffset": 784466,
    "RowId": 36225,
    "Text": "凍てつけ！"
  },
