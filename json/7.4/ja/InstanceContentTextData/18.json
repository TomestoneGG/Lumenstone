  },
  {
    "RowOffset": 698546,
    "RowId": 33800,
    "Text": "家臣団よ、出陣せよクポーッ！"
  },
  {
    "RowOffset": 698602,
    "RowId": 33801,
    "Text": "家臣たちよ、ワルモノを裁くクポーッ！"
  },
  {
    "RowOffset": 698670,
    "RowId": 33802,
    "Text": "家臣たちよ、連携して戦うべしクポーッ！"
  },
  {
    "RowOffset": 698738,
    "RowId": 33803,
    "Text": "メメント・モーグリ！\u3000モグを記憶せよクポーッ！"
  },
  {
    "RowOffset": 698818,
    "RowId": 33804,
    "Text": "我らモーグリ家臣団……！\nさからう者は、ギッタギタにしてやるクポ！"
  },
  {
    "RowOffset": 698930,
    "RowId": 33805,
    "Text": "ち、ちょっとは、やるようクポね……。\nこうなったら、善王様にいいつけてやるクポ……！"
  },
  {
    "RowOffset": 699070,
    "RowId": 33806,
    "Text": "善王様、その裁きをクポ！"
  },
  {
    "RowOffset": 699118,
    "RowId": 33807,
    "Text": "モグたちの戦いはこれからクポ……！"
  },
  {
    "RowOffset": 699182,
    "RowId": 33808,
    "Text": "モーグリ家臣団よ、制裁を与えるクポ！"
  },
  {
    "RowOffset": 699250,
    "RowId": 33809,
    "Text": "パワーをポンポンメテオに……！\n落ちたらドッカーン、痛いクポよ～！"
  },
