    "Text": ""
  },
  {
    "RowOffset": 942570,
    "RowId": 40200,
    "Text": "ブルートボンバーの撃破"
  },
  {
    "RowOffset": 942614,
    "RowId": 40201,
    "Text": "ボムキングの力で吹っ飛ばしてやるぜ！"
  },
  {
    "RowOffset": 942682,
    "RowId": 40202,
    "Text": "ついに、「ブルートボンバー」のお出ましです！"
  },
  {
    "RowOffset": 942762,
    "RowId": 40203,
    "Text": "ゲヘヘヘ……\nこいつを使わせてもらうぜ！"
  },
  {
    "RowOffset": 942834,
    "RowId": 40204,
    "Text": "ドーピングを検知！\n失格処分、失格処分……！"
  },
  {
    "RowOffset": 942914,
    "RowId": 40205,
    "Text": "うるせぇ！\u3000邪魔すんじゃねぇ！！"
  },
  {
    "RowOffset": 942974,
    "RowId": 40206,
    "Text": "レフェリーに暴行ゥ～！\nこれはヒドい、まさに外道ッ！"
  },
  {
    "RowOffset": 943066,
    "RowId": 40207,
    "Text": "ゲハハハハ、もう邪魔者はいねぇ！"
  },
  {
    "RowOffset": 943126,
    "RowId": 40208,
    "Text": "ダメだ、これじゃ足りねぇ！\n別の強化薬だ！"
  },
  {
    "RowOffset": 943202,
    "RowId": 40209,
    "Text": "ブルートボンバー、巨大化しているぞォ～！"
  },
  {
    "RowOffset": 943274,
    "RowId": 40210,
    "Text": "くそっ、まだ足りねぇ！\nもっと、追加だっ……！！"
  },
  {
    "RowOffset": 943358,
    "RowId": 40211,
    "Text": "ブルートボンバー、もはやルール無用だァ～！"
  },
  {
    "RowOffset": 943434,
    "RowId": 40212,
    "Text": "この大技を喰らいやがれっ！！"
  },
  {
    "RowOffset": 943490,
    "RowId": 40213,
    "Text": "出たァ～！\n「ボンバリアンスペシャル」だァ～！"
  },
  {
    "RowOffset": 943574,
    "RowId": 40214,
    "Text": "「フューズボム」の餌食にしてやろう！"
  },
  {
    "RowOffset": 943642,
    "RowId": 40215,
    "Text": "こいつと俺様の魔炎で……ドカンッだ！"
  },
  {
    "RowOffset": 943710,
    "RowId": 40216,
    "Text": "導火線地獄「フューズフィールド」！\nさあ、どうするッ！？"
  },
  {
    "RowOffset": 943806,
    "RowId": 40217,
    "Text": "さあ、俺様のルールに従ってもらうぜ！"
  },
  {
    "RowOffset": 943874,
    "RowId": 40218,
    "Text": "「チェーンデスマッチ」！\n鎖からは逃れられないッ！"
  },
  {
    "RowOffset": 943962,
    "RowId": 40219,
    "Text": "この俺様が、負けるわけ、ねぇんだっ！"
  },
  {
    "RowOffset": 944030,
    "RowId": 40220,
    "Text": "ブルートボンバー、もはや破れかぶれだァ～！"
  },
  {
    "RowOffset": 944106,
    "RowId": 40221,
    "Text": "こいつで……終わりだぁ……！"
  },
