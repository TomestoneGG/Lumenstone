  },
  {
    "RowOffset": 902782,
    "RowId": 39100,
    "Text": "さあ、「ハニー・B・ラブリー」の登場です！"
  },
  {
    "RowOffset": 902854,
    "RowId": 39101,
    "Text": "蜂の劇毒を使った攻撃ッ！\nこれは恐ろしい！"
  },
  {
    "RowOffset": 902930,
    "RowId": 39102,
    "Text": "待ってましたァ～！\nハニー・Bの魅力全開です！"
  },
  {
    "RowOffset": 903010,
    "RowId": 39103,
    "Text": "客席からは溢れんばかりの歓声！"
  },
  {
    "RowOffset": 903066,
    "RowId": 39104,
    "Text": "危険な魅力に、挑戦者は抗えるかァ～！？"
  },
  {
    "RowOffset": 903134,
    "RowId": 39105,
    "Text": "お～っと！\n挑戦者はハニー・Bにメロメロだァ！"
  },
  {
    "RowOffset": 903214,
    "RowId": 39106,
    "Text": "おや？\nハニー・B、戦法を変えてきました！"
  },
  {
    "RowOffset": 903290,
    "RowId": 39107,
    "Text": "両者譲らない激戦が繰り広げられてます！"
  },
  {
    "RowOffset": 903358,
    "RowId": 39108,
    "Text": "あま～い蜜蜂、ハニー・B！\nラブリーにはじめるよ！"
  },
  {
    "RowOffset": 903446,
    "RowId": 39109,
    "Text": "さぁて、これはどうかな～？"
  },
  {
    "RowOffset": 903498,
    "RowId": 39110,
    "Text": "突き刺しちゃうぞ☆"
  },
  {
    "RowOffset": 903538,
    "RowId": 39111,
    "Text": "くらえ、すんごい毒～っ！"
  },
  {
    "RowOffset": 903586,
    "RowId": 39112,
    "Text": "ものども、ひれふせーぃ！"
  },
  {
    "RowOffset": 903634,
    "RowId": 39113,
    "Text": "B！\u3000B！\u3000ブリリアント☆"
  },
  {
    "RowOffset": 903682,
    "RowId": 39114,
    "Text": "盛り上がってきたね～！"
  },
  {
    "RowOffset": 903726,
    "RowId": 39115,
    "Text": "死ぬかもだから、ほんとごめんね？"
  },
  {
    "RowOffset": 903786,
    "RowId": 39116,
    "Text": "やば、今日のバトル、めっちゃ良きだね！？"
  },
  {
    "RowOffset": 903858,
    "RowId": 39117,
    "Text": "みんな～！\nハート連打の準備はいいかぁ！？"
  },
  {
    "RowOffset": 903934,
    "RowId": 39118,
    "Text": "よーし、魅せちゃうぞ～！"
  },
  {
    "RowOffset": 903982,
    "RowId": 39119,
    "Text": "今日からアタシの働き蜂、でしょ？"
  },
  {
    "RowOffset": 904042,
    "RowId": 39120,
    "Text": "みんな～！\nまだまだ、楽しんでってね！\u3000B！"
  },
  {
    "RowOffset": 904118,
    "RowId": 39121,
    "Text": "うわウザ、堕ちないとかなくない？"
  },
  {
    "RowOffset": 904178,
    "RowId": 39122,
    "Text": "みんな応援ありがと～！\u3000ラブリーっ！"
  },
  {
    "RowOffset": 904246,
    "RowId": 39123,
    "Text": "は？\u3000マジ？\nなんで普通にしてるわけ！？"
  },
  {
    "RowOffset": 904318,
    "RowId": 39124,
    "Text": "B……B……ぶっころす……。"
  },
  {
    "RowOffset": 904370,
    "RowId": 39125,
    "Text": "まだまだ、いっくよ～☆"
  },
  {
    "RowOffset": 904414,
    "RowId": 39126,
    "Text": "あのさぁ、何アタシより目立ってんの……？"
  },
  {
    "RowOffset": 904486,
    "RowId": 39127,
    "Text": "いい加減……退場してくれないかな……？"
  },
  {
    "RowOffset": 904554,
    "RowId": 39128,
    "Text": "もう……これでおしまい！"
  },
  {
    "RowOffset": 904602,
    "RowId": 39129,
    "Text": "ハニー・B・ラブリーの撃破"
