    "Text": ""
  },
  {
    "RowOffset": 221330,
    "RowId": 10533,
    "Text": "もっと激しくいってみよう！"
  },
  {
    "RowOffset": 221382,
    "RowId": 10534,
    "Text": "油断は大敵ですよ……！"
  },
  {
    "RowOffset": 221426,
