  },
  {
    "RowOffset": 873642,
    "RowId": 38300,
    "Text": "フレンドシップラウンドへの到達"
  },
  {
    "RowOffset": 873698,
    "RowId": 38301,
    "Text": "ノッギン・ザ・ナイスヘッドの撃破"
  },
  {
    "RowOffset": 873758,
    "RowId": 38302,
    "Text": "パーティープラザへの到達"
  },
  {
    "RowOffset": 873806,
    "RowId": 38303,
    "Text": "ジャック・イン・ザ・ポットの撃破"
  },
  {
    "RowOffset": 873866,
    "RowId": 38304,
    "Text": "レストレスホールへの到達"
  },
  {
    "RowOffset": 873914,
    "RowId": 38305,
    "Text": "トロイメライの撃破"
  },
  {
    "RowOffset": 873954,
    "RowId": 38306,
    "Text": "ナイスヘッド！\nステキなアタマを見せてアゲル！"
  },
  {
    "RowOffset": 874038,
    "RowId": 38307,
    "Text": "ダサいアタマのアナタたち！\nナイスヘッドにしてアゲル！！"
  },
  {
    "RowOffset": 874134,
    "RowId": 38308,
    "Text": "ど、ど、ど、ど、どうして逃げるの……！？\nそんなアタマじゃ、ナイスヘッドと呼べないのに！"
  },
  {
    "RowOffset": 874278,
    "RowId": 38309,
    "Text": "ナイスヘッド！\nいいわ、いいわ、アナタのアタマもステキだわ！"
  },
  {
    "RowOffset": 874382,
    "RowId": 38310,
    "Text": "ナカマたちを紹介するわ！\nステキで、イカした、ナイスヘッドなナカマたち！"
  },
  {
    "RowOffset": 874502,
    "RowId": 38311,
    "Text": "ナイスヘッド！\nステキなアタマをしていれば、走る姿もステキだわ！"
  },
  {
    "RowOffset": 874610,
    "RowId": 38312,
    "Text": "な、な、な、な、なんで逃げるの……！？\nアナタもナカマにしてアゲルのに！"
  },
  {
    "RowOffset": 874730,
    "RowId": 38313,
    "Text": "ナイスヘッド！\nもうすぐ、アナタもナカマになれるわ！"
  },
  {
    "RowOffset": 874822,
    "RowId": 38314,
    "Text": "さあさあ、ステキなアタマのナカマたち！\nナイスヘッドをもっと見せて！"
  },
  {
    "RowOffset": 874938,
    "RowId": 38315,
    "Text": "ナイスヘッド！\nアナタもドナタも、ステキなアタマにご注目～！"
  },
  {
    "RowOffset": 875042,
    "RowId": 38316,
    "Text": "わ、わ、わ、わ、わからないわ！\nステキなアタマを見逃すなんて、センスのカケラもないみたい！"
  },
  {
    "RowOffset": 875190,
    "RowId": 38317,
    "Text": "は、は、は、は、腹が立つわ！\nドイツもコイツも、ダサいアタマでかわいくない！"
  },
  {
    "RowOffset": 875318,
    "RowId": 38318,
    "Text": "さっきから、ひとりだけナカマ外れがいるみたい！\nナイスヘッドに、なれない子が……！"
  },
  {
    "RowOffset": 875454,
    "RowId": 38319,
    "Text": "ナイスヘッド！\nアナタのアタマ、とってもステキ！"
  },
  {
    "RowOffset": 875538,
    "RowId": 38320,
    "Text": "ナイスヘッド！\u3000ナイスヘッド！\nダレもカレも、ステキなアタマにしてアゲル！"
  },
  {
    "RowOffset": 875662,
    "RowId": 38321,
    "Text": "ナカマ外れの、あの子を狙って！\nダサいアタマを引っこ抜いて、ナイスヘッドにしてアゲて！"
  },
  {
    "RowOffset": 875806,
    "RowId": 38322,
    "Text": "ナイスヘッド！\u3000ナイスヘッド！\u3000ナイスヘッド！\nやっぱり似合うわ、ステキなアタマ！"
  },
  {
    "RowOffset": 875942,
    "RowId": 38323,
    "Text": "あの……そろそろ抵抗をおやめになっていただけませんか？\n客商売とは言え、私としても我慢には限界があるんですよ。"
  },
  {
    "RowOffset": 876122,
    "RowId": 38324,
    "Text": "ああ、もう……ウロチョロ逃げ回るなって言ってるんです。\nなるべく痛みなく頭部を交換しますから、ご協力いただけますか？"
  },
  {
    "RowOffset": 876310,
    "RowId": 38325,
    "Text": "ああああああああ……！\nシね、シね、シね、シね、シね、シね、シね、シね、シね、シね！！"
  },
  {
    "RowOffset": 876454,
    "RowId": 38326,
    "Text": "やあやあ、よい子のみんな！\n楽しいティーパーティーへ、ようこそォ～！"
  },
  {
    "RowOffset": 876570,
    "RowId": 38327,
    "Text": "さあさあ、おもてなしの時間だよ！\nお化けのティーカップたち、出ておいで～！"
  },
  {
    "RowOffset": 876694,
    "RowId": 38328,
    "Text": "サプラ～イズ！\nクフフフ、びっくりしたかなァ～！？"
  },
  {
    "RowOffset": 876782,
    "RowId": 38329,
    "Text": ""
  },
  {
    "RowOffset": 876794,
    "RowId": 38330,
    "Text": ""
  },
  {
    "RowOffset": 876806,
    "RowId": 38331,
    "Text": ""
  },
  {
    "RowOffset": 876818,
    "RowId": 38332,
    "Text": ""
  },
  {
    "RowOffset": 876830,
    "RowId": 38333,
    "Text": ""
  },
  {
    "RowOffset": 876842,
    "RowId": 38334,
    "Text": "回れ回れよ、み～んな回れ♪\nカップも目玉も、ぐるぐる回れェ～♪"
  },
  {
    "RowOffset": 876950,
    "RowId": 38335,
    "Text": "ほらほら、おいし～い紅茶だよ！\nクフフフ、お口に合うかなァ～？"
  },
  {
    "RowOffset": 877058,
    "RowId": 38336,
    "Text": "営業……終了……おやすみ、な、さい……。"
  },
  {
    "RowOffset": 877130,
    "RowId": 38337,
    "Text": "ナイスヘッド！\nミンナいっしょに、ダサいアタマを捕まえよう！"
  },
  {
    "RowOffset": 877234,
    "RowId": 38338,
    "Text": "過ぎ去りし日々は消え、永遠に明日は来ない。\nさあ、お前も、悪夢に呑まれるがいい……。"
  },
  {
    "RowOffset": 877374,
    "RowId": 38339,
    "Text": ""
  },
  {
    "RowOffset": 877386,
    "RowId": 38340,
    "Text": "もう、逃げられはしない……。"
  },
  {
    "RowOffset": 877442,
    "RowId": 38341,
    "Text": ""
  },
  {
    "RowOffset": 877454,
    "RowId": 38342,
    "Text": "ふむ……これまでの有象無象とは違うようだ。\nならば、さらなる悪夢を見せてやろう……。"
  },
  {
    "RowOffset": 877594,
    "RowId": 38343,
    "Text": "夢に沈みし亡霊どもよ、集うがいい……！"
  },
  {
    "RowOffset": 877662,
    "RowId": 38344,
    "Text": "諸君、今こそ我が魔法で助力しよう……！\n光る床に乗って霊体化し、壁をすり抜けるのだ！"
  },
  {
    "RowOffset": 877802,
    "RowId": 38345,
    "Text": "だが、奴は霊体殺しの技を持つ……。\n危険を感じたら、ふたたび光る床に乗り霊体化を解くのだ！"
  },
  {
    "RowOffset": 877950,
    "RowId": 38346,
    "Text": ""
  },
  {
    "RowOffset": 877962,
    "RowId": 38347,
    "Text": ""
  },
  {
    "RowOffset": 877974,
    "RowId": 38348,
    "Text": ""
  },
  {
    "RowOffset": 877986,
    "RowId": 38349,
    "Text": "永久に眠らぬ夢の園へ、ようこそ！\n入園の際は、順序よくゆっくりとお進みください！"
  },
  {
    "RowOffset": 878118,
    "RowId": 38350,
    "Text": "本日も、ストレイバローは終日開園いたしております。\n素敵な夢のひと時を、どうぞお楽しみください。"
  },
  {
    "RowOffset": 878274,
    "RowId": 38351,
    "Text": "みんなの人気者「ノッギン・ザ・ナイスヘッド」のグリーティングが、\nまもなく開演いたします！"
  },
  {
    "RowOffset": 878422,
    "RowId": 38352,
    "Text": "フロリックパークには、魅力的なアトラクションがいっぱい！\n浮かれすぎにご注意のうえ、指定の歩道をお進みください！"
  },
  {
    "RowOffset": 878602,
    "RowId": 38353,
    "Text": "「ジャック・イン・ザ・ポット」の素敵で不敵なティーパーティー！\nお茶が好きなら誰でも歓迎、ドレスコードはございません！"
  },
  {
    "RowOffset": 878794,
    "RowId": 38354,
    "Text": "ようこそ、「エンドレスハウス」へ……！\n諸君らの先達であり、夢敗れて死した私が案内役を務めよう！"
  },
  {
    "RowOffset": 878950,
    "RowId": 38355,
    "Text": "ほう、悪しき亡霊たちをものともしないとは……\n諸君ならば、この館の主を倒すことができるやもしれんな！"
  },
  {
    "RowOffset": 879114,
    "RowId": 38356,
    "Text": "この奥に待つのは館の主「トロイメライ」……\n数多の悪念が変異した、悪夢の王たる存在だ。"
  },
  {
    "RowOffset": 879258,
    "RowId": 38357,
    "Text": "だが、安心したまえ……この私が手助けする！\n我が助言を聞き逃すなよ……？"
  },
  {
    "RowOffset": 879378,
    "RowId": 38358,
    "Text": ""
  },
  {
    "RowOffset": 879390,
    "RowId": 38359,
    "Text": ""
  },
  {
    "RowOffset": 879402,
    "RowId": 38360,
    "Text": ""
  },
