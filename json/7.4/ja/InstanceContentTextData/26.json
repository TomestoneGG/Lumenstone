  {
    "RowOffset": 879474,
    "RowId": 38400,
    "Text": "プヌティープールへの到達"
  },
  {
    "RowOffset": 879522,
    "RowId": 38401,
    "Text": "プヌティープールの突破"
  },
  {
    "RowOffset": 879566,
    "RowId": 38402,
    "Text": "ドラウジーのねぐらへの到達"
  },
  {
    "RowOffset": 879618,
    "RowId": 38403,
    "Text": "ドラウジーのねぐらの突破"
  },
  {
    "RowOffset": 879666,
    "RowId": 38404,
    "Text": "肺の広場への到達"
  },
  {
    "RowOffset": 879702,
    "RowId": 38405,
    "Text": "アポリオンの撃破"
  },
  {
    "RowOffset": 879738,
    "RowId": 38406,
    "Text": "先行してる同じ型の船がいるようね。\nゾラージャ王子か……まさか、バクージャジャ？"
  },
  {
    "RowOffset": 879870,
    "RowId": 38407,
    "Text": "今はほかの船のことよりも、魔物たちの相手を頼む！\n迎撃は任せるぞ！"
  },
  {
    "RowOffset": 879982,
    "RowId": 38408,
    "Text": "雨が降ってきたわね……。"
  },
  {
    "RowOffset": 880030,
    "RowId": 38409,
    "Text": "遅いじゃねェか、待ってたぜェ！"
  },
  {
    "RowOffset": 880086,
    "RowId": 38410,
    "Text": "チッ、しぶとい連中だ！\nだったら……ここで足止めしてやるぜッ！"
  },
  {
    "RowOffset": 880194,
    "RowId": 38411,
    "Text": "キャハハハハ！\nお先に失礼させてもらうよォ！"
  },
  {
    "RowOffset": 880274,
    "RowId": 38412,
    "Text": "プヌティーのハーネスがやられた……！\nすまないが、一度、船を止めるぞ！"
  },
  {
    "RowOffset": 880394,
    "RowId": 38413,
    "Text": "あなたたちは陸路を進んでみて！\nあとで合流しましょう！"
  },
  {
    "RowOffset": 880490,
    "RowId": 38414,
    "Text": "おや、こんなところで遭遇するとは……\n船はどうしたのですか？"
  },
  {
    "RowOffset": 880594,
    "RowId": 38415,
    "Text": "おっと悪いな。\nお前たちは別のルートを探してくれ！"
  },
  {
    "RowOffset": 880682,
    "RowId": 38416,
    "Text": "あれは……バクージャジャの船か！？\n気をつけろ、仕掛けてくるぞ！"
  },
  {
    "RowOffset": 880790,
    "RowId": 38417,
    "Text": "船を狙うとは、卑怯な奴め……！"
  },
  {
    "RowOffset": 880846,
    "RowId": 38418,
    "Text": "エレンヴィル……！\n船速が落ちてるんじゃない！？"
  },
  {
    "RowOffset": 880930,
    "RowId": 38419,
    "Text": "プヌティーのハーネスを直すまで、船は動かせない……。"
  },
  {
    "RowOffset": 881022,
    "RowId": 38420,
    "Text": "さあて、オレサマからの贈り物をくれてやるぜェ！\nたっぷり楽しんでくれやァ！"
  },
  {
    "RowOffset": 881146,
    "RowId": 38421,
    "Text": ""
  },
