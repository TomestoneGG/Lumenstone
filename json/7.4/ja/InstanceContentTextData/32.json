  {
    "RowOffset": 998010,
    "RowId": 41700,
    "Text": "真の闇に溶けるがいい！"
  },
  {
    "RowOffset": 998054,
    "RowId": 41701,
    "Text": "闇の力を刃と為さん……！"
  },
  {
    "RowOffset": 998102,
    "RowId": 41702,
    "Text": "無がすべてを凌駕する！"
  },
  {
    "RowOffset": 998146,
    "RowId": 41703,
    "Text": "我が雲にて、光を覆わん……！"
  },
  {
    "RowOffset": 998202,
    "RowId": 41704,
    "Text": "さらなる暗闇へ導こうぞ……！"
  },
  {
    "RowOffset": 998258,
    "RowId": 41705,
    "Text": "まとめて消し飛べ……！"
  },
  {
    "RowOffset": 998302,
    "RowId": 41706,
    "Text": "小虫ども、薙ぎ払ってくれようぞ！"
  },
  {
    "RowOffset": 998362,
    "RowId": 41707,
    "Text": "闇も光も我が腕の中に……。"
  },
  {
    "RowOffset": 998414,
    "RowId": 41708,
    "Text": "すべては優しき無へと還る……。"
  },
  {
    "RowOffset": 998470,
    "RowId": 41709,
    "Text": "死すらも無への過程に過ぎぬと知れ……。"
  },
  {
    "RowOffset": 998538,
    "RowId": 41710,
    "Text": "闇の風よ、すべてを無へと送れ……！"
  },
  {
    "RowOffset": 998602,
    "RowId": 41711,
    "Text": "死よ、我が腕に宿れ……！"
  },
  {
    "RowOffset": 998650,
    "RowId": 41712,
    "Text": "風よ、我が腕に宿れ……！"
  },
  {
    "RowOffset": 998698,
    "RowId": 41713,
    "Text": "闇の力を……もう抑えられん……！"
  },
  {
    "RowOffset": 998758,
    "RowId": 41714,
    "Text": "物言わぬ石と化すがいい……！"
  },
  {
    "RowOffset": 998814,
    "RowId": 41715,
    "Text": "さあ、逃げ切れるか……？"
  },
