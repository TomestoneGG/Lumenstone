[
  {
    "RowOffset": 995678,
    "RowId": 41609,
    "Text": "まだ生きていますか？\n安全装置を解除します！"
  },
  {
    "RowOffset": 995758,
    "RowId": 41610,
    "Text": "空間を掌握しました！\n存在抹消を実行します！"
  },
  {
    "RowOffset": 995838,
    "RowId": 41611,
    "Text": "限界負荷を超過……中断します。"
  },
  {
    "RowOffset": 995894,
    "RowId": 41612,
    "Text": "まだ生きて……空間掌握……再実行します！"
  },
  {
    "RowOffset": 995966,
    "RowId": 41613,
    "Text": "限界負荷……超過……\nエラーが発生し……"
  },
  {
    "RowOffset": 996038,
    "RowId": 41614,
    "Text": "強制実行……命令……確認……"
  },
  {
    "RowOffset": 996094,
    "RowId": 41615,
    "Text": "アブソリュート・オーソリティ発動まで\u30005"
  },
  {
    "RowOffset": 996166,
    "RowId": 41616,
    "Text": "アブソリュート・オーソリティ発動まで\u30004"
  },
  {
    "RowOffset": 996238,
    "RowId": 41617,
    "Text": "アブソリュート・オーソリティ発動まで\u30003"
  },
  {
    "RowOffset": 996310,
    "RowId": 41618,
    "Text": "アブソリュート・オーソリティ発動まで\u30002"
  },
  {
    "RowOffset": 996382,
    "RowId": 41619,
    "Text": "アブソリュート・オーソリティ発動まで\u30001"
  },
  {
    "RowOffset": 996454,
    "RowId": 41620,
    "Text": "ココ、コんに……こんニチは！\nそそそソシて、そソシて、さようナラ……！！！"
  },
  {
    "RowOffset": 996578,
    "RowId": 41621,
    "Text": "トワびトの、み、ミなさんは、ゴ安心……さい……！\nまもなく、いのチ、いのチが、がガガ……。"
  },
  {
    "RowOffset": 996726,
    "RowId": 41622,
    "Text": "もしモの、トき……ハ……\nきミ、が……わタシを……。"
  },
  {
    "RowOffset": 996818,
    "RowId": 41623,
    "Text": "せ、せつゾく……世界を……\nオオお、見せ、しましょう……！"
  },
  {
    "RowOffset": 996918,
    "RowId": 41624,
    "Text": "シシ、し……しあわ、セ、ですか……？"
  },
  {
    "RowOffset": 996986,
    "RowId": 41625,
    "Text": "こ、ココ、こわがら……ナい……で……。"
  },
  {
    "RowOffset": 997054,
    "RowId": 41626,
    "Text": "し、シを……死を、死を！\nのりこえましょう！"
  },
