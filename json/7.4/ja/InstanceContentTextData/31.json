  {
    "RowId": 41419,
    "Text": "おりゃあっ、もういっちょー！！"
  },
  {
    "RowId": 41420,
    "Text": "喰らいやがれ！！"
  },
  {
    "RowId": 41421,
    "Text": "まだまだこっからだぁっ！"
  },
  {
    "RowId": 41422,
    "Text": "俺のとっておき、たえられっかな！？"
  },
  {
    "RowId": 41423,
    "Text": "マジの本気でいかせてもらうぜーー！！"
  },
  {
    "RowId": 41424,
    "Text": "ヘヘっ！\u3000覚悟しな！"
  },
  {
    "RowId": 41425,
    "Text": "女神様、俺に光を……！"
  },
  {
    "RowId": 41426,
    "Text": "女神様、光のご加護を……！"
  },
  {
    "RowId": 41427,
    "Text": "オラオラオラーッ！！\u3000夢想阿修羅拳！！！"
  },
  {
    "RowId": 41428,
    "Text": "すぅーぱぁー、崑崙八象脚！"
  },
  {
    "RowId": 41429,
    "Text": "ヘヘへ、楽しくなってきたぜ！"
  },
  {
    "RowId": 41430,
    "Text": "おまえら、なかなかやるじゃねーか！\u3000"
  },
  {
    "RowId": 41431,
    "Text": "負けるわけにはいかねぇんだ……！"
  },
  {
    "RowId": 41432,
    "Text": "負けたくねえ……負けたくねえよ……！"
  },
  {
    "RowId": 41433,
    "Text": "おーい、もう終わりかよぉ。\nもっとあそぼーぜー。"
  },
  {
    "RowId": 41434,
    "Text": "まだやる気だな！\n何度でもぶっ飛ばしてやるぜ！"
  },
  {
    "RowId": 41435,
    "Text": "ッてぇぇー……！\n今のは、いい一撃だったぜ！"
  },
  {
    "RowId": 41436,
    "Text": "なんじゃこりゃー！？俺の攻撃でびくともしねぇ！"
  },
  {
    "RowId": 41437,
    "Text": "おまえらも女神の祝福を！？\nそんなわけあるかよ！"
  },
  {
    "RowId": 41438,
    "Text": "内なる「怯懦」が、\nおまえたちを押しつぶす……。"
  },
  {
    "RowId": 41439,
    "Text": "内なる「怯懦」よ……潰せ。"
  },
  {
    "RowId": 41440,
    "Text": "内なる「嫉妬」が、\nおまえたちをかじりとる……。"
  },
  {
    "RowId": 41441,
    "Text": "内なる「嫉妬」よ……断て。"
  },
  {
    "RowId": 41442,
    "Text": "内なる「憎悪」が、\nおまえたちを焼きこがす……。"
  },
  {
    "RowId": 41443,
    "Text": "内なる「憎悪」よ……滅せよ。"
  },
  {
    "RowId": 41444,
    "Text": "内なる「無知」が、\nおまえたちをうつろにする……。"
  },
  {
    "RowId": 41445,
    "Text": "内なる「無知」よ……刈れ。"
  },
  {
    "RowId": 41446,
    "Text": "内なる「驕慢」が、\nおまえたちを腐らせる……。"
  },
  {
    "RowId": 41447,
    "Text": "内なる「驕慢」よ……圧せよ。"
  },
  {
    "RowId": 41448,
    "Text": "ジュノ下層の突破"
  },
  {
    "RowId": 41449,
    "Text": "闘舞台の突破"
  },
  {
    "RowId": 41450,
    "Text": "ボヤーダ樹の突破"
  },
  {
    "RowId": 41451,
    "Text": "龍のねぐらの突破"
  },
  {
    "RowId": 41452,
    "Text": "ル・オンの庭の突破"
  },
  {
    "RowId": 41453,
    "Text": "ラ・ロフの劇場の突破"
  },
  {
    "RowId": 41454,
    "Text": "ズヴァール城の突破"
  },
  {
    "RowId": 41455,
    "Text": "王の間の突破"
  },
  {
    "RowId": 41456,
    "Text": "気をつけな！\nあの嬢ちゃん、ただのガキじゃねェぞ……！"
  },
  {
    "RowId": 41457,
    "Text": "いろいろと聞きてェことがあるからな……。\nおねんねしてる間に運んじまうぞ！"
  },
  {
    "RowId": 41458,
    "Text": "出口を探すには、先に進むしかなさそうだよ！"
  },
  {
    "RowId": 41459,
    "Text": "なんだァ？\u3000森の中に飛ばされちまったみてェだな。"
  },
  {
    "RowId": 41460,
    "Text": "こっちは嬢ちゃんを守るので精一杯だ！\n悪ィが、戦闘は任せたぞ！"
  },
  {
    "RowId": 41461,
    "Text": "この先から、バカでかい気配を感じるぜ！\n注意して進みな！"
  },
  {
    "RowId": 41462,
    "Text": "これは……強制転移の魔法だよ！\nはぐれないように気をつけて！"
  },
  {
    "RowId": 41463,
    "Text": "ったく、いったいどこに飛ばしやがった……って、\n遺跡が空に浮いてやがるぞ……！"
  },
  {
    "RowId": 41464,
    "Text": "あの5人組、どいつもかなりやるようだぜ。\n油断するなよ。"
  },
  {
    "RowId": 41465,
    "Text": "手強そうな相手だったけど、\nさすがは武王ウクラマトの協力者だねェ！"
  },
  {
    "RowId": 41466,
    "Text": "あの城がゴール地点か？\n手厚い歓迎は期待できなさそうだけどよ……。"
  },
  {
    "RowId": 41467,
    "Text": "微塵がくれ発動まで\u300010\u3000秒！"
  },
  {
    "RowId": 41468,
    "Text": "微塵がくれ発動まで\u30005\u3000秒！"
  },
  {
    "RowId": 41469,
    "Text": "微塵がくれ発動まで\u30004\u3000秒！"
  },
  {
    "RowId": 41470,
    "Text": "微塵がくれ発動まで\u30003\u3000秒！"
  },
  {
    "RowId": 41471,
    "Text": "微塵がくれ発動まで\u30002\u3000秒！"
  },
  {
    "RowId": 41472,
    "Text": "微塵がくれ発動まで\u30001\u3000秒！"
  },
  {
    "RowId": 41473,
    "Text": "ぐ～る……"
  },
  {
    "RowId": 41474,
    "Text": "ドォーーーーーン！！！！！"
  },
  {
    "RowId": 41475,
    "Text": "羅刹七星拳ンン！！"
  },
  {
    "RowId": 41476,
    "Text": "微塵がくれ発動まで\u300030\u3000秒！"
  },
  {
    "RowId": 41477,
    "Text": "微塵がくれ発動まで\u300020\u3000秒！"
  },
