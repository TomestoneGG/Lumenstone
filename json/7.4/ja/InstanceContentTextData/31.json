  {
    "RowId": 41600,
    "Text": "こんにちは、そしてさようなら！"
  },
  {
    "RowId": 41601,
    "Text": "生きていますか？"
  },
  {
    "RowId": 41602,
    "Text": "幸せですか？"
  },
  {
    "RowId": 41603,
    "Text": "死をのりこえましょう！"
  },
  {
    "RowId": 41604,
    "Text": "エーテルが必要です！"
  },
  {
    "RowId": 41605,
    "Text": "死んでもおわりではありません！\nさあ、こわがらないで！"
  },
  {
    "RowId": 41606,
    "Text": "接続された世界を、お見せしましょう！"
  },
  {
    "RowId": 41607,
    "Text": "小型ユニットを展開します！"
  },
  {
    "RowId": 41608,
    "Text": "まだ生きていますか？\n予備動力を起動します！"
  }
