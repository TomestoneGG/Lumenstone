  {
    "RowOffset": 995170,
    "RowId": 41600,
    "Text": "こんにちは、そしてさようなら！"
  },
  {
    "RowOffset": 995226,
    "RowId": 41601,
    "Text": "生きていますか？"
  },
  {
    "RowOffset": 995262,
    "RowId": 41602,
    "Text": "幸せですか？"
  },
  {
    "RowOffset": 995294,
    "RowId": 41603,
    "Text": "死をのりこえましょう！"
  },
  {
    "RowOffset": 995338,
    "RowId": 41604,
    "Text": "エーテルが必要です！"
  },
  {
    "RowOffset": 995382,
    "RowId": 41605,
    "Text": "死んでもおわりではありません！\nさあ、こわがらないで！"
  },
  {
    "RowOffset": 995478,
    "RowId": 41606,
    "Text": "接続された世界を、お見せしましょう！"
  },
  {
    "RowOffset": 995546,
    "RowId": 41607,
    "Text": "小型ユニットを展開します！"
  },
  {
    "RowOffset": 995598,
    "RowId": 41608,
    "Text": "まだ生きていますか？\n予備動力を起動します！"
  }
