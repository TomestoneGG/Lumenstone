  },
  {
    "RowId": 43000,
    "Text": "獲得した輝く袋"
  },
  {
    "RowId": 43100,
    "Text": "クワン洞の踏破"
  },
  {
    "RowId": 43101,
    "Text": "トレノ・カトブレパスの撃破"
  },
  {
    "RowId": 43102,
    "Text": "トレノ平野の踏破"
  },
  {
    "RowId": 43103,
    "Text": "アムドゥシアスの撃破"
  },
  {
    "RowId": 43104,
    "Text": "トレノ市街地の踏破"
  },
  {
    "RowId": 43105,
    "Text": "サンダーグリフォンの撃破"
  },
  {
    "RowId": 43106,
    "Text": "まったく、次から次へと……！\n俺たちの街を、魔物から守り抜くぞ！"
  },
  {
    "RowId": 43107,
    "Text": "君たち、旅人さんか！？\nみんな街の奥へ避難してるから、そこを目指すといい！"
  },
  {
    "RowId": 43300,
    "Text": "葬送をお望みかしら？\nいいわ、私が眠りの御使いよ。"
  },
  {
    "RowId": 43400,
    "Text": "そいつの相手は任せたぜ、お客人……！"
  },
  {
    "RowId": 43401,
    "Text": "ああっ、車両をふっ飛ばしやがった！！"
  },
  {
    "RowId": 43402,
    "Text": "うわ、タレット！？\n使えるもんで凌いでくれ！"
  },
  {
    "RowId": 43403,
    "Text": "また車両が……お客人、大丈夫か！？"
  },
  {
    "RowId": 43404,
    "Text": "昇降用の装置があるから、移動に使ってくれ！"
  },
  {
    "RowId": 43405,
    "Text": "何度も何度も、やってくれるぜ……！"
  },
  {
    "RowId": 43406,
    "Text": "あれっ、お客人いるよな！？\n平気か！？"
  },
  {
    "RowId": 43407,
    "Text": "何だあれ……エーテルの、腕！？"
  },
  {
    "RowId": 43408,
    "Text": "マズい！\n車両を切り離すから、次のに飛び移れ！"
  },
  {
    "RowId": 43409,
    "Text": "くっそーっ、無茶苦茶しやがって！"
  },
  {
    "RowId": 43410,
    "Text": "だああっ、またやられた！"
  },
  {
    "RowId": 43411,
    "Text": "お客人、来るぞ！"
  },
  {
    "RowId": 43412,
    "Text": "やばい、やばい……もうあとがないぞ！"
  },
  {
    "RowId": 43413,
    "Text": "このままじゃ、マズいぜ！？"
  },
  {
    "RowId": 43414,
    "Text": "こいつ、しぶとすぎだろ！"
  },
  {
    "RowId": 43500,
    "Text": "ヴァンプ・ファタールの撃破"
  },
  {
    "RowId": 43501,
    "Text": "ウフフ、アナタはどんな声で泣くのかしら？"
  },
  {
    "RowId": 43502,
    "Text": "ヘビー級の初戦は「ヴァンプ・ファタール」！"
  },
  {
    "RowId": 43503,
    "Text": "挑戦者は処刑人の餌食にされるのかァ～？"
  },
  {
    "RowId": 43504,
    "Text": "おいで、しもべたち！"
  },
  {
    "RowId": 43505,
    "Text": "さあ、ショータイムよ。\nせいぜい、泣き叫んでちょうだい。"
  },
  {
    "RowId": 43506,
    "Text": "出たァ～！\n凶器が襲いくる「殺戮ショー」の始まりだァ～！"
  },
  {
    "RowId": 43507,
    "Text": "ほらほら、リングのシミになっちゃうわよ？"
  },
  {
    "RowId": 43508,
    "Text": "挑戦者、もうあとがないぞォ～！"
  },
  {
    "RowId": 43509,
    "Text": "お愉しみは、これから……\n会場の下僕たち、エーテルをよこしなさい。"
  },
  {
    "RowId": 43510,
    "Text": "「クラウドキリング」！\n観客のエーテルまで吸い取っているぞォ～！"
  },
  {
    "RowId": 43511,
    "Text": "これで、みんな呑み込んであげる。"
  },
  {
    "RowId": 43512,
    "Text": "ヴァンプ・ファタールがエーテルを解き放った！\nもはや独壇場だァ～！"
  },
  {
    "RowId": 43513,
    "Text": "なかなか、しぶといじゃない……\n許しを請うなら今のうちよ！"
  },
  {
    "RowId": 43514,
    "Text": "「殺戮ショー」の再演！\n無数の凶器の中、挑戦者はどうする～？"
  },
  {
    "RowId": 43515,
    "Text": "阿鼻叫喚の中、さらなる凶器が降り注ぐ～！"
  },
  {
    "RowId": 43516,
    "Text": "ああもう、小賢しい……\nよこしなさい……もっと、もっとよ！"
  },
  {
    "RowId": 43517,
    "Text": "またも「クラウドキリング」！\n観客の皆さん、お気分は悪くないですかァ～？"
  },
  {
    "RowId": 43518,
    "Text": "とことん、痛めつけてあげるわ！"
  },
  {
    "RowId": 43519,
    "Text": "大量のエーテルを解き放ったぞ！\nいったい、どうなってしまうんだァ～？"
  },
  {
    "RowId": 43520,
    "Text": "絶対に、逃がさないんだから！"
  },
  {
    "RowId": 43521,
    "Text": "まだまだ足りない……\nもっとよ……ありったけよこしなさい！"
  },
  {
    "RowId": 43522,
    "Text": "またまた「クラウドキリング」！\nさすがにワタシも……ちょっと気分が……。"
  },
  {
    "RowId": 43523,
    "Text": "もう……謝っても……許さないわ……！"
  },
  {
    "RowId": 43524,
    "Text": "挑戦者のエーテルが吸い取られてしまったァ～！"
  },
  {
    "RowId": 43525,
    "Text": "いい加減……ひれ伏しなさい……！"
  },
