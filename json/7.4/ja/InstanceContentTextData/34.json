  {
    "RowOffset": 1030926,
    "RowId": 42700,
    "Text": "ヨ、ウ……ブン……ヨウブン……！"
  },
  {
    "RowOffset": 1030986,
    "RowId": 42701,
    "Text": "カブ、ワケ……カブワケ……！"
  },
  {
    "RowOffset": 1031042,
    "RowId": 42702,
    "Text": "ミンナ、イッショ……サキホコレ……！"
  },
  {
    "RowOffset": 1031110,
    "RowId": 42703,
    "Text": "ヨウブン……ヨウブン……カレタクナイ……！"
  },
  {
    "RowOffset": 1031186,
    "RowId": 42704,
    "Text": "モット、カブワケ……フエル、フエル……！"
