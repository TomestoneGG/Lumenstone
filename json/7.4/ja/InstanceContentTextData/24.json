  },
  {
    "RowOffset": 821494,
    "RowId": 37100,
    "Text": "パンデモニウムの撃破"
  },
  {
    "RowOffset": 821538,
    "RowId": 37101,
    "Text": "我ハ障害、立チハダカル城壁ナリ！"
  },
  {
    "RowOffset": 821598,
    "RowId": 37102,
    "Text": "コノ器ハ、蜘蛛ノ特長ヲ有スル……。"
  },
  {
    "RowOffset": 821662,
    "RowId": 37103,
    "Text": "我ガ糸ヲ断裂スルハ、困難ナリ……！"
  },
  {
    "RowOffset": 821726,
    "RowId": 37104,
    "Text": "絡メ取リ、死ヲモタラソウ！"
  },
  {
    "RowOffset": 821778,
    "RowId": 37105,
    "Text": "牢獄ニ招待シヨウ……。"
  },
  {
    "RowOffset": 821822,
    "RowId": 37106,
    "Text": "我、大監獄パンデモニウムナリ！"
  },
  {
    "RowOffset": 821878,
    "RowId": 37107,
    "Text": "生命ヲ収監スル……！"
  },
  {
    "RowOffset": 821922,
    "RowId": 37108,
    "Text": "ドコニ行コウト、見逃サヌ！"
  },
  {
    "RowOffset": 821974,
    "RowId": 37109,
    "Text": "監獄スベテガ、貴様ノ敵ダ……！"
  },
  {
    "RowOffset": 822030,
    "RowId": 37110,
    "Text": "何度、圧殺シテモ足リヌ！"
  },
  {
    "RowOffset": 822078,
    "RowId": 37111,
    "Text": "アテナ様ノ力……ソノ一片ヲ見ヨ！"
  },
  {
    "RowOffset": 822138,
    "RowId": 37112,
    "Text": "串刺シ、ダ……！"
  },
  {
    "RowOffset": 822174,
    "RowId": 37113,
    "Text": "獄内ノ魔力ヲ解キ放タン！"
  },
  {
    "RowOffset": 822222,
    "RowId": 37114,
    "Text": "地獄ノ呪縛ヲ受ケヨ！"
  },
  {
    "RowOffset": 822266,
    "RowId": 37115,
    "Text": "アテナ様……我ガ母君ノタメ……！"
  },
  {
    "RowOffset": 822326,
    "RowId": 37116,
    "Text": "アテナ様ノタメニ……！"
  },
  {
    "RowOffset": 822370,
    "RowId": 37117,
    "Text": "貴様ノ全力ヲ見セヨ！"
  },
  {
    "RowOffset": 822414,
    "RowId": 37118,
    "Text": "ソノ魂ノ嘆キヲ聞カセヨ！"
  },
  {
    "RowOffset": 822462,
    "RowId": 37119,
    "Text": "コノ器カラ……零レ落チヨウトモ……！"
  },
