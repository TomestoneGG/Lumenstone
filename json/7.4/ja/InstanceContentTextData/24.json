  {
    "RowOffset": 823490,
    "RowId": 37200,
    "Text": "エネミーの強化まで"
  },
  {
    "RowOffset": 823530,
    "RowId": 37201,
    "Text": ""
  },
  {
    "RowOffset": 823542,
    "RowId": 37300,
    "Text": "わしのクリスタルは渡さん！\nしねい！"
  },
  {
    "RowOffset": 823610,
    "RowId": 37301,
    "Text": "なかなかやるな……\nわしのクリスタルの力、見せてやる！"
  },
  {
    "RowOffset": 823706,
    "RowId": 37302,
    "Text": "輝けクリスタルよ！\nわしに力を与えるのだ……！"
  },
  {
    "RowOffset": 823790,
    "RowId": 37303,
    "Text": "ファファファ……力がみなぎってくるわ！！"
  },
  {
    "RowOffset": 823862,
    "RowId": 37304,
    "Text": "こしゃくな！\nええい、負けるものか……！"
  },
  {
    "RowOffset": 823934,
    "RowId": 37305,
    "Text": "クリスタルの輝きがある限り、\nわしに魔法は通用せん！"
  },
