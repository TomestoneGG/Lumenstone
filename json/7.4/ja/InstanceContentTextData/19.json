[
  {
    "RowOffset": 731134,
    "RowId": 34269,
    "Text": "シルキーの撃破"
  },
  {
    "RowOffset": 731166,
    "RowId": 34270,
    "Text": "力の庭の突破"
  },
  {
    "RowOffset": 731198,
    "RowId": 34271,
    "Text": "シラディハ・グラディアトルの撃破"
  },
  {
    "RowOffset": 731258,
    "RowId": 34272,
    "Text": "影火のゼレズ・ガーの撃破"
  },
  {
    "RowOffset": 731306,
    "RowId": 34273,
    "Text": ""
  },
  {
    "RowOffset": 731318,
    "RowId": 34300,
    "Text": "導きの水廊の突破"
  },
  {
    "RowOffset": 731354,
    "RowId": 34301,
    "Text": "知恵の河の突破"
  },
  {
    "RowOffset": 731386,
    "RowId": 34302,
    "Text": "大洋の虚の突破"
  },
  {
    "RowOffset": 731418,
    "RowId": 34303,
    "Text": "風の通り道の突破"
  },
  {
    "RowOffset": 731454,
    "RowId": 34304,
    "Text": "六天座の階の突破"
  },
  {
    "RowOffset": 731490,
    "RowId": 34305,
    "Text": "星天の突破"
  },
  {
    "RowOffset": 731518,
    "RowId": 34306,
    "Text": "航海に大事なもんを教えてやろう！"
  },
  {
    "RowOffset": 731578,
    "RowId": 34307,
    "Text": "海よ風よ、アタシに力を！"
  },
  {
    "RowOffset": 731626,
    "RowId": 34308,
    "Text": "海神の神威を見せてやろう！"
  },
  {
    "RowOffset": 731678,
    "RowId": 34309,
    "Text": "アタシの教えは、なかなか手荒いよ？"
  },
  {
    "RowOffset": 731742,
    "RowId": 34310,
    "Text": "海を統べるアタシについてこれるかな！"
  },
  {
    "RowOffset": 731810,
    "RowId": 34311,
    "Text": "風を味方につけるんだよ！"
  },
  {
    "RowOffset": 731858,
    "RowId": 34312,
    "Text": "アンタたち最高だねぇ！"
  },
  {
    "RowOffset": 731902,
    "RowId": 34313,
    "Text": "白波を越えてゆけ！"
  },
  {
    "RowOffset": 731942,
    "RowId": 34314,
    "Text": "満ち満ちて、大海となれ！"
  },
  {
    "RowOffset": 731990,
    "RowId": 34315,
    "Text": "嵐だ！\u3000吹き荒れな！"
  },
  {
    "RowOffset": 732034,
    "RowId": 34316,
    "Text": "海を分かて、トライデント！"
  },
  {
    "RowOffset": 732086,
    "RowId": 34317,
    "Text": "ハハハッ！\u3000やるじゃないか！"
  },
  {
    "RowOffset": 732142,
    "RowId": 34318,
    "Text": "なかなか頼もしいよ、あんたたち！"
  },
  {
    "RowOffset": 732202,
    "RowId": 34319,
    "Text": "こんなもんじゃないだろう？"
  },
  {
    "RowOffset": 732254,
    "RowId": 34320,
    "Text": "船旅は、仲間と手を取りあって進むもんだ。"
  },
  {
    "RowOffset": 732326,
    "RowId": 34321,
    "Text": "これからの航海……任せたからね……！"
  },
  {
    "RowOffset": 732394,
    "RowId": 34322,
    "Text": "おいで！\u3000ペリュコス、サラオス！"
  },
  {
    "RowOffset": 732454,
    "RowId": 34323,
    "Text": "アタシと一緒にひと暴れだ！"
  },
  {
    "RowOffset": 732506,
    "RowId": 34324,
    "Text": "ペリュコス、サラオス！\n派手にいくよ！"
  },
  {
    "RowOffset": 732578,
    "RowId": 34325,
    "Text": "こいつらも遊びたいってさ！"
  },
  {
    "RowOffset": 732630,
    "RowId": 34326,
    "Text": "いい子だ、アタシの可愛い海蛇たち！"
  },
  {
    "RowOffset": 732694,
    "RowId": 34327,
    "Text": "ペリュコス、行っておいで！"
  },
  {
    "RowOffset": 732746,
    "RowId": 34328,
    "Text": "さすがペリュコス、わかってるじゃないか！"
  },
  {
    "RowOffset": 732818,
    "RowId": 34329,
    "Text": "さぁ、海原を駆けろ！"
  },
  {
    "RowOffset": 732862,
    "RowId": 34330,
    "Text": "サラオス、行っておいで！"
  },
  {
    "RowOffset": 732910,
    "RowId": 34331,
    "Text": "よしよし、サラオスも楽しそうだね！"
  },
  {
    "RowOffset": 732974,
    "RowId": 34332,
    "Text": "さぁ、波間を舞いな！"
  },
  {
    "RowOffset": 733018,
    "RowId": 34333,
    "Text": "コラ！\u3000しゃんとしなッ！"
  },
  {
    "RowOffset": 733066,
    "RowId": 34334,
    "Text": "よく来た……この水天を進んでおいで……。"
  },
  {
    "RowOffset": 733138,
    "RowId": 34335,
    "Text": "どれ、神使と手合わせ願おうか……。"
  },
  {
    "RowOffset": 733202,
    "RowId": 34336,
    "Text": "我が弟子ビエルゴを退けた力は本物か……。"
  },
  {
    "RowOffset": 733274,
    "RowId": 34337,
    "Text": "汝らを歓迎しよう。"
  },
  {
    "RowOffset": 733314,
    "RowId": 34338,
    "Text": "順調じゃないか。\nお次はこっちに乗り込みな！"
  },
  {
    "RowOffset": 733394,
    "RowId": 34339,
    "Text": "総員乗船、船の準備を整えな！"
  },
  {
    "RowOffset": 733450,
    "RowId": 34340,
    "Text": "よーし、出航だ！"
  },
  {
    "RowOffset": 733486,
    "RowId": 34341,
    "Text": "アタシと対峙する準備はできてるかい！？"
  },
  {
    "RowOffset": 733554,
    "RowId": 34342,
    "Text": "ほうら、急ぎな！"
  },
  {
    "RowOffset": 733590,
    "RowId": 34343,
    "Text": "ふさわしい場を拵えてやろうじゃないか！"
  },
  {
    "RowOffset": 733658,
    "RowId": 34344,
    "Text": "こうやって呼びかけるのは、変な気分だ……。"
  },
  {
    "RowOffset": 733734,
    "RowId": 34345,
    "Text": "ここまで来てくれて……感謝してる。"
  },
  {
    "RowOffset": 733798,
    "RowId": 34346,
    "Text": "君たちとの旅も、あと少し……。"
  },
  {
    "RowOffset": 733854,
    "RowId": 34347,
    "Text": "さあ、「先」への門を開こう。"
  },
  {
    "RowOffset": 733910,
    "RowId": 34348,
    "Text": "君との戦いで、俺たちは本来の性質に近づいた。"
  },
  {
    "RowOffset": 733990,
    "RowId": 34349,
    "Text": "最後の仕上げを任せるよ。"
  },
  {
    "RowOffset": 734038,
    "RowId": 34350,
    "Text": "戻ってきた……！\n見てくれ、オムファロスが急に……！"
  },
  {
    "RowOffset": 734130,
    "RowId": 34351,
    "Text": "こいつらは神使……！？\nいったい誰の……！"
  },
  {
    "RowOffset": 734206,
    "RowId": 34352,
    "Text": "そっちは頼む！"
  },
  {
    "RowOffset": 734238,
    "RowId": 34353,
    "Text": "これは……呼ばれている……？"
  },
  {
    "RowOffset": 734294,
    "RowId": 34354,
    "Text": "先へ行ってくれ！\nスノーゲイムたちはオレが護る！"
  },
  {
    "RowOffset": 734378,
    "RowId": 34355,
    "Text": "いよいよか……。"
  },
  {
    "RowOffset": 734414,
    "RowId": 34356,
    "Text": "俺が最後だ、よろしく頼む。"
  },
  {
    "RowOffset": 734466,
    "RowId": 34357,
    "Text": "風よ、山より吹き下ろせ。"
  },
  {
    "RowOffset": 734514,
    "RowId": 34358,
    "Text": "風猛り、人を翻弄せよ……！"
  },
  {
    "RowOffset": 734566,
    "RowId": 34359,
    "Text": "渦巻き集い、高く舞え！"
  },
  {
    "RowOffset": 734610,
    "RowId": 34360,
    "Text": "これが旅神の矢だ……！"
  },
  {
    "RowOffset": 734654,
    "RowId": 34361,
    "Text": "弦よ唸れ！"
  },
  {
    "RowOffset": 734682,
    "RowId": 34362,
    "Text": "風穴が開くぞ……！"
  },
  {
    "RowOffset": 734722,
    "RowId": 34363,
    "Text": "迷わず進むんだ！"
  },
  {
    "RowOffset": 734758,
    "RowId": 34364,
    "Text": "本気で向かってこい……！"
  },
  {
    "RowOffset": 734806,
    "RowId": 34365,
    "Text": "ここが俺たちの旅の終わり……。"
  },
  {
    "RowOffset": 734862,
    "RowId": 34366,
    "Text": "捉えたッ……！"
  },
  {
    "RowOffset": 734894,
    "RowId": 34367,
    "Text": "耐えてみせてくれ！"
  },
  {
    "RowOffset": 734934,
    "RowId": 34368,
    "Text": "隆起せよ……！"
  },
  {
    "RowOffset": 734966,
    "RowId": 34369,
    "Text": "すべてを均してしまえ……！"
  },
  {
    "RowOffset": 735018,
    "RowId": 34370,
    "Text": "人の祈りが、俺たちをここまで強くした……。"
  },
  {
    "RowOffset": 735094,
    "RowId": 34371,
    "Text": "君との戦いで、このエーテルが世界に還元される。"
  },
  {
    "RowOffset": 735174,
    "RowId": 34372,
    "Text": "さあ、神の願いを叶えてくれ！"
  },
  {
    "RowOffset": 735230,
    "RowId": 34373,
    "Text": "ああ……人は本当に強くなったな。"
  },
  {
    "RowOffset": 735290,
    "RowId": 34374,
    "Text": "いくぞ、君たちなら越えられるはずだ……！"
  },
  {
    "RowOffset": 735362,
    "RowId": 34375,
    "Text": "さすがだよ、これなら安心だ。"
  },
  {
    "RowOffset": 735418,
    "RowId": 34376,
    "Text": "君たちを信じさせてくれ。"
  },
  {
    "RowOffset": 735466,
    "RowId": 34377,
    "Text": "この戦いが終われば、俺は……。"
  },
  {
    "RowOffset": 735522,
    "RowId": 34378,
    "Text": "神域に招いたのが、君でよかった。"
  },
  {
    "RowOffset": 735582,
    "RowId": 34379,
    "Text": "別れの寂しさを、教えてくれてありがとう。"
  },
  {
    "RowOffset": 735654,
    "RowId": 34380,
    "Text": "どうか、最後まで歩み続けてくれ……！"
  },
  {
    "RowOffset": 735722,
    "RowId": 34381,
    "Text": "人の旅路に祝福があらんことを。"
  },
  {
    "RowOffset": 735778,
    "RowId": 34382,
    "Text": "君たちに追い風を……。"
  },
  {
    "RowOffset": 735822,
    "RowId": 34383,
    "Text": "旅人は強い。\n君たちの知るように……！"
  },
  {
    "RowOffset": 735894,
    "RowId": 34384,
    "Text": "人よ、最後の望みを叶えたまえ。"
  },
  {
    "RowOffset": 735950,
    "RowId": 34385,
    "Text": "私たちのすべてを、星へ還すのだ！"
  },
  {
    "RowOffset": 736010,
    "RowId": 34386,
    "Text": "十二神の名のもとに！"
  },
  {
    "RowOffset": 736054,
    "RowId": 34387,
    "Text": "さあ、もっと……！"
  },
  {
    "RowOffset": 736094,
    "RowId": 34388,
    "Text": "綺羅星のように、命を輝かせ！"
  },
  {
    "RowOffset": 736150,
    "RowId": 34389,
    "Text": "愛しき子らに慈悲を……！"
  },
  {
    "RowOffset": 736198,
    "RowId": 34390,
    "Text": "手を取りあい、たくましくあれ……！"
  },
  {
    "RowOffset": 736262,
    "RowId": 34391,
    "Text": "退くことはかなわぬ、先に進め……！"
  },
  {
    "RowOffset": 736326,
    "RowId": 34392,
    "Text": "最後の裁定、耐えてみせてくれ！"
  },
  {
    "RowOffset": 736382,
    "RowId": 34393,
    "Text": "思考を巡らせ、力を解き放て！"
  },
  {
    "RowOffset": 736438,
    "RowId": 34394,
    "Text": "挑め、全身全霊を懸けて！"
  },
  {
    "RowOffset": 736486,
    "RowId": 34395,
    "Text": "立て……小さくとも強きものよ！"
  },
  {
    "RowOffset": 736542,
    "RowId": 34396,
    "Text": "受けよ、超えよ、この愛を！"
  },
  {
    "RowOffset": 736594,
    "RowId": 34397,
    "Text": "人は祈り、願い、生きてきた……。"
  },
  {
    "RowOffset": 736654,
    "RowId": 34398,
    "Text": "想いは重なり、私たちを形作った……。"
  },
  {
    "RowOffset": 736722,
    "RowId": 34399,
    "Text": "星よ人よ、一切をここに返さん！"
  },
  {
    "RowOffset": 736778,
    "RowId": 34400,
    "Text": "ああ、よくぞこれほどまでに……。"
  },
  {
    "RowOffset": 736838,
    "RowId": 34401,
    "Text": "アーテリスに祝福を……！"
  },
  {
    "RowOffset": 736886,
    "RowId": 34402,
    "Text": "力はすべて、ここで出し切る……！"
  },
  {
    "RowOffset": 736946,
    "RowId": 34403,
    "Text": "私たちへの信仰が、この力となったのだ！"
  },
  {
    "RowOffset": 737014,
    "RowId": 34404,
    "Text": "メネフィナの権能により、月が形成された……！"
  },
  {
    "RowOffset": 737094,
    "RowId": 34405,
    "Text": "慈愛の月が満ち始める……"
  },
  {
    "RowOffset": 737142,
    "RowId": 34406,
    "Text": "アルジクの権能により、時間が加速する……！"
  },
  {
    "RowOffset": 737218,
    "RowId": 34407,
    "Text": "待っていたよ、愛しい人の子ら……。"
  },
  {
    "RowOffset": 737282,
    "RowId": 34408,
    "Text": "知神の名において、汝らの知を測ろう。"
  },
  {
    "RowOffset": 737350,
    "RowId": 34409,
    "Text": "奔流よ、人の本質を露わにせよ！"
  },
  {
    "RowOffset": 737406,
    "RowId": 34410,
    "Text": "河よ、猛るがいい！"
  },
  {
    "RowOffset": 737446,
    "RowId": 34411,
    "Text": "学問の時間だ、人の子らよ。"
  },
  {
    "RowOffset": 737498,
    "RowId": 34412,
    "Text": "知神の問いに、どう答える……？"
  },
  {
    "RowOffset": 737554,
    "RowId": 34413,
    "Text": "視点を変えれば、異なる解が見えるはず……。"
  },
  {
    "RowOffset": 737630,
    "RowId": 34414,
    "Text": "さぁ、とめどなく思考を巡らせるのだ。"
  },
  {
    "RowOffset": 737698,
    "RowId": 34415,
    "Text": "人の知を証明したまえ……！"
  },
  {
    "RowOffset": 737750,
    "RowId": 34416,
    "Text": "清らかにあれ！"
  },
  {
    "RowOffset": 737782,
    "RowId": 34417,
    "Text": "問答を交わそうじゃないか！"
  },
  {
    "RowOffset": 737834,
    "RowId": 34418,
    "Text": "ただ流れるだけが水に非ず……！"
  },
  {
    "RowOffset": 737890,
    "RowId": 34419,
    "Text": "汝らの考えを教えておくれ。"
  },
  {
    "RowOffset": 737942,
    "RowId": 34420,
    "Text": "力だけでは、出せぬ答えがあるのだよ。"
  },
  {
    "RowOffset": 738010,
    "RowId": 34421,
    "Text": "ふっ……皆が高揚していたのも頷ける……！"
  },
  {
    "RowOffset": 738082,
    "RowId": 34422,
    "Text": "知の深淵へ、汝らを誘おう……！"
  },
  {
    "RowOffset": 738138,
    "RowId": 34423,
    "Text": "利口な子らだ……。"
  },
  {
    "RowOffset": 738178,
    "RowId": 34424,
    "Text": ""
  },
  {
    "RowOffset": 738190,
    "RowId": 34425,
    "Text": ""
  },
  {
    "RowOffset": 738202,
    "RowId": 34426,
    "Text": ""
  },
  {
    "RowOffset": 738214,
    "RowId": 34427,
    "Text": ""
  },
  {
    "RowOffset": 738226,
    "RowId": 34428,
    "Text": ""
  },
  {
    "RowOffset": 738238,
    "RowId": 34429,
    "Text": ""
  },
  {
    "RowOffset": 738250,
    "RowId": 34500,
    "Text": "美味そうなエーテルだ……"
  },
  {
    "RowOffset": 738298,
    "RowId": 34501,
    "Text": "私の髪も、艶めいているぞ……！"
  },
  {
    "RowOffset": 738354,
    "RowId": 34502,
    "Text": "この技が見切れるか！？"
  },
  {
    "RowOffset": 738398,
    "RowId": 34503,
    "Text": "さぁ、受けるがいい！"
  },
  {
    "RowOffset": 738442,
    "RowId": 34504,
    "Text": "断ち斬るッ！"
  },
  {
    "RowOffset": 738474,
    "RowId": 34505,
    "Text": "くらいなッ！"
  },
  {
    "RowOffset": 738506,
    "RowId": 34506,
    "Text": "我が髪は、風のように自由気まま……。"
  },
  {
    "RowOffset": 738574,
    "RowId": 34507,
    "Text": "しなやかに、そして強く……！"
  },
  {
    "RowOffset": 738630,
    "RowId": 34508,
    "Text": "あぁ……いい風が吹いているぞ！"
  },
  {
    "RowOffset": 738686,
    "RowId": 34509,
    "Text": "感じるだろう、この風を……！"
  },
  {
    "RowOffset": 738742,
    "RowId": 34510,
    "Text": "これくらいは凌いでみせるか……。"
  },
  {
    "RowOffset": 738802,
    "RowId": 34511,
    "Text": "ならば、私も本気を出すとしよう……！"
  },
  {
    "RowOffset": 738870,
    "RowId": 34512,
    "Text": "アッハハハハハ……！"
  },
  {
    "RowOffset": 738914,
    "RowId": 34513,
    "Text": "テメェら全員、ブッ殺す！！"
  },
  {
    "RowOffset": 738966,
    "RowId": 34514,
    "Text": "オラオラオラオラァッ！"
  },
  {
    "RowOffset": 739010,
    "RowId": 34515,
    "Text": "ソッコーでケリつけてやるよ！"
  },
  {
    "RowOffset": 739066,
    "RowId": 34516,
    "Text": "ソラソラソラソラァッ！ "
  },
  {
    "RowOffset": 739114,
    "RowId": 34517,
    "Text": "チョーシ乗ってんじゃないよ！"
  },
  {
    "RowOffset": 739170,
    "RowId": 34518,
    "Text": "ホラホラホラホラァッ！"
  },
  {
    "RowOffset": 739214,
    "RowId": 34519,
    "Text": "片っ端から、ブッ壊す！"
  },
  {
    "RowOffset": 739258,
    "RowId": 34520,
    "Text": "ナメてんじゃねぇぞ！？"
  },
  {
    "RowOffset": 739302,
    "RowId": 34521,
    "Text": "目ざわりなんだよ！"
  },
  {
    "RowOffset": 739342,
    "RowId": 34522,
    "Text": "上等だコラァ！"
  },
  {
    "RowOffset": 739374,
    "RowId": 34523,
    "Text": "さぁ、もう一度行くぞ……。"
  },
  {
    "RowOffset": 739426,
    "RowId": 34524,
    "Text": "塵も残さず、ブッ飛ばす！！"
  },
  {
    "RowOffset": 739478,
    "RowId": 34525,
    "Text": "戯れも、そろそろ終わりだ……。"
  },
  {
    "RowOffset": 739534,
    "RowId": 34526,
    "Text": "消え去るがいいッ！"
