    "Text": ""
  },
  {
    "RowOffset": 613494,
    "RowId": 30600,
    "Text": "笑顔あふれる正門への到達"
  },
  {
    "RowOffset": 613542,
    "RowId": 30601,
    "Text": "笑顔あふれる正門の突破"
  },
  {
    "RowOffset": 613586,
    "RowId": 30602,
    "Text": "大歓迎の玄関への到達"
  },
  {
    "RowOffset": 613630,
    "RowId": 30603,
    "Text": "大歓迎の玄関の突破"
  },
  {
    "RowOffset": 613670,
    "RowId": 30604,
    "Text": "ビッグチーズへの到達"
  },
  {
    "RowOffset": 613714,
    "RowId": 30605,
    "Text": "ビッグチーズの撃破"
  },
  {
    "RowOffset": 613754,
    "RowId": 30606,
    "Text": "関係者以外、立入禁止……！\nセキュリティ、強制排除、実行……！"
  },
  {
    "RowOffset": 613862,
    "RowId": 30607,
    "Text": "侵入者、未ダ健在……\nフレームワーカー、スキャニング、実行……！"
  },
  {
    "RowOffset": 613970,
    "RowId": 30608,
    "Text": "あぶないから、はいってはいけません！！\n安全第一で爆殺しまーす！！"
  },
  {
    "RowOffset": 614082,
    "RowId": 30609,
    "Text": "ご迷惑をかけて、まことにすみません！！\n爆破作業は、有資格者がおこなっていまーす！！"
  },
  {
    "RowOffset": 614222,
    "RowId": 30610,
    "Text": "ここは笑顔あふれる街、スマイルトン！\n侵入者のみなさん、生命活動中止の準備はよろしいですか？"
  },
  {
    "RowOffset": 614374,
    "RowId": 30611,
    "Text": "フレームワーカー、スキャニング、完了……\nワーカー・プリントアウト、実行……！"
  },
  {
    "RowOffset": 614506,
    "RowId": 30612,
    "Text": ""
  },
  {
    "RowOffset": 614518,
