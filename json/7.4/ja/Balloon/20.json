  },
  {
    "RowOffset": 571942,
    "RowId": 9777,
    "Dialogue": "衣装も好評ね！",
    "Slowly": false
  },
  {
    "RowOffset": 571978,
    "RowId": 9778,
    "Dialogue": "すごーい！\n旅先でそんなことが…！",
    "Slowly": false
  },
  {
    "RowOffset": 572046,
    "RowId": 9779,
    "Dialogue": "友達ができたみたいだな",
    "Slowly": false
  },
  {
    "RowOffset": 572094,
    "RowId": 9780,
    "Dialogue": "ウキャキャッ！",
    "Slowly": false
  },
  {
    "RowOffset": 572130,
    "RowId": 9781,
    "Dialogue": "ウェーイ！！\nいいパーティーじゃないか！",
    "Slowly": false
  },
  {
    "RowOffset": 572206,
    "RowId": 9782,
    "Dialogue": "イメージが\n湧いてきまちた！",
    "Slowly": false
  },
  {
    "RowOffset": 572266,
    "RowId": 9783,
    "Dialogue": "よしよし\n今日もフカフカだね",
    "Slowly": false
  },
  {
    "RowOffset": 572326,
    "RowId": 9784,
    "Dialogue": "ボクがついていれば\n大丈夫さ！",
    "Slowly": false
  },
  {
    "RowOffset": 572390,
    "RowId": 9785,
    "Dialogue": "私たち\n街を守っていけるかしら",
    "Slowly": false
  },
  {
    "RowOffset": 572454,
    "RowId": 9786,
    "Dialogue": "唸れ、筋肉ゥ！",
    "Slowly": false
  },
  {
    "RowOffset": 572490,
    "RowId": 9787,
    "Dialogue": "砕けろ、瓦礫ィ！",
    "Slowly": false
  },
  {
    "RowOffset": 572530,
    "RowId": 9788,
    "Dialogue": "それ飲んだら\n作業はじめましょう",
    "Slowly": false
  },
  {
    "RowOffset": 572594,
    "RowId": 9789,
    "Dialogue": "ルムルの薬湯は\nよく効くわね",
    "Slowly": false
  },
  {
    "RowOffset": 572654,
    "RowId": 9790,
    "Dialogue": "よっしゃあ！\nまかせとけぇ！",
    "Slowly": false
  },
