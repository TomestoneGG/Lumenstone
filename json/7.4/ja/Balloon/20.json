  },
  {
    "RowOffset": 565782,
    "RowId": 9667,
    "Dialogue": "ウィフーテの奴…\nもう騙されないからな",
    "Slowly": false
  },
  {
    "RowOffset": 565858,
    "RowId": 9668,
    "Dialogue": "永久人を\n利用しやがって！",
    "Slowly": false
  },
  {
    "RowOffset": 565914,
    "RowId": 9669,
    "Dialogue": "みんなの記憶を\n決して無駄にしない…",
    "Slowly": false
  },
  {
    "RowOffset": 565986,
    "RowId": 9670,
    "Dialogue": "今は進むしかないわ",
    "Slowly": false
  },
  {
    "RowOffset": 566030,
    "RowId": 9671,
    "Dialogue": "永久人たちの\n恐怖の記憶が…",
    "Slowly": false
  },
  {
    "RowOffset": 566090,
    "RowId": 9672,
    "Dialogue": "非道なことを…",
    "Slowly": false
  },
  {
    "RowOffset": 566126,
    "RowId": 9673,
    "Dialogue": "カリュクスの奴…！",
    "Slowly": false
  },
  {
    "RowOffset": 566170,
    "RowId": 9674,
    "Dialogue": "決着をつけに行こう",
    "Slowly": false
  },
  {
    "RowOffset": 566214,
    "RowId": 9675,
    "Dialogue": "こっちの勝ちだ\nカリュクス",
    "Slowly": false
  },
  {
    "RowOffset": 566270,
    "RowId": 9676,
    "Dialogue": "やったよ、みんな…！",
    "Slowly": false
  },
  {
    "RowOffset": 566318,
    "RowId": 9677,
    "Dialogue": "本当にこれで\n終わりかしら…",
    "Slowly": false
  },
  {
    "RowOffset": 566378,
    "RowId": 9678,
    "Dialogue": "嫌な予感がするわ…",
    "Slowly": false
  },
  {
    "RowOffset": 566422,
    "RowId": 9679,
    "Dialogue": "今のうちに\n制御装置を壊そう",
    "Slowly": false
  },
  {
    "RowOffset": 566482,
    "RowId": 9680,
    "Dialogue": "これでカリュクスに\n為す術はないわ",
    "Slowly": false
  },
  {
    "RowOffset": 566550,
    "RowId": 9681,
    "Dialogue": "まさか蛮神を\n召喚するとはな",
    "Slowly": false
  },
  {
    "RowOffset": 566610,
    "RowId": 9682,
    "Dialogue": "ジオードさんの分まで\n頑張らないと…",
    "Slowly": false
  },
  {
    "RowOffset": 566682,
    "RowId": 9683,
    "Dialogue": "物資がある以上\n見張りは続けないとね",
    "Slowly": false
  },
  {
    "RowOffset": 566754,
    "RowId": 9684,
    "Dialogue": "くそ…まだ信じられねえ…",
    "Slowly": false
  },
  {
    "RowOffset": 566806,
    "RowId": 9685,
    "Dialogue": "異状なしだ",
    "Slowly": false
  },
  {
    "RowOffset": 566838,
    "RowId": 9686,
    "Dialogue": "ジオードさん…",
    "Slowly": false
  },
  {
    "RowOffset": 566874,
    "RowId": 9687,
    "Dialogue": "この銃はゲノルトさん行きだ",
    "Slowly": false
  },
  {
    "RowOffset": 566930,
    "RowId": 9688,
    "Dialogue": "言葉が出ない…",
    "Slowly": false
  },
  {
    "RowOffset": 566966,
    "RowId": 9689,
    "Dialogue": "仮眠室に行こうか…",
    "Slowly": false
  },
  {
    "RowOffset": 567010,
    "RowId": 9690,
    "Dialogue": "こんなときこそ\nしっかりしないと…",
    "Slowly": false
  },
  {
    "RowOffset": 567078,
    "RowId": 9691,
    "Dialogue": "製造品をガバメントに\n申請しないと",
    "Slowly": false
  },
  {
    "RowOffset": 567146,
    "RowId": 9692,
    "Dialogue": "ジオードさんのためにも…",
    "Slowly": false
  },
  {
    "RowOffset": 567198,
    "RowId": 9693,
    "Dialogue": "セキュリティレベルの高い\n魔法回路を開発中さ",
    "Slowly": false
  },
  {
    "RowOffset": 567282,
    "RowId": 9694,
    "Dialogue": "この一帯の地下反応…\nすごいものがあるな",
    "Slowly": false
  },
  {
    "RowOffset": 567358,
    "RowId": 9695,
    "Dialogue": "例の「パエンナイト」が\nこの地下にまだまだあるのか",
    "Slowly": false
  },
  {
    "RowOffset": 567450,
    "RowId": 9696,
    "Dialogue": "惑星パエンナでも\nエクスプローラー魂だぜ！",
    "Slowly": false
  },
  {
    "RowOffset": 567530,
    "RowId": 9697,
    "Dialogue": "メカオペレーション…\n緊張するなぁ…",
    "Slowly": false
  },
  {
    "RowOffset": 567602,
    "RowId": 9698,
    "Dialogue": "コスモドリルの扱いなら\n任せとけ！",
    "Slowly": false
  },
  {
    "RowOffset": 567670,
    "RowId": 9699,
    "Dialogue": "パエンナイトどこだ～！？",
    "Slowly": false
  },
  {
    "RowOffset": 567722,
    "RowId": 9700,
    "Dialogue": "任務ご苦労様！",
    "Slowly": false
  },
  {
    "RowOffset": 567758,
    "RowId": 9701,
    "Dialogue": "あのパイロットは\n良い仕事をしていたな",
    "Slowly": false
  },
  {
    "RowOffset": 567834,
    "RowId": 9702,
    "Dialogue": "結晶みたいなガラスが\nどんどん生えてくる…",
    "Slowly": false
  },
  {
    "RowOffset": 567914,
    "RowId": 9703,
    "Dialogue": "独特な惑星ですねぇ\nパエンナは…",
    "Slowly": false
  },
  {
    "RowOffset": 567978,
    "RowId": 9704,
    "Dialogue": "メカオペレーションなら\n私に任せときな！",
    "Slowly": false
  },
  {
    "RowOffset": 568054,
    "RowId": 9705,
    "Dialogue": "鍾乳洞での任務かぁ",
    "Slowly": false
  },
  {
    "RowOffset": 568098,
    "RowId": 9706,
    "Dialogue": "出力を加減して…\nスゥ～…ッとな！",
    "Slowly": false
  },
  {
    "RowOffset": 568166,
    "RowId": 9707,
    "Dialogue": "コスモゲイナーって\nこんなに強力なの！？",
    "Slowly": false
  },
  {
    "RowOffset": 568242,
    "RowId": 9708,
    "Dialogue": "素晴らしい活躍だ\nありがとうー！",
    "Slowly": false
  },
  {
    "RowOffset": 568306,
    "RowId": 9709,
    "Dialogue": "ホイールローダー\nカッコいいなぁ～！",
    "Slowly": false
  },
  {
    "RowOffset": 568378,
    "RowId": 9710,
    "Dialogue": "砕いた偏属性クリスタルは\nこちらへ！",
    "Slowly": false
  },
  {
    "RowOffset": 568450,
    "RowId": 9711,
    "Dialogue": "フィールドサーチャーに\n資材を投入して分析だ！",
    "Slowly": false
  },
  {
    "RowOffset": 568538,
    "RowId": 9712,
    "Dialogue": "巨大な偏属性クリスタルを\nローダーで破砕してください！",
    "Slowly": false
  },
  {
    "RowOffset": 568638,
    "RowId": 9713,
    "Dialogue": "ハイ・キャロットキャノン…\n威力は予想以上だ",
    "Slowly": false
  },
  {
    "RowOffset": 568722,
    "RowId": 9714,
    "Dialogue": "焼却した菌床の灰は\nこちらへ！",
    "Slowly": false
  },
  {
    "RowOffset": 568786,
    "RowId": 9715,
    "Dialogue": "フィールドサーチャーで\n隠れた異常菌床を探すぞ！",
    "Slowly": false
  },
  {
    "RowOffset": 568874,
    "RowId": 9716,
    "Dialogue": "巨大な異常菌床を\nローダーで粉砕してくれ！",
    "Slowly": false
  },
  {
    "RowOffset": 568954,
    "RowId": 9717,
    "Dialogue": "ブレードダッシュが\n異常菌床にこうも有効だとは！",
    "Slowly": false
  },
  {
    "RowOffset": 569042,
    "RowId": 9718,
    "Dialogue": "獲得したパエンナイトは\nこちらへ～！",
    "Slowly": false
  },
  {
    "RowOffset": 569114,
    "RowId": 9719,
    "Dialogue": "フィールドサーチャーは\nこの星でも正常稼働中だな",
    "Slowly": false
  },
  {
    "RowOffset": 569202,
    "RowId": 9720,
    "Dialogue": "エネルギーが溜まったら\n流砂の穴にビームを撃って～！",
    "Slowly": false
  },
  {
    "RowOffset": 569298,
    "RowId": 9721,
    "Dialogue": "ビームのエネルギーは\n雷気イオンを吸収して貯めよう",
    "Slowly": false
  },
  {
    "RowOffset": 569390,
    "RowId": 9722,
    "Dialogue": "吸引したガラス片は\nここに納品を！",
    "Slowly": false
  },
  {
    "RowOffset": 569458,
    "RowId": 9723,
    "Dialogue": "フィールドサーチャー…\nガラス塊を見つけてくれよ",
    "Slowly": false
  },
  {
    "RowOffset": 569546,
    "RowId": 9724,
    "Dialogue": "でかいガラス塊は\nローダーが破砕してくれ！",
    "Slowly": false
  },
  {
    "RowOffset": 569626,
    "RowId": 9725,
    "Dialogue": "プラズマ・ブレードダッシュ…\n素晴らしい力です！",
    "Slowly": false
  },
  {
    "RowOffset": 569714,
    "RowId": 9726,
    "Dialogue": "先生も飾りタマゴと共に\n木の根元でじっと…フフ…",
    "Slowly": false
  },
  {
    "RowOffset": 569802,
    "RowId": 9727,
    "Dialogue": "ホッホウ！\n皆、似合っておりますな！",
    "Slowly": false
  },
  {
    "RowOffset": 569874,
    "RowId": 9728,
    "Dialogue": "噂の魔物も\n対処できたらしいな",
    "Slowly": false
  },
  {
    "RowOffset": 569938,
    "RowId": 9729,
    "Dialogue": "祝祭なんだから\nいいだろ！",
    "Slowly": false
  },
  {
    "RowOffset": 569994,
    "RowId": 9730,
    "Dialogue": "チッ\n視界が悪い…",
    "Slowly": false
  },
  {
    "RowOffset": 570038,
    "RowId": 9731,
    "Dialogue": "こういうデザインも\nたまにはいいですね",
    "Slowly": false
  },
  {
    "RowOffset": 570114,
    "RowId": 9732,
    "Dialogue": "ククク…\n似合ってるぜ",
    "Slowly": false
  },
  {
    "RowOffset": 570166,
    "RowId": 9733,
    "Dialogue": "ミララ族はこの地に残って\nトレノを護ってきたんだね…",
    "Slowly": false
  },
  {
    "RowOffset": 570262,
    "RowId": 9734,
    "Dialogue": "障壁のおかげか\n雷エーテルが穏やかね",
    "Slowly": false
  },
  {
    "RowOffset": 570334,
    "RowId": 9735,
    "Dialogue": "住民に負傷者がいるなら\n手当を急がないと…",
    "Slowly": false
  },
  {
    "RowOffset": 570414,
    "RowId": 9736,
    "Dialogue": "静かになったな…\n住民は無事だろうか",
    "Slowly": false
  },
  {
    "RowOffset": 570486,
    "RowId": 9737,
    "Dialogue": "",
    "Slowly": false
  },
