    "RowId": 9777,
    "Dialogue": "衣装も好評ね！",
    "Slowly": false
  },
  {
    "RowId": 9778,
    "Dialogue": "すごーい！\n旅先でそんなことが…！",
    "Slowly": false
  },
  {
    "RowId": 9779,
    "Dialogue": "友達ができたみたいだな",
    "Slowly": false
  },
  {
    "RowId": 9780,
    "Dialogue": "ウキャキャッ！",
    "Slowly": false
  },
  {
    "RowId": 9781,
    "Dialogue": "ウェーイ！！\nいいパーティーじゃないか！",
    "Slowly": false
  },
  {
    "RowId": 9782,
    "Dialogue": "イメージが\n湧いてきまちた！",
    "Slowly": false
  },
  {
    "RowId": 9783,
    "Dialogue": "よしよし\n今日もフカフカだね",
    "Slowly": false
  },
  {
    "RowId": 9784,
    "Dialogue": "ボクがついていれば\n大丈夫さ！",
    "Slowly": false
  },
  {
    "RowId": 9785,
    "Dialogue": "私たち\n街を守っていけるかしら",
    "Slowly": false
  },
  {
    "RowId": 9786,
    "Dialogue": "唸れ、筋肉ゥ！",
    "Slowly": false
  },
  {
    "RowId": 9787,
    "Dialogue": "砕けろ、瓦礫ィ！",
    "Slowly": false
  },
  {
    "RowId": 9788,
    "Dialogue": "それ飲んだら\n作業はじめましょう",
    "Slowly": false
  },
  {
    "RowId": 9789,
    "Dialogue": "ルムルの薬湯は\nよく効くわね",
    "Slowly": false
  },
  {
    "RowId": 9790,
    "Dialogue": "よっしゃあ！\nまかせとけぇ！",
    "Slowly": false
