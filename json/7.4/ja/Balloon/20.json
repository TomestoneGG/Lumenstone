    "Slowly": false
  },
  {
    "RowId": 9750,
    "Dialogue": "おい、しっかりしろ！",
    "Slowly": false
  },
  {
    "RowId": 9751,
    "Dialogue": "いたたた…",
    "Slowly": false
  },
  {
    "RowId": 9752,
    "Dialogue": "綺麗に咲いたね…",
    "Slowly": false
  },
  {
    "RowId": 9753,
    "Dialogue": "う、うおお…！\nこのくらい自力で…",
    "Slowly": false
  },
  {
    "RowId": 9754,
    "Dialogue": "ほんとに\n助けなくて平気！？",
    "Slowly": false
  },
  {
    "RowId": 9755,
    "Dialogue": "魔物…\nもう、いない…？",
    "Slowly": false
  },
  {
    "RowId": 9756,
    "Dialogue": "大丈夫だから\n復旧作業やるぞ！",
    "Slowly": false
  },
  {
    "RowId": 9757,
    "Dialogue": "街の外から\n人が来たんだって！",
    "Slowly": false
  },
  {
    "RowId": 9758,
    "Dialogue": "戦ったあとの薬湯が\n染みるわぁ",
    "Slowly": false
  },
  {
    "RowId": 9759,
    "Dialogue": "避難するにしても\nしのげるの…？",
    "Slowly": false
  },
  {
    "RowId": 9760,
    "Dialogue": "やったやった！\nお祝いしなきゃ！",
    "Slowly": false
  },
  {
    "RowId": 9761,
    "Dialogue": "お客人だなんて\n何年振りだ？",
    "Slowly": false
  },
  {
    "RowId": 9762,
    "Dialogue": "この酸味が\nクセになるよな",
    "Slowly": false
  },
  {
    "RowId": 9763,
    "Dialogue": "最悪の事態は\n覚悟しないと…",
    "Slowly": false
  },
  {
    "RowId": 9764,
    "Dialogue": "ド派手に\n祭りでもやるか！",
    "Slowly": false
  },
  {
    "RowId": 9765,
    "Dialogue": "まずはここを\n片付けるぞー！",
    "Slowly": false
  },
  {
    "RowId": 9766,
    "Dialogue": "ぼくたち仲良しだよね…？\n噛まないでね？",
    "Slowly": false
  },
  {
    "RowId": 9767,
    "Dialogue": "カードゲーム大会\nまたやりたいなぁ",
    "Slowly": false
  },
  {
    "RowId": 9768,
    "Dialogue": "残りの12枚\nどこにあったっけな…",
    "Slowly": false
  },
