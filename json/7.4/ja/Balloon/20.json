  },
  {
    "RowId": 9660,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9661,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9662,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9663,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9664,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9665,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9666,
    "Dialogue": "",
    "Slowly": false
  },
  {
    "RowId": 9667,
    "Dialogue": "ウィフーテの奴…\nもう騙されないからな",
    "Slowly": false
  },
  {
    "RowId": 9668,
    "Dialogue": "永久人を\n利用しやがって！",
    "Slowly": false
  },
  {
    "RowId": 9669,
    "Dialogue": "みんなの記憶を\n決して無駄にしない…",
    "Slowly": false
  },
  {
    "RowId": 9670,
    "Dialogue": "今は進むしかないわ",
    "Slowly": false
  },
  {
    "RowId": 9671,
    "Dialogue": "永久人たちの\n恐怖の記憶が…",
    "Slowly": false
  },
  {
    "RowId": 9672,
    "Dialogue": "非道なことを…",
    "Slowly": false
  },
  {
    "RowId": 9673,
    "Dialogue": "カリュクスの奴…！",
    "Slowly": false
  },
  {
    "RowId": 9674,
    "Dialogue": "決着をつけに行こう",
    "Slowly": false
  },
  {
    "RowId": 9675,
    "Dialogue": "こっちの勝ちだ\nカリュクス",
    "Slowly": false
  },
  {
    "RowId": 9676,
    "Dialogue": "やったよ、みんな…！",
    "Slowly": false
  },
  {
    "RowId": 9677,
    "Dialogue": "本当にこれで\n終わりかしら…",
    "Slowly": false
  },
  {
    "RowId": 9678,
    "Dialogue": "嫌な予感がするわ…",
    "Slowly": false
  },
  {
    "RowId": 9679,
    "Dialogue": "今のうちに\n制御装置を壊そう",
    "Slowly": false
  },
  {
    "RowId": 9680,
    "Dialogue": "これでカリュクスに\n為す術はないわ",
    "Slowly": false
  },
  {
    "RowId": 9681,
    "Dialogue": "まさか蛮神を\n召喚するとはな",
    "Slowly": false
  },
  {
    "RowId": 9682,
    "Dialogue": "ジオードさんの分まで\n頑張らないと…",
    "Slowly": false
  },
  {
    "RowId": 9683,
    "Dialogue": "物資がある以上\n見張りは続けないとね",
    "Slowly": false
  },
  {
    "RowId": 9684,
    "Dialogue": "くそ…まだ信じられねえ…",
    "Slowly": false
  },
  {
    "RowId": 9685,
    "Dialogue": "異状なしだ",
    "Slowly": false
  },
  {
    "RowId": 9686,
    "Dialogue": "ジオードさん…",
    "Slowly": false
  },
  {
    "RowId": 9687,
    "Dialogue": "この銃はゲノルトさん行きだ",
    "Slowly": false
  },
  {
    "RowId": 9688,
    "Dialogue": "言葉が出ない…",
    "Slowly": false
  },
  {
    "RowId": 9689,
    "Dialogue": "仮眠室に行こうか…",
    "Slowly": false
  },
  {
    "RowId": 9690,
    "Dialogue": "こんなときこそ\nしっかりしないと…",
    "Slowly": false
  },
  {
    "RowId": 9691,
    "Dialogue": "製造品をガバメントに\n申請しないと",
    "Slowly": false
  },
  {
    "RowId": 9692,
    "Dialogue": "ジオードさんのためにも…",
    "Slowly": false
  },
  {
    "RowId": 9693,
    "Dialogue": "セキュリティレベルの高い\n魔法回路を開発中さ",
    "Slowly": false
  },
  {
    "RowId": 9694,
    "Dialogue": "この一帯の地下反応…\nすごいものがあるな",
    "Slowly": false
  },
  {
    "RowId": 9695,
    "Dialogue": "例の「パエンナイト」が\nこの地下にまだまだあるのか",
    "Slowly": false
  },
  {
    "RowId": 9696,
    "Dialogue": "惑星パエンナでも\nエクスプローラー魂だぜ！",
    "Slowly": false
  },
  {
    "RowId": 9697,
    "Dialogue": "メカオペレーション…\n緊張するなぁ…",
    "Slowly": false
  },
  {
    "RowId": 9698,
    "Dialogue": "コスモドリルの扱いなら\n任せとけ！",
    "Slowly": false
  },
  {
    "RowId": 9699,
    "Dialogue": "パエンナイトどこだ～！？",
    "Slowly": false
  },
  {
    "RowId": 9700,
    "Dialogue": "任務ご苦労様！",
    "Slowly": false
  },
  {
    "RowId": 9701,
    "Dialogue": "あのパイロットは\n良い仕事をしていたな",
    "Slowly": false
  },
  {
    "RowId": 9702,
    "Dialogue": "結晶みたいなガラスが\nどんどん生えてくる…",
    "Slowly": false
  },
  {
    "RowId": 9703,
    "Dialogue": "独特な惑星ですねぇ\nパエンナは…",
    "Slowly": false
  },
  {
    "RowId": 9704,
    "Dialogue": "メカオペレーションなら\n私に任せときな！",
    "Slowly": false
  },
  {
    "RowId": 9705,
    "Dialogue": "鍾乳洞での任務かぁ",
    "Slowly": false
  },
  {
    "RowId": 9706,
    "Dialogue": "出力を加減して…\nスゥ～…ッとな！",
    "Slowly": false
  },
  {
    "RowId": 9707,
    "Dialogue": "コスモゲイナーって\nこんなに強力なの！？",
    "Slowly": false
  },
  {
    "RowId": 9708,
    "Dialogue": "素晴らしい活躍だ\nありがとうー！",
    "Slowly": false
  },
  {
    "RowId": 9709,
    "Dialogue": "ホイールローダー\nカッコいいなぁ～！",
    "Slowly": false
  },
  {
    "RowId": 9710,
    "Dialogue": "砕いた偏属性クリスタルは\nこちらへ！",
    "Slowly": false
  },
  {
    "RowId": 9711,
    "Dialogue": "フィールドサーチャーに\n資材を投入して分析だ！",
    "Slowly": false
  },
  {
    "RowId": 9712,
    "Dialogue": "巨大な偏属性クリスタルを\nローダーで破砕してください！",
    "Slowly": false
  },
  {
    "RowId": 9713,
    "Dialogue": "ハイ・キャロットキャノン…\n威力は予想以上だ",
    "Slowly": false
  },
  {
    "RowId": 9714,
    "Dialogue": "焼却した菌床の灰は\nこちらへ！",
    "Slowly": false
  },
  {
    "RowId": 9715,
    "Dialogue": "フィールドサーチャーで\n隠れた異常菌床を探すぞ！",
    "Slowly": false
  },
  {
    "RowId": 9716,
    "Dialogue": "巨大な異常菌床を\nローダーで粉砕してくれ！",
    "Slowly": false
  },
  {
    "RowId": 9717,
    "Dialogue": "ブレードダッシュが\n異常菌床にこうも有効だとは！",
    "Slowly": false
  },
  {
    "RowId": 9718,
    "Dialogue": "獲得したパエンナイトは\nこちらへ～！",
    "Slowly": false
  },
  {
    "RowId": 9719,
    "Dialogue": "フィールドサーチャーは\nこの星でも正常稼働中だな",
    "Slowly": false
  },
  {
    "RowId": 9720,
    "Dialogue": "エネルギーが溜まったら\n流砂の穴にビームを撃って～！",
    "Slowly": false
  },
  {
    "RowId": 9721,
    "Dialogue": "ビームのエネルギーは\n雷気イオンを吸収して貯めよう",
    "Slowly": false
  },
  {
    "RowId": 9722,
    "Dialogue": "吸引したガラス片は\nここに納品を！",
    "Slowly": false
  },
  {
    "RowId": 9723,
    "Dialogue": "フィールドサーチャー…\nガラス塊を見つけてくれよ",
    "Slowly": false
  },
  {
    "RowId": 9724,
    "Dialogue": "でかいガラス塊は\nローダーが破砕してくれ！",
    "Slowly": false
  },
  {
    "RowId": 9725,
    "Dialogue": "プラズマ・ブレードダッシュ…\n素晴らしい力です！",
    "Slowly": false
  },
  {
    "RowId": 9726,
    "Dialogue": "先生も飾りタマゴと共に\n木の根元でじっと…フフ…",
    "Slowly": false
  },
  {
    "RowId": 9727,
    "Dialogue": "ホッホウ！\n皆、似合っておりますな！",
    "Slowly": false
  },
  {
    "RowId": 9728,
    "Dialogue": "噂の魔物も\n対処できたらしいな",
    "Slowly": false
  },
  {
    "RowId": 9729,
    "Dialogue": "祝祭なんだから\nいいだろ！",
    "Slowly": false
  },
  {
    "RowId": 9730,
    "Dialogue": "チッ\n視界が悪い…",
    "Slowly": false
  },
  {
    "RowId": 9731,
    "Dialogue": "こういうデザインも\nたまにはいいですね",
    "Slowly": false
  },
  {
    "RowId": 9732,
    "Dialogue": "ククク…\n似合ってるぜ",
    "Slowly": false
  },
  {
    "RowId": 9733,
    "Dialogue": "ミララ族はこの地に残って\nトレノを護ってきたんだね…",
    "Slowly": false
  },
  {
    "RowId": 9734,
    "Dialogue": "障壁のおかげか\n雷エーテルが穏やかね",
    "Slowly": false
  },
  {
    "RowId": 9735,
    "Dialogue": "住民に負傷者がいるなら\n手当を急がないと…",
    "Slowly": false
  },
  {
    "RowId": 9736,
    "Dialogue": "静かになったな…\n住民は無事だろうか",
    "Slowly": false
  },
  {
    "RowId": 9737,
    "Dialogue": "",
    "Slowly": false
  },
