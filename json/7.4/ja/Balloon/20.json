    "Slowly": false
  },
  {
    "RowOffset": 570694,
    "RowId": 9750,
    "Dialogue": "おい、しっかりしろ！",
    "Slowly": false
  },
  {
    "RowOffset": 570742,
    "RowId": 9751,
    "Dialogue": "いたたた…",
    "Slowly": false
  },
  {
    "RowOffset": 570774,
    "RowId": 9752,
    "Dialogue": "綺麗に咲いたね…",
    "Slowly": false
  },
  {
    "RowOffset": 570814,
    "RowId": 9753,
    "Dialogue": "う、うおお…！\nこのくらい自力で…",
    "Slowly": false
  },
  {
    "RowOffset": 570882,
    "RowId": 9754,
    "Dialogue": "ほんとに\n助けなくて平気！？",
    "Slowly": false
  },
  {
    "RowOffset": 570942,
    "RowId": 9755,
    "Dialogue": "魔物…\nもう、いない…？",
    "Slowly": false
  },
  {
    "RowOffset": 570994,
    "RowId": 9756,
    "Dialogue": "大丈夫だから\n復旧作業やるぞ！",
    "Slowly": false
  },
  {
    "RowOffset": 571058,
    "RowId": 9757,
    "Dialogue": "街の外から\n人が来たんだって！",
    "Slowly": false
  },
  {
    "RowOffset": 571122,
    "RowId": 9758,
    "Dialogue": "戦ったあとの薬湯が\n染みるわぁ",
    "Slowly": false
  },
  {
    "RowOffset": 571186,
    "RowId": 9759,
    "Dialogue": "避難するにしても\nしのげるの…？",
    "Slowly": false
  },
  {
    "RowOffset": 571250,
    "RowId": 9760,
    "Dialogue": "やったやった！\nお祝いしなきゃ！",
    "Slowly": false
  },
  {
    "RowOffset": 571314,
    "RowId": 9761,
    "Dialogue": "お客人だなんて\n何年振りだ？",
    "Slowly": false
  },
  {
    "RowOffset": 571374,
    "RowId": 9762,
    "Dialogue": "この酸味が\nクセになるよな",
    "Slowly": false
  },
  {
    "RowOffset": 571430,
    "RowId": 9763,
    "Dialogue": "最悪の事態は\n覚悟しないと…",
    "Slowly": false
  },
  {
    "RowOffset": 571490,
    "RowId": 9764,
    "Dialogue": "ド派手に\n祭りでもやるか！",
    "Slowly": false
  },
  {
    "RowOffset": 571546,
    "RowId": 9765,
    "Dialogue": "まずはここを\n片付けるぞー！",
    "Slowly": false
  },
  {
    "RowOffset": 571606,
    "RowId": 9766,
    "Dialogue": "ぼくたち仲良しだよね…？\n噛まないでね？",
    "Slowly": false
  },
  {
    "RowOffset": 571682,
    "RowId": 9767,
    "Dialogue": "カードゲーム大会\nまたやりたいなぁ",
    "Slowly": false
  },
  {
    "RowOffset": 571750,
    "RowId": 9768,
    "Dialogue": "残りの12枚\nどこにあったっけな…",
    "Slowly": false
