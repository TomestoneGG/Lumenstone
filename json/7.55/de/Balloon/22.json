    "Slowly": false
  },
  {
    "RowId": 10540,
    "Dialogue": "Er ist revitalisiert!",
    "Slowly": false
  },
  {
    "RowId": 10541,
    "Dialogue": "Nyam, nyam, nyam \\\\<schnarch> So angehnem... Zzzzz... warm...",
    "Slowly": false
  },
  {
    "RowId": 10542,
    "Dialogue": "Muhahahaaa! Nun ist es so weit, ich habe mich erbarmt! Meine Anwesenheit soll auch dies smaragdfarbene Gestirn in absolute Dunkelheit hüllen! ",
    "Slowly": false
  },
  {
    "RowId": 10543,
    "Dialogue": "So einen Hintergrund findet man nicht alle Tage!",
    "Slowly": false
  },
  {
    "RowId": 10544,
    "Dialogue": "Puh! Gerade noch rechtzeitig!",
    "Slowly": false
  },
  {
    "RowId": 10545,
    "Dialogue": "Jetzt ergibt alles Sinn...",
    "Slowly": false
  },
  {
    "RowId": 10546,
    "Dialogue": "Du elender... Runter da! <i>Sofort</i>!",
    "Slowly": false
  },
  {
    "RowId": 10547,
    "Dialogue": "Das schreit nach einem Prosit!",
    "Slowly": false
  },
  {
