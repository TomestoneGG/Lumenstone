  },
  {
    "RowId": 10529,
    "Dialogue": "Was sind denn diese Vorrichtungen?",
    "Slowly": false
  },
  {
    "RowId": 10530,
    "Dialogue": "Bald soll es ihm wieder besser gehen.",
    "Slowly": false
  },
  {
    "RowId": 10531,
    "Dialogue": "Der Blütenturmling!",
    "Slowly": false
  },
  {
    "RowId": 10532,
    "Dialogue": "Er ist revitalisiert!",
    "Slowly": false
  },
  {
    "RowId": 10533,
    "Dialogue": "Die heben alle ab, was?",
    "Slowly": false
  },
  {
    "RowId": 10534,
    "Dialogue": "Wir machen die Drohnen einsatzbereit!",
    "Slowly": false
  },
  {
    "RowId": 10535,
    "Dialogue": "Eine Brücke!",
    "Slowly": false
  },
  {
    "RowId": 10536,
    "Dialogue": "Jetzt geht's nach drüben!",
    "Slowly": false
  },
  {
    "RowId": 10537,
    "Dialogue": "Was der wohl so kann...?",
    "Slowly": false
  },
  {
    "RowId": 10538,
    "Dialogue": "Inmitten der Finsternis, ein Hoffnungsschimmer!",
    "Slowly": false
  },
  {
    "RowId": 10539,
