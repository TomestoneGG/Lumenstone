  {
    "RowId": 13001,
    "Text": "Mentor Certification"
  },
  {
    "RowId": 13002,
    "Text": "<String>StringParameter(1)</String>"
  },
  {
    "RowId": 13003,
    "Text": "You will receive the following mentor certification:"
  },
  {
    "RowId": 13004,
    "Text": "・<Icon>79</Icon> Battle Mentor"
  },
  {
    "RowId": 13005,
    "Text": "・<Icon>80</Icon> Trade Mentor"
  },
  {
    "RowId": 13006,
    "Text": "Mentors are expected to:\n\u3000・Provide gameplay advice for new adventurers.\n\u3000・Be an exemplar for player etiquette.\n\u3000・Invite new adventurers to the Novice Network, and answer their queries in the chat channel."
  },
  {
    "RowId": 13007,
    "Text": ""
  },
  {
    "RowId": 13008,
    "Text": "Accept terms."
  },
  {
    "RowId": 13009,
    "Text": "Obtain Mentor Certification"
  },
  {
    "RowId": 13010,
    "Text": "Cancel"
  },
  {
    "RowId": 13011,
    "Text": "※Inappropriate mentor behavior may be reported."
  },
  {
    "RowId": 13012,
    "Text": "The requirements for becoming a mentor have been updated. Mentor certification must be renewed during the period covered by the current patch."
  },
  {
    "RowId": 13013,
    "Text": "Players who applied for mentor certification prior to the requirements being updated must apply again. For details, speak with a Smith."
  },
  {
    "RowId": 13014,
    "Text": "Close"
  },
  {
    "RowId": 13015,
    "Text": "The mentor certification renewal period has ended."
  },
  {
    "RowId": 13016,
    "Text": "Your mentor certification has been revoked due to failure to renew it during the specified period.\n\nIf you wish to regain your mentor status, speak with a Smith once you have fulfilled the updated requirements."
  },
  {
    "RowId": 13017,
    "Text": "Close"
  },
  {
    "RowId": 13018,
    "Text": "5: Complete any level <Num>IntegerParameter(1)</Num> melee DPS or ranged DPS role quest."
  },
  {
    "RowId": 13019,
    "Text": "2: Synthesize 100 collectables."
  },
  {
    "RowId": 13020,
    "Text": "3: Reach level <Num>IntegerParameter(1)</Num> in any Disciple of the Land class."
  },
  {
    "RowId": 13021,
    "Text": "4: Reach level <Num>IntegerParameter(1)</Num> in any Disciple of the Hand class."
  },
  {
    "RowId": 13022,
    "Text": "All mentor certifications attained."
  },
  {
    "RowId": 13023,
    "Text": "Close"
  },
  {
    "RowId": 13024,
    "Text": ""
  },
  {
    "RowId": 13025,
    "Text": "Do not display again."
  },
  {
    "RowId": 13026,
    "Text": "Warning: If you do not renew your mentor certification during the designated renewal period, your mentor status will be revoked, and you will lose access to mentor-specific features and bonuses. Please be sure to renew in a timely fashion."
  },
  {
    "RowId": 13027,
    "Text": ""
  },
  {
    "RowId": 13028,
    "Text": ""
  },
  {
    "RowId": 13029,
    "Text": ""
  },
  {
    "RowId": 13030,
    "Text": "Limited Leveling Roulette"
  },
  {
    "RowId": 13031,
    "Text": "Limit the roulette to duties of an appropriate difficulty based on the level of party members.\n\nThe duty chosen will be within eight levels of the lowest level party member. For example, should the lowest character level in the party be 70, a duty ranging from level 63 to 70 will be chosen.\n\nThe following requirements must be met to enable this option:\n・Parties must meet minimum size requirements.\n・Parties must meet entry requirements for two or more duties.\n\n<span style=\"color: #ff8080;\">※Only the party leader's settings are applicable.</span>"
  },
  {
    "RowId": 13032,
    "Text": "Summon Striking Dummy"
  },
  {
