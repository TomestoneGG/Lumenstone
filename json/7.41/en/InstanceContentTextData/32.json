  {
    "RowId": 41700,
    "Text": "Drown in true Darkness!"
  },
  {
    "RowId": 41701,
    "Text": "Darkness as my blade!"
  },
  {
    "RowId": 41702,
    "Text": "Nothingness rules over all!"
  },
  {
    "RowId": 41703,
    "Text": "My clouds shall smother Light!"
  },
  {
    "RowId": 41704,
    "Text": "Darkest Darkness awaits!"
  },
  {
    "RowId": 41705,
    "Text": "Begone with you!"
  },
  {
    "RowId": 41706,
    "Text": "I will exterminate you like the vermin you are!"
  },
  {
    "RowId": 41707,
    "Text": "Both Darkness and Light in my hands..."
  },
  {
    "RowId": 41708,
    "Text": "All shall know oblivion's sweet embrace..."
  },
  {
    "RowId": 41709,
    "Text": "Death is but a prelude to nothingness..."
  },
  {
    "RowId": 41710,
    "Text": "Winds of Darkness, usher all unto oblivion!"
  },
  {
    "RowId": 41711,
    "Text": "Death abide in my breast!"
  },
  {
    "RowId": 41712,
    "Text": "Wind abide in my breast!"
  },
  {
    "RowId": 41713,
    "Text": "The Darkness...will not be contained!"
  },
  {
    "RowId": 41714,
    "Text": "Become silent stone!"
  },
  {
    "RowId": 41715,
    "Text": "You shall not escape!"
  },
