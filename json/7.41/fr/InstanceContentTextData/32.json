  {
    "RowId": 41700,
    "Text": "Bientôt, vous ne ferez plus qu'un avec les Ténèbres!"
  },
  {
    "RowId": 41701,
    "Text": "Que les Ténèbres enveloppent mes lames!"
  },
  {
    "RowId": 41702,
    "Text": "Le néant enveloppera tout!"
  },
  {
    "RowId": 41703,
    "Text": "Jamais la Lumière ne percera ce nuage!"
  },
  {
    "RowId": 41704,
    "Text": "Sombrez dans l'abîme!"
  },
  {
    "RowId": 41705,
    "Text": "Soyez anéantis!"
  },
  {
    "RowId": 41706,
    "Text": "Je vais vous exterminer comme les insectes que vous êtes!"
  },
  {
    "RowId": 41707,
    "Text": "Ténèbres... Lumière... Lovés dans mes bras..."
  },
  {
    "RowId": 41708,
    "Text": "Acceptez la caresse du néant..."
  },
  {
    "RowId": 41709,
    "Text": "La mort n'est que le commencement..."
  },
  {
    "RowId": 41710,
    "Text": "Que le tumulte ténébreux vous emporte!"
  },
  {
    "RowId": 41711,
    "Text": "Plénitude de la mort... Je t'attire en mon sein!"
  },
  {
    "RowId": 41712,
    "Text": "Impétuosité des vents... Je t'attire en mon sein!"
  },
  {
    "RowId": 41713,
    "Text": "Je n'arrive plus à contenir... le pouvoir des Ténèbres!"
  },
  {
    "RowId": 41714,
    "Text": "Soyez réduits à l'état de pierres!"
  },
  {
    "RowId": 41715,
    "Text": "Essayez donc d'éviter ça!"
  },
