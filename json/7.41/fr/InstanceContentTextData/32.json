  {
    "RowId": 42000,
    "Text": "Oh là là... Brute Bombinator veut en découdre hors du ring!"
  },
  {
    "RowId": 42001,
    "Text": "Notre challenger va devoir affronter une multitude d'âmes combinées en une chimère infernale!"
  },
  {
    "RowId": 42002,
    "Text": "Impossible! La puissance combinée des créatures a permis de créer une arme!"
  },
  {
    "RowId": 42003,
    "Text": "Tiens... Les graines éparpillées se sont transformées en monstres!"
  },
  {
    "RowId": 42004,
    "Text": "Houlà! Notre caméra a été pétrifiée par la dernière attaque!"
  },
  {
    "RowId": 42005,
    "Text": "Quel souffle! Brute Bombinator envoie valdinguer le challenger!"
  },
  {
    "RowId": 42006,
    "Text": "Comment est-ce possible? Brute Bombinator s'accroche aux murs!"
  },
  {
    "RowId": 42007,
    "Text": "Il saute de mur en mur!"
  },
  {
    "RowId": 42008,
    "Text": "Incroyable démonstration de force! Le sol de l'arène n'a pas résisté!"
  },
  {
    "RowId": 42009,
    "Text": "Notre caméra va s'empresser de suivre les combattants!"
  },
  {
    "RowId": 42010,
    "Text": "Apparemment, la destruction du sol a causé un incendie!"
  },
  {
    "RowId": 42011,
    "Text": "Un lariat! Est-ce la conscience de Brute Bomber qui resurgit?"
  },
  {
    "RowId": 42012,
    "Text": "Hallucinant! La puissance cumulée de ces monstres est à couper le souffle!"
  },
  {
    "RowId": 42013,
    "Text": "Notre challenger a réussi à éviter tous les coups de son adversaire!"
  },
  {
    "RowId": 42014,
    "Text": "Et encore une attaque dévastatrice! Mais notre challenger tient bon!"
  },
  {
    "RowId": 42015,
    "Text": "Quel combat acharné! J'en ai des palpitations!"
  },
  {
    "RowId": 42016,
    "Text": "Vaincre Brute Bombinator"
