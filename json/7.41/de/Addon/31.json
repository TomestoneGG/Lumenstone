    "RowId": 15418,
    "Text": "Abbrechen"
  },
  {
    "RowId": 15419,
    "Text": "Nach zufälliger Gruppe suchen und zu viert betreten"
  },
  {
    "RowId": 15420,
    "Text": "Wird mit zufälliger Gruppe aus vier Spielern betreten."
  },
  {
    "RowId": 15421,
    "Text": "Kann nur als feste Gruppe aus vier Spielern betreten werden."
  },
  {
    "RowId": 15422,
    "Text": "Teilnehmen"
  },
  {
    "RowId": 15423,
    "Text": "Seiten <Num>IntegerParameter(1)</Num>/<Num>IntegerParameter(2)</Num>"
  },
  {
    "RowId": 15424,
    "Text": "Auf dieser Seite steht noch nichts geschrieben ..."
  },
  {
    "RowId": 15425,
    "Text": "Leere Seite"
  },
  {
    "RowId": 15426,
    "Text": "Im Erkundungsbericht lesen"
  },
  {
    "RowId": 15427,
    "Text": "Erklärung zur Gewölbesuche anzeigen"
  },
  {
    "RowId": 15428,
    "Text": "GEWÖLBESUCHE-HILFE"
  },
  {
    "RowId": 15429,
    "Text": ""
  },
  {
    "RowId": 15430,
    "Text": "Den Inhalt wirklich alleine bestreiten?"
  },
  {
    "RowId": 15431,
    "Text": "Unstete Kommandos können während des Kampfes oder bei laufender Reaktivierungszeit nicht geändert werden."
  },
  {
    "RowId": 15432,
    "Text": "Um die aufgedeckte Geschichte lesen zu können, muss der Auftrag „<sheet(Quest,IntegerParameter(1),0)>“ abgeschlossen sein."
  },
