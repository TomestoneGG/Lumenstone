  },
  {
    "RowId": 2841,
    "Text": "Dieser Inhalt gewährt Belohnungen, die beim reisenden Mogry eingetauscht werden können."
  },
  {
    "RowId": 2842,
    "Text": "Missionsfortschritt <Num>IntegerParameter(1)</Num>/<Num>IntegerParameter(2)</Num>"
  },
  {
    "RowId": 2843,
    "Text": "\\\\< <Num>IntegerParameter(1)</Num> Minute<If(Equal(IntegerParameter(1),1))> <Else/>n</If>"
  },
