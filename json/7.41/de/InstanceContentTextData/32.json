  {
    "RowId": 42000,
    "Text": "Brutalo Biestinator brennt auf Rache!"
  },
  {
    "RowId": 42001,
    "Text": "Ist ein Sieg gegen so viele Seelen überhaupt möglich?!"
  },
  {
    "RowId": 42002,
    "Text": "Er nutzt die Kraft der Bestien, um Waffen zu erzeugen!"
  },
  {
    "RowId": 42003,
    "Text": "Was zum...?! Aus den Samen sind Ungeheuer gewachsen!"
  },
  {
    "RowId": 42004,
    "Text": "Die Kameras wurden versteinert! Sie können sich nicht mehr in der Luft halten!"
  },
  {
    "RowId": 42005,
    "Text": "Was für eine Schlagkraft! Die Herausforderer wurden weggeschleudert!"
  },
  {
    "RowId": 42006,
    "Text": "Ich werd verrückt! Brutalo Biestinator klebt an der Wand!"
  },
  {
    "RowId": 42007,
    "Text": "Er springt von Wand zu Wand!"
  },
  {
    "RowId": 42008,
    "Text": "Ein Angriff für die Geschichtsbücher! Der ganze Boden wurde zerschmettert! "
  },
  {
    "RowId": 42009,
    "Text": "Schnell hinterher mit den Kameras!"
  },
  {
    "RowId": 42010,
    "Text": "Der Einsturz hat ein Feuer ausgelöst!"
  },
  {
    "RowId": 42011,
    "Text": "Ein Lariat! In diesem Ungetüm steckt immer noch Brutalo Bomber!"
  },
  {
    "RowId": 42012,
    "Text": "Was für eine Intensität! Wie viel Kraft haben ihm die Seelen nur verliehen?!"
  },
  {
    "RowId": 42013,
    "Text": "Die Herausforderer konnten allen Angriffen ausweichen! Unglaublich!"
  },
  {
    "RowId": 42014,
    "Text": "Ein Angriff mit ganzer Kraft! Aber die Herausforderer halten stand!"
  },
  {
    "RowId": 42015,
    "Text": "Dieser spektakuläre Kampf will einfach kein Ende nehmen!"
  },
  {
    "RowId": 42016,
    "Text": "Brutalo Biestinator bezwingen"
