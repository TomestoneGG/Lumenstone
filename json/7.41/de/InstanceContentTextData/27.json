  {
    "RowId": 39200,
    "Text": "Besiege Gulool Ja Jas Glorie!"
  },
  {
    "RowId": 39201,
    "Text": "Zeigt mir den Mut, den ihr auf eurer Reise gesammelt habt!"
  },
  {
    "RowId": 39202,
    "Text": "Lasst es uns beweisen! Gemeinsam können wir selbst den Dämmerkönig bezwingen!"
  },
  {
    "RowId": 39203,
    "Text": ""
  },
  {
    "RowId": 39204,
    "Text": "Das sieht nicht gut aus. Schnell, schaffen wir Deckung!"
  },
  {
    "RowId": 39205,
    "Text": "Meinen Flammen entkommt niemand."
  },
  {
    "RowId": 39206,
    "Text": "Feurige Klinge, stürze hernieder."
  },
  {
    "RowId": 39207,
    "Text": "Zu einem guten Kampf sage ich nie Nein!"
  },
  {
    "RowId": 39208,
    "Text": ""
  },
  {
    "RowId": 39209,
    "Text": "Es hat nicht gereicht?! In dem Fall... Alle auf sie!"
  },
  {
    "RowId": 39210,
    "Text": "Flammen des Mutes, in Weisheit vereint..."
  },
  {
    "RowId": 39211,
    "Text": "Schnell, hinter mich! Das sieht gefährlich aus!"
  },
  {
    "RowId": 39212,
    "Text": "Könnt ihr dieser Stärke wirklich trotzen?"
  },
  {
    "RowId": 39213,
    "Text": "Ich werde den Frieden auf Tural beschützen!"
  },
  {
    "RowId": 39214,
    "Text": "Hah ...! Selbst deine gesamte Kraft war nicht genug, Alterchen!"
  },
  {
    "RowId": 39215,
    "Text": "Ihr steht tatsächlich noch?! Glaubt euch aber noch nicht als Sieger!"
  },
  {
    "RowId": 39216,
    "Text": "Ich werde dich übertrumpfen und Lamaty'i den Thron gewinnen! Für die Zukunft Tuliyollals!"
  },
  {
    "RowId": 39217,
    "Text": ""
  },
  {
    "RowId": 39218,
    "Text": ""
  },
  {
    "RowId": 39219,
    "Text": "Enttäuscht mich nicht, ja?"
  },
  {
    "RowId": 39220,
    "Text": "Wollt ihr immer noch nicht aufgeben?"
  },
  {
    "RowId": 39221,
    "Text": "Werdet zur glühenden Klinge, die unsere Feinde zerteilt!"
  },
  {
    "RowId": 39222,
    "Text": "<split(<String>ObjectParameter(1)</String>, ,1)>, nein! Das darf nicht sein!"
  },
  {
    "RowId": 39223,
    "Text": "Habt ihr auch an Weisheit gewonnen ...?"
  },
  {
    "RowId": 39224,
    "Text": "Nichts als Kämpfen im Schädel... Ich beende dieses alberne Spielchen."
  },
  {
    "RowId": 39225,
    "Text": "Pfad der Morgensonne in 5..."
  },
  {
    "RowId": 39226,
    "Text": "Pfad der Morgensonne in 4..."
  },
  {
    "RowId": 39227,
    "Text": "Pfad der Morgensonne in 3..."
  },
  {
    "RowId": 39228,
    "Text": "Pfad der Morgensonne in 2..."
  },
  {
    "RowId": 39229,
    "Text": "Pfad der Morgensonne in 1..."
  },
  {
    "RowId": 39230,
    "Text": "Könnt ihr folgen?"
