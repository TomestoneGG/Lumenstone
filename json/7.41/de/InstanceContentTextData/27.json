  {
    "RowId": 39000,
    "Text": "Besiege Samidare!"
  },
  {
    "RowId": 39001,
    "Text": "Du hast Flatterschein die längste Zeit besessen!"
  },
  {
    "RowId": 39002,
    "Text": "Mit diesem Artefakt ist die schwierigste Technik ein Klacks!"
  },
  {
    "RowId": 39003,
    "Text": "Selbst Bestien beherrscht man damit! Bei Fuß, meine Diener!"
  },
  {
    "RowId": 39004,
    "Text": "Mal sehen, ob ihr denen entkommt!"
  },
  {
    "RowId": 39005,
    "Text": "Jetzt! Auf sie!"
  },
  {
    "RowId": 39006,
    "Text": "Verdammt, sind das viele... Überlass sie mir!"
  },
  {
    "RowId": 39007,
    "Text": ""
  },
  {
    "RowId": 39008,
    "Text": "Lästiges Geschmeiß! Zeit, dass dieser Magnai hier aufräumt!"
  },
  {
    "RowId": 39009,
    "Text": "Schluss mit dem Gewusel!"
  },
  {
    "RowId": 39010,
    "Text": "Bestimmt hat Sadu ein paar gute Tricks auf Lager!"
  },
  {
    "RowId": 39011,
    "Text": "Hahaha! Ein Freiflug bis zum Mond ohne Wiederkehr!"
  },
  {
    "RowId": 39012,
    "Text": "Also gut! Mal sehen, ob ihr es mit einer Gottheit aufnehmen könnt!"
  },
  {
    "RowId": 39013,
    "Text": "Erzittert vor der Macht von Tamamo no Gozen!"
  },
  {
    "RowId": 39014,
    "Text": "Das gefällt mir nicht. Wir halten besser Abstand!"
  },
  {
    "RowId": 39015,
    "Text": "Ha, es hat gerade erst begonnen!"
  },
  {
    "RowId": 39016,
    "Text": "Die Macht der Füchsin ist grenzenlos!"
  },
  {
    "RowId": 39017,
    "Text": "Ich werde den hiesigen Äther aufsaugen und unendliches Leid über euch bringen!"
  },
  {
    "RowId": 39018,
    "Text": "Ich spüre eine grausame Kraft. Wir müssen ihn irgendwie stören!"
  },
  {
    "RowId": 39019,
    "Text": "Neunundneunzigfacher Fluch in 10 ..."
  },
  {
    "RowId": 39020,
    "Text": "Neunundneunzigfacher Fluch in 5 ..."
  },
  {
    "RowId": 39021,
    "Text": "Neunundneunzigfacher Fluch in 4 ..."
  },
  {
    "RowId": 39022,
    "Text": "Neunundneunzigfacher Fluch in 3 ..."
  },
  {
    "RowId": 39023,
    "Text": "Neunundneunzigfacher Fluch in 2 ..."
  },
  {
    "RowId": 39024,
    "Text": "Neunundneunzigfacher Fluch in 1 ..."
  },
  {
    "RowId": 39025,
    "Text": ""
  },
  {
    "RowId": 39026,
    "Text": "\\\\<keuch> ... \\\\<pust> ...\nIhr konntet dieser Allmacht widerstehen?!"
  },
  {
    "RowId": 39027,
    "Text": "Egal, solange ich das Artefakt besitze, bin ich unbesiegbar!"
  },
  {
    "RowId": 39028,
    "Text": "Niemals! Ich werde nie vor euch kapitulieren!"
  },
  {
    "RowId": 39029,
    "Text": "Zerschlage die Fessel und befreie Kuiyki!"
  },
  {
    "RowId": 39030,
    "Text": "Zerstöre die Finsterspähren!"
  },
  {
    "RowId": 39031,
    "Text": "Ihr wollt mich besiegen? Nur über I'tocas Leiche!"
  },
  {
    "RowId": 39032,
    "Text": "Der Mistkerl schwächelt! Das ist unsere Chance!"
  },
