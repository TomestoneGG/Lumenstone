  {
    "RowId": 45300,
    "Text": "Celui qui ose s'opposer à moi... finira prisonnier des Ténèbres."
  },
  {
    "RowId": 45301,
    "Text": "Disparais."
  },
  {
    "RowId": 45302,
    "Text": "Je peux manipuler le néant à ma guise."
  },
  {
    "RowId": 45303,
    "Text": "Tu ne mérites pas de vivre."
  },
  {
    "RowId": 45304,
    "Text": "Sois anéanti<If(PlayerParameter(4))>e<Else/> </If>..."
  },
  {
    "RowId": 45305,
    "Text": "Toute résistance est futile."
  },
  {
    "RowId": 45306,
    "Text": "Je détruirai la frontière entre nos mondes."
  },
  {
    "RowId": 45307,
    "Text": "Cesse donc de bouger."
  },
  {
    "RowId": 45308,
    "Text": "Et si je te projettais dans une faille?"
  },
  {
    "RowId": 45309,
    "Text": "Ce monde n'a qu'une seule vérité!"
  },
  {
    "RowId": 45310,
    "Text": "Tout sera bientôt englouti\u00A0!"
  },
  {
    "RowId": 45311,
    "Text": "Ici, il n'y a rien..."
  },
  {
    "RowId": 45312,
    "Text": "Ni passé, ni futur... ni présent."
  },
  {
    "RowId": 45313,
    "Text": "Tu ne ressentiras plus qu'une chose..."
  },
  {
    "RowId": 45314,
    "Text": "Mon existence!"
  },
  {
    "RowId": 45315,
    "Text": "J'ai pu créer une brèche dans son domaine! Suis la Lumière pour en sortir!"
  },
  {
    "RowId": 45316,
    "Text": "Tu dois briser cet espace de l'intérieur!"
  },
  {
    "RowId": 45317,
    "Text": "On s'est occupé du menu fretin! On arrive en renfort!"
  },
  {
    "RowId": 45318,
    "Text": "La vie, la mort... Plus rien n'a de sens."
  },
  {
    "RowId": 45319,
    "Text": "Admire le véritable pouvoir du néant!"
  },
  {
    "RowId": 45320,
    "Text": "Tu n'auras pas notre monde!"
  },
  {
    "RowId": 45321,
    "Text": "Ô puissante Lumière, prête-nous ta force!"
  },
  {
    "RowId": 45322,
    "Text": "Impossible! Le néant ne peut disparaître!"
  },
  {
    "RowId": 45323,
    "Text": "Ma puissance est absolue!"
  },
  {
    "RowId": 45324,
    "Text": "Viens aux confins de la Lumière et des Ténèbres..."
  },
  {
    "RowId": 45325,
    "Text": "Et succombe au silence éternel!"
  },
