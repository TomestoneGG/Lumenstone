[
  {
    "RowId": 44694,
    "Text": "Das war noch viel zu zart,\nso langsam komme ich in Fahrt!"
  },
  {
    "RowId": 44695,
    "Text": "Die Essenz der wahren Magie\nzwingt euch alle in die Knie!"
  },
  {
    "RowId": 44696,
    "Text": "Was für andere unmöglich sei,\nist für mich nur Spielerei!"
  },
  {
    "RowId": 44697,
    "Text": "Weiter kämpft ihr gegen mich an...\nDoch ihr wisst nicht, was ich noch alles kann!"
  },
  {
    "RowId": 44698,
    "Text": "Versucht gar nicht erst zu rennen,\nmeine Rache wird euch verbrennen!"
  },
  {
    "RowId": 44699,
    "Text": "Ihr habt es geschafft, meine Geduld ist am Ende!"
  },
  {
    "RowId": 44700,
    "Text": "……わたくし、ブチ切れましたわ。"
  },
  {
    "RowId": 44701,
    "Text": "Nobel war euer Streben,\ndoch nun erlischt die Flamme eurer Leben!"
  },
  {
    "RowId": 44702,
    "Text": "Ihr versteht schnell, das lobe ich mir!\nFast, als stünde mein Schüler hier."
  },
  {
    "RowId": 44703,
    "Text": "Ooohohohoho! Das war wohl zu schwer,\nerwartet hätte ich von euch mehr!"
  },
  {
    "RowId": 44704,
    "Text": "Meine arme Puppe, zerstört wie von einer Presse.\nGlaubt ja nicht, dass ich diese Schmach vergesse..."
  },
  {
    "RowId": 44705,
    "Text": "Dieser Zauber...?! Bleibt wachsam!"
  },
  {
    "RowId": 44706,
    "Text": "Urgh... Weniger hätte ich auch nicht erwartet. Geht es allen gut?!"
  },
  {
    "RowId": 44707,
    "Text": "Gebt nicht auf! Schnell, helft den Gefallenen!"
  },
  {
    "RowId": 44708,
    "Text": "Doktor Shantotto überlebt man nicht ohne ein paar Wunden. Heiler, wir verlassen uns auf euch!"
  },
  {
    "RowId": 44709,
    "Text": "Ooohohohohoho!"
  },
  {
    "RowId": 44710,
    "Text": "Wer... riefet meinen Namen?!"
  },
  {
    "RowId": 44711,
    "Text": "Wir haben es mit einer Gründergottheit zu tun! Kämpft mit aller Kraft!"
  },
  {
    "RowId": 44712,
    "Text": "Verlangen... Hunger... nach dem Ende der Sterblichkeit."
  },
  {
    "RowId": 44713,
    "Text": "Sehnsucht nach dem Nichts..."
  },
  {
    "RowId": 44714,
    "Text": "Besiegelt ist das Schicksal aller..."
  },
  {
    "RowId": 44715,
    "Text": "Das Nichts... durchdringt alles."
  },
  {
    "RowId": 44716,
    "Text": "Teile meiner Selbst... Nah und fern..."
  },
  {
    "RowId": 44717,
    "Text": "Stürzet hernieder... O Sterne."
  },
  {
    "RowId": 44718,
    "Text": "O Göttin der Morgenröte...! Erfüllt mein Herz mit Eurem Glanz...!"
  },
  {
    "RowId": 44719,
    "Text": "Werde mein... Herz voll Arroganz."
  },
  {
    "RowId": 44720,
    "Text": "Dieser Ort... Er ist erfüllt vom „Nichts“, der inneren Dunkelheit der Bewohner Vana'diels!"
  },
  {
    "RowId": 44721,
    "Text": "Ich habe unzählige Bünde des Vertrauens mit meinen Kameraden geschmiedet. Als ob ich jetzt dem Nichts erliegen würde!"
  },
  {
    "RowId": 44722,
    "Text": "Der Sieg der Dämmerung ist unausweichlich..."
  },
  {
    "RowId": 44723,
    "Text": "Die eigene Schwäche begeht Verrat..."
  },
  {
    "RowId": 44724,
    "Text": "Er hat das Nichts in sich aufgenommen!"
  },
  {
    "RowId": 44725,
    "Text": "Der ewige Abschied erlöst uns..."
  },
  {
    "RowId": 44726,
    "Text": "Diesen Promathia kenne ich nicht...! Sareel Ja muss auch hier seine Finger im Spiel haben."
  },
  {
    "RowId": 44727,
    "Text": "Was ist das...?!"
  },
  {
    "RowId": 44728,
    "Text": "Das Nichts fließt aus ihm heraus...!"
  },
  {
    "RowId": 44729,
    "Text": "Lasst euch davon nicht verschlucken!"
  },
  {
    "RowId": 44730,
    "Text": "Ein unechter Tod... Nicht absolut.\nVerwehrt bleibt diesem Körper... die wahre Erfüllung..."
  },
  {
    "RowId": 44731,
    "Text": "Er will die Dunkelheit in meinem Herzen gegen uns verwenden?!"
  },
  {
    "RowId": 44732,
    "Text": "Vorsicht, sie führt etwas im Schilde!"
  },
