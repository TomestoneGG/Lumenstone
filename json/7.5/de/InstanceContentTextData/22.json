  {
    "RowId": 45300,
    "Text": "Schöne, stille Dunkelheit. Umschließe meine Widersacher!"
  },
  {
    "RowId": 45301,
    "Text": "Alles erlischt!"
  },
  {
    "RowId": 45302,
    "Text": "Das Nichts gehorcht mir."
  },
  {
    "RowId": 45303,
    "Text": "Du bist ein Niemand."
  },
  {
    "RowId": 45304,
    "Text": "Vergehe!"
  },
  {
    "RowId": 45305,
    "Text": "Wehr dich nicht."
  },
  {
    "RowId": 45306,
    "Text": "Die Grenzen werden eingerissen."
  },
  {
    "RowId": 45307,
    "Text": "Möge Stillstand herrschen."
  },
  {
    "RowId": 45308,
    "Text": "Wer will in den Abgrund blicken?"
  },
  {
    "RowId": 45309,
    "Text": "Das ist das wahre Gesicht der Realität!"
  },
  {
    "RowId": 45310,
    "Text": "Das Nichts wird alles verschlingen."
  },
  {
    "RowId": 45311,
    "Text": "Alles wird zu nichts."
  },
  {
    "RowId": 45312,
    "Text": "Kein Gestern, kein Heute, kein Morgen."
  },
  {
    "RowId": 45313,
    "Text": "Jetzt gibt es nur noch eins ..."
  },
  {
    "RowId": 45314,
    "Text": "Meine Macht!"
  },
  {
    "RowId": 45315,
    "Text": "Das ist seine Domäne. Folgt dem Licht!"
  },
  {
    "RowId": 45316,
    "Text": "Raus da, schnell!"
  },
  {
    "RowId": 45317,
    "Text": "Die sind erledigt. Jetzt auf Enuo!"
  },
  {
    "RowId": 45318,
    "Text": "Leben und Tod haben keine Bedeutung."
  },
  {
    "RowId": 45319,
    "Text": "Das ist die Macht des Nichts!"
  },
  {
    "RowId": 45320,
    "Text": "Ich gebe diese Welt nicht auf!"
  },
  {
    "RowId": 45321,
    "Text": "Licht, schenk uns Kraft!"
  },
  {
    "RowId": 45322,
    "Text": "Das Nichts kann nicht vergehen!"
  },
  {
    "RowId": 45323,
    "Text": "Seine Macht ist absolut!"
  },
  {
    "RowId": 45324,
    "Text": "Licht und Dunkel enden nun ..."
  },
  {
    "RowId": 45325,
    "Text": "Übrig bleibt nur ewige Stille ..."
  },
