  },
  {
    "RowId": 10992,
    "Text": "Gegenstandsstufe nicht anpassen"
  },
  {
    "RowId": 10993,
    "Text": "Senkt die Stufe aller Ausrüstungsgegenstände beider Duellanten auf die Stufe des Gegenstands mit der niedrigsten Gegenstandsstufe, in diesem Fall \uE0BD <Num>IntegerParameter(1)</Num>."
  },
  {
    "RowId": 10994,
    "Text": "Senkt die Stufe aller Ausrüstungsgegenstände beider Duellanten auf \uE0BD 150. Gegenstände mit einer Stufe unter 150 werden nicht angepasst."
  },
  {
    "RowId": 10995,
    "Text": "Alle Ausrüstungsgegenstände behalten ihre Stufe."
  },
