  {
    "RowId": 10801,
    "Text": "Kampf der Trabanten"
  },
  {
    "RowId": 10802,
    "Text": "※ Für bereits vollständige Gruppen ist jede Zusammensetzung und Gegenstandsstufe erlaubt."
  },
  {
    "RowId": 10803,
    "Text": "※ Für bereits vollständige Allianzen ist jede Zusammensetzung und Gegenstandsstufe erlaubt."
  },
