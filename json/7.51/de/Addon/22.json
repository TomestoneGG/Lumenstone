    "Text": ""
  },
  {
    "RowId": 10973,
    "Text": "Zertifiziert"
  },
  {
    "RowId": 10974,
    "Text": "<Icon>79</Icon> Mentor (K/M)"
  },
  {
    "RowId": 10975,
    "Text": "1. Bedingung: 1.000 Dungeons, Raids oder Prüfungen erfolgreich abgeschlossen."
  },
  {
    "RowId": 10976,
    "Text": "<Icon>80</Icon> Mentor (HW/S)"
  },
  {
    "RowId": 10977,
    "Text": "1. Bedingung: 300 Sammlerstücke sammeln."
  },
  {
    "RowId": 10978,
    "Text": "Als Mentor registrieren"
  },
  {
    "RowId": 10979,
    "Text": "Abbrechen"
  },
  {
    "RowId": 10980,
    "Text": "Du hast dich dem Titel „Mentor für Krieger und Magier“ als würdig erwiesen!"
  },
  {
    "RowId": 10981,
    "Text": "Du hast dich dem Titel „Mentor für Sammler und Handwerker“ als würdig erwiesen!"
  },
  {
    "RowId": 10982,
    "Text": "Erstaunlich! Du bist ein wahres Multitalent!"
  },
  {
    "RowId": 10983,
    "Text": "Ich fürchte, deine Erfahrung reicht nicht aus, um den Mentoren-Status zu erhalten. Übe noch ein wenig und melde dich dann wieder bei mir."
  },
  {
    "RowId": 10984,
    "Text": "2. Bedingung: 1.500 Ehrungen zum wertvollsten Spieler erhalten."
  },
  {
    "RowId": 10985,
    "Text": "3. Bedingung: Rollenauftrag für Verteidiger der Stufe <Num>IntegerParameter(1)</Num> abgeschlossen."
  },
  {
    "RowId": 10986,
    "Text": "4. Bedingung: Rollenauftrag für Heiler der Stufe <Num>IntegerParameter(1)</Num> abgeschlossen."
  },
  {
    "RowId": 10987,
    "Text": "Bitte warten - Inhalt ist stark besucht"
  },
  {
    "RowId": 10988,
    "Text": "Position auf der Warteliste"
  },
  {
    "RowId": 10989,
    "Text": "Möchtest du die Teilnahme abbrechen?"
