  },
  {
    "RowId": 1666,
    "Unknown0": "神羅なんかクソ食らえってなもんだ！",
    "Unknown1": "しんらなんかくそくらえってなもんだ"
  },
  {
    "RowId": 1667,
    "Unknown0": "ネコっかわいがりの刑だ！",
    "Unknown1": "ねこっかわいがりのけいだ"
  },
  {
    "RowId": 1668,
    "Unknown0": "星命学の聖地コスモキャニオン",
    "Unknown1": "せいめいがくのせいちこすもきゃにおん"
  },
  {
    "RowId": 1669,
    "Unknown0": "星とともにあらんことを",
