[
  {
    "RowId": 44694,
    "Text": "Das war noch viel zu zart,\nso langsam komme ich in Fahrt!"
  },
  {
    "RowId": 44695,
    "Text": "Die Essenz der wahren Magie\nzwingt euch alle in die Knie!"
  },
  {
    "RowId": 44696,
    "Text": "Was für andere unmöglich sei,\nist für mich nur Spielerei!"
  },
  {
    "RowId": 44697,
    "Text": "Weiter kämpft ihr gegen mich an...\nDoch ihr wisst nicht, was ich noch alles kann!"
  },
  {
    "RowId": 44698,
    "Text": "Versucht gar nicht erst zu rennen,\nmeine Rache wird euch verbrennen!"
  },
  {
    "RowId": 44699,
    "Text": "Ihr habt es geschafft, meine Geduld ist am Ende!"
  },
  {
    "RowId": 44700,
    "Text": "……わたくし、ブチ切れましたわ。"
  },
  {
    "RowId": 44701,
    "Text": "Nobel war euer Streben,\ndoch nun erlischt die Flamme eurer Leben!"
  },
  {
    "RowId": 44702,
    "Text": "Ihr versteht schnell, das lobe ich mir!\nFast, als stünde mein Schüler hier."
  },
  {
    "RowId": 44703,
    "Text": "Ooohohohoho! Das war wohl zu schwer,\nerwartet hätte ich von euch mehr!"
  },
  {
    "RowId": 44704,
    "Text": "Meine arme Puppe, zerstört wie von einer Presse.\nGlaubt ja nicht, dass ich diese Schmach vergesse..."
  },
  {
    "RowId": 44705,
    "Text": "Dieser Zauber...?! Bleibt wachsam!"
  },
  {
    "RowId": 44706,
    "Text": "Urgh... Weniger hätte ich auch nicht erwartet. Geht es allen gut?!"
  },
  {
    "RowId": 44707,
    "Text": "Gebt nicht auf! Schnell, helft den Gefallenen!"
  },
  {
    "RowId": 44708,
    "Text": "Doktor Shantotto überlebt man nicht ohne ein paar Wunden. Heiler, wir verlassen uns auf euch!"
  },
  {
    "RowId": 44709,
    "Text": "Ooohohohohoho!"
  },
  {
    "RowId": 44710,
    "Text": "Wer... riefet meinen Namen?!"
  },
  {
    "RowId": 44711,
    "Text": "Wir haben es mit einer Gründergottheit zu tun! Kämpft mit aller Kraft!"
  },
  {
    "RowId": 44712,
    "Text": "Verlangen... Hunger... nach dem Ende der Sterblichkeit."
  },
  {
    "RowId": 44713,
    "Text": "Sehnsucht nach dem Nichts..."
  },
  {
    "RowId": 44714,
    "Text": "Besiegelt ist das Schicksal aller..."
  },
  {
    "RowId": 44715,
    "Text": "Das Nichts... durchdringt alles."
  },
  {
    "RowId": 44716,
    "Text": "Teile meiner Selbst... Nah und fern..."
  },
  {
    "RowId": 44717,
    "Text": "Stürzet hernieder... O Sterne."
  },
  {
    "RowId": 44718,
    "Text": "O Göttin der Morgenröte...! Erfüllt mein Herz mit Eurem Glanz...!"
  },
  {
    "RowId": 44719,
    "Text": "Werde mein... Herz voll Arroganz."
  },
  {
    "RowId": 44720,
    "Text": "Dieser Ort... Er ist erfüllt vom „Nichts“, der inneren Dunkelheit der Bewohner Vana'diels!"
  },
  {
    "RowId": 44721,
    "Text": "Ich habe unzählige Bünde des Vertrauens mit meinen Kameraden geschmiedet. Als ob ich jetzt dem Nichts erliegen würde!"
  },
  {
    "RowId": 44722,
    "Text": "Der Sieg der Dämmerung ist unausweichlich..."
  },
  {
    "RowId": 44723,
    "Text": "Die eigene Schwäche begeht Verrat..."
  },
  {
    "RowId": 44724,
    "Text": "Er hat das Nichts in sich aufgenommen!"
  },
  {
    "RowId": 44725,
    "Text": "Der ewige Abschied erlöst uns..."
  },
  {
    "RowId": 44726,
    "Text": "Diesen Promathia kenne ich nicht...! Sareel Ja muss auch hier seine Finger im Spiel haben."
  },
  {
    "RowId": 44727,
    "Text": "Was ist das...?!"
  },
  {
    "RowId": 44728,
    "Text": "Das Nichts fließt aus ihm heraus...!"
  },
  {
    "RowId": 44729,
    "Text": "Lasst euch davon nicht verschlucken!"
  },
  {
    "RowId": 44730,
    "Text": "Ein unechter Tod... Nicht absolut.\nVerwehrt bleibt diesem Körper... die wahre Erfüllung..."
  },
  {
    "RowId": 44731,
    "Text": "Er will die Dunkelheit in meinem Herzen gegen uns verwenden?!"
  },
  {
    "RowId": 44732,
    "Text": "Vorsicht, sie führt etwas im Schilde!"
  },
  {
    "RowId": 44800,
    "Text": "Hrrraaarrr! Unsere Bande sind allmächtig!"
  },
  {
    "RowId": 44801,
    "Text": "Jetzt! Gemeinsam sind wir unsterblich!"
  },
  {
    "RowId": 44802,
    "Text": "Hrrr ... Hrrr ... Hrrraaarrr!"
  },
  {
    "RowId": 44803,
    "Text": "Pshhh ... Wir zuschlagen aus Untererde!"
  },
  {
    "RowId": 44804,
    "Text": "Mein Schlageschwert so schnell wie Plappermaul, kho!"
  },
  {
    "RowId": 44805,
    "Text": "Kho! Hackrum auf Töffelchen is' fiesgemein!"
  },
  {
    "RowId": 44806,
    "Text": "Töffelchen! Du in Ordnung?"
  },
  {
    "RowId": 44807,
    "Text": "Losfrox hat Eisenwille!"
  },
  {
    "RowId": 44808,
    "Text": "Heutige Wettersage: Knallschauer!"
  },
  {
    "RowId": 44809,
    "Text": "M-Macht mir gar nix, weizzu?"
  },
  {
    "RowId": 44810,
    "Text": "Töffelchen, mach Leihekraft!"
  },
  {
    "RowId": 44900,
    "Text": "Diene mir, Tochter der Torheit!"
  },
  {
    "RowId": 44901,
    "Text": "Deine Klinge folgt meinem Willen."
  },
  {
    "RowId": 44902,
    "Text": "Die gesamte Schöpfung kriecht vor mir im Staub!"
  },
  {
    "RowId": 44903,
    "Text": "Du entkommst mir nicht, <If(PlayerParameter(4))>Bändigerin<Else/>Bändiger</If>!"
  },
  {
    "RowId": 44904,
    "Text": "Versenge, o Klinge!"
  },
  {
    "RowId": 44905,
    "Text": "Grrrrrr! Stirb ... STIRB!!!"
  },
  {
    "RowId": 44906,
    "Text": "Töricht! Wage es nicht ... dich mir zu widersetzen!"
  },
  {
    "RowId": 45100,
    "Text": "Beweise mir deine Stärke mit der Wahrheit."
  },
  {
    "RowId": 45101,
    "Text": "Wie steht es um dein Wissen von Zahlen?"
  },
  {
    "RowId": 45102,
    "Text": "Wie gut ist dein Gedächtnis?"
  },
  {
    "RowId": 45103,
    "Text": "Sag mir: Wer ist ein Kind der Wölklinge?"
  },
  {
    "RowId": 45104,
    "Text": "Sag mir: Wer ist ein Kind der Schupplinge?"
  },
  {
    "RowId": 45105,
    "Text": "Sag mir: Wer ist ein Kind der Biestlinge?"
  },
  {
    "RowId": 45106,
    "Text": "Sag mir: Wer ist ein Kind der Woglinge?"
  },
  {
    "RowId": 45107,
    "Text": "Vortrefflich. Diese Leistung will gebührend entlohnt werden."
  },
  {
    "RowId": 45108,
    "Text": "Erbärmlich. Dieser Fehler will gebührend bestraft werden."
  },
  {
    "RowId": 45109,
    "Text": "Du hast deine Stärke bewiesen."
  },
  {
    "RowId": 45110,
    "Text": "Kupo! Jetzt gibt's auf die Bommel!"
  },
  {
    "RowId": 45111,
    "Text": "Unserer Mogry-Magie bist du nicht gewachsen! Kupokadabra!"
  },
  {
    "RowId": 45112,
    "Text": "Reißt euch am Bommel, Leute! Verkupot diesen Kümmerling nach Strich und Faden!"
  },
  {
    "RowId": 45113,
    "Text": "Mögen unsere Bande uns Kraft bescheren!"
  },
  {
    "RowId": 45114,
    "Text": "Meiner Klinge wirst du nicht entkommen!"
  },
  {
    "RowId": 45115,
    "Text": "Alles gehorcht meinem Willen. Und bald auch du!"
  },
  {
    "RowId": 45116,
    "Text": "Den Fesseln der Lhu ... Kann niemand entkommen!"
  },
  {
    "RowId": 45117,
    "Text": "Guttler, schenk mir die Kraft des Feuers!"
  },
  {
    "RowId": 45118,
    "Text": "Labe dich an meiner Kraft, Lauda. Fälle unsere Feinde!"
  },
  {
    "RowId": 45119,
    "Text": "Unsere Seelen flackern ... Mögen sie abermals auflodern!"
  },
  {
    "RowId": 45120,
    "Text": "Der Pfad, den Guttler und ich beschreiten ...\nEr soll hier nicht enden! Erfahre unsere Macht!"
  },
  {
    "RowId": 45121,
    "Text": "Vermagst du, zu sehen, was nicht sichtbar ist?"
  },
  {
    "RowId": 45122,
    "Text": "Du hast noch fünf Sekunden."
  },
  {
    "RowId": 45123,
    "Text": "Vier ..."
  },
  {
    "RowId": 45124,
    "Text": "Drei ..."
  },
  {
    "RowId": 45125,
    "Text": "Zwei ..."
  },
  {
    "RowId": 45126,
    "Text": "Eins ..."
  },
  {
    "RowId": 45127,
    "Text": "Deine Stärke erkenne ich an.\nAber ich werde mich nicht vor ihr beugen!"
  },
  {
    "RowId": 45128,
    "Text": "Sag mir: Wo liegen die Geraden?"
  },
  {
    "RowId": 45129,
    "Text": "Sag mir: Wo liegen die Ungeraden?"
  },
  {
    "RowId": 45130,
    "Text": "Sag mir: Was lässt sich teilen durch drei?"
  },
  {
    "RowId": 45131,
    "Text": "Sag mir: Was ist nur mit sich selbst im Reinen?"
  },
  {
    "RowId": 45132,
    "Text": "Triff deine Wahl."
  },
  {
    "RowId": 45200,
    "Text": "Was sind das für Kreaturen?!"
  },
  {
    "RowId": 45201,
    "Text": "Wilde Tiere können das ja kaum sein..."
  },
  {
    "RowId": 45202,
    "Text": "Darüber kannst du später nachdenken. Augen nach vorn!"
  },
  {
    "RowId": 45203,
    "Text": "Ich verlass mich auf euch."
  },
  {
    "RowId": 45204,
    "Text": "Natürlich. Ich decke euch den Rücken."
  },
  {
    "RowId": 45205,
    "Text": "Jetzt reicht's aber. Schluss damit!"
  },
  {
    "RowId": 45206,
    "Text": "Sie wollen angreifen ... Macht euch bereit!"
  },
  {
    "RowId": 45207,
    "Text": "Hier, ein wenig Verstärkung!"
  },
  {
    "RowId": 45208,
    "Text": "Was soll das denn bitte werden?"
  },
  {
    "RowId": 45209,
    "Text": "Finger weg von ihm!"
  },
  {
    "RowId": 45210,
    "Text": "Danke euch!"
  },
  {
    "RowId": 45211,
    "Text": "Eigenartig... Sie haben mich festgesetzt und sofort in Ruhe gelassen."
  },
  {
    "RowId": 45212,
    "Text": "War das also ihre eigentliche Absicht?"
  },
  {
    "RowId": 45213,
    "Text": "Was sollte das denn gewesen sein?"
  },
  {
    "RowId": 45214,
    "Text": "Es scheint vorerst Ruhe eingekehrt zu sein..."
  },
  {
    "RowId": 45215,
    "Text": "Ich halte ein Auge auf die Manöver des Feindes!"
  },
  {
    "RowId": 45216,
    "Text": "Die scheint sich auszukennen. Spielen wir mit."
  },
  {
    "RowId": 45217,
    "Text": "Die ganze Wassermagie entlädt sich! Haltet Abstand!"
  },
  {
    "RowId": 45218,
    "Text": "Verzeichne einen massiven Anstieg der magischen Dichte!"
  },
  {
    "RowId": 45219,
    "Text": "Weg da, bevor alles hochgeht!"
  },
  {
    "RowId": 45220,
    "Text": "Augen nach oben, bevor euch das Wasser erschlägt!"
  },
  {
    "RowId": 45221,
    "Text": "Seid wachsam und passt gut auf, dann könnt ihr ausweichen!"
  },
  {
    "RowId": 45222,
    "Text": "Ein Anstieg der magischen Potenz... Rückzug, sofort!"
  },
  {
    "RowId": 45223,
    "Text": "Raus da, sonst seid ihr in großen Schwierigkeiten!"
  },
  {
    "RowId": 45224,
    "Text": "Sie wollen mich noch einmal fesseln!"
  },
  {
    "RowId": 45225,
    "Text": "Oh nein, keine Chance!"
  },
  {
    "RowId": 45226,
    "Text": "Besten Dank für die Unterstützung!"
  },
  {
    "RowId": 45227,
    "Text": "Überlasst die Kleinen mir und kümmert euch um den Großen!"
  },
  {
    "RowId": 45228,
    "Text": "Zieht die Kreatur Äther aus der Insel?!"
  },
  {
    "RowId": 45229,
    "Text": "Es sammelt Magie in seiner Brust! Greift den Kern an!"
  },
  {
    "RowId": 45230,
    "Text": "Schön, dann muss ich mich ja auch nicht zurückhalten."
  },
  {
    "RowId": 45231,
    "Text": "Das Blut der Drachen ..."
  },
  {
    "RowId": 45232,
    "Text": "Das hat wehgetan! Jetzt!"
  },
  {
    "RowId": 45233,
    "Text": "... besiegelt dein Schicksal!"
  },
  {
    "RowId": 45234,
    "Text": "Besiege die Angreifer!"
  },
  {
    "RowId": 45235,
    "Text": "Gut, einer nach dem anderen."
  },
  {
    "RowId": 45300,
    "Text": "Schöne, stille Dunkelheit. Umschließe meine Widersacher!"
  },
  {
    "RowId": 45301,
    "Text": "Alles erlischt!"
  },
  {
    "RowId": 45302,
    "Text": "Das Nichts gehorcht mir."
  },
  {
    "RowId": 45303,
    "Text": "Du bist ein Niemand."
  },
  {
    "RowId": 45304,
    "Text": "Vergehe!"
  },
  {
    "RowId": 45305,
    "Text": "Wehr dich nicht."
  },
  {
    "RowId": 45306,
    "Text": "Die Grenzen werden eingerissen."
  },
  {
    "RowId": 45307,
    "Text": "Möge Stillstand herrschen."
  },
  {
    "RowId": 45308,
    "Text": "Wer will in den Abgrund blicken?"
  },
  {
    "RowId": 45309,
    "Text": "Das ist das wahre Gesicht der Realität!"
  },
  {
    "RowId": 45310,
    "Text": "Das Nichts wird alles verschlingen."
  },
  {
    "RowId": 45311,
    "Text": "Alles wird zu nichts."
  },
  {
    "RowId": 45312,
    "Text": "Kein Gestern, kein Heute, kein Morgen."
  },
  {
    "RowId": 45313,
    "Text": "Jetzt gibt es nur noch eins ..."
  },
  {
    "RowId": 45314,
    "Text": "Meine Macht!"
  },
  {
    "RowId": 45315,
    "Text": "Das ist seine Domäne. Folgt dem Licht!"
  },
  {
    "RowId": 45316,
    "Text": "Raus da, schnell!"
  },
  {
    "RowId": 45317,
    "Text": "Die sind erledigt. Jetzt auf Enuo!"
  },
  {
    "RowId": 45318,
    "Text": "Leben und Tod haben keine Bedeutung."
  },
  {
    "RowId": 45319,
    "Text": "Das ist die Macht des Nichts!"
  },
  {
    "RowId": 45320,
    "Text": "Ich gebe diese Welt nicht auf!"
  },
  {
    "RowId": 45321,
    "Text": "Licht, schenk uns Kraft!"
  },
  {
    "RowId": 45322,
    "Text": "Das Nichts kann nicht vergehen!"
  },
  {
    "RowId": 45323,
    "Text": "Seine Macht ist absolut!"
  },
  {
    "RowId": 45324,
    "Text": "Licht und Dunkel enden nun ..."
  },
  {
    "RowId": 45325,
    "Text": "Übrig bleibt nur ewige Stille ..."
  },
  {
    "RowId": 45400,
    "Text": "Möge das Festmahl beginnen!"
  },
  {
    "RowId": 45401,
    "Text": "Eilt herbei, meine Schwestern! Bewirtet unseren Besuch!"
  },
  {
    "RowId": 45402,
    "Text": "Mich dürstet nach deiner Lebenskraft..."
  },
  {
    "RowId": 45403,
    "Text": "Erliege deiner Versuchung..."
  },
  {
    "RowId": 45404,
    "Text": "Liebe ist das süßeste Gift von allen, nicht wahr?"
  },
